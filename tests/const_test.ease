package main

import (
    "testing"
    "reflect"
    "json"
)

const MAX_SIZE = 1024
const APP_NAME = "myapp"
const DEBUG = false
const NEGATIVE = -1
const PI = 3.14
const GRAVITY = 9.81

fn TestConstInt(t: testing.T) {
    if MAX_SIZE != 1024 { t.Fatal("MAX_SIZE should be 1024") }
}

fn TestConstString(t: testing.T) {
    if APP_NAME != "myapp" { t.Fatal("APP_NAME should be myapp") }
}

fn TestConstBool(t: testing.T) {
    if DEBUG == true { t.Fatal("DEBUG should be false") }
}

fn TestConstNegativeInt(t: testing.T) {
    if NEGATIVE != -1 { t.Fatal("NEGATIVE should be -1") }
}

fn TestConstInExpression(t: testing.T) {
    x := MAX_SIZE * 2
    if x != 2048 { t.Fatal("MAX_SIZE * 2 should be 2048") }
}

fn TestConstStringConcat(t: testing.T) {
    greeting := "Hello, " + APP_NAME
    if greeting != "Hello, myapp" { t.Fatal("string concat with const failed") }
}

fn TestConstInComparison(t: testing.T) {
    if MAX_SIZE < 100 { t.Fatal("MAX_SIZE should be >= 100") }
    if MAX_SIZE > 2000 { t.Fatal("MAX_SIZE should be <= 2000") }
}

fn TestConstArithmetic(t: testing.T) {
    result := MAX_SIZE + NEGATIVE
    if result != 1023 { t.Fatal("MAX_SIZE + NEGATIVE should be 1023") }
}

fn TestConstFloat(t: testing.T) {
    if PI != 3.14 { t.Fatal("PI should be 3.14") }
    if GRAVITY != 9.81 { t.Fatal("GRAVITY should be 9.81") }
}

fn TestConstFloatArithmetic(t: testing.T) {
    circumference := 2.0 * PI * 10.0
    if circumference < 62.0 { t.Fatal("circumference should be >= 62.0") }
    if circumference > 63.0 { t.Fatal("circumference should be <= 63.0") }
}

struct ConstTestPoint {
    x: int,
    y: int,
}

const CONST_VAL_A = 42
const CONST_VAL_B = 99

fn TestConstInStructLiteral(t: testing.T) {
    p := ConstTestPoint { x: CONST_VAL_A, y: CONST_VAL_B }
    if p.x != 42 { t.Fatal("struct literal const field x should be 42") }
    if p.y != 99 { t.Fatal("struct literal const field y should be 99") }
}

struct ConstTaggedValue {
    type_tag: int,
    data: int,
}

const TYPE_A = 1
const TYPE_B = 2
const TYPE_C = 3

fn TestConstSmallValuesInStructLit(t: testing.T) {
    v := ConstTaggedValue { type_tag: TYPE_A, data: 100 }
    if v.type_tag != 1 { t.Fatal("type_tag should be 1, got something else") }
    if v.data != 100 { t.Fatal("data should be 100") }
}

fn TestConstSmallValuesInStructLit2(t: testing.T) {
    v := ConstTaggedValue { type_tag: TYPE_C, data: TYPE_B }
    if v.type_tag != 3 { t.Fatal("type_tag should be 3") }
    if v.data != 2 { t.Fatal("data should be 2") }
}

fn TestCrossPackageConst(t: testing.T) {
    x := reflect.INT
    if x != 1 { t.Fatal("reflect.INT should be 1") }
}

fn TestCrossPackageConstInStructLit(t: testing.T) {
    v := ConstTaggedValue { type_tag: reflect.STRING, data: 42 }
    if v.type_tag != 3 { t.Fatal("reflect.STRING should be 3") }
}

fn TestConstShadowingPrevention(t: testing.T) {
    // Both reflect and json define constants with small int values.
    // If scoping works, local TYPE_A/TYPE_B/TYPE_C should NOT be shadowed.
    if TYPE_A != 1 { t.Fatal("local TYPE_A should be 1") }
    if TYPE_B != 2 { t.Fatal("local TYPE_B should be 2") }
    if TYPE_C != 3 { t.Fatal("local TYPE_C should be 3") }
    // Cross-package access still works
    if reflect.INT != 1 { t.Fatal("reflect.INT should be 1") }
    if json.JSON_STRING != 1 { t.Fatal("json.JSON_STRING should be 1") }
}

fn TestLocalConstNotShadowedByImport(t: testing.T) {
    // json has private const json_string = 1 (lowercase = private)
    // It should NOT be visible here. Our local TYPE_A = 1 must resolve correctly.
    v := TYPE_A
    if v != 1 { t.Fatal("TYPE_A should be 1, not shadowed by imports") }
    // Verify multiple cross-package const types work
    if reflect.STRING != 3 { t.Fatal("reflect.STRING should be 3") }
    if json.JSON_ARRAY != 5 { t.Fatal("json.JSON_ARRAY should be 5") }
}

