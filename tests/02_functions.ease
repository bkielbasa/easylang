// Test 2: Function calls and recursion
fn add(x: int, y: int) -> int {
    return x + y
}

fn multiply(x: int, y: int) -> int {
    return x * y
}

fn factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn main() -> int {
    let sum = add(5, 3)
    if sum != 8 {
        return 1
    }
    
    let prod = multiply(4, 7)
    if prod != 28 {
        return 2
    }
    
    let fact = factorial(5)
    if fact != 120 {
        return 3
    }
    
    return 0
}
