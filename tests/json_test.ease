package main

import (
    "testing"
)

fn TestJsonNewObject(t: testing.T) {
    doc := json.New()
    doc.SetString("name", "ease")
    result := doc.GetString("name")
    if result != "ease" {
        t.Fatal("expected ease, got " + result)
    }
    if doc.Has("name") != 1 {
        t.Fatal("expected Has(name) == 1")
    }
    if doc.Has("missing") != 0 {
        t.Fatal("expected Has(missing) == 0")
    }
}

fn TestJsonSetInt(t: testing.T) {
    doc := json.New()
    doc.SetInt("version", 42)
    v := doc.GetInt("version")
    if v != 42 {
        t.Fatal("expected 42, got " + strconv.Itoa(v))
    }
}

fn TestJsonSetBool(t: testing.T) {
    doc := json.New()
    doc.SetBool("active", 1)
    doc.SetBool("deleted", 0)
    if doc.GetBool("active") != 1 {
        t.Fatal("expected active == 1")
    }
    if doc.GetBool("deleted") != 0 {
        t.Fatal("expected deleted == 0")
    }
}

fn TestJsonSetNull(t: testing.T) {
    doc := json.New()
    doc.SetNull("empty")
    output := doc.Marshal()
    if output != "{\"empty\":null}" {
        t.Fatal("expected {\"empty\":null}, got " + output)
    }
}

fn TestJsonNestedObject(t: testing.T) {
    doc := json.New()
    meta := json.New()
    meta.SetString("type", "compiler")
    doc.SetObject("meta", meta)
    inner := doc.GetObject("meta")
    result := inner.GetString("type")
    if result != "compiler" {
        t.Fatal("expected compiler, got " + result)
    }
}

fn TestJsonArray(t: testing.T) {
    arr := json.NewArray()
    arr.PushString("hello")
    arr.PushInt(42)
    arr.PushBool(1)
    if arr.Len() != 3 {
        t.Fatal("expected len 3, got " + strconv.Itoa(arr.Len()))
    }
    s := arr.AtString(0)
    if s != "hello" {
        t.Fatal("expected hello, got " + s)
    }
    n := arr.AtInt(1)
    if n != 42 {
        t.Fatal("expected 42, got " + strconv.Itoa(n))
    }
}

fn TestJsonMarshalSimple(t: testing.T) {
    doc := json.New()
    doc.SetString("key", "value")
    doc.SetInt("num", 42)
    output := doc.Marshal()
    expected := "{\"key\":\"value\",\"num\":42}"
    if output != expected {
        t.Fatal("expected " + expected + ", got " + output)
    }
}

fn TestJsonMarshalNested(t: testing.T) {
    doc := json.New()
    doc.SetString("name", "ease")
    meta := json.New()
    meta.SetString("type", "lang")
    doc.SetObject("meta", meta)
    arr := json.NewArray()
    arr.PushInt(1)
    arr.PushInt(2)
    doc.SetArray("items", arr)
    output := doc.Marshal()
    expected := "{\"name\":\"ease\",\"meta\":{\"type\":\"lang\"},\"items\":[1,2]}"
    if output != expected {
        t.Fatal("expected " + expected + ", got " + output)
    }
}

fn TestJsonParseSimple(t: testing.T) {
    input := "{\"key\":\"value\",\"num\":42}"
    doc := json.Parse(input)
    v := doc.GetString("key")
    if v != "value" {
        t.Fatal("expected value, got " + v)
    }
    n := doc.GetInt("num")
    if n != 42 {
        t.Fatal("expected 42, got " + strconv.Itoa(n))
    }
}

fn TestJsonParseNested(t: testing.T) {
    input := "{\"outer\":{\"inner\":\"deep\"}}"
    doc := json.Parse(input)
    inner := doc.GetObject("outer")
    v := inner.GetString("inner")
    if v != "deep" {
        t.Fatal("expected deep, got " + v)
    }
}

fn TestJsonParseArray(t: testing.T) {
    input := "[1,2,3]"
    doc := json.Parse(input)
    if doc.Len() != 3 {
        t.Fatal("expected len 3, got " + strconv.Itoa(doc.Len()))
    }
    if doc.AtInt(0) != 1 {
        t.Fatal("expected 1 at index 0")
    }
    if doc.AtInt(1) != 2 {
        t.Fatal("expected 2 at index 1")
    }
    if doc.AtInt(2) != 3 {
        t.Fatal("expected 3 at index 2")
    }
}

fn TestJsonEscaping(t: testing.T) {
    doc := json.New()
    doc.SetString("msg", "hello \"world\"")
    output := doc.Marshal()
    expected := "{\"msg\":\"hello \\\"world\\\"\"}"
    if output != expected {
        t.Fatal("expected " + expected + ", got " + output)
    }
}

fn TestJsonDocString(t: testing.T) {
    doc := json.New()
    doc.SetString("name", "ease")
    result := fmt.Sprint(doc)
    if result != "{\"name\":\"ease\"}" {
        t.Fatal("expected JSON string, got " + result)
    }
}

fn TestJsonWriteTo(t: testing.T) {
    doc := json.New()
    doc.SetString("lang", "ease")
    b := strings.NewBuilder()
    n := json.WriteTo(b, doc)
    expected := "{\"lang\":\"ease\"}"
    if n != len(expected) {
        t.Fatal("expected WriteTo to return " + strconv.Itoa(len(expected)) + ", got " + strconv.Itoa(n))
    }
    result := b.String()
    if result != expected {
        t.Fatal("expected " + expected + ", got " + result)
    }
}

fn TestJsonValueStr(t: testing.T) {
    v := json.Str("hello")
    if v.Type() != 1 { t.Fatal("expected TYPE_STRING") }
    if v.String() != "hello" { t.Fatal("expected hello") }
}

fn TestJsonValueNum(t: testing.T) {
    v := json.Num(42)
    if v.Type() != 2 { t.Fatal("expected TYPE_NUM") }
    if v.Int() != 42 { t.Fatal("expected 42") }
}

fn TestJsonValueBool(t: testing.T) {
    v := json.Bool(1)
    if v.Type() != 3 { t.Fatal("expected TYPE_BOOL") }
    if v.Bool() != 1 { t.Fatal("expected 1") }
}

fn TestJsonValueNull(t: testing.T) {
    v := json.Null()
    if v.Type() != 0 { t.Fatal("expected TYPE_NULL") }
    if v.IsNull() != 1 { t.Fatal("expected IsNull() == 1") }
}

fn TestJsonValueObject(t: testing.T) {
    doc := json.Object()
    nameStr := json.Str("alice")
    doc.Set("name", nameStr)
    ageNum := json.Num(30)
    doc.Set("age", ageNum)
    nameVal := doc.Get("name")
    if nameVal.String() != "alice" { t.Fatal("expected alice") }
    ageVal := doc.Get("age")
    if ageVal.Int() != 30 { t.Fatal("expected 30") }
    if doc.Has("name") != 1 { t.Fatal("expected Has(name) == 1") }
    if doc.Has("missing") != 0 { t.Fatal("expected Has(missing) == 0") }
}

fn TestJsonValueSetUpdate(t: testing.T) {
    doc := json.Object()
    oldVal := json.Str("old")
    doc.Set("key", oldVal)
    newVal := json.Str("new")
    doc.Set("key", newVal)
    keyVal := doc.Get("key")
    if keyVal.String() != "new" { t.Fatal("expected updated value") }
    if doc.Len() != 1 { t.Fatal("expected len 1 after update") }
}

fn TestJsonValueArray(t: testing.T) {
    arr := json.Array()
    va := json.Str("a")
    arr.Push(va)
    vn := json.Num(1)
    arr.Push(vn)
    if arr.Len() != 2 { t.Fatal("expected len 2") }
    at0 := arr.At(0)
    if at0.String() != "a" { t.Fatal("expected a") }
    at1 := arr.At(1)
    if at1.Int() != 1 { t.Fatal("expected 1") }
}

fn TestJsonValueNested(t: testing.T) {
    doc := json.Object()
    vname := json.Str("ease")
    doc.Set("name", vname)
    inner := json.Object()
    vlang := json.Str("lang")
    inner.Set("type", vlang)
    doc.Set("meta", inner)
    m := doc.Get("meta")
    mtype := m.Get("type")
    if mtype.String() != "lang" { t.Fatal("expected lang") }
}

fn TestJsonValueMarshal(t: testing.T) {
    doc := json.Object()
    vkey := json.Str("value")
    doc.Set("key", vkey)
    vnum := json.Num(42)
    doc.Set("num", vnum)
    output := doc.Marshal()
    expected := "{\"key\":\"value\",\"num\":42}"
    if output != expected { t.Fatal("expected " + expected + ", got " + output) }
}

fn TestJsonValueArrayMarshal(t: testing.T) {
    arr := json.Array()
    vs := json.Str("hello")
    arr.Push(vs)
    vn := json.Num(1)
    arr.Push(vn)
    vb := json.Bool(1)
    arr.Push(vb)
    output := arr.Marshal()
    expected := "[\"hello\",1,true]"
    if output != expected { t.Fatal("expected " + expected + ", got " + output) }
}

fn TestJsonGetNonexistent(t: testing.T) {
    doc := json.Object()
    v := doc.Get("missing")
    if v.IsNull() != 1 { t.Fatal("expected null for missing key") }
}

fn TestJsonAtOutOfBounds(t: testing.T) {
    arr := json.Array()
    vn := json.Num(1)
    arr.Push(vn)
    v := arr.At(5)
    if v.IsNull() != 1 { t.Fatal("expected null for out of bounds") }
}

fn TestJsonParseValue(t: testing.T) {
    doc := json.ParseValue("{\"name\":\"alice\",\"age\":30}")
    nameVal := doc.Get("name")
    if nameVal.String() != "alice" { t.Fatal("expected alice") }
    ageVal := doc.Get("age")
    if ageVal.Int() != 30 { t.Fatal("expected 30") }
}

fn TestJsonParseValueArray(t: testing.T) {
    arr := json.ParseValue("[1,2,3]")
    if arr.Len() != 3 { t.Fatal("expected len 3") }
    v0 := arr.At(0)
    if v0.Int() != 1 { t.Fatal("expected 1") }
    v2 := arr.At(2)
    if v2.Int() != 3 { t.Fatal("expected 3") }
}

fn TestJsonParseValueNested(t: testing.T) {
    doc := json.ParseValue("{\"inner\":{\"key\":\"val\"}}")
    inner := doc.Get("inner")
    keyVal := inner.Get("key")
    if keyVal.String() != "val" { t.Fatal("expected val") }
}

fn TestJsonRoundTrip(t: testing.T) {
    doc := json.Object()
    v1 := json.Str("ease")
    doc.Set("name", v1)
    v2 := json.Num(1)
    doc.Set("version", v2)
    s := doc.Marshal()
    parsed := json.ParseValue(s)
    nameVal := parsed.Get("name")
    if nameVal.String() != "ease" { t.Fatal("round trip name failed") }
    verVal := parsed.Get("version")
    if verVal.Int() != 1 { t.Fatal("round trip version failed") }
}

struct MarshalUser {
    name: string,
    age: int,
}

fn TestJsonMarshalStruct(t: testing.T) {
    u := MarshalUser { name: "alice", age: 30 }
    s := json.Marshal(u)
    expected := "{\"name\":\"alice\",\"age\":30}"
    if s != expected { t.Fatal("expected " + expected + ", got " + s) }
}

fn TestJsonUnmarshalStruct(t: testing.T) {
    s := "{\"name\":\"bob\",\"age\":25}"
    u := json.Unmarshal[MarshalUser](s)
    if u.name != "bob" { t.Fatal("expected name = bob, got " + u.name) }
    if u.age != 25 { t.Fatal("expected age = 25") }
}

fn TestJsonUnmarshalMissingFields(t: testing.T) {
    s := "{\"name\":\"carol\"}"
    u := json.Unmarshal[MarshalUser](s)
    if u.name != "carol" { t.Fatal("expected name = carol") }
    if u.age != 0 { t.Fatal("expected age = 0 for missing field") }
}

fn TestInlineStructReturnAsMethodArg(t: testing.T) {
    doc := json.Object()
    doc.Set("name", json.Str("alice"))
    doc.Set("age", json.Num(30))
    nameVal := doc.Get("name")
    if nameVal.String() != "alice" { t.Fatal("expected alice") }
    ageVal := doc.Get("age")
    if ageVal.Int() != 30 { t.Fatal("expected 30") }
}

fn TestJsonCrossPackageTypeConsts(t: testing.T) {
    s := json.Str("hello")
    if s.Type() != json.JSON_STRING { t.Fatal("expected JSON_STRING") }
    n := json.Num(42)
    if n.Type() != json.JSON_NUM { t.Fatal("expected JSON_NUM") }
    o := json.Object()
    if o.Type() != json.JSON_OBJECT { t.Fatal("expected JSON_OBJECT") }
}



