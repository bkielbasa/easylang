package main

import (
    "testing"
)

fn TestMethodValueReceiver(t: testing.T) {
    c := NewCounter(42)
    v := c.Value()
    if v != 42 {
        t.Fatal("expected Value() == 42, got " + strconv.Itoa(v))
    }
}

fn TestMethodDouble(t: testing.T) {
    c := NewCounter(21)
    d := c.Double()
    if d != 42 {
        t.Fatal("expected Double() == 42, got " + strconv.Itoa(d))
    }
}

fn TestMethodWithArgs(t: testing.T) {
    c := NewCounter(10)
    result := c.Add(32)
    if result != 42 {
        t.Fatal("expected Add(32) == 42, got " + strconv.Itoa(result))
    }
}

fn TestMethodOnPoint(t: testing.T) {
    p := make_point(3, 7)
    s := p.Sum()
    if s != 10 {
        t.Fatal("expected Sum() == 10, got " + strconv.Itoa(s))
    }
}

fn TestMethodReturningString(t: testing.T) {
    p := make_point(5, 12)
    desc := p.Describe()
    if desc != "(5, 12)" {
        t.Fatal("expected (5, 12), got " + desc)
    }
}

fn TestMethodOnStructLiteral(t: testing.T) {
    c := Counter { count: 100 }
    v := c.Value()
    if v != 100 {
        t.Fatal("expected Value() == 100, got " + strconv.Itoa(v))
    }
}
