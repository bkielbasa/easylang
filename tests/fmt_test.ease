package main

import (
    "testing"
)

struct Point { x: int, y: int }

fn (p: Point) String() -> string {
    return "(" + strconv.Itoa(p.x) + ", " + strconv.Itoa(p.y) + ")"
}

struct Color { name: string }

fn (c: Color) String() -> string {
    return c.name
}

fn TestFmtSprint(t: testing.T) {
    p := Point { x: 3, y: 4 }
    result := fmt.Sprint(p)
    if result != "(3, 4)" {
        t.Fatal("expected (3, 4), got " + result)
    }
}

fn TestFmtSprintDifferentTypes(t: testing.T) {
    c := Color { name: "red" }
    result := fmt.Sprint(c)
    if result != "red" {
        t.Fatal("expected red, got " + result)
    }
}

fn TestFmtPrintln(t: testing.T) {
    p := Point { x: 5, y: 6 }
    fmt.Println(p)
}
