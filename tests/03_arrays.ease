package main

// Test 3: Array operations
fn main() -> int {
    // Test array literal and indexing
    arr := []int{10, 20, 30, 40, 50}
    
    if arr[0] != 10 {
        return 1
    }
    if arr[2] != 30 {
        return 2
    }
    if arr[4] != 50 {
        return 3
    }
    
    // Test array length
    if len(arr) != 5 {
        return 4
    }
    
    // Test push
    darr := []int{1, 2}
    push(darr, 3)
    push(darr, 4)
    
    if len(darr) != 4 {
        return 5
    }
    if darr[3] != 4 {
        return 6
    }
    
    return 0
}
