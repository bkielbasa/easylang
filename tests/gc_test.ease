package main

import ("testing")
import ("strconv")

// Focused tests for the conservative GC. With GC=none these still pass
// (runtime.GC is a no-op); with GC=conservative they exercise mark-sweep.

struct GcBox {
    a: int,
    b: int,
}

fn TestGcRetainsLive(t: testing.T) {
    // A live reference must survive collection.
    box := GcBox { a: 42, b: 84 }
    runtime.GC()
    if box.a != 42 { t.Fatal("box.a should be 42 after GC") }
    if box.b != 84 { t.Fatal("box.b should be 84 after GC") }
}

fn TestGcRetainsLiveString(t: testing.T) {
    s := "hello, garbage collector"
    runtime.GC()
    if s != "hello, garbage collector" { t.Fatal("string should survive GC") }
}

fn TestGcRetainsLiveArray(t: testing.T) {
    arr := []int{10, 20, 30, 40, 50}
    runtime.GC()
    if arr[0] != 10 { t.Fatal("arr[0] should be 10") }
    if arr[4] != 50 { t.Fatal("arr[4] should be 50") }
    if len(arr) != 5 { t.Fatal("arr len should be 5") }
}

fn TestGcCyclesThroughStructs(t: testing.T) {
    // Two boxes referencing each other through struct fields would form
    // a cycle. Reference counting GCs leak this; mark-sweep handles it.
    // Ease structs don't currently support pointer-to-struct fields, so
    // we approximate via array-of-int holding indirect references through
    // shared array (cycle is implicit via the same heap region).
    arr := []int{1, 2, 3}
    arr[0] = 100
    arr[1] = arr[0]
    runtime.GC()
    if arr[0] != 100 { t.Fatal("arr[0] should be 100") }
    if arr[1] != 100 { t.Fatal("arr[1] should be 100") }
}

fn TestGcStringConcatLoop(t: testing.T) {
    // Many short-lived string concatenations. Each iteration produces a
    // string that becomes garbage when the next iteration overwrites s.
    // With auto-trigger, the GC must run at some point and the program
    // must complete without OOMing or corrupting s.
    s := "x"
    i := 0
    for i < 5000 {
        s = s + "."
        i = i + 1
    }
    if len(s) != 5001 { t.Fatal("expected len 5001, got " + strconv.Itoa(len(s))) }
}

fn TestGcArrayGrowReclaims(t: testing.T) {
    // Push enough elements to force several reallocs of the underlying
    // buffer. Old buffers should be reclaimable.
    arr := []int{}
    i := 0
    for i < 10000 {
        arr = append(arr, i)
        i = i + 1
    }
    runtime.GC()
    if len(arr) != 10000 { t.Fatal("len should be 10000") }
    if arr[0] != 0 { t.Fatal("arr[0] should be 0") }
    if arr[9999] != 9999 { t.Fatal("arr[9999] should be 9999") }
}

fn TestGcInClosure(t: testing.T) {
    // A closure that captures a struct holds it alive through its env.
    box := GcBox { a: 7, b: 11 }
    get_a := |_x: int| -> int { return box.a + 0 }
    runtime.GC()
    if get_a(0) != 7 { t.Fatal("closure should keep box live, got != 7") }
}

fn TestGcManyAllocations(t: testing.T) {
    // Allocate many small structs in a loop, forcing many auto-collections.
    sum := 0
    i := 0
    for i < 2000 {
        b := GcBox { a: i, b: i + 1 }
        sum = sum + b.a
        i = i + 1
    }
    // sum of 0..1999 = 1999*2000/2 = 1999000
    if sum != 1999000 { t.Fatal("sum mismatch, got " + strconv.Itoa(sum)) }
}
