package main

// Shared helper functions and structs for test suite

fn add(x: int, y: int) -> int {
    return x + y
}

fn multiply(x: int, y: int) -> int {
    return x * y
}

fn factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

struct Point {
    x: int,
    y: int,
}

struct Rectangle {
    width: int,
    height: int,
}

fn make_point(x: int, y: int) -> Point {
    return Point { x: x, y: y }
}

fn area(r: Rectangle) -> int {
    return r.width * r.height
}

fn sum_range(start: int, end: int) -> int {
    sum := 0
    for i in start..end {
        sum = sum + i
    }
    return sum
}

fn count_even(arr: []int) -> int {
    count := 0
    for i in 0..len(arr) {
        if arr[i] % 2 == 0 {
            count = count + 1
        }
    }
    return count
}

enum TestColor { Red, Green, Blue }
enum TestOption { Some { value: int }, None }

fn test_color_code(c: int) -> int {
    result := match c {
        TestColor::Red => 1,
        TestColor::Green => 2,
        TestColor::Blue => 3,
    }
    return result
}

fn test_unwrap_or(opt: int, def: int) -> int {
    result := match opt {
        TestOption::Some { value } => value,
        TestOption::None => def,
    }
    return result
}

struct Counter {
    count: int,
}

fn NewCounter(initial: int) -> Counter {
    return Counter { count: initial }
}

fn (c: Counter) Value() -> int {
    return c.count
}

fn (c: Counter) Double() -> int {
    return c.count * 2
}

fn (c: Counter) Add(n: int) -> int {
    return c.count + n
}

fn (p: Point) Sum() -> int {
    return p.x + p.y
}

fn (p: Point) Describe() -> string {
    return "(" + strconv.Itoa(p.x) + ", " + strconv.Itoa(p.y) + ")"
}
