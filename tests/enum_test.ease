package main

fn TestSimpleEnum(t: T) {
    r := TestColor::Red
    g := TestColor::Green
    b := TestColor::Blue
    if test_color_code(r) != 1 { testing.Fatal("Red should be 1") }
    if test_color_code(g) != 2 { testing.Fatal("Green should be 2") }
    if test_color_code(b) != 3 { testing.Fatal("Blue should be 3") }
}

fn TestEnumWithData(t: T) {
    some := TestOption::Some { value: 42 }
    none := TestOption::None
    if test_unwrap_or(some, 0) != 42 { testing.Fatal("Some should unwrap to 42") }
    if test_unwrap_or(none, 10) != 10 { testing.Fatal("None should give default") }
}

fn TestMatchExpression(t: T) {
    some := TestOption::Some { value: 7 }
    none := TestOption::None
    a := test_unwrap_or(some, 0)
    b := test_unwrap_or(none, 99)
    if a + b != 106 { testing.Fatal("expected 106") }
}
