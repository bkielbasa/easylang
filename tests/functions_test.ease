package main

// Function calls and recursion

fn TestFunctionCalls() {
    sum := add(5, 3)
    if sum != 8 {
        testing.Fatal("add(5, 3) should be 8")
    }
    prod := multiply(4, 7)
    if prod != 28 {
        testing.Fatal("multiply(4, 7) should be 28")
    }
}

fn TestRecursion() {
    fact := factorial(5)
    if fact != 120 {
        testing.Fatal("factorial(5) should be 120")
    }
}
