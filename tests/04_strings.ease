package main

// Test 4: String operations
import ("strings")
import ("strconv")

fn main() -> int {
    // Test string concatenation
    hello := "Hello"
    world := "World"
    greeting := strings.Concat(hello, " ")
    greeting = strings.Concat(greeting, world)
    
    // Test string contains
    if !strings.Contains(greeting, "World") {
        return 1
    }
    
    // Test string starts with
    if !strings.StartsWith(greeting, "Hello") {
        return 2
    }
    
    // Test string ends with
    if !strings.EndsWith(greeting, "World") {
        return 3
    }
    
    // Test string index of
    idx := strings.IndexOf(greeting, "World")
    if idx != 6 {
        return 4
    }
    
    // Test strconv
    num_str := strconv.Itoa(42)
    if num_str != "42" {
        return 5
    }
    
    num := strconv.Atoi("123")
    if num != 123 {
        return 6
    }
    
    return 0
}
