package main

// Test 1: Basic arithmetic operations
fn main() -> int {
    a := 10
    b := 20
    sum := a + b
    diff := b - a
    prod := a * b
    quot := b / a
    
    if sum != 30 {
        return 1  // fail
    }
    if diff != 10 {
        return 2  // fail
    }
    if prod != 200 {
        return 3  // fail
    }
    if quot != 2 {
        return 4  // fail
    }
    
    return 0  // success
}
