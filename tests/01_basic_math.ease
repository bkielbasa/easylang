package main

// Test 1: Basic arithmetic operations
fn main() -> int {
    let a = 10
    let b = 20
    let sum = a + b
    let diff = b - a
    let prod = a * b
    let quot = b / a
    
    if sum != 30 {
        return 1  // fail
    }
    if diff != 10 {
        return 2  // fail
    }
    if prod != 200 {
        return 3  // fail
    }
    if quot != 2 {
        return 4  // fail
    }
    
    return 0  // success
}
