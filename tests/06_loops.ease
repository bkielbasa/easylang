// Test 6: Loops and control flow
fn sum_range(start: int, end: int) -> int {
    let mut sum = 0
    for i in start..end {
        sum = sum + i
    }
    return sum
}

fn count_even(arr: []int) -> int {
    let mut count = 0
    for i in 0..len(arr) {
        if arr[i] % 2 == 0 {
            count = count + 1
        }
    }
    return count
}

fn main() -> int {
    // Test range loop
    let s1 = sum_range(1, 6)  // 1+2+3+4+5 = 15
    if s1 != 15 {
        return 1
    }
    
    // Test loop with condition
    let mut n = 0
    let mut sum = 0
    for n < 10 {
        sum = sum + n
        n = n + 1
    }
    if sum != 45 {
        return 2
    }
    
    // Test loop with array
    let arr = []int{1, 2, 3, 4, 5, 6}
    let evens = count_even(arr)
    if evens != 3 {
        return 3
    }
    
    return 0
}
