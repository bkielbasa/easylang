package main

import (
    "testing"
)

// Array operations

fn TestArrayLiteralAndIndex(t: testing.T) {
    arr := []int{10, 20, 30, 40, 50}
    if arr[0] != 10 {
        t.Fatal("arr[0] should be 10")
    }
    if arr[2] != 30 {
        t.Fatal("arr[2] should be 30")
    }
    if arr[4] != 50 {
        t.Fatal("arr[4] should be 50")
    }
}

fn TestArrayLen(t: testing.T) {
    arr := []int{10, 20, 30, 40, 50}
    if len(arr) != 5 {
        t.Fatal("len should be 5")
    }
}

fn TestArrayPush(t: testing.T) {
    darr := []int{1, 2}
    darr = append(darr, 3)
    darr = append(darr, 4)
    if len(darr) != 4 {
        t.Fatal("len after append should be 4")
    }
    if darr[3] != 4 {
        t.Fatal("darr[3] should be 4")
    }
}

fn TestArrayElementAssign(t: testing.T) {
    arr := []int{10, 20, 30}
    arr[0] = 99
    if arr[0] != 99 {
        t.Fatal("arr[0] should be 99")
    }
    if arr[1] != 20 {
        t.Fatal("arr[1] should still be 20")
    }
    arr[2] = arr[1] + 5
    if arr[2] != 25 {
        t.Fatal("arr[2] should be 25")
    }
}

fn TestArraySwap(t: testing.T) {
    arr := []int{1, 2, 3}
    tmp := arr[0]
    arr[0] = arr[2]
    arr[2] = tmp
    if arr[0] != 3 {
        t.Fatal("arr[0] should be 3")
    }
    if arr[2] != 1 {
        t.Fatal("arr[2] should be 1")
    }
}

fn TestArrayFillLoop(t: testing.T) {
    arr := []int{0, 0, 0, 0, 0}
    i := 0
    for i < 5 {
        arr[i] = i * 10
        i = i + 1
    }
    if arr[0] != 0 {
        t.Fatal("arr[0] should be 0")
    }
    if arr[3] != 30 {
        t.Fatal("arr[3] should be 30")
    }
    if arr[4] != 40 {
        t.Fatal("arr[4] should be 40")
    }
}

