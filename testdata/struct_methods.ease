struct Point {
    x: int,
    y: int,
}

impl Point {
    fn sum(&self) -> int {
        return self.x + self.y
    }

    fn scale(&self, factor: int) -> Point {
        return Point { x: self.x * factor, y: self.y * factor }
    }
}

fn main() -> int {
    let p = Point { x: 3, y: 4 }

    // Test 1: Method call with no args
    if p.sum() != 7 {
        return 1
    }

    // Test 2: Method call with args
    let p2 = p.scale(2)
    if p2.x != 6 {
        return 2
    }
    if p2.y != 8 {
        return 3
    }

    // Test 3: Chained method calls
    if p.scale(3).sum() != 21 {
        return 4
    }

    return 42
}
