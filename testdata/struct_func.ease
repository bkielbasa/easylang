struct Point {
    x: int,
    y: int,
}

fn add_points(a: Point, b: Point) -> int {
    return a.x + a.y + b.x + b.y
}

fn get_x(p: Point) -> int {
    return p.x
}

fn main() -> int {
    p1 := Point { x: 1, y: 2 }
    p2 := Point { x: 3, y: 4 }

    sum := add_points(p1, p2)
    x1 := get_x(p1)

    // sum = 1+2+3+4 = 10, x1 = 1
    // return 10 + 1 = 11
    return sum + x1
}
