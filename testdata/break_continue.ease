fn main() -> int {
    // Test 1: Break from loop
    let mut sum = 0
    let mut i = 0
    for i < 10 {
        if i == 5 {
            break
        }
        sum = sum + i
        i = i + 1
    }
    // sum should be 0+1+2+3+4 = 10
    if sum != 10 {
        return 1
    }

    // Test 2: Continue to skip values
    sum = 0
    for j in 0..10 {
        if j == 3 {
            continue
        }
        if j == 7 {
            continue
        }
        sum = sum + j
    }
    // sum should be 0+1+2+4+5+6+8+9 = 35
    if sum != 35 {
        return 2
    }

    // Test 3: Nested loops with break
    let mut found = 0
    for x in 0..5 {
        for y in 0..5 {
            if x == 2 {
                found = 1
                break
            }
        }
        if found == 1 {
            break
        }
    }
    if found != 1 {
        return 3
    }

    return 42
}
