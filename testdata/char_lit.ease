fn main() -> int {
    a := 'a'
    newline := '\n'
    zero := '\0'

    // Test 1: 'a' should be 97
    if a != 97 {
        return 1
    }

    // Test 2: '\n' should be 10
    if newline != 10 {
        return 2
    }

    // Test 3: '\0' should be 0
    if zero != 0 {
        return 3
    }

    // Test 4: Compare with string indexing
    s := "hello"
    if s[0] != 'h' {
        return 4
    }

    // All tests passed
    return 42
}
