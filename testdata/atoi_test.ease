fn main() -> int {
    print("Testing strconv.Atoi:\n")

    n1 := strconv.Atoi("42")
    print("Atoi(\"42\") = ")
    print(strconv.Itoa(n1))
    print("\n")

    n2 := strconv.Atoi("0")
    print("Atoi(\"0\") = ")
    print(strconv.Itoa(n2))
    print("\n")

    n3 := strconv.Atoi("-123")
    print("Atoi(\"-123\") = ")
    print(strconv.Itoa(n3))
    print("\n")

    n4 := strconv.Atoi("999")
    print("Atoi(\"999\") = ")
    print(strconv.Itoa(n4))
    print("\n")

    n5 := strconv.Atoi("+456")
    print("Atoi(\"+456\") = ")
    print(strconv.Itoa(n5))
    print("\n")

    n6 := strconv.Atoi("-1")
    print("Atoi(\"-1\") = ")
    print(strconv.Itoa(n6))
    print("\n")

    n7 := strconv.Atoi("1000000000")
    print("Atoi(\"1000000000\") = ")
    print(strconv.Itoa(n7))
    print("\n")

    // Test with command-line arg parsing
    argc := os.Argc()
    if argc > 1 {
        arg := os.Argv(1)
        num := strconv.Atoi(arg)
        print("Parsed arg: ")
        print(strconv.Itoa(num))
        print("\n")
        return num
    }

    return 0
}
