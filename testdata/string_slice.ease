fn main() -> int {
    let s = "hello world"

    // Test 1: Middle slice "hello world"[0:5] = "hello"
    let h = s[0:5]
    if len(h) != 5 {
        return 1
    }
    if h[0] != 'h' {
        return 2
    }
    if h[4] != 'o' {
        return 3
    }

    // Test 2: End slice "hello world"[6:11] = "world"
    let w = s[6:11]
    if len(w) != 5 {
        return 4
    }
    if w[0] != 'w' {
        return 5
    }

    // Test 3: Open start [:5] = "hello"
    let h2 = s[:5]
    if len(h2) != 5 {
        return 6
    }

    // Test 4: Open end [6:] = "world"
    let w2 = s[6:]
    if len(w2) != 5 {
        return 7
    }

    // Test 5: Single character slice [0:1]
    let single = s[0:1]
    if len(single) != 1 {
        return 8
    }
    if single[0] != 'h' {
        return 9
    }

    // Test 6: Empty slice [5:5]
    let empty = s[5:5]
    if len(empty) != 0 {
        return 10
    }

    return 42
}
