enum Option {
    Some { value: int },
    None,
}

fn unwrap_or(opt: Option, def: int) -> int {
    match opt {
        Option::Some { value } => value,
        Option::None => def,
    }
}

fn main() -> int {
    let some = Option::Some { value: 42 }
    let none = Option::None

    let a = unwrap_or(some, 0)    // should be 42
    let b = unwrap_or(none, 10)   // should be 10

    return a + b  // 42 + 10 = 52
}
