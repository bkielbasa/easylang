fn main() -> int {
    let s = "hello"

    // Test 1: First character should be 'h' (104)
    if s[0] != 104 {
        return 1
    }

    // Test 2: Second character should be 'e' (101)
    if s[1] != 101 {
        return 2
    }

    // Test 3: Last character should be 'o' (111)
    if s[4] != 111 {
        return 3
    }

    // Test 4: Index with variable
    let i = 2
    if s[i] != 108 {  // 'l' = 108
        return 4
    }

    // All tests passed
    return 42
}
