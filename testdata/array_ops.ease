fn main() -> int {
    // Test 1: Array literal has correct len
    arr := [1, 2, 3]
    if len(arr) != 3 {
        return 1
    }

    // Test 2: cap equals len for literals
    if cap(arr) != 3 {
        return 2
    }

    // Test 3: Index works
    if arr[0] != 1 {
        return 3
    }
    if arr[2] != 3 {
        return 4
    }

    // Note: push test would require arrays with extra capacity
    // For now, arrays from literals have cap = len

    return 42
}
