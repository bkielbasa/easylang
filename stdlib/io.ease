// Package io provides I/O operations
//
// Functions needed for self-hosting compiler:
// - Reading source files
// - Writing compiled binaries
// - File system operations

// ReadFile reads the entire contents of a file
// Returns the file contents as a string
// Note: For now, uses os.ReadFile builtin which returns string directly
// TODO: Return Result<string, Error> when error handling is implemented
fn ReadFile(path: string) -> string {
    return os.ReadFile(path)
}

// WriteFile writes data to a file, creating it if it doesn't exist
// Note: For now, uses os.WriteFile builtin which returns nothing
// TODO: Return Result<(), Error> when error handling is implemented
fn WriteFile(path: string, content: string) {
    os.WriteFile(path, content)
}

// TODO: Add when needed for self-hosting:
// - FileExists(path: string) -> bool
// - ReadDir(path: string) -> []string
// - CreateDir(path: string)
