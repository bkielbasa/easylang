// Package strconv provides string conversion functions
//
// Functions needed for self-hosting compiler:
// - Parsing integer literals from source code (Atoi, ParseInt)
// - Formatting numbers for output/debugging (Itoa, FormatInt)
// - Converting between different number bases (hex, binary)

// Helper: Convert digit (0-9) to character ('0'-'9')
fn DigitToChar(digit: int) -> string {
    if digit == 0 { return "0" }
    if digit == 1 { return "1" }
    if digit == 2 { return "2" }
    if digit == 3 { return "3" }
    if digit == 4 { return "4" }
    if digit == 5 { return "5" }
    if digit == 6 { return "6" }
    if digit == 7 { return "7" }
    if digit == 8 { return "8" }
    if digit == 9 { return "9" }
    return ""
}

// Helper: Convert digit (0-35) to character ('0'-'9', 'a'-'z')
fn DigitToCharBase(digit: int) -> string {
    if digit < 10 {
        return DigitToChar(digit)
    }
    // 'a' = 97, so digit 10 -> 'a' (97), digit 11 -> 'b' (98), etc.
    let charCode = 97 + (digit - 10)
    // TODO: Need a way to convert ASCII code to string
    // For now, hardcode common cases
    if digit == 10 { return "a" }
    if digit == 11 { return "b" }
    if digit == 12 { return "c" }
    if digit == 13 { return "d" }
    if digit == 14 { return "e" }
    if digit == 15 { return "f" }
    if digit == 16 { return "g" }
    if digit == 17 { return "h" }
    if digit == 18 { return "i" }
    if digit == 19 { return "j" }
    if digit == 20 { return "k" }
    if digit == 21 { return "l" }
    if digit == 22 { return "m" }
    if digit == 23 { return "n" }
    if digit == 24 { return "o" }
    if digit == 25 { return "p" }
    if digit == 26 { return "q" }
    if digit == 27 { return "r" }
    if digit == 28 { return "s" }
    if digit == 29 { return "t" }
    if digit == 30 { return "u" }
    if digit == 31 { return "v" }
    if digit == 32 { return "w" }
    if digit == 33 { return "x" }
    if digit == 34 { return "y" }
    if digit == 35 { return "z" }
    return ""
}

// Helper: Convert character to digit value
// Returns -1 for invalid characters
// Supports '0'-'9' (0-9), 'a'-'z' and 'A'-'Z' (10-35)
fn CharToDigit(ch: int) -> int {
    // '0' = 48, '9' = 57
    if ch >= 48 {
        if ch <= 57 {
            return ch - 48
        }
    }

    // 'a' = 97, 'z' = 122
    if ch >= 97 {
        if ch <= 122 {
            return ch - 97 + 10
        }
    }

    // 'A' = 65, 'Z' = 90
    if ch >= 65 {
        if ch <= 90 {
            return ch - 65 + 10
        }
    }

    return -1
}

// Itoa converts an integer to its decimal string representation
// Example: Itoa(42) returns "42", Itoa(-10) returns "-10"
fn Itoa(i: int) -> string {
    if i == 0 {
        return "0"
    }

    let mut negative = false
    let mut n = i

    if i < 0 {
        negative = true
        n = -i
    }

    // Build digits in reverse order
    let mut digits = []int{}
    for n > 0 {
        push(digits, n % 10)
        n = n / 10
    }

    // Build string from digits (reverse order)
    let mut result = ""
    if negative {
        result = "-"
    }

    let mut idx = len(digits) - 1
    for idx >= 0 {
        let digit = digits[idx]
        result = str_concat(result, DigitToChar(digit))
        idx = idx - 1
    }

    return result
}

// Atoi parses a decimal string to an integer
// Returns 0 if the string is not a valid integer
// Example: Atoi("42") returns 42, Atoi("-10") returns -10
fn Atoi(s: string) -> int {
    return ParseInt(s, 10)
}

// ParseInt parses a string as an integer in the given base (2-36)
// Returns 0 if the string is not valid for the given base
// Supports negative numbers (leading '-')
// Example: ParseInt("1010", 2) returns 10, ParseInt("FF", 16) returns 255
fn ParseInt(s: string, base: int) -> int {
    if len(s) == 0 {
        return 0
    }

    if base < 2 {
        return 0
    }
    if base > 36 {
        return 0
    }

    let mut idx = 0
    let mut negative = false

    // Check for negative sign
    if str_char_at(s, 0) == 45 {  // '-' = ASCII 45
        negative = true
        idx = 1
    }

    let mut result = 0
    for idx < len(s) {
        let ch = str_char_at(s, idx)
        let digit = CharToDigit(ch)

        if digit < 0 {
            return 0  // Invalid character
        }
        if digit >= base {
            return 0  // Digit too large for base
        }

        result = result * base + digit
        idx = idx + 1
    }

    if negative {
        return -result
    }
    return result
}

// FormatInt converts an integer to a string in the given base (2-36)
// Uses lowercase letters for bases > 10 (e.g., base 16 uses 0-9, a-f)
// Example: FormatInt(255, 16) returns "ff", FormatInt(10, 2) returns "1010"
fn FormatInt(i: int, base: int) -> string {
    if i == 0 {
        return "0"
    }

    if base < 2 {
        return "0"
    }
    if base > 36 {
        return "0"
    }

    let mut negative = false
    let mut n = i

    if i < 0 {
        negative = true
        n = -i
    }

    // Build digits in reverse order
    let mut digits = []int{}
    for n > 0 {
        push(digits, n % base)
        n = n / base
    }

    // Build string from digits (reverse order)
    let mut result = ""
    if negative {
        result = "-"
    }

    let mut idx = len(digits) - 1
    for idx >= 0 {
        let digit = digits[idx]
        result = str_concat(result, DigitToCharBase(digit))
        idx = idx - 1
    }

    return result
}
