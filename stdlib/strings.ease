// Package strings provides string manipulation functions
//
// Functions needed for self-hosting compiler:
// - Parsing source code (Split, Contains, StartsWith, etc.)
// - Building identifiers and paths (Join)
// - Text processing (Trim, Replace, Substring)

// Split divides a string into substrings separated by sep
// Returns empty slice if s is empty
fn Split(s: string, sep: string) -> []string {
    return str_split(s, sep)
}

// Join concatenates slice elements with sep between them
fn Join(parts: []string, sep: string) -> string {
    if len(parts) == 0 {
        return ""
    }

    result := parts[0]
    for i in 1..len(parts) {
        result = str_concat(result, sep)
        result = str_concat(result, parts[i])
    }
    return result
}

// Contains reports whether substr is within s
fn Contains(s: string, substr: string) -> bool {
    return str_contains(s, substr)
}

// StartsWith tests whether s begins with prefix
fn StartsWith(s: string, prefix: string) -> bool {
    return str_starts_with(s, prefix)
}

// EndsWith tests whether s ends with suffix
fn EndsWith(s: string, suffix: string) -> bool {
    return str_ends_with(s, suffix)
}

// IndexOf returns the index of the first instance of substr in s, or -1
fn IndexOf(s: string, substr: string) -> int {
    return str_index_of(s, substr)
}

// Substring returns a substring from start (inclusive) to end (exclusive)
fn Substring(s: string, start: int, end: int) -> string {
    return str_substring(s, start, end)
}

// CharAt returns the character code at position i
fn CharAt(s: string, i: int) -> int {
    return str_char_at(s, i)
}

// Trim removes leading and trailing whitespace
fn Trim(s: string) -> string {
    return str_trim(s, " \t\n\r")
}

// Replace replaces all occurrences of old with new in s
fn Replace(s: string, old: string, new: string) -> string {
    return str_replace(s, old, new)
}

// Concat concatenates two strings (note: + operator also works)
fn Concat(a: string, b: string) -> string {
    return str_concat(a, b)
}
