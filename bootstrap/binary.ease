// Binary writing utilities for bootstrap compiler
// Uses poke/peek for byte-level memory operations

// Write 32-bit little-endian integer to memory
fn write_u32_le(addr: int, value: int) {
    // Extract bytes (little-endian: LSB first)
    poke(addr, value - ((value / 256) * 256))               // byte 0: value & 0xFF
    poke(addr + 1, (value / 256) - ((value / 65536) * 256)) // byte 1: (value >> 8) & 0xFF
    poke(addr + 2, (value / 65536) - ((value / 16777216) * 256)) // byte 2: (value >> 16) & 0xFF
    poke(addr + 3, value / 16777216)                        // byte 3: (value >> 24) & 0xFF
}

// Write 64-bit little-endian integer to memory
fn write_u64_le(addr: int, value: int) {
    // Write low 32 bits
    write_u32_le(addr, value)

    // Write high 32 bits (value / 2^32)
    let high = value / 4294967296  // 0x100000000
    write_u32_le(addr + 4, high)
}

// Write 16-bit little-endian integer to memory
fn write_u16_le(addr: int, value: int) {
    poke(addr, value - ((value / 256) * 256))      // byte 0: value & 0xFF
    poke(addr + 1, value / 256)                    // byte 1: (value >> 8) & 0xFF
}

// Write byte to memory
fn write_u8(addr: int, value: int) {
    poke(addr, value)
}

// Write string with null terminator
fn write_cstring(addr: int, str: string) -> int {
    let len = str_len(str)
    let i = 0

    // Copy each character
    for i < len {
        let ch = peek_string(str, i)
        poke(addr + i, ch)
        i = i + 1
    }

    // Null terminator
    poke(addr + len, 0)

    return len + 1  // Return bytes written
}

// Write fixed-length string (padded with zeros)
fn write_fixed_string(addr: int, str: string, size: int) {
    let len = str_len(str)
    let i = 0

    // Copy string (up to size)
    for i < len {
        if i >= size {
            return
        }
        let ch = peek_string(str, i)
        poke(addr + i, ch)
        i = i + 1
    }

    // Pad with zeros
    for i < size {
        poke(addr + i, 0)
        i = i + 1
    }
}

// Zero out memory
fn write_zeros(addr: int, count: int) {
    let i = 0
    for i < count {
        poke(addr + i, 0)
        i = i + 1
    }
}

// Helper: Read byte from string at index
// Note: In a real implementation, this would access string data directly
// For now, we'll need to use a workaround
fn peek_string(str: string, index: int) -> int {
    // String is a pointer to null-terminated data
    // We can treat it as an address and peek at it
    // This assumes string is passed as a pointer value
    return 0  // TODO: Need a way to get string address
}

// Write buffer to file descriptor
fn write_buffer_to_file(fd: int, buf: int, size: int) -> int {
    return syscall.write(fd, buf, size)
}

fn main() -> int {
    print("Binary writing utilities ready\n")
    return 0
}
