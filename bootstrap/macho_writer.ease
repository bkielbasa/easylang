// Minimal Mach-O writer for ARM64 macOS
// Generates executable binaries

import ("strconv")

// Mach-O constants
fn MH_MAGIC_64() -> int { return 0xfeedfacf }
fn MH_EXECUTE() -> int { return 0x2 }
fn MH_NOUNDEFS() -> int { return 0x1 }
fn MH_DYLDLINK() -> int { return 0x4 }
fn MH_TWOLEVEL() -> int { return 0x80 }
fn MH_PIE() -> int { return 0x200000 }

fn CPU_TYPE_ARM64() -> int { return 0x100000C }
fn CPU_SUBTYPE_ARM64_ALL() -> int { return 0x0 }

fn LC_SEGMENT_64() -> int { return 0x19 }
fn LC_MAIN() -> int { return 0x80000028 }
fn LC_SYMTAB() -> int { return 0x2 }
fn LC_DYSYMTAB() -> int { return 0xB }
fn LC_LOAD_DYLINKER() -> int { return 0xE }
fn LC_UUID() -> int { return 0x1B }
fn LC_BUILD_VERSION() -> int { return 0x32 }
fn LC_SOURCE_VERSION() -> int { return 0x2A }
fn LC_FUNCTION_STARTS() -> int { return 0x26 }
fn LC_DATA_IN_CODE() -> int { return 0x29 }
fn LC_LOAD_DYLIB() -> int { return 0xC }
fn LC_CODE_SIGNATURE() -> int { return 0x1D }

// Code signature blob types
fn CSSLOT_CODEDIRECTORY() -> int { return 0 }
fn CSSLOT_REQUIREMENTS() -> int { return 2 }

// Code signature magic numbers
fn CSMAGIC_EMBEDDED_SIGNATURE() -> int { return 0xfade0cc0 }
fn CSMAGIC_CODEDIRECTORY() -> int { return 0xfade0c02 }
fn CSMAGIC_REQUIREMENTS() -> int { return 0xfade0c01 }

// Build version platform
fn PLATFORM_MACOS() -> int { return 1 }

fn VM_PROT_READ() -> int { return 0x1 }
fn VM_PROT_WRITE() -> int { return 0x2 }
fn VM_PROT_EXECUTE() -> int { return 0x4 }

fn PAGE_SIZE() -> int { return 0x4000 }

// Binary writing helpers
fn write_u32_le(addr: int, value: int) {
    poke(addr, value - ((value / 256) * 256))
    poke(addr + 1, (value / 256) - ((value / 65536) * 256))
    poke(addr + 2, (value / 65536) - ((value / 16777216) * 256))
    poke(addr + 3, value / 16777216)
}

fn write_u64_le(addr: int, value: int) {
    write_u32_le(addr, value)
    let high = value / 4294967296
    write_u32_le(addr + 4, high)
}

fn write_zeros(addr: int, count: int) {
    let mut i = 0
    for i < count {
        poke(addr + i, 0)
        i = i + 1
    }
}

fn write_string_16(addr: int, str: string) {
    // Write up to 16 bytes of string, pad with zeros
    let len = str_len(str)
    let mut i = 0

    // Copy string bytes (assume string is at a known address for now)
    // For MVP, we'll hardcode the segment names

    // This is a limitation - we need a way to read string bytes
    // For now, just zero it out
    write_zeros(addr, 16)
}

// Align value up to alignment
fn align_up(val: int, alignment: int) -> int {
    let remainder = val - ((val / alignment) * alignment)
    if remainder == 0 {
        return val
    }
    return val + (alignment - remainder)
}

// Write Mach-O header (32 bytes)
fn write_mach_header(buf: int, num_cmds: int, cmds_size: int) -> int {
    let mut offset = 0

    // magic
    write_u32_le(buf + offset, MH_MAGIC_64())
    offset = offset + 4

    // cputype
    write_u32_le(buf + offset, CPU_TYPE_ARM64())
    offset = offset + 4

    // cpusubtype
    write_u32_le(buf + offset, CPU_SUBTYPE_ARM64_ALL())
    offset = offset + 4

    // filetype
    write_u32_le(buf + offset, MH_EXECUTE())
    offset = offset + 4

    // ncmds
    write_u32_le(buf + offset, num_cmds)
    offset = offset + 4

    // sizeofcmds
    write_u32_le(buf + offset, cmds_size)
    offset = offset + 4

    // flags
    let flags = MH_NOUNDEFS() + MH_DYLDLINK() + MH_TWOLEVEL() + MH_PIE()
    write_u32_le(buf + offset, flags)
    offset = offset + 4

    // reserved
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    return offset  // 32 bytes
}

// Write LC_SEGMENT_64 for __PAGEZERO (72 bytes)
fn write_pagezero_segment(buf: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_SEGMENT_64())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 72)
    offset = offset + 4

    // segname (16 bytes): "__PAGEZERO"
    write_zeros(buf + offset, 16)
    // Manually write __PAGEZERO
    poke(buf + offset, 95)   // '_'
    poke(buf + offset + 1, 95) // '_'
    poke(buf + offset + 2, 80) // 'P'
    poke(buf + offset + 3, 65) // 'A'
    poke(buf + offset + 4, 71) // 'G'
    poke(buf + offset + 5, 69) // 'E'
    poke(buf + offset + 6, 90) // 'Z'
    poke(buf + offset + 7, 69) // 'E'
    poke(buf + offset + 8, 82) // 'R'
    poke(buf + offset + 9, 79) // 'O'
    offset = offset + 16

    // vmaddr
    write_u64_le(buf + offset, 0)
    offset = offset + 8

    // vmsize (4GB)
    write_u64_le(buf + offset, 0x100000000)
    offset = offset + 8

    // fileoff
    write_u64_le(buf + offset, 0)
    offset = offset + 8

    // filesize
    write_u64_le(buf + offset, 0)
    offset = offset + 8

    // maxprot
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // initprot
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // nsects
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // flags
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    return offset  // 72 bytes
}

// Write LC_SEGMENT_64 for __TEXT with code (152 bytes header + 80 bytes section)
fn write_text_segment(buf: int, code_offset: int, code_size: int) -> int {
    let mut offset = 0
    let vm_addr = 0x100000000 + code_offset

    // cmd
    write_u32_le(buf + offset, LC_SEGMENT_64())
    offset = offset + 4

    // cmdsize (72 + 80 for one section)
    write_u32_le(buf + offset, 152)
    offset = offset + 4

    // segname (16 bytes): "__TEXT"
    write_zeros(buf + offset, 16)
    poke(buf + offset, 95)   // '_'
    poke(buf + offset + 1, 95) // '_'
    poke(buf + offset + 2, 84) // 'T'
    poke(buf + offset + 3, 69) // 'E'
    poke(buf + offset + 4, 88) // 'X'
    poke(buf + offset + 5, 84) // 'T'
    offset = offset + 16

    // vmaddr
    write_u64_le(buf + offset, 0x100000000)
    offset = offset + 8

    // vmsize (round up to page size)
    let seg_size = align_up(code_offset + code_size, PAGE_SIZE())
    write_u64_le(buf + offset, seg_size)
    offset = offset + 8

    // fileoff
    write_u64_le(buf + offset, 0)
    offset = offset + 8

    // filesize
    write_u64_le(buf + offset, seg_size)
    offset = offset + 8

    // maxprot
    let maxprot = VM_PROT_READ() + VM_PROT_WRITE() + VM_PROT_EXECUTE()
    write_u32_le(buf + offset, maxprot)
    offset = offset + 4

    // initprot
    let initprot = VM_PROT_READ() + VM_PROT_EXECUTE()
    write_u32_le(buf + offset, initprot)
    offset = offset + 4

    // nsects (1 section: __text)
    write_u32_le(buf + offset, 1)
    offset = offset + 4

    // flags
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // Section: __text (80 bytes)
    // sectname (16 bytes): "__text"
    write_zeros(buf + offset, 16)
    poke(buf + offset, 95)   // '_'
    poke(buf + offset + 1, 95) // '_'
    poke(buf + offset + 2, 116) // 't'
    poke(buf + offset + 3, 101) // 'e'
    poke(buf + offset + 4, 120) // 'x'
    poke(buf + offset + 5, 116) // 't'
    offset = offset + 16

    // segname (16 bytes): "__TEXT"
    write_zeros(buf + offset, 16)
    poke(buf + offset, 95)   // '_'
    poke(buf + offset + 1, 95) // '_'
    poke(buf + offset + 2, 84) // 'T'
    poke(buf + offset + 3, 69) // 'E'
    poke(buf + offset + 4, 88) // 'X'
    poke(buf + offset + 5, 84) // 'T'
    offset = offset + 16

    // addr
    write_u64_le(buf + offset, vm_addr)
    offset = offset + 8

    // size
    write_u64_le(buf + offset, code_size)
    offset = offset + 8

    // offset
    write_u32_le(buf + offset, code_offset)
    offset = offset + 4

    // align (2^2 = 4 byte alignment)
    write_u32_le(buf + offset, 2)
    offset = offset + 4

    // reloff
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // nreloc
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // flags (S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS)
    write_u32_le(buf + offset, 0x80000400)
    offset = offset + 4

    // reserved1
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // reserved2
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // reserved3
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    return offset  // 152 bytes
}

// Write LC_MAIN (24 bytes)
fn write_main_command(buf: int, entry_offset: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_MAIN())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 24)
    offset = offset + 4

    // entryoff (offset from __TEXT start)
    write_u64_le(buf + offset, entry_offset)
    offset = offset + 8

    // stacksize
    write_u64_le(buf + offset, 0)
    offset = offset + 8

    return offset  // 24 bytes
}

// Write LC_SEGMENT_64 for __LINKEDIT (72 bytes)
fn write_linkedit_segment(buf: int, linkedit_offset: int, linkedit_size: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_SEGMENT_64())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 72)
    offset = offset + 4

    // segname (16 bytes): "__LINKEDIT"
    write_zeros(buf + offset, 16)
    poke(buf + offset, 95)   // '_'
    poke(buf + offset + 1, 95) // '_'
    poke(buf + offset + 2, 76) // 'L'
    poke(buf + offset + 3, 73) // 'I'
    poke(buf + offset + 4, 78) // 'N'
    poke(buf + offset + 5, 75) // 'K'
    poke(buf + offset + 6, 69) // 'E'
    poke(buf + offset + 7, 68) // 'D'
    poke(buf + offset + 8, 73) // 'I'
    poke(buf + offset + 9, 84) // 'T'
    offset = offset + 16

    // vmaddr (starts after __TEXT)
    write_u64_le(buf + offset, 0x100000000 + PAGE_SIZE())
    offset = offset + 8

    // vmsize
    write_u64_le(buf + offset, PAGE_SIZE())
    offset = offset + 8

    // fileoff
    write_u64_le(buf + offset, linkedit_offset)
    offset = offset + 8

    // filesize
    write_u64_le(buf + offset, linkedit_size)
    offset = offset + 8

    // maxprot (read only)
    write_u32_le(buf + offset, VM_PROT_READ())
    offset = offset + 4

    // initprot (read only)
    write_u32_le(buf + offset, VM_PROT_READ())
    offset = offset + 4

    // nsects
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // flags
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    return offset  // 72 bytes
}

// Write LC_SYMTAB (24 bytes)
fn write_symtab_command(buf: int, symoff: int, nsyms: int, stroff: int, strsize: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_SYMTAB())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 24)
    offset = offset + 4

    // symoff
    write_u32_le(buf + offset, symoff)
    offset = offset + 4

    // nsyms
    write_u32_le(buf + offset, nsyms)
    offset = offset + 4

    // stroff
    write_u32_le(buf + offset, stroff)
    offset = offset + 4

    // strsize
    write_u32_le(buf + offset, strsize)
    offset = offset + 4

    return offset  // 24 bytes
}

// Write LC_DYSYMTAB (80 bytes)
fn write_dysymtab_command(buf: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_DYSYMTAB())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 80)
    offset = offset + 4

    // All zeros for minimal binary
    write_zeros(buf + offset, 72)
    offset = offset + 72

    return offset  // 80 bytes
}

// Write LC_LOAD_DYLINKER (32 bytes)
fn write_dylinker_command(buf: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_LOAD_DYLINKER())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 32)
    offset = offset + 4

    // name offset (12 bytes into this load command)
    write_u32_le(buf + offset, 12)
    offset = offset + 4

    // name: "/usr/lib/dyld" (null-terminated, padded to 20 bytes)
    poke(buf + offset, 47)  // '/'
    poke(buf + offset + 1, 117) // 'u'
    poke(buf + offset + 2, 115) // 's'
    poke(buf + offset + 3, 114) // 'r'
    poke(buf + offset + 4, 47)  // '/'
    poke(buf + offset + 5, 108) // 'l'
    poke(buf + offset + 6, 105) // 'i'
    poke(buf + offset + 7, 98) // 'b'
    poke(buf + offset + 8, 47)  // '/'
    poke(buf + offset + 9, 100) // 'd'
    poke(buf + offset + 10, 121) // 'y'
    poke(buf + offset + 11, 108) // 'l'
    poke(buf + offset + 12, 100) // 'd'
    poke(buf + offset + 13, 0)  // null terminator
    write_zeros(buf + offset + 14, 6)  // padding
    offset = offset + 20

    return offset  // 32 bytes
}

// Write LC_UUID (24 bytes)
fn write_uuid_command(buf: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_UUID())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 24)
    offset = offset + 4

    // uuid (16 bytes) - just use zeros for now
    write_zeros(buf + offset, 16)
    offset = offset + 16

    return offset  // 24 bytes
}

// Write LC_BUILD_VERSION (24 bytes)
fn write_build_version_command(buf: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_BUILD_VERSION())
    offset = offset + 4

    // cmdsize (24 bytes when ntools = 0)
    write_u32_le(buf + offset, 24)
    offset = offset + 4

    // platform (1 = macOS)
    write_u32_le(buf + offset, PLATFORM_MACOS())
    offset = offset + 4

    // minos (minimum OS version: 11.0)
    write_u32_le(buf + offset, 0x000B0000)  // 11.0.0
    offset = offset + 4

    // sdk (SDK version: 11.0)
    write_u32_le(buf + offset, 0x000B0000)  // 11.0.0
    offset = offset + 4

    // ntools (0 = no build tools)
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    return offset  // 24 bytes
}

// Write LC_SOURCE_VERSION (16 bytes)
fn write_source_version_command(buf: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_SOURCE_VERSION())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 16)
    offset = offset + 4

    // version (8 bytes, all zeros)
    write_u64_le(buf + offset, 0)
    offset = offset + 8

    return offset  // 16 bytes
}

// Write LC_FUNCTION_STARTS (16 bytes)
fn write_function_starts_command(buf: int, dataoff: int, datasize: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_FUNCTION_STARTS())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 16)
    offset = offset + 4

    // dataoff
    write_u32_le(buf + offset, dataoff)
    offset = offset + 4

    // datasize
    write_u32_le(buf + offset, datasize)
    offset = offset + 4

    return offset  // 16 bytes
}

// Write LC_DATA_IN_CODE (16 bytes)
fn write_data_in_code_command(buf: int, dataoff: int, datasize: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_DATA_IN_CODE())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 16)
    offset = offset + 4

    // dataoff
    write_u32_le(buf + offset, dataoff)
    offset = offset + 4

    // datasize
    write_u32_le(buf + offset, datasize)
    offset = offset + 4

    return offset  // 16 bytes
}

// Write LC_LOAD_DYLIB (56 bytes for libSystem.B.dylib)
fn write_load_dylib_command(buf: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_LOAD_DYLIB())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 56)
    offset = offset + 4

    // name offset (24 bytes into this load command)
    write_u32_le(buf + offset, 24)
    offset = offset + 4

    // timestamp (2)
    write_u32_le(buf + offset, 2)
    offset = offset + 4

    // current version (0)
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // compatibility version (0)
    write_u32_le(buf + offset, 0)
    offset = offset + 4

    // name: "/usr/lib/libSystem.B.dylib" (32 bytes with null terminator and padding)
    poke(buf + offset, 47)   // '/'
    poke(buf + offset + 1, 117) // 'u'
    poke(buf + offset + 2, 115) // 's'
    poke(buf + offset + 3, 114) // 'r'
    poke(buf + offset + 4, 47)  // '/'
    poke(buf + offset + 5, 108) // 'l'
    poke(buf + offset + 6, 105) // 'i'
    poke(buf + offset + 7, 98) // 'b'
    poke(buf + offset + 8, 47)  // '/'
    poke(buf + offset + 9, 108) // 'l'
    poke(buf + offset + 10, 105) // 'i'
    poke(buf + offset + 11, 98) // 'b'
    poke(buf + offset + 12, 83) // 'S'
    poke(buf + offset + 13, 121) // 'y'
    poke(buf + offset + 14, 115) // 's'
    poke(buf + offset + 15, 116) // 't'
    poke(buf + offset + 16, 101) // 'e'
    poke(buf + offset + 17, 109) // 'm'
    poke(buf + offset + 18, 46) // '.'
    poke(buf + offset + 19, 66) // 'B'
    poke(buf + offset + 20, 46) // '.'
    poke(buf + offset + 21, 100) // 'd'
    poke(buf + offset + 22, 121) // 'y'
    poke(buf + offset + 23, 108) // 'l'
    poke(buf + offset + 24, 105) // 'i'
    poke(buf + offset + 25, 98) // 'b'
    poke(buf + offset + 26, 0)  // null terminator
    write_zeros(buf + offset + 27, 5)  // padding
    offset = offset + 32

    return offset  // 56 bytes
}

// Write LC_CODE_SIGNATURE (16 bytes)
fn write_code_signature_command(buf: int, dataoff: int, datasize: int) -> int {
    let mut offset = 0

    // cmd
    write_u32_le(buf + offset, LC_CODE_SIGNATURE())
    offset = offset + 4

    // cmdsize
    write_u32_le(buf + offset, 16)
    offset = offset + 4

    // dataoff
    write_u32_le(buf + offset, dataoff)
    offset = offset + 4

    // datasize
    write_u32_le(buf + offset, datasize)
    offset = offset + 4

    return offset  // 16 bytes
}

// Write big-endian uint32
fn write_u32_be(addr: int, value: int) {
    poke(addr, value / 16777216)
    poke(addr + 1, (value / 65536) - ((value / 16777216) * 256))
    poke(addr + 2, (value / 256) - ((value / 65536) * 256))
    poke(addr + 3, value - ((value / 256) * 256))
}

// Create ad-hoc code signature blob
// Returns size of signature data written
fn write_code_signature_blob(buf: int, sig_offset: int, code_limit: int, identifier: string) -> int {
    let mut offset = 0

    // Calculate sizes
    let ident_len = str_len(identifier) + 1  // include null terminator
    let cd_size = 88 + ident_len + 32  // CodeDirectory header + identifier + 1 hash slot (32 bytes for SHA256)
    let cd_size_aligned = align_up(cd_size, 4)
    let req_size = 12  // Empty requirements
    let total_size = 8 + (2 * 8) + cd_size_aligned + req_size  // SuperBlob header + 2 index entries + blobs

    // SuperBlob header
    write_u32_be(buf + offset, CSMAGIC_EMBEDDED_SIGNATURE())  // magic
    offset = offset + 4
    write_u32_be(buf + offset, total_size)  // length
    offset = offset + 4
    write_u32_be(buf + offset, 2)  // count (CodeDirectory + Requirements)
    offset = offset + 4

    // Index entry 0: CodeDirectory
    write_u32_be(buf + offset, CSSLOT_CODEDIRECTORY())  // type
    offset = offset + 4
    write_u32_be(buf + offset, 8 + 16)  // offset (after header + 2 index entries)
    offset = offset + 4

    // Index entry 1: Requirements
    write_u32_be(buf + offset, CSSLOT_REQUIREMENTS())  // type
    offset = offset + 4
    write_u32_be(buf + offset, 8 + 16 + cd_size_aligned)  // offset
    offset = offset + 4

    // CodeDirectory blob
    let cd_start = offset
    write_u32_be(buf + offset, CSMAGIC_CODEDIRECTORY())  // magic
    offset = offset + 4
    write_u32_be(buf + offset, cd_size_aligned)  // length
    offset = offset + 4
    write_u32_be(buf + offset, 0x20400)  // version
    offset = offset + 4
    write_u32_be(buf + offset, 0x20002)  // flags (adhoc | linker-signed)
    offset = offset + 4
    write_u32_be(buf + offset, 52)  // hashOffset (after fixed header)
    offset = offset + 4
    write_u32_be(buf + offset, 88)  // identOffset (after hashes)
    offset = offset + 4
    write_u32_be(buf + offset, 0)  // nSpecialSlots
    offset = offset + 4
    write_u32_be(buf + offset, 1)  // nCodeSlots (1 hash for simplicity)
    offset = offset + 4
    write_u32_be(buf + offset, code_limit)  // codeLimit
    offset = offset + 4
    poke(buf + offset, 32)  // hashSize (SHA256 = 32 bytes)
    offset = offset + 1
    poke(buf + offset, 2)  // hashType (SHA256)
    offset = offset + 1
    poke(buf + offset, 0)  // platform
    offset = offset + 1
    poke(buf + offset, 12)  // pageSize (2^12 = 4096)
    offset = offset + 1
    write_u32_be(buf + offset, 0)  // spare2
    offset = offset + 4
    write_u32_be(buf + offset, 0)  // scatterOffset
    offset = offset + 4
    write_u32_be(buf + offset, 0)  // teamOffset
    offset = offset + 4
    write_u32_be(buf + offset, 0)  // spare3
    offset = offset + 4
    write_u64_le(buf + offset, 0)  // codeLimit64
    offset = offset + 8
    write_u64_le(buf + offset, 0)  // execSegBase
    offset = offset + 8
    write_u64_le(buf + offset, 0)  // execSegLimit
    offset = offset + 8
    write_u64_le(buf + offset, 0)  // execSegFlags
    offset = offset + 8

    // Hash slot (32 bytes of zeros for ad-hoc)
    write_zeros(buf + offset, 32)
    offset = offset + 32

    // Identifier string
    let mut i = 0
    let id_len = str_len(identifier)
    for i < id_len {
        poke(buf + offset + i, 0)  // TODO: copy from identifier string
        i = i + 1
    }
    poke(buf + offset + id_len, 0)  // null terminator
    offset = offset + ident_len

    // Pad to alignment
    for offset < (cd_start + cd_size_aligned) {
        poke(buf + offset, 0)
        offset = offset + 1
    }

    // Requirements blob (empty)
    write_u32_be(buf + offset, CSMAGIC_REQUIREMENTS())  // magic
    offset = offset + 4
    write_u32_be(buf + offset, req_size)  // length
    offset = offset + 4
    write_u32_le(buf + offset, 0)  // data (empty)
    offset = offset + 4

    return offset  // total signature size
}

// Generate minimal Mach-O binary
// code: pointer to code bytes
// code_size: size of code in bytes
// output_path: where to write the binary
fn generate_macho(code: int, code_size: int, output_path: string) -> int {
    print("Generating Mach-O binary...\n")

    // Calculate layout
    let header_size = 32
    // PAGEZERO(72) + TEXT(152) + LINKEDIT(72) + MAIN(24) + SYMTAB(24) + DYSYMTAB(80) + DYLINKER(32) + UUID(24) + BUILD_VERSION(24) + LOAD_DYLIB(56) + SOURCE_VERSION(16) + FUNCTION_STARTS(16) + DATA_IN_CODE(16) + CODE_SIGNATURE(16)
    let load_cmds_size = 72 + 152 + 72 + 24 + 24 + 80 + 32 + 24 + 24 + 56 + 16 + 16 + 16 + 16  // = 624
    let code_offset = align_up(header_size + load_cmds_size, 256)

    // Calculate __LINKEDIT layout (symbol table + string table + function_starts + data_in_code + code_signature)
    // Symbol table: 1 symbol entry (16 bytes each for nlist_64)
    // String table: minimal strings
    // Function starts: minimal data
    // Data in code: minimal data (0 bytes is fine)
    // Code signature: ad-hoc signature blob
    let linkedit_offset = align_up(code_offset + code_size, PAGE_SIZE())
    let symtab_offset = linkedit_offset
    let nsyms = 1
    let symtab_size = nsyms * 16  // nlist_64 is 16 bytes
    let strtab_offset = symtab_offset + symtab_size
    let strtab_size = 16  // Just enough for minimal strings
    let func_starts_offset = strtab_offset + strtab_size
    let func_starts_size = 8  // Minimal ULEB128 data
    let data_in_code_offset = func_starts_offset + func_starts_size
    let data_in_code_size = 0  // No data-in-code entries
    let codesig_offset = align_up(data_in_code_offset + data_in_code_size, 16)
    let codesig_size = 256  // Reserve space for signature blob
    let linkedit_size = (codesig_offset - linkedit_offset) + codesig_size

    print("  Header size: ")
    print(strconv.Itoa(header_size))
    print("\n  Load commands size: ")
    print(strconv.Itoa(load_cmds_size))
    print("\n  Code offset: ")
    print(strconv.Itoa(code_offset))
    print("\n  Code size: ")
    print(strconv.Itoa(code_size))
    print("\n")

    // Allocate buffer (include __LINKEDIT)
    let total_size = align_up(linkedit_offset + linkedit_size, PAGE_SIZE())
    print("  Total size: ")
    print(strconv.Itoa(total_size))
    print("\n")

    let buf = heap_alloc(total_size)
    if buf == 0 {
        print("ERROR: Failed to allocate buffer\n")
        return 1
    }

    // Zero out buffer
    print("  Zeroing buffer...\n")
    write_zeros(buf, total_size)

    // Write Mach-O header
    print("  Writing header...\n")
    write_mach_header(buf, 14, load_cmds_size)  // 14 load commands now

    // Write load commands
    print("  Writing load commands...\n")
    let mut lc_offset = header_size
    lc_offset = lc_offset + write_pagezero_segment(buf + lc_offset)
    lc_offset = lc_offset + write_text_segment(buf + lc_offset, code_offset, code_size)
    lc_offset = lc_offset + write_linkedit_segment(buf + lc_offset, linkedit_offset, linkedit_size)
    lc_offset = lc_offset + write_main_command(buf + lc_offset, code_offset)
    lc_offset = lc_offset + write_symtab_command(buf + lc_offset, symtab_offset, nsyms, strtab_offset, strtab_size)
    lc_offset = lc_offset + write_dysymtab_command(buf + lc_offset)
    lc_offset = lc_offset + write_dylinker_command(buf + lc_offset)
    lc_offset = lc_offset + write_uuid_command(buf + lc_offset)
    lc_offset = lc_offset + write_build_version_command(buf + lc_offset)
    lc_offset = lc_offset + write_load_dylib_command(buf + lc_offset)
    lc_offset = lc_offset + write_source_version_command(buf + lc_offset)
    lc_offset = lc_offset + write_function_starts_command(buf + lc_offset, func_starts_offset, func_starts_size)
    lc_offset = lc_offset + write_data_in_code_command(buf + lc_offset, data_in_code_offset, data_in_code_size)
    lc_offset = lc_offset + write_code_signature_command(buf + lc_offset, codesig_offset, codesig_size)

    // Copy code
    print("  Copying code...\n")
    let mut i = 0
    for i < code_size {
        let byte_val = peek(code + i)
        poke(buf + code_offset + i, byte_val)
        i = i + 1
    }

    // Write __LINKEDIT data (symbol table + string table)
    print("  Writing symbol table...\n")
    // Symbol table: 1 entry of nlist_64 (16 bytes, all zeros for minimal binary)
    write_zeros(buf + symtab_offset, symtab_size)

    // String table: starts with null byte, then minimal padding
    print("  Writing string table...\n")
    write_zeros(buf + strtab_offset, strtab_size)
    poke(buf + strtab_offset, 0)  // First byte must be null

    // Function starts: ULEB128-encoded function offsets (minimal: just zeros)
    print("  Writing function starts...\n")
    write_zeros(buf + func_starts_offset, func_starts_size)

    // Data in code: none needed for our simple binary

    // Code signature: ad-hoc signature blob
    print("  Writing code signature...\n")
    let actual_sig_size = write_code_signature_blob(buf + codesig_offset, codesig_offset, code_offset + code_size, "test_exe")
    print("  Signature size: ")
    print(strconv.Itoa(actual_sig_size))
    print(" bytes\n")

    // Write to file
    print("  Writing to file: ")
    print(output_path)
    print("\n")

    let fd = syscall.open(output_path, 1537, 493)  // 0755 = 493
    if fd < 0 {
        print("ERROR: Failed to open output file\n")
        return 1
    }

    let written = syscall.write(fd, buf, total_size)
    syscall.close(fd)

    if written != total_size {
        print("ERROR: Write failed\n")
        return 1
    }

    print("Success! Generated ")
    print(strconv.Itoa(written))
    print(" byte executable\n")
    return 0
}

fn main() -> int {
    print("Mach-O writer ready\n")

    // Test with minimal code that just exits
    // ARM64: MOV X0, #42; MOV X16, #1; SVC #0x80
    let code = heap_alloc(16)
    write_u32_le(code, 0xd2800540)      // MOV X0, #42
    write_u32_le(code + 4, 0xd2800030)  // MOV X16, #1 (exit syscall)
    write_u32_le(code + 8, 0xd4001001)  // SVC #0x80
    write_u32_le(code + 12, 0xd65f03c0) // RET (unreachable)

    let result = generate_macho(code, 16, "tmp/test_exe")
    return result
}
