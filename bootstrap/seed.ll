  %argc.ext = sext i32 %argc to i64
  store i64 %argc.ext, ptr @g_argc
  store ptr %argv, ptr @g_argv
  %r = call i64 @ease_user_main()
  %r32 = trunc i64 %r to i32
  ret i32 %r32
}

