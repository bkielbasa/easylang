// Semantic analyzer for the Ease bootstrap compiler
// Type checking and name resolution using parallel arrays
// (avoiding struct arrays due to compiler limitations)

// ============================================================================
// Type tag constants
// ============================================================================

fn TY_INVALID() -> int { return 0 }
fn TY_INT() -> int { return 1 }
fn TY_BOOL() -> int { return 2 }
fn TY_STRING() -> int { return 3 }
fn TY_UNIT() -> int { return 4 }
fn TY_ARRAY() -> int { return 10 }
fn TY_SLICE() -> int { return 11 }
fn TY_STRUCT() -> int { return 12 }
fn TY_FUNCTION() -> int { return 13 }

fn type_name(tag: int) -> string {
    if tag == TY_INVALID() { return "invalid" }
    if tag == TY_INT() { return "int" }
    if tag == TY_BOOL() { return "bool" }
    if tag == TY_STRING() { return "string" }
    if tag == TY_UNIT() { return "()" }
    if tag == TY_ARRAY() { return "array" }
    if tag == TY_SLICE() { return "slice" }
    if tag == TY_STRUCT() { return "struct" }
    if tag == TY_FUNCTION() { return "function" }
    return "unknown"
}

// ============================================================================
// Symbol kind constants
// ============================================================================

fn SYM_VAR() -> int { return 1 }
fn SYM_FUNC() -> int { return 2 }
fn SYM_PARAM() -> int { return 3 }
fn SYM_TYPE() -> int { return 4 }

// ============================================================================
// Token constants (from parser.ease)
// ============================================================================

fn TK_PLUS() -> int { return 30 }
fn TK_MINUS() -> int { return 31 }
fn TK_STAR() -> int { return 32 }
fn TK_SLASH() -> int { return 33 }
fn TK_PERCENT() -> int { return 34 }
fn TK_EQ() -> int { return 35 }
fn TK_EQEQ() -> int { return 36 }
fn TK_BANGEQ() -> int { return 37 }
fn TK_LT() -> int { return 38 }
fn TK_GT() -> int { return 39 }
fn TK_LTEQ() -> int { return 40 }
fn TK_GTEQ() -> int { return 41 }
fn TK_BANG() -> int { return 42 }
fn TK_AMPAMP() -> int { return 43 }
fn TK_PIPEPIPE() -> int { return 44 }
fn TK_AMP() -> int { return 45 }

// AST Node types (from parser.ease)
fn EXPR_IDENT() -> int { return 1 }
fn EXPR_INT() -> int { return 2 }
fn EXPR_STRING() -> int { return 3 }
fn EXPR_CHAR() -> int { return 4 }
fn EXPR_BOOL() -> int { return 5 }
fn EXPR_BINARY() -> int { return 6 }
fn EXPR_UNARY() -> int { return 7 }
fn EXPR_CALL() -> int { return 8 }
fn EXPR_INDEX() -> int { return 9 }
fn EXPR_FIELD() -> int { return 10 }

fn STMT_LET() -> int { return 20 }
fn STMT_RETURN() -> int { return 21 }
fn STMT_EXPR() -> int { return 22 }
fn STMT_IF() -> int { return 23 }
fn STMT_FOR() -> int { return 24 }
fn STMT_BREAK() -> int { return 25 }
fn STMT_CONTINUE() -> int { return 26 }
fn STMT_BLOCK() -> int { return 27 }

fn DECL_FN() -> int { return 30 }
fn DECL_STRUCT() -> int { return 31 }

fn TYPE_IDENT() -> int { return 40 }
fn TYPE_ARRAY() -> int { return 41 }

// ============================================================================
// AstNode structure (from parser.ease)
// ============================================================================

struct AstNode {
    tag: int,
    str_val: string,
    int_val: int,
    left: int,
    right: int,
    extra: int,
    children_start: int,
    children_count: int,
}

// ============================================================================
// Sema State - Using parallel arrays to avoid struct array issues
// ============================================================================

// Types are stored in parallel arrays
// type_tags[i], type_names[i], type_elem[i], etc. describe type i
struct Sema {
    // Type storage (parallel arrays)
    type_tags: []int,       // TY_* constants
    type_names: []string,   // struct name or ""
    type_elem: []int,       // element type for arrays
    type_fields_start: []int,   // start of fields in field arrays
    type_fields_count: []int,   // number of fields
    type_params_start: []int,   // for functions: start of params
    type_params_count: []int,   // for functions: number of params
    type_result: []int,         // for functions: return type

    // Field storage (parallel arrays)
    field_names: []string,
    field_types: []int,

    // Symbol storage (parallel arrays)
    sym_names: []string,
    sym_types: []int,       // type index
    sym_scopes: []int,      // scope id
    sym_kinds: []int,       // SYM_* constant
    sym_mutable: []int,     // 1 if mutable, 0 otherwise

    // Scope storage (parallel arrays)
    scope_parents: []int,   // parent scope id, -1 for global
    scope_names: []string,

    // State
    errors: []string,
    current_scope: []int,   // single element array for mutability
    current_func: []int,    // single element array for mutability
}

fn new_sema() -> Sema {
    let mut s = Sema {
        type_tags: []int{},
        type_names: []string{},
        type_elem: []int{},
        type_fields_start: []int{},
        type_fields_count: []int{},
        type_params_start: []int{},
        type_params_count: []int{},
        type_result: []int{},

        field_names: []string{},
        field_types: []int{},

        sym_names: []string{},
        sym_types: []int{},
        sym_scopes: []int{},
        sym_kinds: []int{},
        sym_mutable: []int{},

        scope_parents: []int{},
        scope_names: []string{},

        errors: []string{},
        current_scope: []int{},
        current_func: []int{},
    }

    // Initialize mutable state
    push(s.current_scope, 0)
    push(s.current_func, -1)

    // Create global scope (id 0)
    push(s.scope_parents, -1)
    push(s.scope_names, "global")

    // Add builtin types
    // Type 0: invalid
    add_primitive_type(s, TY_INVALID(), "")
    // Type 1: int
    add_primitive_type(s, TY_INT(), "")
    // Type 2: bool
    add_primitive_type(s, TY_BOOL(), "")
    // Type 3: string
    add_primitive_type(s, TY_STRING(), "")
    // Type 4: unit
    add_primitive_type(s, TY_UNIT(), "")

    // Register builtin type symbols
    add_symbol(s, "int", SYM_TYPE(), 1)
    add_symbol(s, "bool", SYM_TYPE(), 2)
    add_symbol(s, "string", SYM_TYPE(), 3)

    // Register builtin functions
    // print(string) -> ()
    let print_params = len(s.field_names)
    push(s.field_names, "s")
    push(s.field_types, 3)  // string
    let print_type = add_function_type(s, print_params, 1, 4)  // 1 param, returns unit
    add_symbol(s, "print", SYM_FUNC(), print_type)

    // len - handled specially
    let len_type = add_function_type(s, -1, 0, 1)  // special, returns int
    add_symbol(s, "len", SYM_FUNC(), len_type)

    // push - handled specially
    let push_type = add_function_type(s, -1, 0, 4)  // special, returns unit
    add_symbol(s, "push", SYM_FUNC(), push_type)

    // strconv.Itoa and strconv.Atoi - will be handled in analyze_field
    add_symbol(s, "strconv", SYM_VAR(), 0)

    return s
}

fn add_primitive_type(s: Sema, tag: int, name: string) -> int {
    let idx = len(s.type_tags)
    push(s.type_tags, tag)
    push(s.type_names, name)
    push(s.type_elem, -1)
    push(s.type_fields_start, -1)
    push(s.type_fields_count, 0)
    push(s.type_params_start, -1)
    push(s.type_params_count, 0)
    push(s.type_result, -1)
    return idx
}

fn add_array_type(s: Sema, elem_type: int) -> int {
    let idx = len(s.type_tags)
    push(s.type_tags, TY_SLICE())
    push(s.type_names, "")
    push(s.type_elem, elem_type)
    push(s.type_fields_start, -1)
    push(s.type_fields_count, 0)
    push(s.type_params_start, -1)
    push(s.type_params_count, 0)
    push(s.type_result, -1)
    return idx
}

fn add_struct_type(s: Sema, name: string, fields_start: int, fields_count: int) -> int {
    let idx = len(s.type_tags)
    push(s.type_tags, TY_STRUCT())
    push(s.type_names, name)
    push(s.type_elem, -1)
    push(s.type_fields_start, fields_start)
    push(s.type_fields_count, fields_count)
    push(s.type_params_start, -1)
    push(s.type_params_count, 0)
    push(s.type_result, -1)
    return idx
}

fn add_function_type(s: Sema, params_start: int, params_count: int, result: int) -> int {
    let idx = len(s.type_tags)
    push(s.type_tags, TY_FUNCTION())
    push(s.type_names, "")
    push(s.type_elem, -1)
    push(s.type_fields_start, -1)
    push(s.type_fields_count, 0)
    push(s.type_params_start, params_start)
    push(s.type_params_count, params_count)
    push(s.type_result, result)
    return idx
}

fn add_symbol(s: Sema, name: string, kind: int, type_idx: int) -> int {
    let idx = len(s.sym_names)
    push(s.sym_names, name)
    push(s.sym_types, type_idx)
    push(s.sym_scopes, get_current_scope(s))
    push(s.sym_kinds, kind)
    push(s.sym_mutable, 0)
    return idx
}

fn add_symbol_mut(s: Sema, name: string, kind: int, type_idx: int, mutable: int) -> int {
    let idx = len(s.sym_names)
    push(s.sym_names, name)
    push(s.sym_types, type_idx)
    push(s.sym_scopes, get_current_scope(s))
    push(s.sym_kinds, kind)
    push(s.sym_mutable, mutable)
    return idx
}

fn add_error(s: Sema, msg: string) {
    push(s.errors, msg)
}

// Helpers for mutable state - use push/read-last instead of array element assignment
fn get_current_scope(s: Sema) -> int {
    return s.current_scope[len(s.current_scope) - 1]
}

fn set_current_scope(s: Sema, value: int) {
    push(s.current_scope, value)
}

fn get_current_func(s: Sema) -> int {
    return s.current_func[len(s.current_func) - 1]
}

fn set_current_func(s: Sema, value: int) {
    push(s.current_func, value)
}

fn enter_scope(s: Sema, name: string) -> int {
    let scope_id = len(s.scope_parents)
    push(s.scope_parents, get_current_scope(s))
    push(s.scope_names, name)
    set_current_scope(s, scope_id)
    return scope_id
}

fn exit_scope(s: Sema) {
    let cur = get_current_scope(s)
    if cur > 0 {
        set_current_scope(s, s.scope_parents[cur])
    }
}

// Lookup a symbol in current scope and parent scopes
fn lookup_symbol(s: Sema, name: string) -> int {
    let mut scope_id = get_current_scope(s)

    for scope_id >= 0 {
        let mut i = 0
        for i < len(s.sym_names) {
            if s.sym_scopes[i] == scope_id && s.sym_names[i] == name {
                return i
            }
            i = i + 1
        }
        scope_id = s.scope_parents[scope_id]
    }
    return -1
}

// Lookup symbol in current scope only
fn lookup_symbol_local(s: Sema, name: string) -> int {
    let mut i = 0
    for i < len(s.sym_names) {
        if s.sym_scopes[i] == get_current_scope(s) && s.sym_names[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// Check if two types are equal
fn types_equal(s: Sema, t1: int, t2: int) -> bool {
    if t1 == t2 {
        return true
    }
    if t1 < 0 || t2 < 0 || t1 >= len(s.type_tags) || t2 >= len(s.type_tags) {
        return false
    }
    if s.type_tags[t1] != s.type_tags[t2] {
        return false
    }

    let tag = s.type_tags[t1]

    // For arrays/slices, check element type
    if tag == TY_ARRAY() || tag == TY_SLICE() {
        return types_equal(s, s.type_elem[t1], s.type_elem[t2])
    }

    // For structs, compare by name
    if tag == TY_STRUCT() {
        return s.type_names[t1] == s.type_names[t2]
    }

    // For functions, compare params and result
    if tag == TY_FUNCTION() {
        if s.type_params_count[t1] != s.type_params_count[t2] {
            return false
        }
        if !types_equal(s, s.type_result[t1], s.type_result[t2]) {
            return false
        }
        let mut i = 0
        for i < s.type_params_count[t1] {
            let p1_type = s.field_types[s.type_params_start[t1] + i]
            let p2_type = s.field_types[s.type_params_start[t2] + i]
            if !types_equal(s, p1_type, p2_type) {
                return false
            }
            i = i + 1
        }
        return true
    }

    return true
}

fn is_numeric(s: Sema, t: int) -> bool {
    if t < 0 || t >= len(s.type_tags) { return false }
    return s.type_tags[t] == TY_INT()
}

fn is_comparable(s: Sema, t: int) -> bool {
    if t < 0 || t >= len(s.type_tags) { return false }
    let tag = s.type_tags[t]
    return tag == TY_INT() || tag == TY_BOOL() || tag == TY_STRING()
}

fn is_ordered(s: Sema, t: int) -> bool {
    if t < 0 || t >= len(s.type_tags) { return false }
    let tag = s.type_tags[t]
    return tag == TY_INT() || tag == TY_STRING()
}

fn get_type_name(s: Sema, t: int) -> string {
    if t < 0 || t >= len(s.type_tags) { return "invalid" }
    let tag = s.type_tags[t]
    if tag == TY_STRUCT() { return s.type_names[t] }
    if tag == TY_ARRAY() || tag == TY_SLICE() {
        return str_concat("[]", get_type_name(s, s.type_elem[t]))
    }
    return type_name(tag)
}

// ============================================================================
// Type Resolution
// ============================================================================

fn resolve_type(s: Sema, nodes: []AstNode, type_idx: int) -> int {
    if type_idx < 0 || type_idx >= len(nodes) {
        return 4  // unit
    }

    let node = nodes[type_idx]

    if node.tag == TYPE_IDENT() {
        let name = node.str_val
        if name == "int" { return 1 }
        if name == "bool" { return 2 }
        if name == "string" { return 3 }

        let sym_idx = lookup_symbol(s, name)
        if sym_idx < 0 {
            add_error(s, str_concat("undefined type: ", name))
            return 0
        }
        if s.sym_kinds[sym_idx] != SYM_TYPE() {
            add_error(s, str_concat("not a type: ", name))
            return 0
        }
        return s.sym_types[sym_idx]
    }

    if node.tag == TYPE_ARRAY() {
        let elem_type = resolve_type(s, nodes, node.left)
        return add_array_type(s, elem_type)
    }

    return 0
}

// ============================================================================
// Declaration Collection (First Pass)
// ============================================================================

fn collect_declarations(s: Sema, nodes: []AstNode) {
    let mut i = 0
    for i < len(nodes) {
        let node = nodes[i]
        if node.tag == DECL_FN() {
            collect_fn_decl(s, nodes, i)
        } else if node.tag == DECL_STRUCT() {
            collect_struct_decl(s, nodes, i)
        }
        i = i + 1
    }
}

fn collect_fn_decl(s: Sema, nodes: []AstNode, idx: int) {
    let node = nodes[idx]
    let name = node.str_val

    if lookup_symbol_local(s, name) >= 0 {
        add_error(s, str_concat("redeclaration of: ", name))
        return
    }

    let params_start = len(s.field_names)
    let mut params_count = 0

    let mut i = 0
    for i < node.children_count {
        let param_idx = node.children_start + i
        let param_node = nodes[param_idx]
        let param_name = param_node.str_val
        let param_type = resolve_type(s, nodes, param_node.left)
        push(s.field_names, param_name)
        push(s.field_types, param_type)
        params_count = params_count + 1
        i = i + 1
    }

    let mut ret_type = 4  // unit
    if node.left >= 0 {
        ret_type = resolve_type(s, nodes, node.left)
    }

    let fn_type_idx = add_function_type(s, params_start, params_count, ret_type)
    add_symbol(s, name, SYM_FUNC(), fn_type_idx)
}

fn collect_struct_decl(s: Sema, nodes: []AstNode, idx: int) {
    let node = nodes[idx]
    let name = node.str_val

    if lookup_symbol_local(s, name) >= 0 {
        add_error(s, str_concat("redeclaration of: ", name))
        return
    }

    let fields_start = len(s.field_names)
    let mut fields_count = 0

    let mut i = 0
    for i < node.children_count {
        let field_idx = node.children_start + i
        let field_node = nodes[field_idx]
        let field_name = field_node.str_val
        let field_type = resolve_type(s, nodes, field_node.left)
        push(s.field_names, field_name)
        push(s.field_types, field_type)
        fields_count = fields_count + 1
        i = i + 1
    }

    let struct_type_idx = add_struct_type(s, name, fields_start, fields_count)
    add_symbol(s, name, SYM_TYPE(), struct_type_idx)
}

// ============================================================================
// Expression Type Checking
// ============================================================================

fn analyze_expr(s: Sema, nodes: []AstNode, idx: int) -> int {
    print("[ae")
    print(strconv.Itoa(idx))
    print("]")
    if idx < 0 || idx >= len(nodes) {
        print("->unit")
        return 4  // unit
    }

    let node = nodes[idx]
    let tag = node.tag
    print("t=")
    print(strconv.Itoa(tag))

    if tag == EXPR_INT() {
        print("->int ")
        return 1
    }
    if tag == EXPR_STRING() { return 3 }
    if tag == EXPR_BOOL() { return 2 }
    if tag == EXPR_CHAR() { return 1 }

    if tag == EXPR_IDENT() {
        return analyze_ident(s, nodes, idx)
    }
    if tag == EXPR_BINARY() {
        print("->bin ")
        return analyze_binary(s, nodes, idx)
    }
    if tag == EXPR_UNARY() {
        return analyze_unary(s, nodes, idx)
    }
    if tag == EXPR_CALL() {
        return analyze_call(s, nodes, idx)
    }
    if tag == EXPR_FIELD() {
        return analyze_field(s, nodes, idx)
    }
    if tag == EXPR_INDEX() {
        return analyze_index(s, nodes, idx)
    }

    return 0
}

fn analyze_ident(s: Sema, nodes: []AstNode, idx: int) -> int {
    let node = nodes[idx]
    let name = node.str_val

    let sym_idx = lookup_symbol(s, name)
    if sym_idx < 0 {
        add_error(s, str_concat("undefined: ", name))
        return 0
    }
    return s.sym_types[sym_idx]
}

fn analyze_binary(s: Sema, nodes: []AstNode, idx: int) -> int {
    print("[ab entry]")
    let node = nodes[idx]
    let op = node.int_val
    print("[op=")
    print(strconv.Itoa(op))
    print(" l=")
    print(strconv.Itoa(node.left))
    print(" r=")
    print(strconv.Itoa(node.right))
    print("]")

    print("[left:]")
    let left_type = analyze_expr(s, nodes, node.left)
    print("[right:]")
    let right_type = analyze_expr(s, nodes, node.right)
    print("[both done]")
    print("[check EQ]")

    // Assignment
    if op == TK_EQ() {
        if !types_equal(s, left_type, right_type) {
            add_error(s, str_concat("type mismatch in assignment: ",
                str_concat(get_type_name(s, left_type),
                str_concat(" vs ", get_type_name(s, right_type)))))
        }
        return 4  // unit
    }

    // Plus: arithmetic or string concat
    print("[check PLUS]")
    if op == TK_PLUS() {
        print("[is PLUS]")
        if left_type == 3 {  // string
            if right_type != 3 {
                add_error(s, "cannot concatenate string with non-string")
            }
            return 3
        }
        print("[checking numeric]")
        if !is_numeric(s, left_type) {
            add_error(s, str_concat("operator + not defined for ", get_type_name(s, left_type)))
            return 0
        }
        print("[checking types_equal]")
        if !types_equal(s, left_type, right_type) {
            add_error(s, str_concat("mismatched types: ",
                str_concat(get_type_name(s, left_type),
                str_concat(" and ", get_type_name(s, right_type)))))
            return 0
        }
        print("[returning left_type]")
        return left_type
    }

    // Other arithmetic
    if op == TK_MINUS() || op == TK_STAR() || op == TK_SLASH() || op == TK_PERCENT() {
        if !is_numeric(s, left_type) {
            add_error(s, str_concat("operator not defined for ", get_type_name(s, left_type)))
            return 0
        }
        if !types_equal(s, left_type, right_type) {
            add_error(s, str_concat("mismatched types: ",
                str_concat(get_type_name(s, left_type),
                str_concat(" and ", get_type_name(s, right_type)))))
            return 0
        }
        return left_type
    }

    // Equality
    if op == TK_EQEQ() || op == TK_BANGEQ() {
        if !is_comparable(s, left_type) {
            add_error(s, str_concat("operator not defined for ", get_type_name(s, left_type)))
            return 0
        }
        if !types_equal(s, left_type, right_type) {
            add_error(s, str_concat("mismatched types: ",
                str_concat(get_type_name(s, left_type),
                str_concat(" and ", get_type_name(s, right_type)))))
            return 0
        }
        return 2  // bool
    }

    // Comparison
    if op == TK_LT() || op == TK_LTEQ() || op == TK_GT() || op == TK_GTEQ() {
        if !is_ordered(s, left_type) {
            add_error(s, str_concat("operator not defined for ", get_type_name(s, left_type)))
            return 0
        }
        if !types_equal(s, left_type, right_type) {
            add_error(s, str_concat("mismatched types: ",
                str_concat(get_type_name(s, left_type),
                str_concat(" and ", get_type_name(s, right_type)))))
            return 0
        }
        return 2  // bool
    }

    // Logical
    if op == TK_AMPAMP() || op == TK_PIPEPIPE() {
        if left_type != 2 {
            add_error(s, str_concat("operator requires bool, got ", get_type_name(s, left_type)))
            return 0
        }
        if right_type != 2 {
            add_error(s, str_concat("operator requires bool, got ", get_type_name(s, right_type)))
            return 0
        }
        return 2  // bool
    }

    add_error(s, "unknown binary operator")
    return 0
}

fn analyze_unary(s: Sema, nodes: []AstNode, idx: int) -> int {
    let node = nodes[idx]
    let op = node.int_val
    let right_type = analyze_expr(s, nodes, node.right)

    if op == TK_MINUS() {
        if !is_numeric(s, right_type) {
            add_error(s, str_concat("operator - not defined for ", get_type_name(s, right_type)))
            return 0
        }
        return right_type
    }

    if op == TK_BANG() {
        if right_type != 2 {
            add_error(s, str_concat("operator ! requires bool, got ", get_type_name(s, right_type)))
            return 0
        }
        return 2
    }

    if op == TK_AMP() {
        return right_type  // simplified: return operand type
    }

    add_error(s, "unknown unary operator")
    return 0
}

fn analyze_call(s: Sema, nodes: []AstNode, idx: int) -> int {
    let node = nodes[idx]
    let func_node = nodes[node.left]

    if func_node.tag != EXPR_IDENT() {
        add_error(s, "cannot call non-identifier")
        return 0
    }

    let func_name = func_node.str_val

    // Handle special builtins
    if func_name == "len" {
        if node.children_count != 1 {
            add_error(s, "len requires exactly 1 argument")
            return 0
        }
        let arg_type = analyze_expr(s, nodes, node.children_start)
        let tag = s.type_tags[arg_type]
        if tag != TY_ARRAY() && tag != TY_SLICE() && tag != TY_STRING() {
            add_error(s, str_concat("len not defined for ", get_type_name(s, arg_type)))
        }
        return 1  // int
    }

    if func_name == "push" {
        if node.children_count != 2 {
            add_error(s, "push requires exactly 2 arguments")
            return 0
        }
        let arr_type = analyze_expr(s, nodes, node.children_start)
        let elem_type = analyze_expr(s, nodes, node.children_start + 1)
        let tag = s.type_tags[arr_type]
        if tag != TY_ARRAY() && tag != TY_SLICE() {
            add_error(s, "first argument to push must be array")
            return 0
        }
        if !types_equal(s, s.type_elem[arr_type], elem_type) {
            add_error(s, "element type mismatch in push")
        }
        return 4  // unit
    }

    if func_name == "print" {
        let mut i = 0
        for i < node.children_count {
            analyze_expr(s, nodes, node.children_start + i)
            i = i + 1
        }
        return 4  // unit
    }

    // Look up function
    let sym_idx = lookup_symbol(s, func_name)
    if sym_idx < 0 {
        add_error(s, str_concat("undefined function: ", func_name))
        return 0
    }
    if s.sym_kinds[sym_idx] != SYM_FUNC() {
        add_error(s, str_concat("not a function: ", func_name))
        return 0
    }

    let fn_type = s.sym_types[sym_idx]

    // Check argument count
    if node.children_count != s.type_params_count[fn_type] {
        add_error(s, str_concat("wrong number of arguments for ", func_name))
        return s.type_result[fn_type]
    }

    // Check argument types
    let mut i = 0
    for i < node.children_count {
        let arg_type = analyze_expr(s, nodes, node.children_start + i)
        let param_type = s.field_types[s.type_params_start[fn_type] + i]
        if !types_equal(s, arg_type, param_type) {
            add_error(s, str_concat("type mismatch in argument to ", func_name))
        }
        i = i + 1
    }

    return s.type_result[fn_type]
}

fn analyze_field(s: Sema, nodes: []AstNode, idx: int) -> int {
    let node = nodes[idx]
    let expr_type = analyze_expr(s, nodes, node.left)
    let field_name = node.str_val

    // Handle strconv module
    let expr_node = nodes[node.left]
    if expr_node.tag == EXPR_IDENT() && expr_node.str_val == "strconv" {
        if field_name == "Itoa" {
            let params_start = len(s.field_names)
            push(s.field_names, "n")
            push(s.field_types, 1)  // int
            return add_function_type(s, params_start, 1, 3)  // returns string
        }
        if field_name == "Atoi" {
            let params_start = len(s.field_names)
            push(s.field_names, "s")
            push(s.field_types, 3)  // string
            return add_function_type(s, params_start, 1, 1)  // returns int
        }
    }

    let tag = s.type_tags[expr_type]
    if tag != TY_STRUCT() {
        add_error(s, str_concat("cannot access field of non-struct ", get_type_name(s, expr_type)))
        return 0
    }

    // Search for field
    let fields_start = s.type_fields_start[expr_type]
    let fields_count = s.type_fields_count[expr_type]
    let mut i = 0
    for i < fields_count {
        if s.field_names[fields_start + i] == field_name {
            return s.field_types[fields_start + i]
        }
        i = i + 1
    }

    add_error(s, str_concat("struct has no field ", field_name))
    return 0
}

fn analyze_index(s: Sema, nodes: []AstNode, idx: int) -> int {
    let node = nodes[idx]
    let arr_type = analyze_expr(s, nodes, node.left)
    let idx_type = analyze_expr(s, nodes, node.right)

    if idx_type != 1 {
        add_error(s, str_concat("array index must be int, got ", get_type_name(s, idx_type)))
    }

    let tag = s.type_tags[arr_type]
    if tag != TY_ARRAY() && tag != TY_SLICE() {
        add_error(s, str_concat("cannot index ", get_type_name(s, arr_type)))
        return 0
    }

    return s.type_elem[arr_type]
}

// ============================================================================
// Statement Analysis
// ============================================================================

fn analyze_stmt(s: Sema, nodes: []AstNode, idx: int) {
    if idx < 0 || idx >= len(nodes) { return }

    let node = nodes[idx]
    let tag = node.tag

    if tag == STMT_LET() {
        analyze_let(s, nodes, idx)
    } else if tag == STMT_RETURN() {
        analyze_return(s, nodes, idx)
    } else if tag == STMT_EXPR() {
        analyze_expr(s, nodes, node.left)
    } else if tag == STMT_IF() {
        analyze_if(s, nodes, idx)
    } else if tag == STMT_FOR() {
        analyze_for(s, nodes, idx)
    } else if tag == STMT_BLOCK() {
        enter_scope(s, "block")
        analyze_block(s, nodes, idx)
        exit_scope(s)
    }
}

fn analyze_let(s: Sema, nodes: []AstNode, idx: int) {
    let node = nodes[idx]
    let name = node.str_val
    let is_mut = node.int_val != 0

    if lookup_symbol_local(s, name) >= 0 {
        add_error(s, str_concat("redeclaration of: ", name))
        return
    }

    let mut var_type = -1
    if node.left >= 0 {
        var_type = resolve_type(s, nodes, node.left)
    }

    let val_type = analyze_expr(s, nodes, node.right)

    if var_type < 0 {
        var_type = val_type
    } else {
        if !types_equal(s, val_type, var_type) {
            add_error(s, str_concat("cannot assign ",
                str_concat(get_type_name(s, val_type),
                str_concat(" to ", get_type_name(s, var_type)))))
        }
    }

    let mut mut_val = 0
    if is_mut { mut_val = 1 }
    add_symbol_mut(s, name, SYM_VAR(), var_type, mut_val)
}

fn analyze_return(s: Sema, nodes: []AstNode, idx: int) {
    let node = nodes[idx]

    if get_current_func(s) < 0 {
        add_error(s, "return outside of function")
        return
    }

    let expected_type = s.type_result[get_current_func(s)]

    if node.left < 0 {
        if expected_type != 4 {
            add_error(s, str_concat("function expects return value of type ", get_type_name(s, expected_type)))
        }
    } else {
        let val_type = analyze_expr(s, nodes, node.left)
        if !types_equal(s, val_type, expected_type) {
            add_error(s, str_concat("cannot return ",
                str_concat(get_type_name(s, val_type),
                str_concat(" as ", get_type_name(s, expected_type)))))
        }
    }
}

fn analyze_if(s: Sema, nodes: []AstNode, idx: int) {
    let node = nodes[idx]

    let cond_type = analyze_expr(s, nodes, node.left)
    if cond_type != 2 {
        add_error(s, str_concat("if condition must be bool, got ", get_type_name(s, cond_type)))
    }

    enter_scope(s, "if:then")
    analyze_block(s, nodes, node.right)
    exit_scope(s)

    if node.extra >= 0 {
        enter_scope(s, "if:else")
        let else_node = nodes[node.extra]
        if else_node.tag == STMT_IF() {
            analyze_if(s, nodes, node.extra)
        } else {
            analyze_block(s, nodes, node.extra)
        }
        exit_scope(s)
    }
}

fn analyze_for(s: Sema, nodes: []AstNode, idx: int) {
    let node = nodes[idx]

    enter_scope(s, "for")

    if node.left >= 0 {
        let cond_type = analyze_expr(s, nodes, node.left)
        if cond_type != 2 {
            add_error(s, str_concat("for condition must be bool, got ", get_type_name(s, cond_type)))
        }
    }

    analyze_block(s, nodes, node.right)
    exit_scope(s)
}

fn analyze_block(s: Sema, nodes: []AstNode, idx: int) {
    if idx < 0 || idx >= len(nodes) { return }

    let node = nodes[idx]
    if node.tag == STMT_BLOCK() {
        let mut i = 0
        for i < node.children_count {
            analyze_stmt(s, nodes, node.children_start + i)
            i = i + 1
        }
    } else {
        analyze_stmt(s, nodes, idx)
    }
}

// ============================================================================
// Function Body Analysis
// ============================================================================

fn analyze_fn_decl(s: Sema, nodes: []AstNode, idx: int) {
    let node = nodes[idx]
    let name = node.str_val

    let sym_idx = lookup_symbol(s, name)
    if sym_idx < 0 { return }

    let fn_type_idx = s.sym_types[sym_idx]
    set_current_func(s, fn_type_idx)

    enter_scope(s, str_concat("function:", name))

    // Define parameters
    let mut i = 0
    for i < node.children_count {
        let param_idx = node.children_start + i
        let param_node = nodes[param_idx]
        let param_name = param_node.str_val
        let param_type = s.field_types[s.type_params_start[fn_type_idx] + i]
        add_symbol(s, param_name, SYM_PARAM(), param_type)
        i = i + 1
    }

    if node.right >= 0 {
        analyze_block(s, nodes, node.right)
    }

    exit_scope(s)
    set_current_func(s, -1)
}

fn analyze_program(s: Sema, nodes: []AstNode) {
    collect_declarations(s, nodes)

    let mut i = 0
    for i < len(nodes) {
        let node = nodes[i]
        if node.tag == DECL_FN() {
            analyze_fn_decl(s, nodes, i)
        }
        i = i + 1
    }
}

// ============================================================================
// Tests
// ============================================================================

fn test_literals() -> bool {
    print("Test: Literal type checking... ")

    let mut nodes = []AstNode{}
    let mut int_node = AstNode {
        tag: EXPR_INT(),
        str_val: "",
        int_val: 42,
        left: -1, right: -1, extra: -1,
        children_start: -1, children_count: 0,
    }
    push(nodes, int_node)

    let mut s = new_sema()
    let t = analyze_expr(s, nodes, 0)

    if t != 1 {
        print("FAIL - int literal should have type int\n")
        return false
    }

    print("OK\n")
    return true
}

fn test_binary_ops() -> bool {
    print("Test: Binary operator type checking... ")

    let mut nodes = []AstNode{}
    print("\n  pushing node 0...")
    push(nodes, AstNode { tag: EXPR_INT(), str_val: "", int_val: 1, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    print(" pushing node 1...")
    push(nodes, AstNode { tag: EXPR_INT(), str_val: "", int_val: 2, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    print(" pushing node 2...")
    push(nodes, AstNode { tag: EXPR_BINARY(), str_val: "", int_val: TK_PLUS(), left: 0, right: 1, extra: -1, children_start: -1, children_count: 0 })
    print(" done, len=")
    print(strconv.Itoa(len(nodes)))
    print("\n  reading node 0...")
    let n0 = nodes[0]
    print(" tag=")
    print(strconv.Itoa(n0.tag))
    print("\n  reading node 1...")
    let n1 = nodes[1]
    print(" tag=")
    print(strconv.Itoa(n1.tag))
    print("\n  reading node 2...")
    let n2 = nodes[2]
    print(" tag=")
    print(strconv.Itoa(n2.tag))
    print("\n  creating sema...")

    let mut s = new_sema()
    print(" analyzing...")
    let t = analyze_expr(s, nodes, 2)

    if t != 1 {
        print("FAIL - 1 + 2 should have type int\n")
        return false
    }
    if len(s.errors) > 0 {
        print("FAIL - unexpected error\n")
        return false
    }

    print("OK\n")
    return true
}

fn test_comparison() -> bool {
    print("Test: Comparison operators... ")

    let mut nodes = []AstNode{}
    push(nodes, AstNode { tag: EXPR_INT(), str_val: "", int_val: 1, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: EXPR_INT(), str_val: "", int_val: 2, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: EXPR_BINARY(), str_val: "", int_val: TK_LT(), left: 0, right: 1, extra: -1, children_start: -1, children_count: 0 })

    let mut s = new_sema()
    let t = analyze_expr(s, nodes, 2)

    if t != 2 {
        print("FAIL - 1 < 2 should have type bool\n")
        return false
    }

    print("OK\n")
    return true
}

fn test_logical_ops() -> bool {
    print("Test: Logical operators... ")

    let mut nodes = []AstNode{}
    push(nodes, AstNode { tag: EXPR_BOOL(), str_val: "", int_val: 1, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: EXPR_BOOL(), str_val: "", int_val: 0, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: EXPR_BINARY(), str_val: "", int_val: TK_AMPAMP(), left: 0, right: 1, extra: -1, children_start: -1, children_count: 0 })

    let mut s = new_sema()
    let t = analyze_expr(s, nodes, 2)

    if t != 2 {
        print("FAIL - true && false should have type bool\n")
        return false
    }

    print("OK\n")
    return true
}

fn test_type_error() -> bool {
    print("Test: Type error detection... ")

    let mut nodes = []AstNode{}
    push(nodes, AstNode { tag: EXPR_INT(), str_val: "", int_val: 1, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: EXPR_BOOL(), str_val: "", int_val: 1, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: EXPR_BINARY(), str_val: "", int_val: TK_PLUS(), left: 0, right: 1, extra: -1, children_start: -1, children_count: 0 })

    let mut s = new_sema()
    analyze_expr(s, nodes, 2)

    if len(s.errors) == 0 {
        print("FAIL - should have reported type error\n")
        return false
    }

    print("OK\n")
    return true
}

fn test_undefined_var() -> bool {
    print("Test: Undefined variable detection... ")

    let mut nodes = []AstNode{}
    push(nodes, AstNode { tag: EXPR_IDENT(), str_val: "x", int_val: 0, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })

    let mut s = new_sema()
    analyze_expr(s, nodes, 0)

    if len(s.errors) == 0 {
        print("FAIL - should have reported undefined variable\n")
        return false
    }

    print("OK\n")
    return true
}

fn test_function_decl() -> bool {
    print("Test: Function declaration... ")

    let mut nodes = []AstNode{}

    // Type nodes
    push(nodes, AstNode { tag: TYPE_IDENT(), str_val: "int", int_val: 0, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: TYPE_IDENT(), str_val: "a", int_val: 0, left: 0, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: TYPE_IDENT(), str_val: "int", int_val: 0, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: TYPE_IDENT(), str_val: "b", int_val: 0, left: 2, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: TYPE_IDENT(), str_val: "int", int_val: 0, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })

    // Expression nodes
    push(nodes, AstNode { tag: EXPR_IDENT(), str_val: "a", int_val: 0, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: EXPR_IDENT(), str_val: "b", int_val: 0, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: EXPR_BINARY(), str_val: "", int_val: TK_PLUS(), left: 5, right: 6, extra: -1, children_start: -1, children_count: 0 })

    // Return and block
    push(nodes, AstNode { tag: STMT_RETURN(), str_val: "", int_val: 0, left: 7, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: STMT_BLOCK(), str_val: "", int_val: 0, left: -1, right: -1, extra: -1, children_start: 8, children_count: 1 })

    // Function declaration
    push(nodes, AstNode { tag: DECL_FN(), str_val: "add", int_val: 0, left: 4, right: 9, extra: -1, children_start: 1, children_count: 2 })

    let mut s = new_sema()
    analyze_program(s, nodes)

    if len(s.errors) > 0 {
        print("FAIL - unexpected error: ")
        print(s.errors[0])
        print("\n")
        return false
    }

    let sym_idx = lookup_symbol(s, "add")
    if sym_idx < 0 {
        print("FAIL - function 'add' not found\n")
        return false
    }
    if s.sym_kinds[sym_idx] != SYM_FUNC() {
        print("FAIL - 'add' is not a function\n")
        return false
    }

    let fn_type = s.sym_types[sym_idx]
    if s.type_params_count[fn_type] != 2 {
        print("FAIL - expected 2 params\n")
        return false
    }
    if s.type_result[fn_type] != 1 {
        print("FAIL - expected int return type\n")
        return false
    }

    print("OK\n")
    return true
}

fn test_struct_decl() -> bool {
    print("Test: Struct declaration... ")

    let mut nodes = []AstNode{}

    push(nodes, AstNode { tag: TYPE_IDENT(), str_val: "int", int_val: 0, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: TYPE_IDENT(), str_val: "x", int_val: 0, left: 0, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: TYPE_IDENT(), str_val: "int", int_val: 0, left: -1, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: TYPE_IDENT(), str_val: "y", int_val: 0, left: 2, right: -1, extra: -1, children_start: -1, children_count: 0 })
    push(nodes, AstNode { tag: DECL_STRUCT(), str_val: "Point", int_val: 0, left: -1, right: -1, extra: -1, children_start: 1, children_count: 2 })

    let mut s = new_sema()
    collect_declarations(s, nodes)

    if len(s.errors) > 0 {
        print("FAIL - unexpected error: ")
        print(s.errors[0])
        print("\n")
        return false
    }

    let sym_idx = lookup_symbol(s, "Point")
    if sym_idx < 0 {
        print("FAIL - struct 'Point' not found\n")
        return false
    }
    if s.sym_kinds[sym_idx] != SYM_TYPE() {
        print("FAIL - 'Point' is not a type\n")
        return false
    }

    let struct_type = s.sym_types[sym_idx]
    if s.type_tags[struct_type] != TY_STRUCT() {
        print("FAIL - expected struct type\n")
        return false
    }
    if s.type_fields_count[struct_type] != 2 {
        print("FAIL - expected 2 fields\n")
        return false
    }

    print("OK\n")
    return true
}

fn main() -> int {
    print("=== Bootstrap Semantic Analyzer Tests ===\n\n")

    let mut passed = 0
    let mut failed = 0

    if test_literals() { passed = passed + 1 } else { failed = failed + 1 }
    if test_binary_ops() { passed = passed + 1 } else { failed = failed + 1 }
    if test_comparison() { passed = passed + 1 } else { failed = failed + 1 }
    if test_logical_ops() { passed = passed + 1 } else { failed = failed + 1 }
    if test_type_error() { passed = passed + 1 } else { failed = failed + 1 }
    if test_undefined_var() { passed = passed + 1 } else { failed = failed + 1 }
    if test_function_decl() { passed = passed + 1 } else { failed = failed + 1 }
    if test_struct_decl() { passed = passed + 1 } else { failed = failed + 1 }

    print("\n=== Results ===\n")
    print("Passed: ")
    print(strconv.Itoa(passed))
    print("\nFailed: ")
    print(strconv.Itoa(failed))
    print("\n")

    if failed > 0 {
        return 1
    }
    return 0
}
