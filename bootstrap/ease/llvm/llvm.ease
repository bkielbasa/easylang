fn emit_op_setjmp(fd: int, instr: IRInstr, ti: int) {
    r32 := tmp_name(ti, 0)
    write_str(fd, "  " + r32 + " = call i32 @setjmp(ptr @ease_test_jmp_buf) #0\n")
    r := tmp_name(ti, 1)
    write_str(fd, "  " + r + " = sext i32 " + r32 + " to i64\n")
    emit_store_vreg(fd, instr.dest, r)
}

fn emit_op_clock_gettime(fd: int, instr: IRInstr, ti: int, clock_id: string) {
    ts := tmp_name(ti, 0)
    write_str(fd, "  " + ts + " = alloca [16 x i8]\n")
    write_str(fd, "  call i32 @clock_gettime(i32 " + clock_id + ", ptr " + ts + ")\n")
    sec := tmp_name(ti, 1)
    write_str(fd, "  " + sec + " = load i64, ptr " + ts + "\n")
    nsec_ptr := tmp_name(ti, 2)
    write_str(fd, "  " + nsec_ptr + " = getelementptr i8, ptr " + ts + ", i64 8\n")
    nsec := tmp_name(ti, 3)
    write_str(fd, "  " + nsec + " = load i64, ptr " + nsec_ptr + "\n")
    sec_ns := tmp_name(ti, 4)
    write_str(fd, "  " + sec_ns + " = mul i64 " + sec + ", 1000000000\n")
    r := tmp_name(ti, 5)
    write_str(fd, "  " + r + " = add i64 " + sec_ns + ", " + nsec + "\n")
    emit_store_vreg(fd, instr.dest, r)
}

fn emit_op_gc_collect(fd: int, instr: IRInstr, ti: int) {
    write_str(fd, "  call void @gc_collect()\n")
}

fn emit_op_loadfloat(fd: int, instr: IRInstr, ti: int) {
    r := tmp_name(ti, 0)
    write_str(fd, "  " + r + " = bitcast double " + instr.str_val + " to i64\n")
    emit_store_vreg(fd, instr.dest, r)
}

fn emit_op_fbinop(fd: int, instr: IRInstr, ti: int) {
    lhs := emit_load_vreg(fd, instr.arg1, ti, 0)
    rhs := emit_load_vreg(fd, instr.arg2, ti, 1)
    ld := tmp_name(ti, 2)
    write_str(fd, "  " + ld + " = bitcast i64 " + lhs + " to double\n")
    rd := tmp_name(ti, 3)
    write_str(fd, "  " + rd + " = bitcast i64 " + rhs + " to double\n")
    fop_name := "fadd"
    if instr.op == ir.OP_FSUB { fop_name = "fsub" }
    if instr.op == ir.OP_FMUL { fop_name = "fmul" }
    if instr.op == ir.OP_FDIV { fop_name = "fdiv" }
    if instr.op == ir.OP_FMOD { fop_name = "frem" }
    res_d := tmp_name(ti, 4)
    write_str(fd, "  " + res_d + " = " + fop_name + " double " + ld + ", " + rd + "\n")
    res_i := tmp_name(ti, 5)
    write_str(fd, "  " + res_i + " = bitcast double " + res_d + " to i64\n")
    emit_store_vreg(fd, instr.dest, res_i)
}

fn emit_op_fcmp(fd: int, instr: IRInstr, ti: int) {
    lhs := emit_load_vreg(fd, instr.arg1, ti, 0)
    rhs := emit_load_vreg(fd, instr.arg2, ti, 1)
    ld := tmp_name(ti, 2)
    write_str(fd, "  " + ld + " = bitcast i64 " + lhs + " to double\n")
    rd := tmp_name(ti, 3)
    write_str(fd, "  " + rd + " = bitcast i64 " + rhs + " to double\n")
    pred := "olt"
    if instr.op == ir.OP_FCMP_GT { pred = "ogt" }
    if instr.op == ir.OP_FCMP_LE { pred = "ole" }
    if instr.op == ir.OP_FCMP_GE { pred = "oge" }
    if instr.op == ir.OP_FCMP_EQ { pred = "oeq" }
    if instr.op == ir.OP_FCMP_NE { pred = "une" }
    cmp := tmp_name(ti, 4)
    write_str(fd, "  " + cmp + " = fcmp " + pred + " double " + ld + ", " + rd + "\n")
    ext := tmp_name(ti, 5)
    write_str(fd, "  " + ext + " = zext i1 " + cmp + " to i64\n")
    emit_store_vreg(fd, instr.dest, ext)
}

fn emit_op_int_to_float(fd: int, instr: IRInstr, ti: int) {
    val := emit_load_vreg(fd, instr.arg1, ti, 0)
    dbl := tmp_name(ti, 1)
    write_str(fd, "  " + dbl + " = sitofp i64 " + val + " to double\n")
    r := tmp_name(ti, 2)
    write_str(fd, "  " + r + " = bitcast double " + dbl + " to i64\n")
    emit_store_vreg(fd, instr.dest, r)
}

fn emit_op_float_to_int(fd: int, instr: IRInstr, ti: int) {
    val := emit_load_vreg(fd, instr.arg1, ti, 0)
    dbl := tmp_name(ti, 1)
    write_str(fd, "  " + dbl + " = bitcast i64 " + val + " to double\n")
    r := tmp_name(ti, 2)
    write_str(fd, "  " + r + " = fptosi double " + dbl + " to i64\n")
    emit_store_vreg(fd, instr.dest, r)
}

fn emit_op_float_to_str(fd: int, instr: IRInstr, ti: int) {
    val := emit_load_vreg(fd, instr.arg1, ti, 0)
    dbl := tmp_name(ti, 1)
    write_str(fd, "  " + dbl + " = bitcast i64 " + val + " to double\n")
    buf := tmp_name(ti, 2)
    write_str(fd, "  " + buf + " = call ptr @gc_alloc(i64 32)\n")
    write_str(fd, "  call i32 (ptr, i64, ptr, ...) @snprintf(ptr " + buf + ", i64 32, ptr @.fmt.g, double " + dbl + ")\n")
    emit_ptrtoint_store(fd, instr.dest, buf, ti, 3)
}

fn emit_op_map_call(fd: int, instr: IRInstr, ti: int, fname: string, two_args: int) {
    m := emit_load_vreg(fd, instr.arg1, ti, 0)
    if two_args == 1 {
        k := emit_load_vreg(fd, instr.arg2, ti, 1)
        r := tmp_name(ti, 2)
        write_str(fd, "  " + r + " = call i64 @" + fname + "(i64 " + m + ", i64 " + k + ")\n")
        emit_store_vreg(fd, instr.dest, r)
    } else {
        r := tmp_name(ti, 1)
        write_str(fd, "  " + r + " = call i64 @" + fname + "(i64 " + m + ")\n")
        emit_store_vreg(fd, instr.dest, r)
    }
}

fn emit_op_map_new(fd: int, instr: IRInstr, ti: int) {
    r := tmp_name(ti, 0)
    write_str(fd, "  " + r + " = call i64 @maps_New(i64 " + strconv.Itoa(instr.arg1) + ")\n")
    emit_store_vreg(fd, instr.dest, r)
}

fn emit_op_map_set(fd: int, instr: IRInstr, ti: int) {
    m := emit_load_vreg(fd, instr.arg1, ti, 0)
    k := emit_load_vreg(fd, instr.arg2, ti, 1)
    v := emit_load_vreg(fd, instr.arg3, ti, 2)
    r := tmp_name(ti, 3)
    write_str(fd, "  " + r + " = call i64 @maps_Set(i64 " + m + ", i64 " + k + ", i64 " + v + ")\n")
    emit_store_vreg(fd, instr.dest, r)
}

fn emit_op_iface_wrap(fd: int, instr: IRInstr, ti: int) {
    iw_ptr := "%iw.ptr." + strconv.Itoa(ti)
    write_str(fd, "  " + iw_ptr + " = call ptr @gc_alloc(i64 16)\n")
    iw_concrete := emit_load_vreg(fd, instr.arg1, ti, 0)
    iw_concrete_ptr := "%iw.cptr." + strconv.Itoa(ti)
    write_str(fd, "  " + iw_concrete_ptr + " = inttoptr i64 " + iw_concrete + " to ptr\n")
    write_str(fd, "  store i64 " + iw_concrete + ", ptr " + iw_ptr + "\n")
    iw_vt := "%iw.vt." + strconv.Itoa(ti)
    write_str(fd, "  " + iw_vt + " = ptrtoint ptr @vtable." + llvm_mangle(instr.str_val) + " to i64\n")
    iw_slot1 := "%iw.slot1." + strconv.Itoa(ti)
    write_str(fd, "  " + iw_slot1 + " = getelementptr i8, ptr " + iw_ptr + ", i64 8\n")
    write_str(fd, "  store i64 " + iw_vt + ", ptr " + iw_slot1 + "\n")
    iw_result := "%iw.result." + strconv.Itoa(ti)
    write_str(fd, "  " + iw_result + " = ptrtoint ptr " + iw_ptr + " to i64\n")
    emit_store_vreg(fd, instr.dest, iw_result)
}

fn emit_op_closure_new(fd: int, instr: IRInstr, ti: int) {
    cl_ptr := "%cl.ptr." + strconv.Itoa(ti)
    write_str(fd, "  " + cl_ptr + " = call ptr @gc_alloc(i64 16)\n")
    cl_fp := "%cl.fp." + strconv.Itoa(ti)
    write_str(fd, "  " + cl_fp + " = ptrtoint ptr @" + llvm_func_name(instr.str_val) + " to i64\n")
    write_str(fd, "  store i64 " + cl_fp + ", ptr " + cl_ptr + "\n")
    cl_env_slot := "%cl.env.slot." + strconv.Itoa(ti)
    write_str(fd, "  " + cl_env_slot + " = getelementptr i8, ptr " + cl_ptr + ", i64 8\n")
    if instr.arg1 >= 0 {
        cl_env_val := emit_load_vreg(fd, instr.arg1, ti, 0)
        write_str(fd, "  store i64 " + cl_env_val + ", ptr " + cl_env_slot + "\n")
    } else {
        write_str(fd, "  store i64 0, ptr " + cl_env_slot + "\n")
    }
    cl_result := "%cl.result." + strconv.Itoa(ti)
    write_str(fd, "  " + cl_result + " = ptrtoint ptr " + cl_ptr + " to i64\n")
    emit_store_vreg(fd, instr.dest, cl_result)
}

fn emit_function_prelude(fd: int, lname: string, param_count: int, vregs: []int) {
    params := ""
    pi := 0
    for pi < param_count {
        if pi > 0 { params = params + ", " }
        params = params + "i64 %param." + strconv.Itoa(pi)
        pi = pi + 1
    }
    write_str(fd, "define i64 @" + lname + "(" + params + ") {\n")
    vi := 0
    for vi < len(vregs) {
        write_str(fd, "  %v." + strconv.Itoa(vregs[vi]) + " = alloca i64\n")
        vi = vi + 1
    }
    pi = 0
    for pi < param_count {
        write_str(fd, "  store i64 %param." + strconv.Itoa(pi) + ", ptr %v." + strconv.Itoa(90000 + pi) + "\n")
        pi = pi + 1
    }
    write_str(fd, "  br label %B.body\n")
    write_str(fd, "B.body:\n")
}

fn emit_op_terminator(fd: int, instr: IRInstr, ti: int) -> int {
    if instr.op == ir.OP_RET {
        if instr.dest >= 0 {
            v := emit_load_vreg(fd, instr.dest, ti, 0)
            write_str(fd, "  ret i64 " + v + "\n")
        } else {
            write_str(fd, "  ret i64 0\n")
        }
        return 1
    }
    if instr.op == ir.OP_JUMP {
        write_str(fd, "  br label %L." + strconv.Itoa(instr.dest) + "\n")
        return 1
    }
    if instr.op == ir.OP_BRANCH {
        cond := emit_load_vreg(fd, instr.dest, ti, 0)
        cmp := tmp_name(ti, 1)
        write_str(fd, "  " + cmp + " = icmp eq i64 " + cond + ", 0\n")
        fall_label := "L.fall." + strconv.Itoa(ti)
        write_str(fd, "  br i1 " + cmp + ", label %L." + strconv.Itoa(instr.arg1) + ", label %" + fall_label + "\n")
        write_str(fd, fall_label + ":\n")
        return 0
    }
    if instr.op == ir.OP_TEST_FAIL {
        write_str(fd, "  call void @longjmp(ptr @ease_test_jmp_buf, i32 1)\n")
        write_str(fd, "  unreachable\n")
        return 1
    }
    return 0
}

fn emit_op_call(fd: int, instr: IRInstr, ti: int, call_args: []int) {
    callee := llvm_func_name(instr.str_val)
    args_str := ""
    ai := 0
    for ai < len(call_args) {
        if ai > 0 { args_str = args_str + ", " }
        arg_val := emit_load_vreg(fd, call_args[ai], ti, ai)
        args_str = args_str + "i64 " + arg_val
        ai = ai + 1
    }
    if instr.dest >= 0 {
        r := tmp_name(ti, 9)
        write_str(fd, "  " + r + " = call i64 @" + callee + "(" + args_str + ")\n")
        emit_store_vreg(fd, instr.dest, r)
    } else {
        write_str(fd, "  call i64 @" + callee + "(" + args_str + ")\n")
    }
}

fn emit_op_iface_call(fd: int, instr: IRInstr, ti: int, call_args: []int) {
    ic_iface := "%ic.iface." + strconv.Itoa(ti)
    ic_iface_val := emit_load_vreg(fd, call_args[0], ti, 0)
    write_str(fd, "  " + ic_iface + " = inttoptr i64 " + ic_iface_val + " to ptr\n")
    ic_concrete := "%ic.concrete." + strconv.Itoa(ti)
    write_str(fd, "  " + ic_concrete + " = load i64, ptr " + ic_iface + "\n")
    ic_vt_slot := "%ic.vt.slot." + strconv.Itoa(ti)
    write_str(fd, "  " + ic_vt_slot + " = getelementptr i8, ptr " + ic_iface + ", i64 8\n")
    ic_vt := "%ic.vt." + strconv.Itoa(ti)
    write_str(fd, "  " + ic_vt + " = load i64, ptr " + ic_vt_slot + "\n")
    ic_vt_ptr := "%ic.vt.ptr." + strconv.Itoa(ti)
    write_str(fd, "  " + ic_vt_ptr + " = inttoptr i64 " + ic_vt + " to ptr\n")
    ic_fp_offset := instr.arg1 * 8
    ic_fp_slot := "%ic.fp.slot." + strconv.Itoa(ti)
    write_str(fd, "  " + ic_fp_slot + " = getelementptr i8, ptr " + ic_vt_ptr + ", i64 " + strconv.Itoa(ic_fp_offset) + "\n")
    ic_fp := "%ic.fp." + strconv.Itoa(ti)
    write_str(fd, "  " + ic_fp + " = load i64, ptr " + ic_fp_slot + "\n")
    ic_fn := "%ic.fn." + strconv.Itoa(ti)
    write_str(fd, "  " + ic_fn + " = inttoptr i64 " + ic_fp + " to ptr\n")
    ic_args_str := "i64 " + ic_concrete
    ic_ai := 1
    for ic_ai < len(call_args) {
        ic_arg_val := emit_load_vreg(fd, call_args[ic_ai], ti, ic_ai)
        ic_args_str = ic_args_str + ", i64 " + ic_arg_val
        ic_ai = ic_ai + 1
    }
    ic_result := "%ic.result." + strconv.Itoa(ti)
    write_str(fd, "  " + ic_result + " = call i64 " + ic_fn + "(" + ic_args_str + ")\n")
    emit_store_vreg(fd, instr.dest, ic_result)
}

fn emit_op_closure_call(fd: int, instr: IRInstr, ti: int, call_args: []int) {
    cc_obj := "%cc.obj." + strconv.Itoa(ti)
    cc_obj_val := emit_load_vreg(fd, instr.arg1, ti, 0)
    write_str(fd, "  " + cc_obj + " = inttoptr i64 " + cc_obj_val + " to ptr\n")
    cc_fp := "%cc.fp." + strconv.Itoa(ti)
    write_str(fd, "  " + cc_fp + " = load i64, ptr " + cc_obj + "\n")
    cc_fn := "%cc.fn." + strconv.Itoa(ti)
    write_str(fd, "  " + cc_fn + " = inttoptr i64 " + cc_fp + " to ptr\n")
    cc_env_slot := "%cc.env.slot." + strconv.Itoa(ti)
    write_str(fd, "  " + cc_env_slot + " = getelementptr i8, ptr " + cc_obj + ", i64 8\n")
    cc_env := "%cc.env." + strconv.Itoa(ti)
    write_str(fd, "  " + cc_env + " = load i64, ptr " + cc_env_slot + "\n")
    cc_args_str := "i64 " + cc_env
    cc_ai := 0
    for cc_ai < len(call_args) {
        cc_arg_val := emit_load_vreg(fd, call_args[cc_ai], ti, cc_ai + 1)
        cc_args_str = cc_args_str + ", i64 " + cc_arg_val
        cc_ai = cc_ai + 1
    }
    cc_result := "%cc.result." + strconv.Itoa(ti)
    write_str(fd, "  " + cc_result + " = call i64 " + cc_fn + "(" + cc_args_str + ")\n")
    emit_store_vreg(fd, instr.dest, cc_result)
}

fn emit_llvm_function(fd: int, instrs: []IRInstr, start: int, end_pos: int, func_name: string, param_count: int, string_table: []string, string_dests: []int) {
    vregs := collect_vregs(instrs, start, end_pos, param_count)
    emit_function_prelude(fd, llvm_func_name(func_name), param_count, vregs)

    // Emit instructions
    terminated := 0
    call_args := []int{}
    ii := start
    for ii < end_pos {
        instr := instrs[ii]
        ti := ii

        if instr.op == ir.OP_LABEL && instr.str_val == "" {
            // Basic block label
            if terminated == 0 {
                write_str(fd, "  br label %L." + strconv.Itoa(instr.dest) + "\n")
            }
            write_str(fd, "L." + strconv.Itoa(instr.dest) + ":\n")
            terminated = 0
        }

        if terminated == 0 && instr.op == ir.OP_LOADCONST { emit_op_loadconst(fd, instr, ti, string_dests) }
        if terminated == 0 && instr.op == ir.OP_LOAD_GLOBAL { emit_op_load_global(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_ADD { emit_op_add(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_SUB { emit_llvm_binop(fd, instr, "sub", ti) }
        if terminated == 0 && instr.op == ir.OP_MUL { emit_llvm_binop(fd, instr, "mul", ti) }
        if terminated == 0 && instr.op == ir.OP_DIV { emit_llvm_binop(fd, instr, "sdiv", ti) }
        if terminated == 0 && instr.op == ir.OP_MOD { emit_llvm_binop(fd, instr, "srem", ti) }
        if terminated == 0 && instr.op == ir.OP_AND { emit_llvm_binop(fd, instr, "and", ti) }
        if terminated == 0 && instr.op == ir.OP_OR { emit_llvm_binop(fd, instr, "or", ti) }
        if terminated == 0 && instr.op == ir.OP_XOR { emit_llvm_binop(fd, instr, "xor", ti) }
        if terminated == 0 && instr.op == ir.OP_BITAND { emit_llvm_binop(fd, instr, "and", ti) }
        if terminated == 0 && instr.op == ir.OP_BITOR { emit_llvm_binop(fd, instr, "or", ti) }

        if terminated == 0 && instr.op == ir.OP_NOT { emit_op_not(fd, instr, ti) }

        if terminated == 0 && instr.op == ir.OP_CMP_EQ { emit_llvm_cmp(fd, instr, "eq", ti) }
        if terminated == 0 && instr.op == ir.OP_CMP_NE { emit_llvm_cmp(fd, instr, "ne", ti) }
        if terminated == 0 && instr.op == ir.OP_CMP_LT { emit_llvm_cmp(fd, instr, "slt", ti) }
        if terminated == 0 && instr.op == ir.OP_CMP_LE { emit_llvm_cmp(fd, instr, "sle", ti) }
        if terminated == 0 && instr.op == ir.OP_CMP_GT { emit_llvm_cmp(fd, instr, "sgt", ti) }
        if terminated == 0 && instr.op == ir.OP_CMP_GE { emit_llvm_cmp(fd, instr, "sge", ti) }

        if terminated == 0 && instr.op == ir.OP_LOAD { emit_op_load(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_STORE { emit_op_store(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_STORE_INDEX { emit_op_store_index(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_COPY { emit_op_copy(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_ALLOCA { emit_op_alloca(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_INDEXADDR { emit_op_indexaddr(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_MEMCOPY { emit_op_memcopy(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_ARRAY_LEN { emit_op_array_len(fd, instr, ti) }

        if terminated == 0 && instr.op == ir.OP_ARRAY_SLICE { emit_op_array_slice(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_REFLECT_NUM_FIELD { emit_op_reflect_num_field(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_REFLECT_FIELD_NAME { emit_op_reflect_field_name(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_REFLECT_FIELD_TYPE { emit_op_reflect_field_type(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_REFLECT_FIELD_VALUE { emit_op_reflect_field_value(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_REFLECT_SET_FIELD_VALUE { emit_op_reflect_set_field_value(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_JSON_MARSHAL { emit_json_marshal(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_JSON_UNMARSHAL { emit_json_unmarshal(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_STR_LEN { emit_op_str_len(fd, instr, ti) }

        if terminated == 0 && instr.op == ir.OP_ARRAY_PUSH { emit_op_array_push(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_POKE { emit_op_poke(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_PEEK { emit_op_peek(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_HEAP_ALLOC { emit_op_heap_alloc(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_ARGC { emit_op_argc(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_ARGV { emit_op_argv(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_INT_TO_STR { emit_op_int_to_str(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_BOOL_TO_STR { emit_op_bool_to_str(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_STR_EQ { emit_op_str_eq(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_STR_NE { emit_op_str_ne(fd, instr, ti) }

        if terminated == 0 && instr.op == ir.OP_STR_CONCAT { emit_op_str_concat(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_STR_CHAR_AT { emit_op_str_char_at(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_SYSCALL_OPEN { emit_op_syscall_open(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_SYSCALL_WRITE { emit_op_syscall_write(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_SYSCALL_CLOSE { emit_op_syscall_close(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_SYSCALL_READ { emit_op_syscall_read(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_IS_DIR { emit_op_is_dir(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_LIST_DIR { emit_op_list_dir(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_SETJMP { emit_op_setjmp(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_TIME_NANOS { emit_op_clock_gettime(fd, instr, ti, "6") }
        if terminated == 0 && instr.op == ir.OP_TIME_WALLCLOCK { emit_op_clock_gettime(fd, instr, ti, "0") }
        if terminated == 0 && instr.op == ir.OP_GC_COLLECT { emit_op_gc_collect(fd, instr, ti) }

        if terminated == 0 && instr.op == ir.OP_ARG {
            // Collect argument for next call
            call_args = append(call_args, instr.arg1)
        }

        if terminated == 0 && instr.op == ir.OP_CALL {
            emit_op_call(fd, instr, ti, call_args)
            call_args = []int{}
        }
        if terminated == 0 && instr.op == ir.OP_IFACE_WRAP { emit_op_iface_wrap(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_IFACE_CALL {
            emit_op_iface_call(fd, instr, ti, call_args)
            call_args = []int{}
        }
        if terminated == 0 && instr.op == ir.OP_CLOSURE_NEW { emit_op_closure_new(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_CLOSURE_CALL {
            emit_op_closure_call(fd, instr, ti, call_args)
            call_args = []int{}
        }

        if terminated == 0 && instr.op == ir.OP_MAP_NEW { emit_op_map_new(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_MAP_GET { emit_op_map_call(fd, instr, ti, "maps_Get", 1) }
        if terminated == 0 && instr.op == ir.OP_MAP_SET { emit_op_map_set(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_MAP_DELETE { emit_op_map_call(fd, instr, ti, "maps_Delete", 1) }
        if terminated == 0 && instr.op == ir.OP_MAP_LEN { emit_op_map_call(fd, instr, ti, "maps_Len", 0) }
        if terminated == 0 && instr.op == ir.OP_MAP_HAS { emit_op_map_call(fd, instr, ti, "maps_Has", 1) }
        if terminated == 0 && instr.op == ir.OP_LOADFLOAT { emit_op_loadfloat(fd, instr, ti) }
        if terminated == 0 && (instr.op == ir.OP_FADD || instr.op == ir.OP_FSUB || instr.op == ir.OP_FMUL || instr.op == ir.OP_FDIV || instr.op == ir.OP_FMOD) { emit_op_fbinop(fd, instr, ti) }
        if terminated == 0 && (instr.op == ir.OP_FCMP_LT || instr.op == ir.OP_FCMP_GT || instr.op == ir.OP_FCMP_LE || instr.op == ir.OP_FCMP_GE || instr.op == ir.OP_FCMP_EQ || instr.op == ir.OP_FCMP_NE) { emit_op_fcmp(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_INT_TO_FLOAT { emit_op_int_to_float(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_FLOAT_TO_INT { emit_op_float_to_int(fd, instr, ti) }
        if terminated == 0 && instr.op == ir.OP_FLOAT_TO_STR { emit_op_float_to_str(fd, instr, ti) }

        if terminated == 0 && (instr.op == ir.OP_RET || instr.op == ir.OP_JUMP || instr.op == ir.OP_BRANCH || instr.op == ir.OP_TEST_FAIL) {
            terminated = emit_op_terminator(fd, instr, ti)
        }

        ii = ii + 1
    }

    // If function didn't end with a terminator, add default return
    if terminated == 0 {
        write_str(fd, "  ret i64 0\n")
    }

    write_str(fd, "}\n\n")
}

fn print_hex(val: int) {
    v := val
    digits := []int{}
    hex_i := 0
    for hex_i < 8 {
        digits = append(digits, v - ((v / 16) * 16))
        v = v / 16
        hex_i = hex_i + 1
    }
    pri := 0
    for pri < 8 {
        d := digits[7 - pri]
        if d < 10 {
            print(strconv.Itoa(d))
        } else {
            if d == 10 { print("a") }
            if d == 11 { print("b") }
            if d == 12 { print("c") }
            if d == 13 { print("d") }
            if d == 14 { print("e") }
            if d == 15 { print("f") }
        }
        pri = pri + 1
    }
}
