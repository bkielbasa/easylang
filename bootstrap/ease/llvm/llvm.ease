    write_str(fd, "  " + offset + " = mul i64 " + idx + ", 8\n")
    addr := tmp_name(ti, 3)
    write_str(fd, "  " + addr + " = add i64 " + base + ", " + offset + "\n")
    ptr := tmp_name(ti, 4)
    write_str(fd, "  " + ptr + " = inttoptr i64 " + addr + " to ptr\n")
    val := tmp_name(ti, 5)
    write_str(fd, "  " + val + " = load i64, ptr " + ptr + "\n")
    emit_store_vreg(fd, instr.dest, val)
