package llvm

// LLVM IR code generation for the Ease bootstrap compiler
//
// Strategy: translate bootstrap IR to LLVM IR text, delegate all builtins
// to the C runtime (ease_runtime.c). clang compiles the .ll to native binary.
//
// Design: all values are i64. Pointers are integers (ptrtoint/inttoptr).
// Each virtual register gets an alloca i64 slot; clang -O1 mem2reg pass
// promotes these to SSA registers automatically.

fn write_str(fd: int, s: string) {
    syscall.write(fd, s, len(s))
}

fn hex_digit_char(v: int) -> string {
    if v == 0 { return "0" }
    if v == 1 { return "1" }
    if v == 2 { return "2" }
    if v == 3 { return "3" }
    if v == 4 { return "4" }
    if v == 5 { return "5" }
    if v == 6 { return "6" }
    if v == 7 { return "7" }
    if v == 8 { return "8" }
    if v == 9 { return "9" }
    if v == 10 { return "A" }
    if v == 11 { return "B" }
    if v == 12 { return "C" }
    if v == 13 { return "D" }
    if v == 14 { return "E" }
    if v == 15 { return "F" }
    return "0"
}

fn hex_byte_str(v: int) -> string {
    hi := v / 16
    lo := v - hi * 16
    return hex_digit_char(hi) + hex_digit_char(lo)
}

fn llvm_escape_string(s: string) -> string {
    result := "c\""
    i := 0
    slen := len(s)
    for i < slen {
        ch := str_char_at(s, i)
        if ch >= 32 && ch < 127 && ch != 34 && ch != 92 {
            result = result + str_substring(s, i, i + 1)
        } else {
            hbs := hex_byte_str(ch)
            result = result + "\\" + hbs
        }
        i = i + 1
    }
    result = result + "\\00\""
    return result
}

fn llvm_mangle(name: string) -> string {
    result := ""
    i := 0
    slen := len(name)
    for i < slen {
        ch := str_char_at(name, i)
        if ch == 46 {
            result = result + "_"
        } else {
            result = result + str_substring(name, i, i + 1)
        }
        i = i + 1
    }
    return result
}

fn llvm_func_name(name: string) -> string {
    if name == "main" {
        return "ease_user_main"
    }
    return llvm_mangle(name)
}

fn add_unique(arr: []int, val: int) {
    i := 0
    for i < len(arr) {
        if arr[i] == val { return }
        i = i + 1
    }
    push(arr, val)
}

fn tmp_name(ti: int, sub: int) -> string {
    return "%t." + strconv.Itoa(ti * 10 + sub)
}

fn emit_load_vreg(fd: int, vreg: int, ti: int, sub: int) -> string {
    name := tmp_name(ti, sub)
    write_str(fd, "  " + name + " = load i64, ptr %v." + strconv.Itoa(vreg) + "\n")
    return name
}

fn emit_load_ptr(fd: int, vreg: int, ti: int, s1: int, s2: int) -> string {
    val := emit_load_vreg(fd, vreg, ti, s1)
    name := tmp_name(ti, s2)
    write_str(fd, "  " + name + " = inttoptr i64 " + val + " to ptr\n")
    return name
}

fn emit_store_vreg(fd: int, vreg: int, val: string) {
    write_str(fd, "  store i64 " + val + ", ptr %v." + strconv.Itoa(vreg) + "\n")
}

fn emit_load_safe_str(fd: int, vreg: int, ti: int, s1: int, s2: int, s3: int) -> string {
    // Load pointer from vreg, replace NULL with @.str.empty
    val := emit_load_vreg(fd, vreg, ti, s1)
    raw := tmp_name(ti, s2)
    write_str(fd, "  " + raw + " = inttoptr i64 " + val + " to ptr\n")
    is_null := "%ns." + strconv.Itoa(ti) + "." + strconv.Itoa(s3)
    write_str(fd, "  " + is_null + " = icmp eq ptr " + raw + ", null\n")
    safe := "%ss." + strconv.Itoa(ti) + "." + strconv.Itoa(s3)
    write_str(fd, "  " + safe + " = select i1 " + is_null + ", ptr @.str.empty, ptr " + raw + "\n")
    return safe
}

fn emit_ptrtoint_store(fd: int, vreg: int, ptr_val: string, ti: int, sub: int) {
    name := tmp_name(ti, sub)
    write_str(fd, "  " + name + " = ptrtoint ptr " + ptr_val + " to i64\n")
    emit_store_vreg(fd, vreg, name)
}

fn emit_llvm_binop(fd: int, instr: IRInstr, op: string, ti: int) {
    lhs := emit_load_vreg(fd, instr.arg1, ti, 0)
    rhs := emit_load_vreg(fd, instr.arg2, ti, 1)
    result := tmp_name(ti, 2)
    write_str(fd, "  " + result + " = " + op + " i64 " + lhs + ", " + rhs + "\n")
    emit_store_vreg(fd, instr.dest, result)
}

fn emit_llvm_cmp(fd: int, instr: IRInstr, pred: string, ti: int) {
    lhs := emit_load_vreg(fd, instr.arg1, ti, 0)
    rhs := emit_load_vreg(fd, instr.arg2, ti, 1)
    cmp := tmp_name(ti, 2)
    write_str(fd, "  " + cmp + " = icmp " + pred + " i64 " + lhs + ", " + rhs + "\n")
    ext := tmp_name(ti, 3)
    write_str(fd, "  " + ext + " = zext i1 " + cmp + " to i64\n")
    emit_store_vreg(fd, instr.dest, ext)
}

fn emit_llvm_decls(fd: int) {
    // Memory allocation
    write_str(fd, "declare ptr @malloc(i64)\n")
    write_str(fd, "declare ptr @calloc(i64, i64)\n")
    write_str(fd, "declare ptr @memcpy(ptr, ptr, i64)\n")
    write_str(fd, "declare ptr @memset(ptr, i32, i64)\n")
    // String operations (libc)
    write_str(fd, "declare i32 @strcmp(ptr, ptr)\n")
    write_str(fd, "declare i64 @strlen(ptr)\n")
    write_str(fd, "declare i32 @snprintf(ptr, i64, ptr, ...)\n")
    // POSIX I/O (libc)
    write_str(fd, "declare i32 @open(ptr, i32, ...)\n")
    write_str(fd, "declare i64 @read(i32, ptr, i64)\n")
    write_str(fd, "declare i64 @write(i32, ptr, i64)\n")
    write_str(fd, "declare i32 @close(i32)\n")
    // Directory operations (libc, macOS mangled names)
    write_str(fd, "declare i32 @\"\\01_stat\"(ptr, ptr)\n")
    write_str(fd, "declare ptr @\"\\01_opendir\"(ptr)\n")
    write_str(fd, "declare ptr @\"\\01_readdir\"(ptr)\n")
    write_str(fd, "declare i32 @\"\\01_closedir\"(ptr)\n")
    // Testing support (libc)
    write_str(fd, "declare i32 @setjmp(ptr) #0\n")
    write_str(fd, "declare void @longjmp(ptr, i32)\n")
    // Time (libc)
    write_str(fd, "declare i32 @clock_gettime(i32, ptr)\n")
    // Globals
    write_str(fd, "@ease_test_jmp_buf = global [37 x i64] zeroinitializer\n")
    write_str(fd, "@g_argc = global i64 0\n")
    write_str(fd, "@g_argv = global ptr null\n")
    write_str(fd, "@.fmt.ld = private unnamed_addr constant [4 x i8] c\"%ld\\00\"\n")
    write_str(fd, "@.fmt.g = private unnamed_addr constant [5 x i8] c\"%.6g\\00\"\n")
    write_str(fd, "@.str.empty = private unnamed_addr constant [1 x i8] c\"\\00\"\n")
    write_str(fd, "@.str.true = private unnamed_addr constant [5 x i8] c\"true\\00\"\n")
    write_str(fd, "@.str.false = private unnamed_addr constant [6 x i8] c\"false\\00\"\n")
    write_str(fd, "attributes #0 = { returns_twice }\n")
    write_str(fd, "\n")
}

fn collect_vregs(instrs: []IRInstr, start: int, end_pos: int, param_count: int) -> []int {
    vregs := []int{}
    p := 0
    for p < param_count {
        add_unique(vregs, 90000 + p)
        p = p + 1
    }
    i := start
    for i < end_pos {
        instr := instrs[i]
        op := instr.op
        // dest is vreg for result-producing operations
        if op == OP_LOADCONST || op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV || op == OP_CMP_LT || op == OP_CMP_GT || op == OP_CMP_LE || op == OP_CMP_GE || op == OP_CMP_EQ || op == OP_CMP_NE || op == OP_AND || op == OP_OR || op == OP_NOT || op == OP_XOR || op == OP_BITAND || op == OP_BITOR || op == OP_ALLOCA || op == OP_LOAD || op == OP_INDEXADDR || op == OP_ARRAY_LEN || op == OP_STR_LEN || op == OP_STR_CHAR_AT || op == OP_PEEK || op == OP_HEAP_ALLOC || op == OP_CALL || op == OP_ARGC || op == OP_ARGV || op == OP_INT_TO_STR || op == OP_STR_EQ || op == OP_STR_NE || op == OP_STR_CONCAT || op == OP_LOAD_GLOBAL || op == OP_SYSCALL_OPEN || op == OP_SYSCALL_WRITE || op == OP_SYSCALL_CLOSE || op == OP_SYSCALL_READ || op == OP_IS_DIR || op == OP_LIST_DIR || op == OP_SETJMP || op == OP_TIME_NANOS || op == OP_TIME_WALLCLOCK || op == OP_IFACE_WRAP || op == OP_IFACE_CALL || op == OP_MAP_NEW || op == OP_MAP_GET || op == OP_MAP_SET || op == OP_MAP_DELETE || op == OP_MAP_LEN || op == OP_MAP_HAS || op == OP_CLOSURE_NEW || op == OP_CLOSURE_CALL || op == OP_LOADFLOAT || op == OP_FADD || op == OP_FSUB || op == OP_FMUL || op == OP_FDIV || op == OP_FMOD || op == OP_FCMP_LT || op == OP_FCMP_GT || op == OP_FCMP_LE || op == OP_FCMP_GE || op == OP_FCMP_EQ || op == OP_FCMP_NE || op == OP_FLOAT_TO_STR || op == OP_INT_TO_FLOAT || op == OP_FLOAT_TO_INT || op == OP_BOOL_TO_STR {
            if instr.dest >= 0 { add_unique(vregs, instr.dest) }
        }
        // RET dest is vreg
        if op == OP_RET && instr.dest >= 0 { add_unique(vregs, instr.dest) }
        // BRANCH dest is vreg (condition)
        if op == OP_BRANCH && instr.dest >= 0 { add_unique(vregs, instr.dest) }
        // COPY: dest=target, arg1=source
        if op == OP_COPY {
            if instr.dest >= 0 { add_unique(vregs, instr.dest) }
            if instr.arg1 >= 0 { add_unique(vregs, instr.arg1) }
        }
        // arg1 is vreg for most ops (not LOADCONST, ALLOCA, LABEL, JUMP, BRANCH, ARGC, CALL)
        if op != OP_LOADCONST && op != OP_LOAD_GLOBAL && op != OP_ALLOCA && op != OP_LABEL && op != OP_JUMP && op != OP_BRANCH && op != OP_ARGC && op != OP_TIME_NANOS && op != OP_TIME_WALLCLOCK && op != OP_CALL && op != OP_IFACE_CALL && op != OP_CLOSURE_CALL && op != OP_MAP_NEW && op != OP_LOADFLOAT {
            if instr.arg1 >= 0 { add_unique(vregs, instr.arg1) }
        }
        // arg2 is vreg for binary ops, STORE, ARRAY_PUSH, POKE, STR_EQ/NE, STR_CHAR_AT, etc
        if op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV || op == OP_CMP_LT || op == OP_CMP_GT || op == OP_CMP_LE || op == OP_CMP_GE || op == OP_CMP_EQ || op == OP_CMP_NE || op == OP_AND || op == OP_OR || op == OP_XOR || op == OP_BITAND || op == OP_BITOR || op == OP_STORE || op == OP_ARRAY_PUSH || op == OP_POKE || op == OP_STR_EQ || op == OP_STR_NE || op == OP_STR_CONCAT || op == OP_STR_CHAR_AT || op == OP_MEMCOPY || op == OP_SYSCALL_OPEN || op == OP_SYSCALL_WRITE || op == OP_SYSCALL_CLOSE || op == OP_SYSCALL_READ || op == OP_STORE_INDEX || op == OP_MAP_GET || op == OP_MAP_SET || op == OP_MAP_DELETE || op == OP_MAP_HAS || op == OP_FADD || op == OP_FSUB || op == OP_FMUL || op == OP_FDIV || op == OP_FMOD || op == OP_FCMP_LT || op == OP_FCMP_GT || op == OP_FCMP_LE || op == OP_FCMP_GE || op == OP_FCMP_EQ || op == OP_FCMP_NE {
            if instr.arg2 >= 0 { add_unique(vregs, instr.arg2) }
        }
        // MEMCOPY arg3 is vreg (size)
        if op == OP_MEMCOPY && instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        // SYSCALL_OPEN arg3 is vreg (mode), SYSCALL_READ arg3 is vreg (size)
        if (op == OP_SYSCALL_OPEN || op == OP_SYSCALL_READ) && instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        // STORE_INDEX arg3 is vreg (value), MAP_SET arg3 is vreg (value)
        if (op == OP_STORE_INDEX || op == OP_MAP_SET) && instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        i = i + 1
    }
    return vregs
}

fn emit_llvm_ir(instrs: []IRInstr, output_path: string) -> int {
    fd := syscall.open(output_path, 1537, 420)
    if fd < 0 {
        print("ERROR: Failed to open output file: " + output_path + "\n")
        return 1
    }

    // Pass 1: Collect string constants
    string_table := []string{}
    string_dests := []int{}
    si := 0
    for si < len(instrs) {
        if instrs[si].op == OP_LOADCONST {
            if instrs[si].str_val != "" {
                push(string_table, instrs[si].str_val)
                push(string_dests, instrs[si].dest)
            }
        }
        si = si + 1
    }

    // Emit string constants
    sci := 0
    for sci < len(string_table) {
        s := string_table[sci]
        escaped := llvm_escape_string(s)
        write_str(fd, "@.str." + strconv.Itoa(sci) + " = private unnamed_addr constant [" + strconv.Itoa(len(s) + 1) + " x i8] " + escaped + "\n")
        sci = sci + 1
    }
    if len(string_table) > 0 {
        write_str(fd, "\n")
    }

    // Pass 1b: Collect global variables from OP_LOAD_GLOBAL instructions
    global_names := []string{}
    gi := 0
    for gi < len(instrs) {
        if instrs[gi].op == OP_LOAD_GLOBAL {
            gname := instrs[gi].str_val
            // Check if already collected
            found := 0
            gj := 0
            for gj < len(global_names) {
                if global_names[gj] == gname {
                    found = 1
                    break
                }
                gj = gj + 1
            }
            if found == 0 {
                push(global_names, gname)
            }
        }
        gi = gi + 1
    }

    // Emit global variable declarations
    gdi := 0
    for gdi < len(global_names) {
        if is_scalar_global(global_names[gdi]) == 1 {
            write_str(fd, "@" + global_names[gdi] + " = global i64 0\n")
        } else {
            write_str(fd, "@" + global_names[gdi] + " = global [24 x i8] zeroinitializer\n")
        }
        gdi = gdi + 1
    }
    if len(global_names) > 0 {
        write_str(fd, "\n")
    }

    // Emit vtable globals
    vti := 0
    for vti < VtableCount() {
        vt_iname := VtableIfaceName(vti)
        vt_sname := VtableStructName(vti)
        vt_mc := iface_method_count(vt_iname)
        vt_size := vt_mc * 8
        write_str(fd, "@vtable." + llvm_mangle(vt_iname + "." + vt_sname) + " = global [" + strconv.Itoa(vt_size) + " x i8] zeroinitializer\n")
        vti = vti + 1
    }
    if VtableCount() > 0 {
        write_str(fd, "\n")
    }

    // Emit runtime declarations
    emit_llvm_decls(fd)

    // Emit helper functions (dir ops)
    emit_llvm_helpers(fd)

    // Pass 2: Emit functions
    fi := 0
    instrs_len := len(instrs)
    for fi < instrs_len {
        if instrs[fi].op == OP_LABEL && instrs[fi].str_val != "" {
            func_name := instrs[fi].str_val
            param_count := instrs[fi].arg1
            func_start := fi + 1

            // Find function end
            func_end := instrs_len
            fj := fi + 1
            for fj < instrs_len {
                if instrs[fj].op == OP_LABEL && instrs[fj].str_val != "" {
                    func_end = fj
                    break
                }
                fj = fj + 1
            }

            // Emit function
            emit_llvm_function(fd, instrs, func_start, func_end, func_name, param_count, string_table, string_dests)

            fi = func_end
        } else {
            fi = fi + 1
        }
    }

    // Emit vtable init function
    emit_llvm_vtable_init(fd)

    // Emit @main wrapper that stores argc/argv and calls ease_user_main
    emit_llvm_main_wrapper(fd)

    syscall.close(fd)
    // Generated LLVM IR
    return 0
}

fn emit_llvm_helpers(fd: int) {
    // ease_is_dir: check if path is a directory using stat()
    // macOS ARM64: struct stat = 144 bytes, st_mode at offset 4 (u16), S_IFDIR=0x4000, S_IFMT=0xF000
    write_str(fd, "define i64 @ease_is_dir(ptr %path) {\n")
    write_str(fd, "  %st = alloca [144 x i8]\n")
    write_str(fd, "  %rc = call i32 @\"\\01_stat\"(ptr %path, ptr %st)\n")
    write_str(fd, "  %fail = icmp ne i32 %rc, 0\n")
    write_str(fd, "  br i1 %fail, label %ret0, label %check\n")
    write_str(fd, "check:\n")
    write_str(fd, "  %mode_ptr = getelementptr i8, ptr %st, i64 4\n")
    write_str(fd, "  %mode16 = load i16, ptr %mode_ptr\n")
    write_str(fd, "  %mode = zext i16 %mode16 to i32\n")
    write_str(fd, "  %masked = and i32 %mode, 61440\n")
    write_str(fd, "  %isdir = icmp eq i32 %masked, 16384\n")
    write_str(fd, "  br i1 %isdir, label %ret1, label %ret0\n")
    write_str(fd, "ret1:\n")
    write_str(fd, "  ret i64 1\n")
    write_str(fd, "ret0:\n")
    write_str(fd, "  ret i64 0\n")
    write_str(fd, "}\n\n")

    // ease_list_dir: list directory entries separated by newlines
    // macOS ARM64: struct dirent d_name at offset 21
    write_str(fd, "define ptr @ease_list_dir(ptr %path) {\n")
    write_str(fd, "  %d = call ptr @\"\\01_opendir\"(ptr %path)\n")
    write_str(fd, "  %dnull = icmp eq ptr %d, null\n")
    write_str(fd, "  br i1 %dnull, label %ld.empty, label %ld.loop\n")
    write_str(fd, "ld.empty:\n")
    write_str(fd, "  %empty = call ptr @malloc(i64 1)\n")
    write_str(fd, "  store i8 0, ptr %empty\n")
    write_str(fd, "  ret ptr %empty\n")
    write_str(fd, "ld.loop:\n")
    // Accumulate result string - start with empty
    write_str(fd, "  %res0 = call ptr @malloc(i64 1)\n")
    write_str(fd, "  store i8 0, ptr %res0\n")
    write_str(fd, "  br label %ld.next\n")
    write_str(fd, "ld.next:\n")
    write_str(fd, "  %res = phi ptr [ %res0, %ld.loop ], [ %newres, %ld.append ], [ %res, %ld.dotcheck ], [ %res, %ld.dotdot2 ]\n")
    write_str(fd, "  %ent = call ptr @\"\\01_readdir\"(ptr %d)\n")
    write_str(fd, "  %enull = icmp eq ptr %ent, null\n")
    write_str(fd, "  br i1 %enull, label %ld.done, label %ld.check\n")
    write_str(fd, "ld.check:\n")
    // Get d_name at offset 21
    write_str(fd, "  %name = getelementptr i8, ptr %ent, i64 21\n")
    // Skip "." and ".."
    write_str(fd, "  %c0 = load i8, ptr %name\n")
    write_str(fd, "  %isdot = icmp eq i8 %c0, 46\n")
    write_str(fd, "  br i1 %isdot, label %ld.dotcheck, label %ld.append\n")
    write_str(fd, "ld.dotcheck:\n")
    write_str(fd, "  %c1ptr = getelementptr i8, ptr %name, i64 1\n")
    write_str(fd, "  %c1 = load i8, ptr %c1ptr\n")
    // "." entry: c1 == 0
    write_str(fd, "  %isdot1 = icmp eq i8 %c1, 0\n")
    write_str(fd, "  br i1 %isdot1, label %ld.next, label %ld.dotdot\n")
    write_str(fd, "ld.dotdot:\n")
    // ".." entry: c1 == '.' and c2 == 0
    write_str(fd, "  %isdot2 = icmp eq i8 %c1, 46\n")
    write_str(fd, "  br i1 %isdot2, label %ld.dotdot2, label %ld.append\n")
    write_str(fd, "ld.dotdot2:\n")
    write_str(fd, "  %c2ptr = getelementptr i8, ptr %name, i64 2\n")
    write_str(fd, "  %c2 = load i8, ptr %c2ptr\n")
    write_str(fd, "  %isdotdot = icmp eq i8 %c2, 0\n")
    write_str(fd, "  br i1 %isdotdot, label %ld.next, label %ld.append\n")
    // Append: result = result + name + "\n"
    write_str(fd, "ld.append:\n")
    write_str(fd, "  %rname = phi ptr [ %name, %ld.check ], [ %name, %ld.dotdot ], [ %name, %ld.dotdot2 ]\n")
    write_str(fd, "  %rlen = call i64 @strlen(ptr %res)\n")
    write_str(fd, "  %nlen = call i64 @strlen(ptr %rname)\n")
    write_str(fd, "  %tlen = add i64 %rlen, %nlen\n")
    write_str(fd, "  %tlen2 = add i64 %tlen, 2\n")
    write_str(fd, "  %newres = call ptr @malloc(i64 %tlen2)\n")
    write_str(fd, "  call ptr @memcpy(ptr %newres, ptr %res, i64 %rlen)\n")
    write_str(fd, "  %ndst = getelementptr i8, ptr %newres, i64 %rlen\n")
    write_str(fd, "  call ptr @memcpy(ptr %ndst, ptr %rname, i64 %nlen)\n")
    write_str(fd, "  %nlpos = add i64 %rlen, %nlen\n")
    write_str(fd, "  %nlptr = getelementptr i8, ptr %newres, i64 %nlpos\n")
    write_str(fd, "  store i8 10, ptr %nlptr\n")
    write_str(fd, "  %nulpos = add i64 %nlpos, 1\n")
    write_str(fd, "  %nulptr = getelementptr i8, ptr %newres, i64 %nulpos\n")
    write_str(fd, "  store i8 0, ptr %nulptr\n")
    write_str(fd, "  br label %ld.next\n")
    write_str(fd, "ld.done:\n")
    write_str(fd, "  call i32 @\"\\01_closedir\"(ptr %d)\n")
    write_str(fd, "  ret ptr %res\n")
    write_str(fd, "}\n\n")
}

fn emit_llvm_vtable_init(fd: int) {
    if VtableCount() == 0 { return }
    write_str(fd, "define void @ease_init_vtables() {\n")
    vti := 0
    for vti < VtableCount() {
        vt_sname := VtableStructName(vti)
        vt_iname := VtableIfaceName(vti)
        vt_mc := iface_method_count(vt_iname)
        vt_global := "@vtable." + llvm_mangle(vt_iname + "." + vt_sname)
        mi := 0
        for mi < vt_mc {
            mname := iface_method_name(vt_iname, mi)
            func_name := lookup_method(vt_sname, mname)
            if func_name != "" {
                actual := lookup_rename(func_name)
                llvm_name := llvm_func_name(actual)
                fp_name := "%vt.fp." + strconv.Itoa(vti) + "." + strconv.Itoa(mi)
                write_str(fd, "  " + fp_name + " = ptrtoint ptr @" + llvm_name + " to i64\n")
                if mi == 0 {
                    write_str(fd, "  store i64 " + fp_name + ", ptr " + vt_global + "\n")
                } else {
                    slot_name := "%vt.slot." + strconv.Itoa(vti) + "." + strconv.Itoa(mi)
                    write_str(fd, "  " + slot_name + " = getelementptr i8, ptr " + vt_global + ", i64 " + strconv.Itoa(mi * 8) + "\n")
                    write_str(fd, "  store i64 " + fp_name + ", ptr " + slot_name + "\n")
                }
            }
            mi = mi + 1
        }
        vti = vti + 1
    }
    write_str(fd, "  ret void\n")
    write_str(fd, "}\n\n")
}

fn emit_llvm_main_wrapper(fd: int) {
    write_str(fd, "define i32 @main(i32 %argc, ptr %argv) {\n")
    write_str(fd, "  %argc.ext = sext i32 %argc to i64\n")
    write_str(fd, "  store i64 %argc.ext, ptr @g_argc\n")
    write_str(fd, "  store ptr %argv, ptr @g_argv\n")
    if VtableCount() > 0 {
        write_str(fd, "  call void @ease_init_vtables()\n")
    }
    write_str(fd, "  %r = call i64 @ease_user_main()\n")
    write_str(fd, "  %r32 = trunc i64 %r to i32\n")
    write_str(fd, "  ret i32 %r32\n")
    write_str(fd, "}\n\n")
}

fn find_string_index(dest: int, string_dests: []int) -> int {
    i := 0
    for i < len(string_dests) {
        if string_dests[i] == dest {
            return i
        }
        i = i + 1
    }
    return -1
}

fn emit_llvm_function(fd: int, instrs: []IRInstr, start: int, end_pos: int, func_name: string, param_count: int, string_table: []string, string_dests: []int) {
    lname := llvm_func_name(func_name)

    // Build parameter list
    params := ""
    pi := 0
    for pi < param_count {
        if pi > 0 { params = params + ", " }
        params = params + "i64 %param." + strconv.Itoa(pi)
        pi = pi + 1
    }

    write_str(fd, "define i64 @" + lname + "(" + params + ") {\n")

    // Collect all vregs used
    vregs := collect_vregs(instrs, start, end_pos, param_count)

    // Emit allocas for all vregs
    vi := 0
    for vi < len(vregs) {
        write_str(fd, "  %v." + strconv.Itoa(vregs[vi]) + " = alloca i64\n")
        vi = vi + 1
    }

    // Store parameters into vreg slots (params use 90000+ offset vregs)
    pi = 0
    for pi < param_count {
        write_str(fd, "  store i64 %param." + strconv.Itoa(pi) + ", ptr %v." + strconv.Itoa(90000 + pi) + "\n")
        pi = pi + 1
    }

    // Branch to body
    write_str(fd, "  br label %B.body\n")
    write_str(fd, "B.body:\n")

    // Emit instructions
    terminated := 0
    call_args := []int{}
    ii := start
    for ii < end_pos {
        instr := instrs[ii]
        ti := ii

        if instr.op == OP_LABEL && instr.str_val == "" {
            // Basic block label
            if terminated == 0 {
                write_str(fd, "  br label %L." + strconv.Itoa(instr.dest) + "\n")
            }
            write_str(fd, "L." + strconv.Itoa(instr.dest) + ":\n")
            terminated = 0
        }

        if terminated == 0 && instr.op == OP_LOADCONST {
            if instr.str_val != "" {
                // String constant
                str_idx := find_string_index(instr.dest, string_dests)
                if str_idx >= 0 {
                    t := tmp_name(ti, 0)
                    write_str(fd, "  " + t + " = ptrtoint ptr @.str." + strconv.Itoa(str_idx) + " to i64\n")
                    emit_store_vreg(fd, instr.dest, t)
                }
            } else {
                // Integer constant
                emit_store_vreg(fd, instr.dest, strconv.Itoa(instr.arg1))
            }
        }

        if terminated == 0 && instr.op == OP_LOAD_GLOBAL {
            // Load address of a global variable: ptrtoint ptr @name to i64
            t := tmp_name(ti, 0)
            write_str(fd, "  " + t + " = ptrtoint ptr @" + instr.str_val + " to i64\n")
            emit_store_vreg(fd, instr.dest, t)
        }

        if terminated == 0 && instr.op == OP_ADD {
            if instr.arg2 == -1 {
                // Copy (MOV variant)
                v := emit_load_vreg(fd, instr.arg1, ti, 0)
                emit_store_vreg(fd, instr.dest, v)
            } else {
                emit_llvm_binop(fd, instr, "add", ti)
            }
        }
        if terminated == 0 && instr.op == OP_SUB { emit_llvm_binop(fd, instr, "sub", ti) }
        if terminated == 0 && instr.op == OP_MUL { emit_llvm_binop(fd, instr, "mul", ti) }
        if terminated == 0 && instr.op == OP_DIV { emit_llvm_binop(fd, instr, "sdiv", ti) }
        if terminated == 0 && instr.op == OP_MOD { emit_llvm_binop(fd, instr, "srem", ti) }
        if terminated == 0 && instr.op == OP_AND { emit_llvm_binop(fd, instr, "and", ti) }
        if terminated == 0 && instr.op == OP_OR { emit_llvm_binop(fd, instr, "or", ti) }
        if terminated == 0 && instr.op == OP_XOR { emit_llvm_binop(fd, instr, "xor", ti) }
        if terminated == 0 && instr.op == OP_BITAND { emit_llvm_binop(fd, instr, "and", ti) }
        if terminated == 0 && instr.op == OP_BITOR { emit_llvm_binop(fd, instr, "or", ti) }

        if terminated == 0 && instr.op == OP_NOT {
            v := emit_load_vreg(fd, instr.arg1, ti, 0)
            r := tmp_name(ti, 1)
            write_str(fd, "  " + r + " = xor i64 " + v + ", 1\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_CMP_EQ { emit_llvm_cmp(fd, instr, "eq", ti) }
        if terminated == 0 && instr.op == OP_CMP_NE { emit_llvm_cmp(fd, instr, "ne", ti) }
        if terminated == 0 && instr.op == OP_CMP_LT { emit_llvm_cmp(fd, instr, "slt", ti) }
        if terminated == 0 && instr.op == OP_CMP_LE { emit_llvm_cmp(fd, instr, "sle", ti) }
        if terminated == 0 && instr.op == OP_CMP_GT { emit_llvm_cmp(fd, instr, "sgt", ti) }
        if terminated == 0 && instr.op == OP_CMP_GE { emit_llvm_cmp(fd, instr, "sge", ti) }

        if terminated == 0 && instr.op == OP_LOAD {
            base := emit_load_vreg(fd, instr.arg1, ti, 0)
            // arg2: if str_val is "array_index", arg2 is a vreg; otherwise immediate offset
            addr_val := ""
            if instr.str_val == "array_index" {
                // Array indexing: base is fat pointer address, arg2 is index vreg
                // 1. Extract data pointer from fat pointer (offset 0)
                fp := tmp_name(ti, 1)
                write_str(fd, "  " + fp + " = inttoptr i64 " + base + " to ptr\n")
                dp := tmp_name(ti, 2)
                write_str(fd, "  " + dp + " = load i64, ptr " + fp + "\n")
                // 2. Scale index by element size (8 bytes for pointer-based storage)
                idx := emit_load_vreg(fd, instr.arg2, ti, 3)
                scaled := tmp_name(ti, 4)
                write_str(fd, "  " + scaled + " = mul i64 " + idx + ", 8\n")
                // 3. Calculate element address
                a := tmp_name(ti, 5)
                write_str(fd, "  " + a + " = add i64 " + dp + ", " + scaled + "\n")
                addr_val = a
            } else {
                if instr.arg2 == 0 {
                    addr_val = base
                } else {
                    a := tmp_name(ti, 2)
                    write_str(fd, "  " + a + " = add i64 " + base + ", " + strconv.Itoa(instr.arg2) + "\n")
                    addr_val = a
                }
            }
            ptr := tmp_name(ti, 6)
            write_str(fd, "  " + ptr + " = inttoptr i64 " + addr_val + " to ptr\n")
            val := tmp_name(ti, 7)
            write_str(fd, "  " + val + " = load i64, ptr " + ptr + "\n")
            emit_store_vreg(fd, instr.dest, val)
        }

        if terminated == 0 && instr.op == OP_STORE {
            addr := emit_load_vreg(fd, instr.arg1, ti, 0)
            val := emit_load_vreg(fd, instr.arg2, ti, 1)
            ptr := tmp_name(ti, 2)
            write_str(fd, "  " + ptr + " = inttoptr i64 " + addr + " to ptr\n")
            write_str(fd, "  store i64 " + val + ", ptr " + ptr + "\n")
        }

        if terminated == 0 && instr.op == OP_STORE_INDEX {
            // arr=arg1, idx=arg2, val=arg3
            arr := emit_load_vreg(fd, instr.arg1, ti, 0)
            si_fp := "%si.fp." + strconv.Itoa(ti)
            write_str(fd, "  " + si_fp + " = inttoptr i64 " + arr + " to ptr\n")
            si_dp := "%si.dp." + strconv.Itoa(ti)
            write_str(fd, "  " + si_dp + " = load i64, ptr " + si_fp + "\n")
            idx := emit_load_vreg(fd, instr.arg2, ti, 1)
            si_scaled := "%si.sc." + strconv.Itoa(ti)
            write_str(fd, "  " + si_scaled + " = mul i64 " + idx + ", 8\n")
            si_addr := "%si.addr." + strconv.Itoa(ti)
            write_str(fd, "  " + si_addr + " = add i64 " + si_dp + ", " + si_scaled + "\n")
            si_ptr := "%si.ptr." + strconv.Itoa(ti)
            write_str(fd, "  " + si_ptr + " = inttoptr i64 " + si_addr + " to ptr\n")
            val := emit_load_vreg(fd, instr.arg3, ti, 2)
            write_str(fd, "  store i64 " + val + ", ptr " + si_ptr + "\n")
        }

        if terminated == 0 && instr.op == OP_COPY {
            // Copy value from source vreg (arg1) to dest vreg
            val := emit_load_vreg(fd, instr.arg1, ti, 0)
            emit_store_vreg(fd, instr.dest, val)
        }

        if terminated == 0 && instr.op == OP_ALLOCA {
            // Allocate with malloc (survives function returns)
            size := strconv.Itoa(instr.arg1)
            p := tmp_name(ti, 0)
            write_str(fd, "  " + p + " = call ptr @malloc(i64 " + size + ")\n")
            z := tmp_name(ti, 1)
            write_str(fd, "  " + z + " = call ptr @memset(ptr " + p + ", i32 0, i64 " + size + ")\n")
            emit_ptrtoint_store(fd, instr.dest, p, ti, 2)
        }

        if terminated == 0 && instr.op == OP_INDEXADDR {
            base := emit_load_vreg(fd, instr.arg1, ti, 0)
            if instr.arg2 == 0 {
                emit_store_vreg(fd, instr.dest, base)
            } else {
                r := tmp_name(ti, 1)
                write_str(fd, "  " + r + " = add i64 " + base + ", " + strconv.Itoa(instr.arg2) + "\n")
                emit_store_vreg(fd, instr.dest, r)
            }
        }

        if terminated == 0 && instr.op == OP_MEMCOPY {
            // arg1=src, arg2=dest, arg3=size
            src := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            dst := emit_load_ptr(fd, instr.arg2, ti, 2, 3)
            size := emit_load_vreg(fd, instr.arg3, ti, 4)
            write_str(fd, "  call ptr @memcpy(ptr " + dst + ", ptr " + src + ", i64 " + size + ")\n")
        }

        if terminated == 0 && instr.op == OP_ARRAY_LEN {
            // Fat pointer: [ptr, len, cap]. len is at offset 8
            base := emit_load_vreg(fd, instr.arg1, ti, 0)
            addr := tmp_name(ti, 1)
            write_str(fd, "  " + addr + " = add i64 " + base + ", 8\n")
            ptr := tmp_name(ti, 2)
            write_str(fd, "  " + ptr + " = inttoptr i64 " + addr + " to ptr\n")
            val := tmp_name(ti, 3)
            write_str(fd, "  " + val + " = load i64, ptr " + ptr + "\n")
            emit_store_vreg(fd, instr.dest, val)
        }

        if terminated == 0 && instr.op == OP_STR_LEN {
            // Direct libc: i64 @strlen(ptr) with null guard
            str_ptr := emit_load_safe_str(fd, instr.arg1, ti, 0, 1, 0)
            result := tmp_name(ti, 2)
            write_str(fd, "  " + result + " = call i64 @strlen(ptr " + str_ptr + ")\n")
            emit_store_vreg(fd, instr.dest, result)
        }

        if terminated == 0 && instr.op == OP_ARRAY_PUSH {
            // Inline array push with grow logic
            // arg1=fat ptr vreg, arg2=element vreg
            fp := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            elem := emit_load_vreg(fd, instr.arg2, ti, 2)
            tis := strconv.Itoa(ti)
            // Load ptr/len/cap from fat pointer
            ptr_val := "%ap.ptr." + tis
            write_str(fd, "  " + ptr_val + " = load i64, ptr " + fp + "\n")
            len_addr := "%ap.la." + tis
            write_str(fd, "  " + len_addr + " = getelementptr i8, ptr " + fp + ", i64 8\n")
            len_val := "%ap.len." + tis
            write_str(fd, "  " + len_val + " = load i64, ptr " + len_addr + "\n")
            cap_addr := "%ap.ca." + tis
            write_str(fd, "  " + cap_addr + " = getelementptr i8, ptr " + fp + ", i64 16\n")
            cap_val := "%ap.cap." + tis
            write_str(fd, "  " + cap_val + " = load i64, ptr " + cap_addr + "\n")
            // Check if needs grow
            needs_grow := "%ap.ng." + tis
            write_str(fd, "  " + needs_grow + " = icmp sge i64 " + len_val + ", " + cap_val + "\n")
            write_str(fd, "  br i1 " + needs_grow + ", label %ap.grow." + tis + ", label %ap.do." + tis + "\n")
            // Grow block
            write_str(fd, "ap.grow." + tis + ":\n")
            cap_is_zero := "%ap.cz." + tis
            write_str(fd, "  " + cap_is_zero + " = icmp eq i64 " + cap_val + ", 0\n")
            cap_double := "%ap.cd." + tis
            write_str(fd, "  " + cap_double + " = mul i64 " + cap_val + ", 2\n")
            new_cap := "%ap.nc." + tis
            write_str(fd, "  " + new_cap + " = select i1 " + cap_is_zero + ", i64 4, i64 " + cap_double + "\n")
            alloc_size := "%ap.as." + tis
            write_str(fd, "  " + alloc_size + " = mul i64 " + new_cap + ", 8\n")
            new_ptr := "%ap.np." + tis
            write_str(fd, "  " + new_ptr + " = call ptr @malloc(i64 " + alloc_size + ")\n")
            old_ptr := "%ap.op." + tis
            write_str(fd, "  " + old_ptr + " = inttoptr i64 " + ptr_val + " to ptr\n")
            copy_size := "%ap.cs." + tis
            write_str(fd, "  " + copy_size + " = mul i64 " + len_val + ", 8\n")
            write_str(fd, "  call ptr @memcpy(ptr " + new_ptr + ", ptr " + old_ptr + ", i64 " + copy_size + ")\n")
            new_ptr_int := "%ap.ni." + tis
            write_str(fd, "  " + new_ptr_int + " = ptrtoint ptr " + new_ptr + " to i64\n")
            write_str(fd, "  store i64 " + new_ptr_int + ", ptr " + fp + "\n")
            write_str(fd, "  store i64 " + new_cap + ", ptr " + cap_addr + "\n")
            write_str(fd, "  br label %ap.do." + tis + "\n")
            // Do block: store element and increment len
            write_str(fd, "ap.do." + tis + ":\n")
            cur_ptr := "%ap.cp." + tis
            write_str(fd, "  " + cur_ptr + " = load i64, ptr " + fp + "\n")
            elem_offset := "%ap.eo." + tis
            write_str(fd, "  " + elem_offset + " = mul i64 " + len_val + ", 8\n")
            elem_addr := "%ap.ea." + tis
            write_str(fd, "  " + elem_addr + " = add i64 " + cur_ptr + ", " + elem_offset + "\n")
            elem_ptr := "%ap.ep." + tis
            write_str(fd, "  " + elem_ptr + " = inttoptr i64 " + elem_addr + " to ptr\n")
            write_str(fd, "  store i64 " + elem + ", ptr " + elem_ptr + "\n")
            new_len := "%ap.nl." + tis
            write_str(fd, "  " + new_len + " = add i64 " + len_val + ", 1\n")
            write_str(fd, "  store i64 " + new_len + ", ptr " + len_addr + "\n")
        }

        if terminated == 0 && instr.op == OP_POKE {
            // Inline: trunc i64 to i8, store i8 to ptr
            addr := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            val := emit_load_vreg(fd, instr.arg2, ti, 2)
            t := tmp_name(ti, 3)
            write_str(fd, "  " + t + " = trunc i64 " + val + " to i8\n")
            write_str(fd, "  store i8 " + t + ", ptr " + addr + "\n")
        }

        if terminated == 0 && instr.op == OP_PEEK {
            // Inline: load i8, zext to i64
            addr := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            b := tmp_name(ti, 2)
            write_str(fd, "  " + b + " = load i8, ptr " + addr + "\n")
            r := tmp_name(ti, 3)
            write_str(fd, "  " + r + " = zext i8 " + b + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_HEAP_ALLOC {
            size := emit_load_vreg(fd, instr.arg1, ti, 0)
            p := tmp_name(ti, 1)
            write_str(fd, "  " + p + " = call ptr @malloc(i64 " + size + ")\n")
            ms := tmp_name(ti, 2)
            write_str(fd, "  " + ms + " = call ptr @memset(ptr " + p + ", i32 0, i64 " + size + ")\n")
            emit_ptrtoint_store(fd, instr.dest, p, ti, 3)
        }

        if terminated == 0 && instr.op == OP_ARGC {
            // Load from global @g_argc
            r := tmp_name(ti, 0)
            write_str(fd, "  " + r + " = load i64, ptr @g_argc\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_ARGV {
            // Load argv[index] from global @g_argv
            idx := emit_load_vreg(fd, instr.arg1, ti, 0)
            argv_ptr := tmp_name(ti, 1)
            write_str(fd, "  " + argv_ptr + " = load ptr, ptr @g_argv\n")
            elem_ptr := tmp_name(ti, 2)
            write_str(fd, "  " + elem_ptr + " = getelementptr ptr, ptr " + argv_ptr + ", i64 " + idx + "\n")
            p := tmp_name(ti, 3)
            write_str(fd, "  " + p + " = load ptr, ptr " + elem_ptr + "\n")
            emit_ptrtoint_store(fd, instr.dest, p, ti, 4)
        }

        if terminated == 0 && instr.op == OP_INT_TO_STR {
            // Inline: malloc(21) + snprintf(buf, 21, "%ld", val)
            val := emit_load_vreg(fd, instr.arg1, ti, 0)
            buf := tmp_name(ti, 1)
            write_str(fd, "  " + buf + " = call ptr @malloc(i64 21)\n")
            write_str(fd, "  call i32 (ptr, i64, ptr, ...) @snprintf(ptr " + buf + ", i64 21, ptr @.fmt.ld, i64 " + val + ")\n")
            emit_ptrtoint_store(fd, instr.dest, buf, ti, 2)
        }

        if terminated == 0 && instr.op == OP_BOOL_TO_STR {
            val := emit_load_vreg(fd, instr.arg1, ti, 0)
            cmp := tmp_name(ti, 1)
            write_str(fd, "  " + cmp + " = icmp ne i64 " + val + ", 0\n")
            result := tmp_name(ti, 2)
            write_str(fd, "  " + result + " = select i1 " + cmp + ", ptr @.str.true, ptr @.str.false\n")
            emit_ptrtoint_store(fd, instr.dest, result, ti, 3)
        }

        if terminated == 0 && instr.op == OP_STR_EQ {
            // strcmp + icmp eq 0 (null-safe)
            a := emit_load_safe_str(fd, instr.arg1, ti, 0, 1, 0)
            b := emit_load_safe_str(fd, instr.arg2, ti, 2, 3, 1)
            cmp := tmp_name(ti, 4)
            write_str(fd, "  " + cmp + " = call i32 @strcmp(ptr " + a + ", ptr " + b + ")\n")
            eq := tmp_name(ti, 5)
            write_str(fd, "  " + eq + " = icmp eq i32 " + cmp + ", 0\n")
            r := tmp_name(ti, 6)
            write_str(fd, "  " + r + " = zext i1 " + eq + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_STR_NE {
            // strcmp + icmp ne 0 (null-safe)
            a := emit_load_safe_str(fd, instr.arg1, ti, 0, 1, 0)
            b := emit_load_safe_str(fd, instr.arg2, ti, 2, 3, 1)
            cmp := tmp_name(ti, 4)
            write_str(fd, "  " + cmp + " = call i32 @strcmp(ptr " + a + ", ptr " + b + ")\n")
            ne := tmp_name(ti, 5)
            write_str(fd, "  " + ne + " = icmp ne i32 " + cmp + ", 0\n")
            r := tmp_name(ti, 6)
            write_str(fd, "  " + r + " = zext i1 " + ne + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_STR_CONCAT {
            // Inline: strlen(a) + strlen(b) + malloc + memcpy + memcpy + null terminator (null-safe)
            a := emit_load_safe_str(fd, instr.arg1, ti, 0, 1, 0)
            b := emit_load_safe_str(fd, instr.arg2, ti, 2, 3, 1)
            tis := strconv.Itoa(ti)
            la := "%sc.la." + tis
            write_str(fd, "  " + la + " = call i64 @strlen(ptr " + a + ")\n")
            lb := "%sc.lb." + tis
            write_str(fd, "  " + lb + " = call i64 @strlen(ptr " + b + ")\n")
            total := "%sc.tot." + tis
            write_str(fd, "  " + total + " = add i64 " + la + ", " + lb + "\n")
            total1 := "%sc.tot1." + tis
            write_str(fd, "  " + total1 + " = add i64 " + total + ", 1\n")
            buf := "%sc.buf." + tis
            write_str(fd, "  " + buf + " = call ptr @malloc(i64 " + total1 + ")\n")
            write_str(fd, "  call ptr @memcpy(ptr " + buf + ", ptr " + a + ", i64 " + la + ")\n")
            dst := "%sc.dst." + tis
            write_str(fd, "  " + dst + " = getelementptr i8, ptr " + buf + ", i64 " + la + "\n")
            write_str(fd, "  call ptr @memcpy(ptr " + dst + ", ptr " + b + ", i64 " + lb + ")\n")
            term := "%sc.trm." + tis
            write_str(fd, "  " + term + " = getelementptr i8, ptr " + buf + ", i64 " + total + "\n")
            write_str(fd, "  store i8 0, ptr " + term + "\n")
            emit_ptrtoint_store(fd, instr.dest, buf, ti, 4)
        }

        if terminated == 0 && instr.op == OP_STR_CHAR_AT {
            // Inline: getelementptr + load i8 + zext (null-safe)
            s := emit_load_safe_str(fd, instr.arg1, ti, 0, 1, 0)
            idx := emit_load_vreg(fd, instr.arg2, ti, 2)
            gep := tmp_name(ti, 3)
            write_str(fd, "  " + gep + " = getelementptr i8, ptr " + s + ", i64 " + idx + "\n")
            b := tmp_name(ti, 4)
            write_str(fd, "  " + b + " = load i8, ptr " + gep + "\n")
            r := tmp_name(ti, 5)
            write_str(fd, "  " + r + " = zext i8 " + b + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_SYSCALL_OPEN {
            // Direct libc: i32 @open(ptr, i32, ...)
            path := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            flags := emit_load_vreg(fd, instr.arg2, ti, 2)
            mode := emit_load_vreg(fd, instr.arg3, ti, 3)
            f32 := tmp_name(ti, 4)
            write_str(fd, "  " + f32 + " = trunc i64 " + flags + " to i32\n")
            m32 := tmp_name(ti, 5)
            write_str(fd, "  " + m32 + " = trunc i64 " + mode + " to i32\n")
            r32 := tmp_name(ti, 6)
            write_str(fd, "  " + r32 + " = call i32 (ptr, i32, ...) @open(ptr " + path + ", i32 " + f32 + ", i32 " + m32 + ")\n")
            r := tmp_name(ti, 7)
            write_str(fd, "  " + r + " = sext i32 " + r32 + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_SYSCALL_WRITE {
            // Direct libc: i64 @write(i32, ptr, i64)
            sfd := emit_load_vreg(fd, instr.arg1, ti, 0)
            buf := emit_load_ptr(fd, instr.arg2, ti, 1, 2)
            size := emit_load_vreg(fd, instr.arg3, ti, 3)
            fd32 := tmp_name(ti, 4)
            write_str(fd, "  " + fd32 + " = trunc i64 " + sfd + " to i32\n")
            r := tmp_name(ti, 5)
            write_str(fd, "  " + r + " = call i64 @write(i32 " + fd32 + ", ptr " + buf + ", i64 " + size + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_SYSCALL_CLOSE {
            // Direct libc: i32 @close(i32)
            sfd := emit_load_vreg(fd, instr.arg1, ti, 0)
            fd32 := tmp_name(ti, 1)
            write_str(fd, "  " + fd32 + " = trunc i64 " + sfd + " to i32\n")
            r32 := tmp_name(ti, 2)
            write_str(fd, "  " + r32 + " = call i32 @close(i32 " + fd32 + ")\n")
            r := tmp_name(ti, 3)
            write_str(fd, "  " + r + " = sext i32 " + r32 + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_SYSCALL_READ {
            // Direct libc: i64 @read(i32, ptr, i64)
            sfd := emit_load_vreg(fd, instr.arg1, ti, 0)
            buf := emit_load_ptr(fd, instr.arg2, ti, 1, 2)
            size := emit_load_vreg(fd, instr.arg3, ti, 3)
            fd32 := tmp_name(ti, 4)
            write_str(fd, "  " + fd32 + " = trunc i64 " + sfd + " to i32\n")
            r := tmp_name(ti, 5)
            write_str(fd, "  " + r + " = call i64 @read(i32 " + fd32 + ", ptr " + buf + ", i64 " + size + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_IS_DIR {
            path := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            r := tmp_name(ti, 2)
            write_str(fd, "  " + r + " = call i64 @ease_is_dir(ptr " + path + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_LIST_DIR {
            path := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            r := tmp_name(ti, 2)
            write_str(fd, "  " + r + " = call ptr @ease_list_dir(ptr " + path + ")\n")
            emit_ptrtoint_store(fd, instr.dest, r, ti, 3)
        }

        if terminated == 0 && instr.op == OP_SETJMP {
            r32 := tmp_name(ti, 0)
            write_str(fd, "  " + r32 + " = call i32 @setjmp(ptr @ease_test_jmp_buf) #0\n")
            r := tmp_name(ti, 1)
            write_str(fd, "  " + r + " = sext i32 " + r32 + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_TEST_FAIL {
            // Inline: longjmp(ease_test_jmp_buf, 1)
            write_str(fd, "  call void @longjmp(ptr @ease_test_jmp_buf, i32 1)\n")
            write_str(fd, "  unreachable\n")
            terminated = 1
        }

        if terminated == 0 && instr.op == OP_TIME_NANOS {
            // Inline: clock_gettime(CLOCK_MONOTONIC=6, &ts) + sec*1e9 + nsec
            ts := tmp_name(ti, 0)
            write_str(fd, "  " + ts + " = alloca [16 x i8]\n")
            write_str(fd, "  call i32 @clock_gettime(i32 6, ptr " + ts + ")\n")
            sec := tmp_name(ti, 1)
            write_str(fd, "  " + sec + " = load i64, ptr " + ts + "\n")
            nsec_ptr := tmp_name(ti, 2)
            write_str(fd, "  " + nsec_ptr + " = getelementptr i8, ptr " + ts + ", i64 8\n")
            nsec := tmp_name(ti, 3)
            write_str(fd, "  " + nsec + " = load i64, ptr " + nsec_ptr + "\n")
            sec_ns := tmp_name(ti, 4)
            write_str(fd, "  " + sec_ns + " = mul i64 " + sec + ", 1000000000\n")
            r := tmp_name(ti, 5)
            write_str(fd, "  " + r + " = add i64 " + sec_ns + ", " + nsec + "\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_TIME_WALLCLOCK {
            // Inline: clock_gettime(CLOCK_REALTIME=0, &ts) + sec*1e9 + nsec
            ts := tmp_name(ti, 0)
            write_str(fd, "  " + ts + " = alloca [16 x i8]\n")
            write_str(fd, "  call i32 @clock_gettime(i32 0, ptr " + ts + ")\n")
            sec := tmp_name(ti, 1)
            write_str(fd, "  " + sec + " = load i64, ptr " + ts + "\n")
            nsec_ptr := tmp_name(ti, 2)
            write_str(fd, "  " + nsec_ptr + " = getelementptr i8, ptr " + ts + ", i64 8\n")
            nsec := tmp_name(ti, 3)
            write_str(fd, "  " + nsec + " = load i64, ptr " + nsec_ptr + "\n")
            sec_ns := tmp_name(ti, 4)
            write_str(fd, "  " + sec_ns + " = mul i64 " + sec + ", 1000000000\n")
            r := tmp_name(ti, 5)
            write_str(fd, "  " + r + " = add i64 " + sec_ns + ", " + nsec + "\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_ARG {
            // Collect argument for next call
            push(call_args, instr.arg1)
        }

        if terminated == 0 && instr.op == OP_CALL {
            callee := llvm_func_name(instr.str_val)
            // Build argument string
            args_str := ""
            ai := 0
            for ai < len(call_args) {
                if ai > 0 { args_str = args_str + ", " }
                arg_val := emit_load_vreg(fd, call_args[ai], ti, ai)
                args_str = args_str + "i64 " + arg_val
                ai = ai + 1
            }
            // Emit call
            if instr.dest >= 0 {
                r := tmp_name(ti, 9)
                write_str(fd, "  " + r + " = call i64 @" + callee + "(" + args_str + ")\n")
                emit_store_vreg(fd, instr.dest, r)
            } else {
                write_str(fd, "  call i64 @" + callee + "(" + args_str + ")\n")
            }
            // Reset call args
            call_args = []int{}
        }

        if terminated == 0 && instr.op == OP_IFACE_WRAP {
            // Allocate 16 bytes for interface value [concrete_ptr, vtable_ptr]
            iw_ptr := "%iw.ptr." + strconv.Itoa(ti)
            write_str(fd, "  " + iw_ptr + " = call ptr @malloc(i64 16)\n")
            // Store concrete ptr at offset 0
            iw_concrete := emit_load_vreg(fd, instr.arg1, ti, 0)
            iw_concrete_ptr := "%iw.cptr." + strconv.Itoa(ti)
            write_str(fd, "  " + iw_concrete_ptr + " = inttoptr i64 " + iw_concrete + " to ptr\n")
            write_str(fd, "  store i64 " + iw_concrete + ", ptr " + iw_ptr + "\n")
            // Store vtable ptr at offset 8
            iw_vt := "%iw.vt." + strconv.Itoa(ti)
            write_str(fd, "  " + iw_vt + " = ptrtoint ptr @vtable." + llvm_mangle(instr.str_val) + " to i64\n")
            iw_slot1 := "%iw.slot1." + strconv.Itoa(ti)
            write_str(fd, "  " + iw_slot1 + " = getelementptr i8, ptr " + iw_ptr + ", i64 8\n")
            write_str(fd, "  store i64 " + iw_vt + ", ptr " + iw_slot1 + "\n")
            // Result = interface value as i64
            iw_result := "%iw.result." + strconv.Itoa(ti)
            write_str(fd, "  " + iw_result + " = ptrtoint ptr " + iw_ptr + " to i64\n")
            emit_store_vreg(fd, instr.dest, iw_result)
        }

        if terminated == 0 && instr.op == OP_IFACE_CALL {
            // Indirect call through interface vtable
            // call_args[0] = interface value, rest = user args
            // instr.arg1 = vtable method index, instr.arg2 = total arg count
            ic_iface := "%ic.iface." + strconv.Itoa(ti)
            ic_iface_val := emit_load_vreg(fd, call_args[0], ti, 0)
            write_str(fd, "  " + ic_iface + " = inttoptr i64 " + ic_iface_val + " to ptr\n")
            // Load concrete_ptr at offset 0
            ic_concrete := "%ic.concrete." + strconv.Itoa(ti)
            write_str(fd, "  " + ic_concrete + " = load i64, ptr " + ic_iface + "\n")
            // Load vtable_ptr at offset 8
            ic_vt_slot := "%ic.vt.slot." + strconv.Itoa(ti)
            write_str(fd, "  " + ic_vt_slot + " = getelementptr i8, ptr " + ic_iface + ", i64 8\n")
            ic_vt := "%ic.vt." + strconv.Itoa(ti)
            write_str(fd, "  " + ic_vt + " = load i64, ptr " + ic_vt_slot + "\n")
            ic_vt_ptr := "%ic.vt.ptr." + strconv.Itoa(ti)
            write_str(fd, "  " + ic_vt_ptr + " = inttoptr i64 " + ic_vt + " to ptr\n")
            // Load function pointer at vtable_idx * 8
            ic_fp_offset := instr.arg1 * 8
            ic_fp_slot := "%ic.fp.slot." + strconv.Itoa(ti)
            write_str(fd, "  " + ic_fp_slot + " = getelementptr i8, ptr " + ic_vt_ptr + ", i64 " + strconv.Itoa(ic_fp_offset) + "\n")
            ic_fp := "%ic.fp." + strconv.Itoa(ti)
            write_str(fd, "  " + ic_fp + " = load i64, ptr " + ic_fp_slot + "\n")
            ic_fn := "%ic.fn." + strconv.Itoa(ti)
            write_str(fd, "  " + ic_fn + " = inttoptr i64 " + ic_fp + " to ptr\n")
            // Build argument string: concrete_ptr as first arg, then remaining args
            ic_args_str := "i64 " + ic_concrete
            ic_ai := 1
            for ic_ai < len(call_args) {
                ic_arg_val := emit_load_vreg(fd, call_args[ic_ai], ti, ic_ai)
                ic_args_str = ic_args_str + ", i64 " + ic_arg_val
                ic_ai = ic_ai + 1
            }
            // Emit indirect call
            ic_result := "%ic.result." + strconv.Itoa(ti)
            write_str(fd, "  " + ic_result + " = call i64 " + ic_fn + "(" + ic_args_str + ")\n")
            emit_store_vreg(fd, instr.dest, ic_result)
            // Reset call args
            call_args = []int{}
        }

        if terminated == 0 && instr.op == OP_CLOSURE_NEW {
            // Allocate 16 bytes for closure [func_ptr, env_ptr]
            cl_ptr := "%cl.ptr." + strconv.Itoa(ti)
            write_str(fd, "  " + cl_ptr + " = call ptr @malloc(i64 16)\n")
            // Store function pointer at offset 0
            cl_fp := "%cl.fp." + strconv.Itoa(ti)
            write_str(fd, "  " + cl_fp + " = ptrtoint ptr @" + llvm_func_name(instr.str_val) + " to i64\n")
            write_str(fd, "  store i64 " + cl_fp + ", ptr " + cl_ptr + "\n")
            // Store env pointer at offset 8
            cl_env_slot := "%cl.env.slot." + strconv.Itoa(ti)
            write_str(fd, "  " + cl_env_slot + " = getelementptr i8, ptr " + cl_ptr + ", i64 8\n")
            if instr.arg1 >= 0 {
                cl_env_val := emit_load_vreg(fd, instr.arg1, ti, 0)
                write_str(fd, "  store i64 " + cl_env_val + ", ptr " + cl_env_slot + "\n")
            } else {
                write_str(fd, "  store i64 0, ptr " + cl_env_slot + "\n")
            }
            // Result = closure as i64
            cl_result := "%cl.result." + strconv.Itoa(ti)
            write_str(fd, "  " + cl_result + " = ptrtoint ptr " + cl_ptr + " to i64\n")
            emit_store_vreg(fd, instr.dest, cl_result)
        }

        if terminated == 0 && instr.op == OP_CLOSURE_CALL {
            // Indirect call through closure object
            // instr.arg1 = closure vreg, instr.arg2 = user arg count
            cc_obj := "%cc.obj." + strconv.Itoa(ti)
            cc_obj_val := emit_load_vreg(fd, instr.arg1, ti, 0)
            write_str(fd, "  " + cc_obj + " = inttoptr i64 " + cc_obj_val + " to ptr\n")
            // Load func_ptr at offset 0
            cc_fp := "%cc.fp." + strconv.Itoa(ti)
            write_str(fd, "  " + cc_fp + " = load i64, ptr " + cc_obj + "\n")
            cc_fn := "%cc.fn." + strconv.Itoa(ti)
            write_str(fd, "  " + cc_fn + " = inttoptr i64 " + cc_fp + " to ptr\n")
            // Load env_ptr at offset 8
            cc_env_slot := "%cc.env.slot." + strconv.Itoa(ti)
            write_str(fd, "  " + cc_env_slot + " = getelementptr i8, ptr " + cc_obj + ", i64 8\n")
            cc_env := "%cc.env." + strconv.Itoa(ti)
            write_str(fd, "  " + cc_env + " = load i64, ptr " + cc_env_slot + "\n")
            // Build argument string: env_ptr as first arg, then user args
            cc_args_str := "i64 " + cc_env
            cc_ai := 0
            for cc_ai < len(call_args) {
                cc_arg_val := emit_load_vreg(fd, call_args[cc_ai], ti, cc_ai + 1)
                cc_args_str = cc_args_str + ", i64 " + cc_arg_val
                cc_ai = cc_ai + 1
            }
            // Emit indirect call
            cc_result := "%cc.result." + strconv.Itoa(ti)
            write_str(fd, "  " + cc_result + " = call i64 " + cc_fn + "(" + cc_args_str + ")\n")
            emit_store_vreg(fd, instr.dest, cc_result)
            // Reset call args
            call_args = []int{}
        }

        if terminated == 0 && instr.op == OP_MAP_NEW {
            r := tmp_name(ti, 0)
            write_str(fd, "  " + r + " = call i64 @maps_New(i64 " + strconv.Itoa(instr.arg1) + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_MAP_GET {
            m := emit_load_vreg(fd, instr.arg1, ti, 0)
            k := emit_load_vreg(fd, instr.arg2, ti, 1)
            r := tmp_name(ti, 2)
            write_str(fd, "  " + r + " = call i64 @maps_Get(i64 " + m + ", i64 " + k + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_MAP_SET {
            m := emit_load_vreg(fd, instr.arg1, ti, 0)
            k := emit_load_vreg(fd, instr.arg2, ti, 1)
            v := emit_load_vreg(fd, instr.arg3, ti, 2)
            r := tmp_name(ti, 3)
            write_str(fd, "  " + r + " = call i64 @maps_Set(i64 " + m + ", i64 " + k + ", i64 " + v + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_MAP_DELETE {
            m := emit_load_vreg(fd, instr.arg1, ti, 0)
            k := emit_load_vreg(fd, instr.arg2, ti, 1)
            r := tmp_name(ti, 2)
            write_str(fd, "  " + r + " = call i64 @maps_Delete(i64 " + m + ", i64 " + k + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_MAP_LEN {
            m := emit_load_vreg(fd, instr.arg1, ti, 0)
            r := tmp_name(ti, 1)
            write_str(fd, "  " + r + " = call i64 @maps_Len(i64 " + m + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_MAP_HAS {
            m := emit_load_vreg(fd, instr.arg1, ti, 0)
            k := emit_load_vreg(fd, instr.arg2, ti, 1)
            r := tmp_name(ti, 2)
            write_str(fd, "  " + r + " = call i64 @maps_Has(i64 " + m + ", i64 " + k + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        // Float operations
        if terminated == 0 && instr.op == OP_LOADFLOAT {
            // bitcast double <literal> to i64
            r := tmp_name(ti, 0)
            write_str(fd, "  " + r + " = bitcast double " + instr.str_val + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && (instr.op == OP_FADD || instr.op == OP_FSUB || instr.op == OP_FMUL || instr.op == OP_FDIV || instr.op == OP_FMOD) {
            // bitcast i64→double, float op, bitcast back
            lhs := emit_load_vreg(fd, instr.arg1, ti, 0)
            rhs := emit_load_vreg(fd, instr.arg2, ti, 1)
            ld := tmp_name(ti, 2)
            write_str(fd, "  " + ld + " = bitcast i64 " + lhs + " to double\n")
            rd := tmp_name(ti, 3)
            write_str(fd, "  " + rd + " = bitcast i64 " + rhs + " to double\n")
            fop_name := "fadd"
            if instr.op == OP_FSUB { fop_name = "fsub" }
            if instr.op == OP_FMUL { fop_name = "fmul" }
            if instr.op == OP_FDIV { fop_name = "fdiv" }
            if instr.op == OP_FMOD { fop_name = "frem" }
            res_d := tmp_name(ti, 4)
            write_str(fd, "  " + res_d + " = " + fop_name + " double " + ld + ", " + rd + "\n")
            res_i := tmp_name(ti, 5)
            write_str(fd, "  " + res_i + " = bitcast double " + res_d + " to i64\n")
            emit_store_vreg(fd, instr.dest, res_i)
        }

        if terminated == 0 && (instr.op == OP_FCMP_LT || instr.op == OP_FCMP_GT || instr.op == OP_FCMP_LE || instr.op == OP_FCMP_GE || instr.op == OP_FCMP_EQ || instr.op == OP_FCMP_NE) {
            lhs := emit_load_vreg(fd, instr.arg1, ti, 0)
            rhs := emit_load_vreg(fd, instr.arg2, ti, 1)
            ld := tmp_name(ti, 2)
            write_str(fd, "  " + ld + " = bitcast i64 " + lhs + " to double\n")
            rd := tmp_name(ti, 3)
            write_str(fd, "  " + rd + " = bitcast i64 " + rhs + " to double\n")
            pred := "olt"
            if instr.op == OP_FCMP_GT { pred = "ogt" }
            if instr.op == OP_FCMP_LE { pred = "ole" }
            if instr.op == OP_FCMP_GE { pred = "oge" }
            if instr.op == OP_FCMP_EQ { pred = "oeq" }
            if instr.op == OP_FCMP_NE { pred = "une" }
            cmp := tmp_name(ti, 4)
            write_str(fd, "  " + cmp + " = fcmp " + pred + " double " + ld + ", " + rd + "\n")
            ext := tmp_name(ti, 5)
            write_str(fd, "  " + ext + " = zext i1 " + cmp + " to i64\n")
            emit_store_vreg(fd, instr.dest, ext)
        }

        if terminated == 0 && instr.op == OP_INT_TO_FLOAT {
            val := emit_load_vreg(fd, instr.arg1, ti, 0)
            dbl := tmp_name(ti, 1)
            write_str(fd, "  " + dbl + " = sitofp i64 " + val + " to double\n")
            r := tmp_name(ti, 2)
            write_str(fd, "  " + r + " = bitcast double " + dbl + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_FLOAT_TO_INT {
            val := emit_load_vreg(fd, instr.arg1, ti, 0)
            dbl := tmp_name(ti, 1)
            write_str(fd, "  " + dbl + " = bitcast i64 " + val + " to double\n")
            r := tmp_name(ti, 2)
            write_str(fd, "  " + r + " = fptosi double " + dbl + " to i64\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_FLOAT_TO_STR {
            val := emit_load_vreg(fd, instr.arg1, ti, 0)
            dbl := tmp_name(ti, 1)
            write_str(fd, "  " + dbl + " = bitcast i64 " + val + " to double\n")
            buf := tmp_name(ti, 2)
            write_str(fd, "  " + buf + " = call ptr @malloc(i64 32)\n")
            write_str(fd, "  call i32 (ptr, i64, ptr, ...) @snprintf(ptr " + buf + ", i64 32, ptr @.fmt.g, double " + dbl + ")\n")
            emit_ptrtoint_store(fd, instr.dest, buf, ti, 3)
        }

        if terminated == 0 && instr.op == OP_RET {
            if instr.dest >= 0 {
                v := emit_load_vreg(fd, instr.dest, ti, 0)
                write_str(fd, "  ret i64 " + v + "\n")
            } else {
                write_str(fd, "  ret i64 0\n")
            }
            terminated = 1
        }

        if terminated == 0 && instr.op == OP_JUMP {
            write_str(fd, "  br label %L." + strconv.Itoa(instr.dest) + "\n")
            terminated = 1
        }

        if terminated == 0 && instr.op == OP_BRANCH {
            // Branch to arg1 if dest is ZERO (CBZ semantics)
            cond := emit_load_vreg(fd, instr.dest, ti, 0)
            cmp := tmp_name(ti, 1)
            write_str(fd, "  " + cmp + " = icmp eq i64 " + cond + ", 0\n")
            fall_label := "L.fall." + strconv.Itoa(ti)
            write_str(fd, "  br i1 " + cmp + ", label %L." + strconv.Itoa(instr.arg1) + ", label %" + fall_label + "\n")
            write_str(fd, fall_label + ":\n")
            terminated = 0
        }

        ii = ii + 1
    }

    // If function didn't end with a terminator, add default return
    if terminated == 0 {
        write_str(fd, "  ret i64 0\n")
    }

    write_str(fd, "}\n\n")
}

fn print_hex(val: int) {
    v := val
    digits := []int{}
    hex_i := 0
    for hex_i < 8 {
        push(digits, v - ((v / 16) * 16))
        v = v / 16
        hex_i = hex_i + 1
    }
    pri := 0
    for pri < 8 {
        d := digits[7 - pri]
        if d < 10 {
            print(strconv.Itoa(d))
        } else {
            if d == 10 { print("a") }
            if d == 11 { print("b") }
            if d == 12 { print("c") }
            if d == 13 { print("d") }
            if d == 14 { print("e") }
            if d == 15 { print("f") }
        }
        pri = pri + 1
    }
}
