package llvm

// LLVM IR code generation for the Ease bootstrap compiler
//
// Strategy: translate bootstrap IR to LLVM IR text, delegate all builtins
// to the C runtime (ease_runtime.c). clang compiles the .ll to native binary.
//
// Design: all values are i64. Pointers are integers (ptrtoint/inttoptr).
// Each virtual register gets an alloca i64 slot; clang -O1 mem2reg pass
// promotes these to SSA registers automatically.

fn write_str(fd: int, s: string) {
    syscall.write(fd, s, len(s))
}

fn hex_digit_char(v: int) -> string {
    if v == 0 { return "0" }
    if v == 1 { return "1" }
    if v == 2 { return "2" }
    if v == 3 { return "3" }
    if v == 4 { return "4" }
    if v == 5 { return "5" }
    if v == 6 { return "6" }
    if v == 7 { return "7" }
    if v == 8 { return "8" }
    if v == 9 { return "9" }
    if v == 10 { return "A" }
    if v == 11 { return "B" }
    if v == 12 { return "C" }
    if v == 13 { return "D" }
    if v == 14 { return "E" }
    if v == 15 { return "F" }
    return "0"
}

fn hex_byte_str(v: int) -> string {
    hi := v / 16
    lo := v - hi * 16
    return hex_digit_char(hi) + hex_digit_char(lo)
}

fn llvm_escape_string(s: string) -> string {
    result := "c\""
    i := 0
    slen := len(s)
    for i < slen {
        ch := str_char_at(s, i)
        if ch >= 32 && ch < 127 && ch != 34 && ch != 92 {
            result = result + str_substring(s, i, i + 1)
        } else {
            hbs := hex_byte_str(ch)
            result = result + "\\" + hbs
        }
        i = i + 1
    }
    result = result + "\\00\""
    return result
}

fn llvm_mangle(name: string) -> string {
    result := ""
    i := 0
    slen := len(name)
    for i < slen {
        ch := str_char_at(name, i)
        if ch == 46 {
            result = result + "_"
        } else {
            result = result + str_substring(name, i, i + 1)
        }
        i = i + 1
    }
    return result
}

fn llvm_func_name(name: string) -> string {
    if name == "main" {
        return "ease_user_main"
    }
    return llvm_mangle(name)
}

fn add_unique(arr: []int, val: int) {
    i := 0
    for i < len(arr) {
        if arr[i] == val { return }
        i = i + 1
    }
    arr = append(arr, val)
}

fn tmp_name(ti: int, sub: int) -> string {
    return "%t." + strconv.Itoa(ti * 10 + sub)
}

fn emit_load_vreg(fd: int, vreg: int, ti: int, sub: int) -> string {
    name := tmp_name(ti, sub)
    write_str(fd, "  " + name + " = load i64, ptr %v." + strconv.Itoa(vreg) + "\n")
    return name
}

fn emit_load_ptr(fd: int, vreg: int, ti: int, s1: int, s2: int) -> string {
    val := emit_load_vreg(fd, vreg, ti, s1)
    name := tmp_name(ti, s2)
    write_str(fd, "  " + name + " = inttoptr i64 " + val + " to ptr\n")
    return name
}

fn emit_store_vreg(fd: int, vreg: int, val: string) {
    write_str(fd, "  store i64 " + val + ", ptr %v." + strconv.Itoa(vreg) + "\n")
}

fn emit_load_safe_str(fd: int, vreg: int, ti: int, s1: int, s2: int, s3: int) -> string {
    // Load pointer from vreg, replace NULL with @.str.empty
    val := emit_load_vreg(fd, vreg, ti, s1)
    raw := tmp_name(ti, s2)
    write_str(fd, "  " + raw + " = inttoptr i64 " + val + " to ptr\n")
    is_null := "%ns." + strconv.Itoa(ti) + "." + strconv.Itoa(s3)
    write_str(fd, "  " + is_null + " = icmp eq ptr " + raw + ", null\n")
    safe := "%ss." + strconv.Itoa(ti) + "." + strconv.Itoa(s3)
    write_str(fd, "  " + safe + " = select i1 " + is_null + ", ptr @.str.empty, ptr " + raw + "\n")
    return safe
}

fn emit_ptrtoint_store(fd: int, vreg: int, ptr_val: string, ti: int, sub: int) {
    name := tmp_name(ti, sub)
    write_str(fd, "  " + name + " = ptrtoint ptr " + ptr_val + " to i64\n")
    emit_store_vreg(fd, vreg, name)
}

fn emit_llvm_binop(fd: int, instr: IRInstr, op: string, ti: int) {
    lhs := emit_load_vreg(fd, instr.arg1, ti, 0)
    rhs := emit_load_vreg(fd, instr.arg2, ti, 1)
    result := tmp_name(ti, 2)
    write_str(fd, "  " + result + " = " + op + " i64 " + lhs + ", " + rhs + "\n")
    emit_store_vreg(fd, instr.dest, result)
}

fn emit_llvm_cmp(fd: int, instr: IRInstr, pred: string, ti: int) {
    lhs := emit_load_vreg(fd, instr.arg1, ti, 0)
    rhs := emit_load_vreg(fd, instr.arg2, ti, 1)
    cmp := tmp_name(ti, 2)
    write_str(fd, "  " + cmp + " = icmp " + pred + " i64 " + lhs + ", " + rhs + "\n")
    ext := tmp_name(ti, 3)
    write_str(fd, "  " + ext + " = zext i1 " + cmp + " to i64\n")
    emit_store_vreg(fd, instr.dest, ext)
}

fn emit_llvm_decls(fd: int) {
    // Memory allocation
    write_str(fd, "declare ptr @malloc(i64)\n")
    write_str(fd, "declare ptr @calloc(i64, i64)\n")
    write_str(fd, "declare ptr @memcpy(ptr, ptr, i64)\n")
    write_str(fd, "declare ptr @memset(ptr, i32, i64)\n")
    // String operations (libc)
    write_str(fd, "declare i32 @strcmp(ptr, ptr)\n")
    write_str(fd, "declare i64 @strlen(ptr)\n")
    write_str(fd, "declare i32 @snprintf(ptr, i64, ptr, ...)\n")
    // POSIX I/O (libc)
    write_str(fd, "declare i32 @open(ptr, i32, ...)\n")
    write_str(fd, "declare i64 @read(i32, ptr, i64)\n")
    write_str(fd, "declare i64 @write(i32, ptr, i64)\n")
    write_str(fd, "declare i32 @close(i32)\n")
    // Directory operations (libc, macOS mangled names)
    write_str(fd, "declare i32 @\"\\01_stat\"(ptr, ptr)\n")
    write_str(fd, "declare ptr @\"\\01_opendir\"(ptr)\n")
    write_str(fd, "declare ptr @\"\\01_readdir\"(ptr)\n")
    write_str(fd, "declare i32 @\"\\01_closedir\"(ptr)\n")
    // Testing support (libc)
    write_str(fd, "declare i32 @setjmp(ptr) #0\n")
    write_str(fd, "declare void @longjmp(ptr, i32)\n")
    // Time (libc)
    write_str(fd, "declare i32 @clock_gettime(i32, ptr)\n")
    // Globals
    write_str(fd, "@ease_test_jmp_buf = global [37 x i64] zeroinitializer\n")
    write_str(fd, "@g_argc = global i64 0\n")
    write_str(fd, "@g_argv = global ptr null\n")
    write_str(fd, "@.fmt.ld = private unnamed_addr constant [4 x i8] c\"%ld\\00\"\n")
    write_str(fd, "@.fmt.g = private unnamed_addr constant [5 x i8] c\"%.6g\\00\"\n")
    write_str(fd, "@.str.empty = private unnamed_addr constant [1 x i8] c\"\\00\"\n")
    write_str(fd, "@.str.true = private unnamed_addr constant [5 x i8] c\"true\\00\"\n")
    write_str(fd, "@.str.false = private unnamed_addr constant [6 x i8] c\"false\\00\"\n")
    write_str(fd, "@.str.lbrace = private unnamed_addr constant [2 x i8] c\"{\\00\"\n")
    write_str(fd, "@.str.rbrace = private unnamed_addr constant [2 x i8] c\"}\\00\"\n")
    write_str(fd, "@.str.comma = private unnamed_addr constant [2 x i8] c\",\\00\"\n")
    // GC runtime ABI (defined in runtime/gc_*.c)
    write_str(fd, "declare ptr @gc_alloc(i64)\n")
    write_str(fd, "declare void @gc_init(ptr)\n")
    write_str(fd, "declare void @gc_collect()\n")
    write_str(fd, "declare void @gc_get_stats(ptr)\n")
    write_str(fd, "declare void @gc_print_stats(ptr)\n")
    write_str(fd, "attributes #0 = { returns_twice }\n")
    write_str(fd, "\n")
}

fn extern_llvm_type(etype: int) -> string {
    if etype == EXTERN_I32 { return "i32" }
    if etype == EXTERN_I64 { return "i64" }
    if etype == EXTERN_PTR { return "ptr" }
    return "void"
}

fn emit_extern_wrappers(fd: int) {
    ec := extern_count()
    if ec == 0 { return }
    write_str(fd, "; --- extern fn wrappers ---\n")
    ei := 0
    for ei < ec {
        c_name := g_extern_c_names[ei]
        ease_name := g_extern_names[ei]
        pc := g_extern_param_counts[ei]
        ps := g_extern_param_starts[ei]
        rt := g_extern_ret_types[ei]

        // Emit C function declaration: declare <ret> @<c_name>(<param types>)
        decl := "declare " + extern_llvm_type(rt) + " @" + c_name + "("
        pi := 0
        for pi < pc {
            if pi > 0 { decl = decl + ", " }
            decl = decl + extern_llvm_type(g_extern_param_types[ps + pi])
            pi = pi + 1
        }
        decl = decl + ")\n"
        write_str(fd, decl)

        // Emit wrapper: define i64 @<ease_mangled_name>(i64 %param.0, ...) {
        wrapper_name := llvm_mangle(ease_name)
        hdr := "define i64 @" + wrapper_name + "("
        pi = 0
        for pi < pc {
            if pi > 0 { hdr = hdr + ", " }
            hdr = hdr + "i64 %param." + strconv.Itoa(pi)
            pi = pi + 1
        }
        hdr = hdr + ") {\n"
        write_str(fd, hdr)

        // Convert params from i64 to C types
        pi = 0
        for pi < pc {
            pt := g_extern_param_types[ps + pi]
            param := "%param." + strconv.Itoa(pi)
            if pt == EXTERN_I32 {
                write_str(fd, "  %p" + strconv.Itoa(pi) + " = trunc i64 " + param + " to i32\n")
            } else if pt == EXTERN_PTR {
                write_str(fd, "  %p" + strconv.Itoa(pi) + " = inttoptr i64 " + param + " to ptr\n")
            }
            pi = pi + 1
        }

        // Call C function
        if rt == EXTERN_VOID {
            call := "  call void @" + c_name + "("
            pi = 0
            for pi < pc {
                if pi > 0 { call = call + ", " }
                pt := g_extern_param_types[ps + pi]
                if pt == EXTERN_I64 {
                    call = call + "i64 %param." + strconv.Itoa(pi)
                } else {
                    call = call + extern_llvm_type(pt) + " %p" + strconv.Itoa(pi)
                }
                pi = pi + 1
            }
            call = call + ")\n"
            write_str(fd, call)
            write_str(fd, "  ret i64 0\n")
        } else {
            call := "  %cr = call " + extern_llvm_type(rt) + " @" + c_name + "("
            pi = 0
            for pi < pc {
                if pi > 0 { call = call + ", " }
                pt := g_extern_param_types[ps + pi]
                if pt == EXTERN_I64 {
                    call = call + "i64 %param." + strconv.Itoa(pi)
                } else {
                    call = call + extern_llvm_type(pt) + " %p" + strconv.Itoa(pi)
                }
                pi = pi + 1
            }
            call = call + ")\n"
            write_str(fd, call)

            // Convert return value to i64
            if rt == EXTERN_I32 {
                write_str(fd, "  %r64 = sext i32 %cr to i64\n")
                write_str(fd, "  ret i64 %r64\n")
            } else if rt == EXTERN_PTR {
                write_str(fd, "  %r64 = ptrtoint ptr %cr to i64\n")
                write_str(fd, "  ret i64 %r64\n")
            } else {
                // i64 return
                write_str(fd, "  ret i64 %cr\n")
            }
        }

        write_str(fd, "}\n")
        ei = ei + 1
    }
    write_str(fd, "\n")
}

fn collect_vregs(instrs: []IRInstr, start: int, end_pos: int, param_count: int) -> []int {
    vregs := []int{}
    p := 0
    for p < param_count {
        add_unique(vregs, 90000 + p)
        p = p + 1
    }
    i := start
    for i < end_pos {
        instr := instrs[i]
        op := instr.op
        // dest is vreg for result-producing operations
        if op == ir.OP_LOADCONST || op == ir.OP_ADD || op == ir.OP_SUB || op == ir.OP_MUL || op == ir.OP_DIV || op == ir.OP_CMP_LT || op == ir.OP_CMP_GT || op == ir.OP_CMP_LE || op == ir.OP_CMP_GE || op == ir.OP_CMP_EQ || op == ir.OP_CMP_NE || op == ir.OP_AND || op == ir.OP_OR || op == ir.OP_NOT || op == ir.OP_XOR || op == ir.OP_BITAND || op == ir.OP_BITOR || op == ir.OP_ALLOCA || op == ir.OP_LOAD || op == ir.OP_INDEXADDR || op == ir.OP_ARRAY_LEN || op == ir.OP_STR_LEN || op == ir.OP_STR_CHAR_AT || op == ir.OP_PEEK || op == ir.OP_HEAP_ALLOC || op == ir.OP_CALL || op == ir.OP_ARGC || op == ir.OP_ARGV || op == ir.OP_INT_TO_STR || op == ir.OP_STR_EQ || op == ir.OP_STR_NE || op == ir.OP_STR_CONCAT || op == ir.OP_LOAD_GLOBAL || op == ir.OP_SYSCALL_OPEN || op == ir.OP_SYSCALL_WRITE || op == ir.OP_SYSCALL_CLOSE || op == ir.OP_SYSCALL_READ || op == ir.OP_IS_DIR || op == ir.OP_LIST_DIR || op == ir.OP_SETJMP || op == ir.OP_TIME_NANOS || op == ir.OP_TIME_WALLCLOCK || op == ir.OP_IFACE_WRAP || op == ir.OP_IFACE_CALL || op == ir.OP_MAP_NEW || op == ir.OP_MAP_GET || op == ir.OP_MAP_SET || op == ir.OP_MAP_DELETE || op == ir.OP_MAP_LEN || op == ir.OP_MAP_HAS || op == ir.OP_CLOSURE_NEW || op == ir.OP_CLOSURE_CALL || op == ir.OP_LOADFLOAT || op == ir.OP_FADD || op == ir.OP_FSUB || op == ir.OP_FMUL || op == ir.OP_FDIV || op == ir.OP_FMOD || op == ir.OP_FCMP_LT || op == ir.OP_FCMP_GT || op == ir.OP_FCMP_LE || op == ir.OP_FCMP_GE || op == ir.OP_FCMP_EQ || op == ir.OP_FCMP_NE || op == ir.OP_FLOAT_TO_STR || op == ir.OP_INT_TO_FLOAT || op == ir.OP_FLOAT_TO_INT || op == ir.OP_BOOL_TO_STR || op == ir.OP_ARRAY_SLICE || op == ir.OP_REFLECT_NUM_FIELD || op == ir.OP_REFLECT_FIELD_NAME || op == ir.OP_REFLECT_FIELD_TYPE || op == ir.OP_REFLECT_FIELD_VALUE || op == ir.OP_JSON_MARSHAL || op == ir.OP_JSON_UNMARSHAL {
            if instr.dest >= 0 { add_unique(vregs, instr.dest) }
        }
        // RET dest is vreg
        if op == ir.OP_RET && instr.dest >= 0 { add_unique(vregs, instr.dest) }
        // BRANCH dest is vreg (condition)
        if op == ir.OP_BRANCH && instr.dest >= 0 { add_unique(vregs, instr.dest) }
        // COPY: dest=target, arg1=source
        if op == ir.OP_COPY {
            if instr.dest >= 0 { add_unique(vregs, instr.dest) }
            if instr.arg1 >= 0 { add_unique(vregs, instr.arg1) }
        }
        // arg1 is vreg for most ops (not LOADCONST, ALLOCA, LABEL, JUMP, BRANCH, ARGC, CALL)
        if op != ir.OP_LOADCONST && op != ir.OP_LOAD_GLOBAL && op != ir.OP_ALLOCA && op != ir.OP_LABEL && op != ir.OP_JUMP && op != ir.OP_BRANCH && op != ir.OP_ARGC && op != ir.OP_TIME_NANOS && op != ir.OP_TIME_WALLCLOCK && op != ir.OP_CALL && op != ir.OP_IFACE_CALL && op != ir.OP_CLOSURE_CALL && op != ir.OP_MAP_NEW && op != ir.OP_LOADFLOAT && op != ir.OP_GC_COLLECT {
            if instr.arg1 >= 0 { add_unique(vregs, instr.arg1) }
        }
        // arg2 is vreg for binary ops, STORE, ARRAY_PUSH, POKE, STR_EQ/NE, STR_CHAR_AT, etc
        if op == ir.OP_ADD || op == ir.OP_SUB || op == ir.OP_MUL || op == ir.OP_DIV || op == ir.OP_CMP_LT || op == ir.OP_CMP_GT || op == ir.OP_CMP_LE || op == ir.OP_CMP_GE || op == ir.OP_CMP_EQ || op == ir.OP_CMP_NE || op == ir.OP_AND || op == ir.OP_OR || op == ir.OP_XOR || op == ir.OP_BITAND || op == ir.OP_BITOR || op == ir.OP_STORE || op == ir.OP_ARRAY_PUSH || op == ir.OP_POKE || op == ir.OP_STR_EQ || op == ir.OP_STR_NE || op == ir.OP_STR_CONCAT || op == ir.OP_STR_CHAR_AT || op == ir.OP_MEMCOPY || op == ir.OP_SYSCALL_OPEN || op == ir.OP_SYSCALL_WRITE || op == ir.OP_SYSCALL_CLOSE || op == ir.OP_SYSCALL_READ || op == ir.OP_STORE_INDEX || op == ir.OP_MAP_GET || op == ir.OP_MAP_SET || op == ir.OP_MAP_DELETE || op == ir.OP_MAP_HAS || op == ir.OP_FADD || op == ir.OP_FSUB || op == ir.OP_FMUL || op == ir.OP_FDIV || op == ir.OP_FMOD || op == ir.OP_FCMP_LT || op == ir.OP_FCMP_GT || op == ir.OP_FCMP_LE || op == ir.OP_FCMP_GE || op == ir.OP_FCMP_EQ || op == ir.OP_FCMP_NE || op == ir.OP_ARRAY_SLICE || op == ir.OP_REFLECT_FIELD_NAME || op == ir.OP_REFLECT_FIELD_TYPE || op == ir.OP_REFLECT_FIELD_VALUE || op == ir.OP_REFLECT_SET_FIELD_VALUE {
            if instr.arg2 >= 0 { add_unique(vregs, instr.arg2) }
        }
        // MEMCOPY arg3 is vreg (size)
        if op == ir.OP_MEMCOPY && instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        // SYSCALL_OPEN arg3 is vreg (mode), SYSCALL_READ arg3 is vreg (size)
        if (op == ir.OP_SYSCALL_OPEN || op == ir.OP_SYSCALL_READ) && instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        // STORE_INDEX arg3 is vreg (value), MAP_SET arg3 is vreg (value), ARRAY_SLICE arg3 is vreg (end)
        if (op == ir.OP_STORE_INDEX || op == ir.OP_MAP_SET || op == ir.OP_ARRAY_SLICE) && instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        if op == ir.OP_REFLECT_SET_FIELD_VALUE && instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        i = i + 1
    }
    return vregs
}

fn emit_json_marshal(fd: int, instr: IRInstr, ti: int) {
    sname := instr.str_val
    struct_ptr := emit_load_vreg(fd, instr.arg1, ti, 0)

    // Look up field info from struct registry
    count := 0
    start := 0
    si := 0
    for si < len(g_struct_reg_names) {
        if g_struct_reg_names[si] == sname {
            count = g_struct_reg_field_counts[si]
            start = g_struct_reg_field_starts[si]
        }
        si = si + 1
    }

    tis := strconv.Itoa(ti)

    // Start with "{"
    cur := "%jm.cur.0." + tis
    write_str(fd, "  " + cur + " = ptrtoint ptr @.str.lbrace to i64\n")

    // Unroll fields
    fi := 0
    for fi < count {
        fis := strconv.Itoa(fi)
        ftype := g_struct_reg_field_types[start + fi]

        // Load field name from reflect metadata
        fname_ptr := "%jm.fn." + fis + "." + tis
        write_str(fd, "  " + fname_ptr + " = ptrtoint ptr @reflect." + sname + ".fname." + fis + " to i64\n")

        // Call json_QuoteKey(field_name) -> "field_name":
        qk := "%jm.qk." + fis + "." + tis
        write_str(fd, "  " + qk + " = call i64 @json_QuoteKey(i64 " + fname_ptr + ")\n")

        // Concat current result + quoted key
        c1 := "%jm.c1." + fis + "." + tis
        write_str(fd, "  " + c1 + " = call i64 @json_ConcatStr(i64 " + cur + ", i64 " + qk + ")\n")

        // Load field value from struct_ptr + fi*8
        foff := "%jm.fo." + fis + "." + tis
        write_str(fd, "  " + foff + " = add i64 " + struct_ptr + ", " + strconv.Itoa(fi * 8) + "\n")
        fptr := "%jm.fp." + fis + "." + tis
        write_str(fd, "  " + fptr + " = inttoptr i64 " + foff + " to ptr\n")
        fval := "%jm.fv." + fis + "." + tis
        write_str(fd, "  " + fval + " = load i64, ptr " + fptr + "\n")

        // Format based on type: TYPE_INT=1, TYPE_BOOL=2, TYPE_STRING=3
        formatted := "%jm.fmt." + fis + "." + tis
        if ftype == 3 {
            // String: call json_QuoteString
            write_str(fd, "  " + formatted + " = call i64 @json_QuoteString(i64 " + fval + ")\n")
        } else if ftype == 1 {
            // Int: call strconv_Itoa
            write_str(fd, "  " + formatted + " = call i64 @strconv_Itoa(i64 " + fval + ")\n")
        } else if ftype == 2 {
            // Bool: call json_FormatBool
            write_str(fd, "  " + formatted + " = call i64 @json_FormatBool(i64 " + fval + ")\n")
        } else {
            // Default: treat as int
            write_str(fd, "  " + formatted + " = call i64 @strconv_Itoa(i64 " + fval + ")\n")
        }

        // Concat result + formatted value
        c2 := "%jm.c2." + fis + "." + tis
        write_str(fd, "  " + c2 + " = call i64 @json_ConcatStr(i64 " + c1 + ", i64 " + formatted + ")\n")

        // If not last field, concat comma
        next_cur := ""
        if fi < count - 1 {
            comma := "%jm.cm." + fis + "." + tis
            write_str(fd, "  " + comma + " = ptrtoint ptr @.str.comma to i64\n")
            c3 := "%jm.c3." + fis + "." + tis
            write_str(fd, "  " + c3 + " = call i64 @json_ConcatStr(i64 " + c2 + ", i64 " + comma + ")\n")
            next_cur = c3
        } else {
            next_cur = c2
        }

        cur = next_cur
        fi = fi + 1
    }

    // Concat "}"
    rbrace := "%jm.rb." + tis
    write_str(fd, "  " + rbrace + " = ptrtoint ptr @.str.rbrace to i64\n")
    final_result := "%jm.result." + tis
    write_str(fd, "  " + final_result + " = call i64 @json_ConcatStr(i64 " + cur + ", i64 " + rbrace + ")\n")

    emit_store_vreg(fd, instr.dest, final_result)
}

fn emit_json_unmarshal(fd: int, instr: IRInstr, ti: int) {
    sname := instr.str_val
    input_str := emit_load_vreg(fd, instr.arg1, ti, 0)
    tis := strconv.Itoa(ti)

    // Look up field info from struct registry
    count := 0
    start := 0
    si := 0
    for si < len(g_struct_reg_names) {
        if g_struct_reg_names[si] == sname {
            count = g_struct_reg_field_counts[si]
            start = g_struct_reg_field_starts[si]
        }
        si = si + 1
    }

    // Parse JSON: doc_id = json_ParseDocId(input)
    doc_id := "%ju.did." + tis
    write_str(fd, "  " + doc_id + " = call i64 @json_ParseDocId(i64 " + input_str + ")\n")

    // Allocate struct: malloc(count * 8)
    struct_size := count * 8
    if struct_size == 0 { struct_size = 8 }
    sptr := "%ju.sp." + tis
    write_str(fd, "  " + sptr + " = call ptr @gc_alloc(i64 " + strconv.Itoa(struct_size) + ")\n")

    // For each field: GetField(doc_id, field_name, json_type_tag) and store
    fi := 0
    for fi < count {
        fis := strconv.Itoa(fi)
        ftype := g_struct_reg_field_types[start + fi]

        // Map compiler type to json type: TYPE_INT(1)->json_int(2), TYPE_BOOL(2)->json_bool(3), TYPE_STRING(3)->json_string(1)
        json_tag := 0
        if ftype == 1 { json_tag = 2 }
        if ftype == 2 { json_tag = 3 }
        if ftype == 3 { json_tag = 1 }

        // Load field name from reflect metadata
        fname_ptr := "%ju.fn." + fis + "." + tis
        write_str(fd, "  " + fname_ptr + " = ptrtoint ptr @reflect." + sname + ".fname." + fis + " to i64\n")

        // Call GetField(doc_id, field_name, type_tag)
        fval := "%ju.fv." + fis + "." + tis
        write_str(fd, "  " + fval + " = call i64 @json_GetField(i64 " + doc_id + ", i64 " + fname_ptr + ", i64 " + strconv.Itoa(json_tag) + ")\n")

        // Store at struct_ptr + fi*8
        fslot := "%ju.fs." + fis + "." + tis
        write_str(fd, "  " + fslot + " = getelementptr i8, ptr " + sptr + ", i64 " + strconv.Itoa(fi * 8) + "\n")
        write_str(fd, "  store i64 " + fval + ", ptr " + fslot + "\n")

        fi = fi + 1
    }

    // Return struct pointer as i64
    result := "%ju.result." + tis
    write_str(fd, "  " + result + " = ptrtoint ptr " + sptr + " to i64\n")
    emit_store_vreg(fd, instr.dest, result)
}

fn emit_reflect_metadata(fd: int) {
    emitted := []string{}
    si := 0
    for si < len(g_struct_reg_names) {
        sname := g_struct_reg_names[si]
        count := g_struct_reg_field_counts[si]
        start := g_struct_reg_field_starts[si]

        // Skip duplicate struct names
        dup := 0
        ei := 0
        for ei < len(emitted) {
            if emitted[ei] == sname {
                dup = 1
                break
            }
            ei = ei + 1
        }
        if dup == 0 {
            emitted = append(emitted, sname)

            // Emit field name string constants as null-terminated C strings
            fi := 0
            for fi < count {
                fname := g_struct_reg_field_names[start + fi]
                write_str(fd, "@reflect." + sname + ".fname." + strconv.Itoa(fi) + " = private unnamed_addr constant [" + strconv.Itoa(len(fname) + 1) + " x i8] c\"" + fname + "\\00\"\n")
                fi = fi + 1
            }

            // Emit field count
            write_str(fd, "@reflect." + sname + ".count = private constant i64 " + strconv.Itoa(count) + "\n")

            // Emit field names pointer array
            if count > 0 {
                write_str(fd, "@reflect." + sname + ".names = private constant [" + strconv.Itoa(count) + " x ptr] [")
                fi = 0
                for fi < count {
                    if fi > 0 { write_str(fd, ", ") }
                    write_str(fd, "ptr @reflect." + sname + ".fname." + strconv.Itoa(fi))
                    fi = fi + 1
                }
                write_str(fd, "]\n")
            }

            // Emit field types array
            if count > 0 {
                write_str(fd, "@reflect." + sname + ".types = private constant [" + strconv.Itoa(count) + " x i64] [")
                fi = 0
                for fi < count {
                    if fi > 0 { write_str(fd, ", ") }
                    ftype := g_struct_reg_field_types[start + fi]
                    write_str(fd, "i64 " + strconv.Itoa(ftype))
                    fi = fi + 1
                }
                write_str(fd, "]\n")
            }
        }

        si = si + 1
    }
}

fn emit_llvm_ir(instrs: []IRInstr, output_path: string) -> int {
    fd := syscall.open(output_path, 1537, 420)
    if fd < 0 {
        print("ERROR: Failed to open output file: " + output_path + "\n")
        return 1
    }

    // Pass 1: Collect string constants
    string_table := []string{}
    string_dests := []int{}
    si := 0
    for si < len(instrs) {
        if instrs[si].op == ir.OP_LOADCONST {
            if instrs[si].str_val != "" {
                string_table = append(string_table, instrs[si].str_val)
                string_dests = append(string_dests, instrs[si].dest)
            }
        }
        si = si + 1
    }

    // Emit string constants
    sci := 0
    for sci < len(string_table) {
        s := string_table[sci]
        escaped := llvm_escape_string(s)
        write_str(fd, "@.str." + strconv.Itoa(sci) + " = private unnamed_addr constant [" + strconv.Itoa(len(s) + 1) + " x i8] " + escaped + "\n")
        sci = sci + 1
    }
    if len(string_table) > 0 {
        write_str(fd, "\n")
    }

    emit_reflect_metadata(fd)

    // Pass 1b: Collect global variables from ir.OP_LOAD_GLOBAL instructions
    global_names := []string{}
    gi := 0
    for gi < len(instrs) {
        if instrs[gi].op == ir.OP_LOAD_GLOBAL {
            gname := instrs[gi].str_val
            // Check if already collected
            found := 0
            gj := 0
            for gj < len(global_names) {
                if global_names[gj] == gname {
                    found = 1
                    break
                }
                gj = gj + 1
            }
            if found == 0 {
                global_names = append(global_names, gname)
            }
        }
        gi = gi + 1
    }

    // Emit global variable declarations
    gdi := 0
    for gdi < len(global_names) {
        if is_scalar_global(global_names[gdi]) == 1 {
            write_str(fd, "@" + global_names[gdi] + " = global i64 0\n")
        } else {
            write_str(fd, "@" + global_names[gdi] + " = global [24 x i8] zeroinitializer\n")
        }
        gdi = gdi + 1
    }
    if len(global_names) > 0 {
        write_str(fd, "\n")
    }

    emit_gc_globals(fd, global_names)

    // Emit vtable globals
    vti := 0
    for vti < VtableCount() {
        vt_iname := VtableIfaceName(vti)
        vt_sname := VtableStructName(vti)
        vt_mc := iface_method_count(vt_iname)
        vt_size := vt_mc * 8
        write_str(fd, "@vtable." + llvm_mangle(vt_iname + "." + vt_sname) + " = global [" + strconv.Itoa(vt_size) + " x i8] zeroinitializer\n")
        vti = vti + 1
    }
    if VtableCount() > 0 {
        write_str(fd, "\n")
    }

    // Emit runtime declarations
    emit_llvm_decls(fd)

    // Emit extern fn wrappers
    emit_extern_wrappers(fd)

    // Emit helper functions (dir ops)
    emit_llvm_helpers(fd)

    // Pass 2: Emit functions
    fi := 0
    instrs_len := len(instrs)
    for fi < instrs_len {
        if instrs[fi].op == ir.OP_LABEL && instrs[fi].str_val != "" {
            func_name := instrs[fi].str_val
            param_count := instrs[fi].arg1
            func_start := fi + 1

            // Find function end
            func_end := instrs_len
            fj := fi + 1
            for fj < instrs_len {
                if instrs[fj].op == ir.OP_LABEL && instrs[fj].str_val != "" {
                    func_end = fj
                    break
                }
                fj = fj + 1
            }

            // Emit function
            emit_llvm_function(fd, instrs, func_start, func_end, func_name, param_count, string_table, string_dests)

            fi = func_end
        } else {
            fi = fi + 1
        }
    }

    // Emit vtable init function
    emit_llvm_vtable_init(fd)

    // Emit @main wrapper that stores argc/argv and calls ease_user_main
    emit_llvm_main_wrapper(fd)

    syscall.close(fd)
    // Generated LLVM IR
    return 0
}

fn emit_llvm_helpers(fd: int) {
    // ease_is_dir: check if path is a directory using stat()
    // macOS ARM64: struct stat = 144 bytes, st_mode at offset 4 (u16), S_IFDIR=0x4000, S_IFMT=0xF000
    write_str(fd, "define i64 @ease_is_dir(ptr %path) {\n")
    write_str(fd, "  %st = alloca [144 x i8]\n")
    write_str(fd, "  %rc = call i32 @\"\\01_stat\"(ptr %path, ptr %st)\n")
    write_str(fd, "  %fail = icmp ne i32 %rc, 0\n")
    write_str(fd, "  br i1 %fail, label %ret0, label %check\n")
    write_str(fd, "check:\n")
    write_str(fd, "  %mode_ptr = getelementptr i8, ptr %st, i64 4\n")
    write_str(fd, "  %mode16 = load i16, ptr %mode_ptr\n")
    write_str(fd, "  %mode = zext i16 %mode16 to i32\n")
    write_str(fd, "  %masked = and i32 %mode, 61440\n")
    write_str(fd, "  %isdir = icmp eq i32 %masked, 16384\n")
    write_str(fd, "  br i1 %isdir, label %ret1, label %ret0\n")
    write_str(fd, "ret1:\n")
    write_str(fd, "  ret i64 1\n")
    write_str(fd, "ret0:\n")
    write_str(fd, "  ret i64 0\n")
    write_str(fd, "}\n\n")

    // ease_list_dir: list directory entries separated by newlines
    // macOS ARM64: struct dirent d_name at offset 21
    write_str(fd, "define ptr @ease_list_dir(ptr %path) {\n")
    write_str(fd, "  %d = call ptr @\"\\01_opendir\"(ptr %path)\n")
    write_str(fd, "  %dnull = icmp eq ptr %d, null\n")
    write_str(fd, "  br i1 %dnull, label %ld.empty, label %ld.loop\n")
    write_str(fd, "ld.empty:\n")
    write_str(fd, "  %empty = call ptr @gc_alloc(i64 1)\n")
    write_str(fd, "  store i8 0, ptr %empty\n")
    write_str(fd, "  ret ptr %empty\n")
    write_str(fd, "ld.loop:\n")
    // Accumulate result string - start with empty
    write_str(fd, "  %res0 = call ptr @gc_alloc(i64 1)\n")
    write_str(fd, "  store i8 0, ptr %res0\n")
    write_str(fd, "  br label %ld.next\n")
    write_str(fd, "ld.next:\n")
    write_str(fd, "  %res = phi ptr [ %res0, %ld.loop ], [ %newres, %ld.append ], [ %res, %ld.dotcheck ], [ %res, %ld.dotdot2 ]\n")
    write_str(fd, "  %ent = call ptr @\"\\01_readdir\"(ptr %d)\n")
    write_str(fd, "  %enull = icmp eq ptr %ent, null\n")
    write_str(fd, "  br i1 %enull, label %ld.done, label %ld.check\n")
    write_str(fd, "ld.check:\n")
    // Get d_name at offset 21
    write_str(fd, "  %name = getelementptr i8, ptr %ent, i64 21\n")
    // Skip "." and ".."
    write_str(fd, "  %c0 = load i8, ptr %name\n")
    write_str(fd, "  %isdot = icmp eq i8 %c0, 46\n")
    write_str(fd, "  br i1 %isdot, label %ld.dotcheck, label %ld.append\n")
    write_str(fd, "ld.dotcheck:\n")
    write_str(fd, "  %c1ptr = getelementptr i8, ptr %name, i64 1\n")
    write_str(fd, "  %c1 = load i8, ptr %c1ptr\n")
    // "." entry: c1 == 0
    write_str(fd, "  %isdot1 = icmp eq i8 %c1, 0\n")
    write_str(fd, "  br i1 %isdot1, label %ld.next, label %ld.dotdot\n")
    write_str(fd, "ld.dotdot:\n")
    // ".." entry: c1 == '.' and c2 == 0
    write_str(fd, "  %isdot2 = icmp eq i8 %c1, 46\n")
    write_str(fd, "  br i1 %isdot2, label %ld.dotdot2, label %ld.append\n")
    write_str(fd, "ld.dotdot2:\n")
    write_str(fd, "  %c2ptr = getelementptr i8, ptr %name, i64 2\n")
    write_str(fd, "  %c2 = load i8, ptr %c2ptr\n")
    write_str(fd, "  %isdotdot = icmp eq i8 %c2, 0\n")
    write_str(fd, "  br i1 %isdotdot, label %ld.next, label %ld.append\n")
    // Append: result = result + name + "\n"
    write_str(fd, "ld.append:\n")
    write_str(fd, "  %rname = phi ptr [ %name, %ld.check ], [ %name, %ld.dotdot ], [ %name, %ld.dotdot2 ]\n")
    write_str(fd, "  %rlen = call i64 @strlen(ptr %res)\n")
    write_str(fd, "  %nlen = call i64 @strlen(ptr %rname)\n")
    write_str(fd, "  %tlen = add i64 %rlen, %nlen\n")
    write_str(fd, "  %tlen2 = add i64 %tlen, 2\n")
    write_str(fd, "  %newres = call ptr @gc_alloc(i64 %tlen2)\n")
    write_str(fd, "  call ptr @memcpy(ptr %newres, ptr %res, i64 %rlen)\n")
    write_str(fd, "  %ndst = getelementptr i8, ptr %newres, i64 %rlen\n")
    write_str(fd, "  call ptr @memcpy(ptr %ndst, ptr %rname, i64 %nlen)\n")
    write_str(fd, "  %nlpos = add i64 %rlen, %nlen\n")
    write_str(fd, "  %nlptr = getelementptr i8, ptr %newres, i64 %nlpos\n")
    write_str(fd, "  store i8 10, ptr %nlptr\n")
    write_str(fd, "  %nulpos = add i64 %nlpos, 1\n")
    write_str(fd, "  %nulptr = getelementptr i8, ptr %newres, i64 %nulpos\n")
    write_str(fd, "  store i8 0, ptr %nulptr\n")
    write_str(fd, "  br label %ld.next\n")
    write_str(fd, "ld.done:\n")
    write_str(fd, "  call i32 @\"\\01_closedir\"(ptr %d)\n")
    write_str(fd, "  ret ptr %res\n")
    write_str(fd, "}\n\n")
}

fn emit_llvm_vtable_init(fd: int) {
    if VtableCount() == 0 { return }
    write_str(fd, "define void @ease_init_vtables() {\n")
    vti := 0
    for vti < VtableCount() {
        vt_sname := VtableStructName(vti)
        vt_iname := VtableIfaceName(vti)
        vt_mc := iface_method_count(vt_iname)
        vt_global := "@vtable." + llvm_mangle(vt_iname + "." + vt_sname)
        mi := 0
        for mi < vt_mc {
            mname := iface_method_name(vt_iname, mi)
            func_name := lookup_method(vt_sname, mname)
            if func_name != "" {
                actual := lookup_rename(func_name)
                llvm_name := llvm_func_name(actual)
                fp_name := "%vt.fp." + strconv.Itoa(vti) + "." + strconv.Itoa(mi)
                write_str(fd, "  " + fp_name + " = ptrtoint ptr @" + llvm_name + " to i64\n")
                if mi == 0 {
                    write_str(fd, "  store i64 " + fp_name + ", ptr " + vt_global + "\n")
                } else {
                    slot_name := "%vt.slot." + strconv.Itoa(vti) + "." + strconv.Itoa(mi)
                    write_str(fd, "  " + slot_name + " = getelementptr i8, ptr " + vt_global + ", i64 " + strconv.Itoa(mi * 8) + "\n")
                    write_str(fd, "  store i64 " + fp_name + ", ptr " + slot_name + "\n")
                }
            }
            mi = mi + 1
        }
        vti = vti + 1
    }
    write_str(fd, "  ret void\n")
    write_str(fd, "}\n\n")
}

fn emit_llvm_main_wrapper(fd: int) {
    write_str(fd, "define i32 @main(i32 %argc, ptr %argv) {\n")
    write_str(fd, "  %frame = alloca i64\n")
    write_str(fd, "  call void @gc_init(ptr %frame)\n")
    write_str(fd, "  %argc.ext = sext i32 %argc to i64\n")
    write_str(fd, "  store i64 %argc.ext, ptr @g_argc\n")
    write_str(fd, "  store ptr %argv, ptr @g_argv\n")
    if VtableCount() > 0 {
        write_str(fd, "  call void @ease_init_vtables()\n")
    }
    write_str(fd, "  %r = call i64 @ease_user_main()\n")
    write_str(fd, "  %r32 = trunc i64 %r to i32\n")
    write_str(fd, "  ret i32 %r32\n")
    write_str(fd, "}\n\n")
}

fn emit_gc_globals(fd: int, global_names: []string) {
    // Collect address-of-i64-word entries. Scalar globals contribute one
    // entry; 24-byte fat-pointer globals contribute three (word offsets 0, 8, 16).
    // Always include @g_argv at the end.
    entries := []string{}
    gi := 0
    for gi < len(global_names) {
        gname := global_names[gi]
        if is_scalar_global(gname) == 1 {
            entries = append(entries, "ptr @" + gname)
        } else {
            entries = append(entries, "ptr @" + gname)
            entries = append(entries, "ptr getelementptr (i8, ptr @" + gname + ", i64 8)")
            entries = append(entries, "ptr getelementptr (i8, ptr @" + gname + ", i64 16)")
        }
        gi = gi + 1
    }
    entries = append(entries, "ptr @g_argv")

    n := len(entries)
    write_str(fd, "@gc_globals_count = global i64 " + strconv.Itoa(n) + "\n")
    write_str(fd, "@gc_globals = global [" + strconv.Itoa(n) + " x ptr] [")
    ei := 0
    for ei < n {
        if ei > 0 { write_str(fd, ", ") }
        write_str(fd, entries[ei])
        ei = ei + 1
    }
    write_str(fd, "]\n\n")
}

fn find_string_index(dest: int, string_dests: []int) -> int {
    i := 0
    for i < len(string_dests) {
        if string_dests[i] == dest {
            return i
        }
        i = i + 1
    }
    return -1
}

// === Per-opcode emitters ===
// Each helper emits the LLVM IR for a single bootstrap-IR opcode.
// Self-contained ones take (fd, instr, ti); call/iface/closure helpers also
// take call_args. Terminator and ARG opcodes stay inline in emit_llvm_function
// because they mutate the per-iteration `terminated` / `call_args` state.

fn emit_op_loadconst(fd: int, instr: IRInstr, ti: int, string_dests: []int) {
    if instr.str_val != "" {
        str_idx := find_string_index(instr.dest, string_dests)
        if str_idx >= 0 {
            t := tmp_name(ti, 0)
            write_str(fd, "  " + t + " = ptrtoint ptr @.str." + strconv.Itoa(str_idx) + " to i64\n")
            emit_store_vreg(fd, instr.dest, t)
        }
    } else {
        emit_store_vreg(fd, instr.dest, strconv.Itoa(instr.arg1))
    }
}

fn emit_op_load_global(fd: int, instr: IRInstr, ti: int) {
    t := tmp_name(ti, 0)
    write_str(fd, "  " + t + " = ptrtoint ptr @" + instr.str_val + " to i64\n")
    emit_store_vreg(fd, instr.dest, t)
}

fn emit_op_add(fd: int, instr: IRInstr, ti: int) {
    if instr.arg2 == -1 {
        v := emit_load_vreg(fd, instr.arg1, ti, 0)
        emit_store_vreg(fd, instr.dest, v)
    } else {
        emit_llvm_binop(fd, instr, "add", ti)
    }
}

fn emit_op_not(fd: int, instr: IRInstr, ti: int) {
    v := emit_load_vreg(fd, instr.arg1, ti, 0)
    r := tmp_name(ti, 1)
    write_str(fd, "  " + r + " = xor i64 " + v + ", 1\n")
    emit_store_vreg(fd, instr.dest, r)
}

fn emit_op_load(fd: int, instr: IRInstr, ti: int) {
    base := emit_load_vreg(fd, instr.arg1, ti, 0)
    addr_val := ""
    if instr.str_val == "array_index" {
        fp := tmp_name(ti, 1)
        write_str(fd, "  " + fp + " = inttoptr i64 " + base + " to ptr\n")
        dp := tmp_name(ti, 2)
        write_str(fd, "  " + dp + " = load i64, ptr " + fp + "\n")
        idx := emit_load_vreg(fd, instr.arg2, ti, 3)
        scaled := tmp_name(ti, 4)
        write_str(fd, "  " + scaled + " = mul i64 " + idx + ", 8\n")
        a := tmp_name(ti, 5)
        write_str(fd, "  " + a + " = add i64 " + dp + ", " + scaled + "\n")
        addr_val = a
    } else {
        if instr.arg2 == 0 {
            addr_val = base
        } else {
            a := tmp_name(ti, 2)
            write_str(fd, "  " + a + " = add i64 " + base + ", " + strconv.Itoa(instr.arg2) + "\n")
            addr_val = a
        }
    }
    ptr := tmp_name(ti, 6)
    write_str(fd, "  " + ptr + " = inttoptr i64 " + addr_val + " to ptr\n")
    val := tmp_name(ti, 7)
    write_str(fd, "  " + val + " = load i64, ptr " + ptr + "\n")
    emit_store_vreg(fd, instr.dest, val)
}

fn emit_op_store(fd: int, instr: IRInstr, ti: int) {
    addr := emit_load_vreg(fd, instr.arg1, ti, 0)
    val := emit_load_vreg(fd, instr.arg2, ti, 1)
    ptr := tmp_name(ti, 2)
    write_str(fd, "  " + ptr + " = inttoptr i64 " + addr + " to ptr\n")
    write_str(fd, "  store i64 " + val + ", ptr " + ptr + "\n")
}

fn emit_op_store_index(fd: int, instr: IRInstr, ti: int) {
    arr := emit_load_vreg(fd, instr.arg1, ti, 0)
    tis := strconv.Itoa(ti)
    si_fp := "%si.fp." + tis
    write_str(fd, "  " + si_fp + " = inttoptr i64 " + arr + " to ptr\n")
    si_dp := "%si.dp." + tis
    write_str(fd, "  " + si_dp + " = load i64, ptr " + si_fp + "\n")
    idx := emit_load_vreg(fd, instr.arg2, ti, 1)
    si_scaled := "%si.sc." + tis
    write_str(fd, "  " + si_scaled + " = mul i64 " + idx + ", 8\n")
    si_addr := "%si.addr." + tis
    write_str(fd, "  " + si_addr + " = add i64 " + si_dp + ", " + si_scaled + "\n")
    si_ptr := "%si.ptr." + tis
    write_str(fd, "  " + si_ptr + " = inttoptr i64 " + si_addr + " to ptr\n")
    val := emit_load_vreg(fd, instr.arg3, ti, 2)
    write_str(fd, "  store i64 " + val + ", ptr " + si_ptr + "\n")
}

fn emit_op_copy(fd: int, instr: IRInstr, ti: int) {
    val := emit_load_vreg(fd, instr.arg1, ti, 0)
    emit_store_vreg(fd, instr.dest, val)
}

fn emit_op_alloca(fd: int, instr: IRInstr, ti: int) {
    size := strconv.Itoa(instr.arg1)
    p := tmp_name(ti, 0)
    write_str(fd, "  " + p + " = call ptr @gc_alloc(i64 " + size + ")\n")
    z := tmp_name(ti, 1)
    write_str(fd, "  " + z + " = call ptr @memset(ptr " + p + ", i32 0, i64 " + size + ")\n")
    emit_ptrtoint_store(fd, instr.dest, p, ti, 2)
}

fn emit_op_indexaddr(fd: int, instr: IRInstr, ti: int) {
    base := emit_load_vreg(fd, instr.arg1, ti, 0)
    if instr.arg2 == 0 {
        emit_store_vreg(fd, instr.dest, base)
    } else {
        r := tmp_name(ti, 1)
        write_str(fd, "  " + r + " = add i64 " + base + ", " + strconv.Itoa(instr.arg2) + "\n")
        emit_store_vreg(fd, instr.dest, r)
    }
}

fn emit_op_memcopy(fd: int, instr: IRInstr, ti: int) {
    src := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
    dst := emit_load_ptr(fd, instr.arg2, ti, 2, 3)
    size := emit_load_vreg(fd, instr.arg3, ti, 4)
    write_str(fd, "  call ptr @memcpy(ptr " + dst + ", ptr " + src + ", i64 " + size + ")\n")
}

fn emit_op_array_len(fd: int, instr: IRInstr, ti: int) {
    base := emit_load_vreg(fd, instr.arg1, ti, 0)
    addr := tmp_name(ti, 1)
    write_str(fd, "  " + addr + " = add i64 " + base + ", 8\n")
    ptr := tmp_name(ti, 2)
    write_str(fd, "  " + ptr + " = inttoptr i64 " + addr + " to ptr\n")
    val := tmp_name(ti, 3)
    write_str(fd, "  " + val + " = load i64, ptr " + ptr + "\n")
    emit_store_vreg(fd, instr.dest, val)
}

fn emit_op_array_slice(fd: int, instr: IRInstr, ti: int) {
    tis := strconv.Itoa(ti)
    fp := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
    dp := "%sl.dp." + tis
    write_str(fd, "  " + dp + " = load i64, ptr " + fp + "\n")
    cap_addr := "%sl.ca." + tis
    write_str(fd, "  " + cap_addr + " = getelementptr i8, ptr " + fp + ", i64 16\n")
    old_cap := "%sl.oc." + tis
    write_str(fd, "  " + old_cap + " = load i64, ptr " + cap_addr + "\n")
    start := emit_load_vreg(fd, instr.arg2, ti, 2)
    end := emit_load_vreg(fd, instr.arg3, ti, 3)
    scaled := "%sl.sc." + tis
    write_str(fd, "  " + scaled + " = mul i64 " + start + ", 8\n")
    new_dp := "%sl.nd." + tis
    write_str(fd, "  " + new_dp + " = add i64 " + dp + ", " + scaled + "\n")
    new_len := "%sl.nl." + tis
    write_str(fd, "  " + new_len + " = sub i64 " + end + ", " + start + "\n")
    new_cap := "%sl.nc." + tis
    write_str(fd, "  " + new_cap + " = sub i64 " + old_cap + ", " + start + "\n")
    new_fp := "%sl.fp." + tis
    write_str(fd, "  " + new_fp + " = call ptr @gc_alloc(i64 24)\n")
    write_str(fd, "  store i64 " + new_dp + ", ptr " + new_fp + "\n")
    len_ptr := "%sl.lp." + tis
    write_str(fd, "  " + len_ptr + " = getelementptr i8, ptr " + new_fp + ", i64 8\n")
    write_str(fd, "  store i64 " + new_len + ", ptr " + len_ptr + "\n")
    cap_ptr := "%sl.cp." + tis
    write_str(fd, "  " + cap_ptr + " = getelementptr i8, ptr " + new_fp + ", i64 16\n")
    write_str(fd, "  store i64 " + new_cap + ", ptr " + cap_ptr + "\n")
    result := "%sl.r." + tis
    write_str(fd, "  " + result + " = ptrtoint ptr " + new_fp + " to i64\n")
    emit_store_vreg(fd, instr.dest, result)
}

fn emit_op_array_push(fd: int, instr: IRInstr, ti: int) {
    fp := emit_load_ptr(fd, instr.arg1, ti, 0, 1)
    elem := emit_load_vreg(fd, instr.arg2, ti, 2)
    tis := strconv.Itoa(ti)
    ptr_val := "%ap.ptr." + tis
    write_str(fd, "  " + ptr_val + " = load i64, ptr " + fp + "\n")
    len_addr := "%ap.la." + tis
    write_str(fd, "  " + len_addr + " = getelementptr i8, ptr " + fp + ", i64 8\n")
    len_val := "%ap.len." + tis
    write_str(fd, "  " + len_val + " = load i64, ptr " + len_addr + "\n")
    cap_addr := "%ap.ca." + tis
    write_str(fd, "  " + cap_addr + " = getelementptr i8, ptr " + fp + ", i64 16\n")
    cap_val := "%ap.cap." + tis
    write_str(fd, "  " + cap_val + " = load i64, ptr " + cap_addr + "\n")
    needs_grow := "%ap.ng." + tis
    write_str(fd, "  " + needs_grow + " = icmp sge i64 " + len_val + ", " + cap_val + "\n")
    write_str(fd, "  br i1 " + needs_grow + ", label %ap.grow." + tis + ", label %ap.do." + tis + "\n")
    write_str(fd, "ap.grow." + tis + ":\n")
    cap_is_zero := "%ap.cz." + tis
    write_str(fd, "  " + cap_is_zero + " = icmp eq i64 " + cap_val + ", 0\n")
    cap_double := "%ap.cd." + tis
    write_str(fd, "  " + cap_double + " = mul i64 " + cap_val + ", 2\n")
    new_cap := "%ap.nc." + tis
    write_str(fd, "  " + new_cap + " = select i1 " + cap_is_zero + ", i64 4, i64 " + cap_double + "\n")
    alloc_size := "%ap.as." + tis
    write_str(fd, "  " + alloc_size + " = mul i64 " + new_cap + ", 8\n")
    new_ptr := "%ap.np." + tis
    write_str(fd, "  " + new_ptr + " = call ptr @gc_alloc(i64 " + alloc_size + ")\n")
    old_ptr := "%ap.op." + tis
    write_str(fd, "  " + old_ptr + " = inttoptr i64 " + ptr_val + " to ptr\n")
    copy_size := "%ap.cs." + tis
    write_str(fd, "  " + copy_size + " = mul i64 " + len_val + ", 8\n")
    write_str(fd, "  call ptr @memcpy(ptr " + new_ptr + ", ptr " + old_ptr + ", i64 " + copy_size + ")\n")
    new_ptr_int := "%ap.ni." + tis
    write_str(fd, "  " + new_ptr_int + " = ptrtoint ptr " + new_ptr + " to i64\n")
    write_str(fd, "  store i64 " + new_ptr_int + ", ptr " + fp + "\n")
    write_str(fd, "  store i64 " + new_cap + ", ptr " + cap_addr + "\n")
    write_str(fd, "  br label %ap.do." + tis + "\n")
    write_str(fd, "ap.do." + tis + ":\n")
    cur_ptr := "%ap.cp." + tis
    write_str(fd, "  " + cur_ptr + " = load i64, ptr " + fp + "\n")
    elem_offset := "%ap.eo." + tis
    write_str(fd, "  " + elem_offset + " = mul i64 " + len_val + ", 8\n")
    elem_addr := "%ap.ea." + tis
    write_str(fd, "  " + elem_addr + " = add i64 " + cur_ptr + ", " + elem_offset + "\n")
    elem_ptr := "%ap.ep." + tis
    write_str(fd, "  " + elem_ptr + " = inttoptr i64 " + elem_addr + " to ptr\n")
    write_str(fd, "  store i64 " + elem + ", ptr " + elem_ptr + "\n")
    new_len := "%ap.nl." + tis
    write_str(fd, "  " + new_len + " = add i64 " + len_val + ", 1\n")
    write_str(fd, "  store i64 " + new_len + ", ptr " + len_addr + "\n")
}

fn emit_op_reflect_num_field(fd: int, instr: IRInstr, ti: int) {
