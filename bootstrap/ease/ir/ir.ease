package ir

// IR types, opcodes, symbol table, and struct layout for the Ease bootstrap compiler

struct IRInstr {
    op: int,       // Instruction opcode
    dest: int,     // Destination vreg or label id
    arg1: int,     // First argument vreg or immediate
    arg2: int,     // Second argument vreg or label id
    arg3: int,     // Third argument vreg (for operations like str_substring)
    str_val: string, // For function names, variable names, etc.
}

struct SymbolTable {
    names: []string,  // Variable names
    vregs: []int,     // Corresponding virtual registers
    types: []int,     // Type tags (TYPE_INT, TYPE_BOOL, etc.)
}

fn symtab_new() -> SymbolTable {
    return SymbolTable {
        names: []string{},
        vregs: []int{}
    }
}

fn symtab_add(st: SymbolTable, name: string, vreg: int) {
    push(st.names, name)
    push(st.vregs, vreg)
}

fn symtab_lookup(st: SymbolTable, name: string) -> int {
    // Search backwards to find the most recent binding (handles shadowing)
    i := len(st.names) - 1
    for i >= 0 {
        if st.names[i] == name {
            return st.vregs[i]
        }
        i = i - 1
    }
    return -1  // Not found
}

// IR Opcodes
const OP_LOADCONST = 1
const OP_ADD = 2
const OP_SUB = 3
const OP_MUL = 4
const OP_DIV = 5
const OP_CMP_LT = 6
const OP_CMP_GT = 7
const OP_CMP_LE = 8
const OP_CMP_GE = 9
const OP_CMP_EQ = 10
const OP_CMP_NE = 11
const OP_AND = 12
const OP_OR = 13
const OP_NOT = 14
const OP_XOR = 15
const OP_BITAND = 16
const OP_BITOR = 17
const OP_ALLOCA = 20
const OP_STORE = 21
const OP_LOAD = 22
const OP_INDEXADDR = 23  // Pointer arithmetic: base + offset
const OP_MEMCOPY = 24    // Memory copy: src, dest, size
const OP_ARRAY_PUSH = 25 // Array push: array, elem, elem_size
const OP_ARRAY_LEN = 26  // Array length: returns len from fat pointer
const OP_STR_CHAR_AT = 27 // String char at: str, index -> char (int)
const OP_STR_SUBSTRING = 28 // String substring: str, start, end -> str
const OP_POKE = 29  // Write byte to memory: addr, value
const OP_RET = 30
const OP_PEEK = 31  // Read byte from memory: addr -> value
const OP_HEAP_ALLOC = 32  // Allocate memory: size -> pointer
const OP_CALL = 33
const OP_ARG = 34
const OP_READFILE = 35  // Read file: path -> content string
const OP_ARGC = 36     // Get argument count -> int
const OP_ARGV = 37     // Get argument at index: index -> string
const OP_INT_TO_STR = 38 // Convert int to string: int -> string
const OP_PRINT = 39 // Print string to stdout: string -> ()
const OP_LABEL = 40
const OP_JUMP = 41
const OP_BRANCH = 42
const OP_SYSCALL_OPEN = 43
const OP_SYSCALL_WRITE = 44
const OP_SYSCALL_CLOSE = 45
const OP_STR_EQ = 46
const OP_STR_NE = 47
const OP_STR_CONCAT = 48
const OP_COPY = 49
const OP_LOAD_GLOBAL = 50
const OP_STR_LEN = 51
const OP_SYSCALL_READ = 52
const OP_IS_DIR = 53
const OP_LIST_DIR = 54
const OP_MOD = 55
const OP_SETJMP = 56
const OP_TEST_FAIL = 57
const OP_TIME_NANOS = 58
const OP_TIME_WALLCLOCK = 59

// Struct definitions and offsets (hardcoded for known structs)
// AstNode: tag(8), int_val(8), str_val(8), left(8), right(8), extra(8), type_tag(8) = 56 bytes
// IRInstr: op(8), dest(8), arg1(8), arg2(8), arg3(8), str_val(8) = 48 bytes
// ParseResult: node_idx(8), new_pos(8) = 16 bytes

// Dynamic struct registry
g_struct_reg_names := []string{}
g_struct_reg_field_counts := []int{}
g_struct_reg_field_starts := []int{}
g_struct_reg_field_names := []string{}

fn RegisterStruct(name: string, field_names: []string) {
    push(g_struct_reg_names, name)
    push(g_struct_reg_field_counts, len(field_names))
    push(g_struct_reg_field_starts, len(g_struct_reg_field_names))
    i := 0
    for i < len(field_names) {
        push(g_struct_reg_field_names, field_names[i])
        i = i + 1
    }
}

fn struct_size(struct_name: string) -> int {
    if struct_name == "AstNode" { return 56 }
    if struct_name == "IRInstr" { return 48 }
    if struct_name == "ParseResult" { return 16 }
    // Look up in dynamic registry
    ri := 0
    for ri < len(g_struct_reg_names) {
        if g_struct_reg_names[ri] == struct_name {
            return g_struct_reg_field_counts[ri] * 8
        }
        ri = ri + 1
    }
    return 64  // Default: 8 fields * 8 bytes
}

fn field_offset(struct_name: string, field_name: string) -> int {
    // AstNode fields
    if struct_name == "AstNode" {
        if field_name == "tag" { return 0 }
        if field_name == "int_val" { return 8 }
        if field_name == "str_val" { return 16 }
        if field_name == "left" { return 24 }
        if field_name == "right" { return 32 }
        if field_name == "extra" { return 40 }
        if field_name == "type_tag" { return 48 }
    }
    // IRInstr fields
    if struct_name == "IRInstr" {
        if field_name == "op" { return 0 }
        if field_name == "dest" { return 8 }
        if field_name == "arg1" { return 16 }
        if field_name == "arg2" { return 24 }
        if field_name == "arg3" { return 32 }
        if field_name == "str_val" { return 40 }
    }
    // ParseResult fields
    if struct_name == "ParseResult" {
        if field_name == "node_idx" { return 0 }
        if field_name == "new_pos" { return 8 }
    }
    // SymbolTable fields
    if struct_name == "SymbolTable" {
        if field_name == "names" { return 0 }
        if field_name == "vregs" { return 8 }
        if field_name == "types" { return 16 }
    }
    // Look up in dynamic registry
    ri := 0
    for ri < len(g_struct_reg_names) {
        if g_struct_reg_names[ri] == struct_name {
            start := g_struct_reg_field_starts[ri]
            count := g_struct_reg_field_counts[ri]
            fi := 0
            for fi < count {
                if g_struct_reg_field_names[start + fi] == field_name {
                    return fi * 8
                }
                fi = fi + 1
            }
        }
        ri = ri + 1
    }
    return 0  // Unknown field, return 0
}

fn get_struct_field_names(name: string) -> []string {
    if name == "AstNode" { return []string{"tag", "int_val", "str_val", "left", "right", "extra", "type_tag"} }
    if name == "IRInstr" { return []string{"op", "dest", "arg1", "arg2", "arg3", "str_val"} }
    if name == "ParseResult" { return []string{"node_idx", "new_pos"} }
    // Look up in dynamic registry
    ri := 0
    for ri < len(g_struct_reg_names) {
        if g_struct_reg_names[ri] == name {
            start := g_struct_reg_field_starts[ri]
            count := g_struct_reg_field_counts[ri]
            result := []string{}
            fi := 0
            for fi < count {
                push(result, g_struct_reg_field_names[start + fi])
                fi = fi + 1
            }
            return result
        }
        ri = ri + 1
    }
    return []string{}
}

// Enum registry
g_enum_names := []string{}
g_enum_variant_counts := []int{}
g_enum_variant_starts := []int{}
g_enum_variant_names := []string{}
g_enum_variant_field_counts := []int{}
g_enum_variant_field_starts := []int{}
g_enum_variant_field_names := []string{}
g_enum_variant_field_types := []int{}

fn RegisterEnum(name: string, variants: []string, field_counts: []int, field_names: []string, field_types: []int) {
    push(g_enum_names, name)
    push(g_enum_variant_counts, len(variants))
    push(g_enum_variant_starts, len(g_enum_variant_names))
    vi := 0
    for vi < len(variants) {
        push(g_enum_variant_names, variants[vi])
        push(g_enum_variant_field_counts, field_counts[vi])
        push(g_enum_variant_field_starts, len(g_enum_variant_field_names))
        // Copy field names for this variant
        fi := 0
        for fi < field_counts[vi] {
            // field_names is a flat array — compute offset from cumulative field counts
            offset := 0
            oi := 0
            for oi < vi {
                offset = offset + field_counts[oi]
                oi = oi + 1
            }
            push(g_enum_variant_field_names, field_names[offset + fi])
            push(g_enum_variant_field_types, field_types[offset + fi])
            fi = fi + 1
        }
        vi = vi + 1
    }
}

fn enum_tag(enum_name: string, variant_name: string) -> int {
    ei := 0
    for ei < len(g_enum_names) {
        if g_enum_names[ei] == enum_name {
            start := g_enum_variant_starts[ei]
            count := g_enum_variant_counts[ei]
            vi := 0
            for vi < count {
                if g_enum_variant_names[start + vi] == variant_name {
                    return vi
                }
                vi = vi + 1
            }
        }
        ei = ei + 1
    }
    return -1
}

fn enum_max_size(enum_name: string) -> int {
    ei := 0
    for ei < len(g_enum_names) {
        if g_enum_names[ei] == enum_name {
            start := g_enum_variant_starts[ei]
            count := g_enum_variant_counts[ei]
            max_fields := 0
            vi := 0
            for vi < count {
                fc := g_enum_variant_field_counts[start + vi]
                if fc > max_fields {
                    max_fields = fc
                }
                vi = vi + 1
            }
            return 8 + max_fields * 8
        }
        ei = ei + 1
    }
    return 8
}

fn enum_variant_field_offset(enum_name: string, variant_name: string, field_name: string) -> int {
    ei := 0
    for ei < len(g_enum_names) {
        if g_enum_names[ei] == enum_name {
            start := g_enum_variant_starts[ei]
            count := g_enum_variant_counts[ei]
            vi := 0
            for vi < count {
                if g_enum_variant_names[start + vi] == variant_name {
                    fstart := g_enum_variant_field_starts[start + vi]
                    fcount := g_enum_variant_field_counts[start + vi]
                    fi := 0
                    for fi < fcount {
                        if g_enum_variant_field_names[fstart + fi] == field_name {
                            return 8 + fi * 8
                        }
                        fi = fi + 1
                    }
                }
                vi = vi + 1
            }
        }
        ei = ei + 1
    }
    return 8
}

fn enum_variant_field_count(enum_name: string, variant_name: string) -> int {
    ei := 0
    for ei < len(g_enum_names) {
        if g_enum_names[ei] == enum_name {
            start := g_enum_variant_starts[ei]
            count := g_enum_variant_counts[ei]
            vi := 0
            for vi < count {
                if g_enum_variant_names[start + vi] == variant_name {
                    return g_enum_variant_field_counts[start + vi]
                }
                vi = vi + 1
            }
        }
        ei = ei + 1
    }
    return 0
}

fn enum_variant_field_name(enum_name: string, variant_name: string, field_idx: int) -> string {
    ei := 0
    for ei < len(g_enum_names) {
        if g_enum_names[ei] == enum_name {
            start := g_enum_variant_starts[ei]
            count := g_enum_variant_counts[ei]
            vi := 0
            for vi < count {
                if g_enum_variant_names[start + vi] == variant_name {
                    fstart := g_enum_variant_field_starts[start + vi]
                    return g_enum_variant_field_names[fstart + field_idx]
                }
                vi = vi + 1
            }
        }
        ei = ei + 1
    }
    return ""
}

fn enum_variant_field_type(enum_name: string, variant_name: string, field_name: string) -> int {
    ei := 0
    for ei < len(g_enum_names) {
        if g_enum_names[ei] == enum_name {
            start := g_enum_variant_starts[ei]
            count := g_enum_variant_counts[ei]
            vi := 0
            for vi < count {
                if g_enum_variant_names[start + vi] == variant_name {
                    fstart := g_enum_variant_field_starts[start + vi]
                    fcount := g_enum_variant_field_counts[start + vi]
                    fi := 0
                    for fi < fcount {
                        if g_enum_variant_field_names[fstart + fi] == field_name {
                            return g_enum_variant_field_types[fstart + fi]
                        }
                        fi = fi + 1
                    }
                }
                vi = vi + 1
            }
        }
        ei = ei + 1
    }
    return TYPE_UNKNOWN
}

fn is_scalar_global(name: string) -> int {
    i := 0
    for i < len(g_scalar_globals) {
        if g_scalar_globals[i] == name { return 1 }
        i = i + 1
    }
    return 0
}
