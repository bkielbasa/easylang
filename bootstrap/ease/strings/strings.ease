package strings

// String functions for the Ease bootstrap compiler

fn str_substring(s: string, start: int, end_pos: int) -> string {
    slen := len(s)
    a := start
    b := end_pos
    if a < 0 { a = 0 }
    if b > slen { b = slen }
    if a >= b { return "" }
    length := b - a
    buf := heap_alloc(length + 1)
    i := 0
    for i < length {
        poke(buf + i, str_char_at(s, a + i))
        i = i + 1
    }
    poke(buf + length, 0)
    return buf
}

fn Contains(s: string, sub: string) -> int {
    slen := len(s)
    sublen := len(sub)
    if sublen == 0 { return 1 }
    if sublen > slen { return 0 }
    limit := slen - sublen
    i := 0
    for i <= limit {
        j := 0
        found := 1
        for j < sublen {
            if str_char_at(s, i + j) != str_char_at(sub, j) {
                found = 0
                break
            }
            j = j + 1
        }
        if found == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn HasPrefix(s: string, pre: string) -> int {
    slen := len(s)
    plen := len(pre)
    if plen > slen { return 0 }
    i := 0
    for i < plen {
        if str_char_at(s, i) != str_char_at(pre, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn HasSuffix(s: string, suf: string) -> int {
    slen := len(s)
    suflen := len(suf)
    if suflen > slen { return 0 }
    offset := slen - suflen
    i := 0
    for i < suflen {
        if str_char_at(s, offset + i) != str_char_at(suf, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn Concat(a: string, b: string) -> string {
    return a + b
}

fn StartsWith(s: string, prefix: string) -> int {
    return HasPrefix(s, prefix)
}

fn EndsWith(s: string, suffix: string) -> int {
    return HasSuffix(s, suffix)
}

fn IndexOf(s: string, substr: string) -> int {
    return Index(s, substr)
}

fn LineColToOffset(src: string, line: int, col: int) -> int {
    slen := len(src)
    i := 0
    cur_line := 0
    for cur_line < line {
        if i >= slen { return slen }
        if str_char_at(src, i) == 10 {
            cur_line = cur_line + 1
        }
        i = i + 1
    }
    // Now at the start of the target line, advance by col
    cur_col := 0
    for cur_col < col {
        if i >= slen { return slen }
        if str_char_at(src, i) == 10 { break }
        cur_col = cur_col + 1
        i = i + 1
    }
    return i
}

fn OffsetToLineCol(src: string, offset: int) -> string {
    line := 1
    col := 1
    i := 0
    for i < offset {
        if i >= len(src) { break }
        if str_char_at(src, i) == 10 {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return strconv.Itoa(line) + ":" + strconv.Itoa(col)
}

fn GetSourceLine(src: string, offset: int) -> string {
    slen := len(src)
    if offset >= slen { return "" }
    // Find start of line
    start := offset
    for start > 0 {
        if str_char_at(src, start - 1) == 10 { break }
        start = start - 1
    }
    // Find end of line
    end := offset
    for end < slen {
        if str_char_at(src, end) == 10 { break }
        end = end + 1
    }
    return str_substring(src, start, end)
}

fn GetColumn(src: string, offset: int) -> int {
    col := 1
    i := offset
    for i > 0 {
        if str_char_at(src, i - 1) == 10 { break }
        col = col + 1
        i = i - 1
    }
    return col
}

fn Index(s: string, sub: string) -> int {
    slen := len(s)
    sublen := len(sub)
    if sublen == 0 { return 0 }
    if sublen > slen { return -1 }
    limit := slen - sublen
    i := 0
    for i <= limit {
        j := 0
        found := 1
        for j < sublen {
            if str_char_at(s, i + j) != str_char_at(sub, j) {
                found = 0
                break
            }
            j = j + 1
        }
        if found == 1 { return i }
        i = i + 1
    }
    return -1
}

fn Split(s: string, sep: string) -> []string {
    parts := []string{}
    slen := len(s)
    seplen := len(sep)
    if seplen == 0 {
        parts = append(parts, s)
        return parts
    }
    start := 0
    for start <= slen {
        idx := Index(str_substring(s, start, slen), sep)
        if idx == -1 {
            parts = append(parts, str_substring(s, start, slen))
            break
        }
        parts = append(parts, str_substring(s, start, start + idx))
        start = start + idx + seplen
        if start > slen {
            parts = append(parts, "")
        }
    }
    return parts
}

fn Join(parts: []string, sep: string) -> string {
    n := len(parts)
    if n == 0 { return "" }
    result := parts[0]
    i := 1
    for i < n {
        result = result + sep + parts[i]
        i = i + 1
    }
    return result
}

fn is_whitespace(c: int) -> int {
    if c == 32 { return 1 }
    if c == 9 { return 1 }
    if c == 10 { return 1 }
    if c == 13 { return 1 }
    return 0
}

fn TrimSpace(s: string) -> string {
    slen := len(s)
    if slen == 0 { return "" }
    start := 0
    for start < slen {
        if is_whitespace(str_char_at(s, start)) == 0 { break }
        start = start + 1
    }
    end := slen
    for end > start {
        if is_whitespace(str_char_at(s, end - 1)) == 0 { break }
        end = end - 1
    }
    return str_substring(s, start, end)
}

fn ReplaceAll(s: string, old: string, new: string) -> string {
    oldlen := len(old)
    if oldlen == 0 { return s }
    result := ""
    slen := len(s)
    i := 0
    for i <= slen {
        idx := Index(str_substring(s, i, slen), old)
        if idx == -1 {
            result = result + str_substring(s, i, slen)
            break
        }
        result = result + str_substring(s, i, i + idx) + new
        i = i + idx + oldlen
    }
    return result
}

fn ToUpper(s: string) -> string {
    slen := len(s)
    buf := heap_alloc(slen + 1)
    i := 0
    for i < slen {
        c := str_char_at(s, i)
        if c >= 97 && c <= 122 {
            c = c - 32
        }
        poke(buf + i, c)
        i = i + 1
    }
    poke(buf + slen, 0)
    return buf
}

fn ToLower(s: string) -> string {
    slen := len(s)
    buf := heap_alloc(slen + 1)
    i := 0
    for i < slen {
        c := str_char_at(s, i)
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        poke(buf + i, c)
        i = i + 1
    }
    poke(buf + slen, 0)
    return buf
}

fn Count(s: string, sub: string) -> int {
    sublen := len(sub)
    if sublen == 0 { return 0 }
    slen := len(s)
    count := 0
    i := 0
    for i <= slen - sublen {
        idx := Index(str_substring(s, i, slen), sub)
        if idx == -1 { break }
        count = count + 1
        i = i + idx + sublen
    }
    return count
}

fn Repeat(s: string, n: int) -> string {
    if n <= 0 { return "" }
    result := ""
    i := 0
    for i < n {
        result = result + s
        i = i + 1
    }
    return result
}

// Builder - mutable string builder using global-array pattern
g_builder_count := 0
g_builder_doc := []int{}
g_builder_parts := []string{}

struct Builder { id: int }

fn NewBuilder() -> Builder {
    id := g_builder_count
    g_builder_count = g_builder_count + 1
    return Builder { id: id }
}

fn (b: Builder) WriteString(s: string) -> int {
    g_builder_doc = append(g_builder_doc, b.id)
    g_builder_parts = append(g_builder_parts, s)
    return len(s)
}

fn (b: Builder) Write(s: string) -> int {
    return b.WriteString(s)
}

fn (b: Builder) String() -> string {
    result := ""
    i := 0
    blen := len(g_builder_doc)
    for i < blen {
        if g_builder_doc[i] == b.id {
            result = result + g_builder_parts[i]
        }
        i = i + 1
    }
    return result
}

fn (b: Builder) Len() -> int {
    return len(b.String())
}

fn (b: Builder) Reset() {
    // Clear all entries belonging to this builder by setting doc IDs to -1
    i := 0
    blen := len(g_builder_doc)
    for i < blen {
        if g_builder_doc[i] == b.id {
            g_builder_doc[i] = -1
        }
        i = i + 1
    }
}
