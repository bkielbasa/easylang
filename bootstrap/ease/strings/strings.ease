package strings

// String functions for the Ease bootstrap compiler

fn str_substring(s: string, start: int, end_pos: int) -> string {
    slen := len(s)
    a := start
    b := end_pos
    if a < 0 { a = 0 }
    if b > slen { b = slen }
    if a >= b { return "" }
    length := b - a
    buf := heap_alloc(length + 1)
    i := 0
    for i < length {
        poke(buf + i, str_char_at(s, a + i))
        i = i + 1
    }
    poke(buf + length, 0)
    return buf
}

fn Contains(s: string, sub: string) -> int {
    slen := len(s)
    sublen := len(sub)
    if sublen == 0 { return 1 }
    if sublen > slen { return 0 }
    limit := slen - sublen
    i := 0
    for i <= limit {
        j := 0
        found := 1
        for j < sublen {
            if str_char_at(s, i + j) != str_char_at(sub, j) {
                found = 0
                break
            }
            j = j + 1
        }
        if found == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn HasPrefix(s: string, pre: string) -> int {
    slen := len(s)
    plen := len(pre)
    if plen > slen { return 0 }
    i := 0
    for i < plen {
        if str_char_at(s, i) != str_char_at(pre, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn HasSuffix(s: string, suf: string) -> int {
    slen := len(s)
    suflen := len(suf)
    if suflen > slen { return 0 }
    offset := slen - suflen
    i := 0
    for i < suflen {
        if str_char_at(s, offset + i) != str_char_at(suf, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn Concat(a: string, b: string) -> string {
    return a + b
}

fn StartsWith(s: string, prefix: string) -> int {
    return HasPrefix(s, prefix)
}

fn EndsWith(s: string, suffix: string) -> int {
    return HasSuffix(s, suffix)
}

fn IndexOf(s: string, substr: string) -> int {
    return Index(s, substr)
}

fn Index(s: string, sub: string) -> int {
    slen := len(s)
    sublen := len(sub)
    if sublen == 0 { return 0 }
    if sublen > slen { return -1 }
    limit := slen - sublen
    i := 0
    for i <= limit {
        j := 0
        found := 1
        for j < sublen {
            if str_char_at(s, i + j) != str_char_at(sub, j) {
                found = 0
                break
            }
            j = j + 1
        }
        if found == 1 { return i }
        i = i + 1
    }
    return -1
}
