package parser

// Parser - recursive descent parser for the Ease bootstrap compiler

// Type name side table: maps AST node indices to struct type names
g_type_name_node_idx := []int{}
g_type_name_str := []string{}

// Method declaration side table
g_method_decl_node_idx := []int{}
g_method_decl_struct := []string{}
g_method_decl_name := []string{}

// Closure function side table
g_closure_func_indices := []int{}
g_closure_func_names := []string{}
g_closure_counter := []int{}

fn count_line_at(src: string, offset: int) -> int {
    line := 1
    i := 0
    for i < offset {
        if i >= len(src) { break }
        if str_char_at(src, i) == 10 { line = line + 1 }
        i = i + 1
    }
    return line
}

fn lookup_type_name(node_idx: int) -> string {
    i := 0
    for i < len(g_type_name_node_idx) {
        if g_type_name_node_idx[i] == node_idx { return g_type_name_str[i] }
        i = i + 1
    }
    return ""
}

// Skip type arguments in type position: Box[int], Result[int, string]
// Returns new position after ] or original pos if no [
fn skip_type_args(src: string, pos: int) -> int {
    p := lex_skip(src, pos)
    if lex_kind(src, p) != token.TK_LBRACKET { return pos }
    p = lex_end(src, p, token.TK_LBRACKET)
    p = lex_skip(src, p)
    depth := 1
    for depth > 0 {
        if lex_kind(src, p) == token.TK_EOF { break }
        if lex_kind(src, p) == token.TK_LBRACKET {
            depth = depth + 1
        }
        if lex_kind(src, p) == token.TK_RBRACKET {
            depth = depth - 1
            if depth == 0 {
                p = lex_end(src, p, token.TK_RBRACKET)
                break
            }
        }
        p = lex_end(src, p, lex_kind(src, p))
        p = lex_skip(src, p)
    }
    return p
}

// Record type arguments for constraint checking: Name[ConcreteType, ...]
// Extracts the first identifier at each type arg position and records it in sema
fn record_type_args(src: string, pos: int, decl_name: string, line: int) {
    p := lex_skip(src, pos)
    if lex_kind(src, p) != token.TK_LBRACKET { return }
    p = lex_end(src, p, token.TK_LBRACKET)
    p = lex_skip(src, p)
    param_idx := 0
    recorded := 0
    depth := 0
    for lex_kind(src, p) != token.TK_EOF {
        k := lex_kind(src, p)
        if k == token.TK_RBRACKET {
            if depth == 0 { break }
            depth = depth - 1
        }
        if k == token.TK_LBRACKET { depth = depth + 1 }
        if k == token.TK_COMMA && depth == 0 {
            param_idx = param_idx + 1
            recorded = 0
            p = lex_end(src, p, k)
            p = lex_skip(src, p)
        } else {
            if k == token.TK_IDENT && depth == 0 && recorded == 0 {
                type_name := lex_string_value(src, p, token.TK_IDENT)
                sema.RecordTypeInstantiation(decl_name, param_idx, type_name, line)
                recorded = 1
            }
            p = lex_end(src, p, k)
            p = lex_skip(src, p)
        }
    }
}

// Parse generic type parameters: [T], [T, U], [T: Constraint]
// Stores params in sema via RegisterTypeParams
// Returns count of type params parsed in node_idx (0 if none)
fn parse_type_params(src: string, pos: int, decl_name: string) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    if lex_kind(src, p) != token.TK_LBRACKET {
        return ParseResult { node_idx: 0, new_pos: pos }
    }
    p = lex_end(src, p, token.TK_LBRACKET)
    p = lex_skip(src, p)

    param_names := []string{}
    constraints := []string{}

    for {
        if lex_kind(src, p) == token.TK_RBRACKET || lex_kind(src, p) == token.TK_EOF {
            break
        }

        // Parse type param name (e.g., T, U)
        if lex_kind(src, p) != token.TK_IDENT { break }
        pname := lex_string_value(src, p, token.TK_IDENT)
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)

        // Optional constraint: T: InterfaceName
        constraint := ""
        if lex_kind(src, p) == token.TK_COLON {
            p = lex_end(src, p, token.TK_COLON)
            p = lex_skip(src, p)
            if lex_kind(src, p) == token.TK_IDENT {
                constraint = lex_string_value(src, p, token.TK_IDENT)
                p = lex_end(src, p, token.TK_IDENT)
                p = lex_skip(src, p)
            }
        }

        param_names = append(param_names, pname)
        constraints = append(constraints, constraint)

        // Optional comma
        if lex_kind(src, p) == token.TK_COMMA {
            p = lex_end(src, p, token.TK_COMMA)
            p = lex_skip(src, p)
        }
    }

    // Expect ']'
    if lex_kind(src, p) == token.TK_RBRACKET {
        p = lex_end(src, p, token.TK_RBRACKET)
    }

    if len(param_names) > 0 {
        sema.RegisterTypeParams(decl_name, param_names, constraints)
    }

    return ParseResult { node_idx: len(param_names), new_pos: p }
}

// Parse variable declaration: name := expr
fn parse_colonequal_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos

    // Parse identifier
    name_kind := lex_kind(src, p)
    if name_kind != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    name := lex_string_value(src, p, name_kind)
    name_node := new_ident_node(name, nodes)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect ':='
    ce_kind := lex_kind(src, p)
    if ce_kind != token.TK_COLONEQUAL {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, ce_kind)
    p = lex_skip(src, p)

    // Parse initializer expression
    expr_result := parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    expr_node := expr_result.node_idx
    p = expr_result.new_pos

    // Create let statement node (reuse ast.STMT_LET, int_val=1 for mutable)
    stmt := AstNode {
        tag: ast.STMT_LET,
        int_val: 1,
        str_val: name,
        left: name_node,
        right: expr_node,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse if statement: if cond { block } [else { block }]
fn parse_if_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'if' token
    p := pos
    kind := lex_kind(src, p)
    if kind != token.TK_IF {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Parse condition expression
    cond_result := parse_expr_with_pos(src, p, nodes)
    if cond_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    cond_node := cond_result.node_idx
    p = cond_result.new_pos
    p = lex_skip(src, p)

    // Parse then block
    then_result := parse_block(src, p, nodes)
    if then_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    then_node := then_result.node_idx
    p = then_result.new_pos
    p = lex_skip(src, p)

    // Check for else
    else_node := -1
    next_kind := lex_kind(src, p)
    if next_kind == token.TK_ELSE {
        p = lex_end(src, p, next_kind)
        p = lex_skip(src, p)
        // Check for else if
        else_kind := lex_kind(src, p)
        if else_kind == token.TK_IF {
            // else if -> parse as nested if statement
            else_if_result := parse_if_stmt(src, p, nodes)
            if else_if_result.node_idx >= 0 {
                else_node = else_if_result.node_idx
                p = else_if_result.new_pos
            }
        } else {
            // else { block }
            else_result := parse_block(src, p, nodes)
            if else_result.node_idx >= 0 {
                else_node = else_result.node_idx
                p = else_result.new_pos
            }
        }
    }

    // Create if statement node
    // left = condition, right = then block, extra = else block
    stmt := AstNode {
        tag: ast.STMT_IF,
        int_val: 0,
        str_val: "",
        left: cond_node,
        right: then_node,
        extra: else_node,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

fn parse_for_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'for' token
    p := pos
    kind := lex_kind(src, p)
    if kind != token.TK_FOR {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Check for range-based for loop: for i in range { }
    next_kind := lex_kind(src, p)
    cond_node := -1
    loop_var := ""

    if next_kind == token.TK_IDENT {
        // Might be: for i in range or for condition
        saved_pos := p
        var_name := lex_string_value(src, p, next_kind)
        p = lex_end(src, p, next_kind)
        p = lex_skip(src, p)

        if lex_kind(src, p) == token.TK_IN {
            // It's a range-based for loop: for i in range
            loop_var = var_name
            p = lex_end(src, p, token.TK_IN)
            p = lex_skip(src, p)

            // Parse range expression
            range_result := parse_expr_with_pos(src, p, nodes)
            if range_result.node_idx >= 0 {
                cond_node = range_result.node_idx
                p = range_result.new_pos
                p = lex_skip(src, p)
            }
        } else {
            // Not 'in', so restore and parse as condition expression
            p = saved_pos
            cond_result := parse_expr_with_pos(src, p, nodes)
            if cond_result.node_idx >= 0 {
                cond_node = cond_result.node_idx
                p = cond_result.new_pos
                p = lex_skip(src, p)
            }
        }
    } else if next_kind != token.TK_LBRACE {
        // Parse condition expression (not identifier, not lbrace)
        cond_result := parse_expr_with_pos(src, p, nodes)
        if cond_result.node_idx >= 0 {
            cond_node = cond_result.node_idx
            p = cond_result.new_pos
            p = lex_skip(src, p)
        }
    }

    // Parse body block
    body_result := parse_block(src, p, nodes)
    if body_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    body_node := body_result.node_idx
    p = body_result.new_pos

    // Create for statement node
    // left = condition/range (-1 for infinite loop), right = body block
    // str_val = loop variable name (for range-based loops)
    stmt := AstNode {
        tag: ast.STMT_FOR,
        int_val: 0,
        str_val: loop_var,
        left: cond_node,
        right: body_node,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

fn parse_return_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'return' token
    p := pos
    kind := lex_kind(src, p)
    if kind != token.TK_RETURN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Check if there's an expression to return
    next_kind := lex_kind(src, p)
    expr_node := -1
    extra_count := 0

    // If not EOF, semicolon, or close brace, parse expression
    if next_kind != token.TK_EOF && next_kind != token.TK_SEMI && next_kind != token.TK_RBRACE {
        expr_result := parse_expr_with_pos(src, p, nodes)
        expr_node = expr_result.node_idx
        p = expr_result.new_pos
        p = lex_skip(src, p)

        // Check for multi-value return: return expr1, expr2, ...
        extra_exprs := []int{}
        for lex_kind(src, p) == token.TK_COMMA {
            p = lex_end(src, p, token.TK_COMMA)
            p = lex_skip(src, p)
            next_result := parse_expr_with_pos(src, p, nodes)
            if next_result.node_idx < 0 { break }
            extra_exprs = append(extra_exprs, next_result.node_idx)
            p = next_result.new_pos
            p = lex_skip(src, p)
        }

        if len(extra_exprs) > 0 {
            extra_count = len(extra_exprs)
            all_exprs := []int{}
            all_exprs = append(all_exprs, expr_node)
            ei := 0
            for ei < len(extra_exprs) {
                all_exprs = append(all_exprs, extra_exprs[ei])
                ei = ei + 1
            }
            // Store expression indices using upcoming node index
            store_multi_ret_exprs(len(nodes), all_exprs)
        }
    }

    // Create return statement node
    // int_val = extra_count (0 for single return, >0 for multi-return)
    stmt := AstNode {
        tag: ast.STMT_RETURN,
        int_val: extra_count,
        str_val: "",
        left: expr_node,
        right: -1,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse assignment: ident = expr
fn parse_assign_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at identifier
    p := pos
    name_kind := lex_kind(src, p)
    if name_kind != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    name := lex_string_value(src, p, name_kind)
    name_node := new_ident_node(name, nodes)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect '='
    eq_kind := lex_kind(src, p)
    if eq_kind != token.TK_ASSIGN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, eq_kind)
    p = lex_skip(src, p)

    // Parse expression
    expr_result := parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    expr_node := expr_result.node_idx
    p = expr_result.new_pos

    // Create assignment node
    stmt := AstNode {
        tag: ast.STMT_ASSIGN,
        int_val: 0,
        str_val: name,
        left: name_node,
        right: expr_node,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse a statement (dispatcher)
fn parse_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)
    kind := lex_kind(src, p)

    if kind == token.TK_IF {
        return parse_if_stmt(src, p, nodes)
    }

    if kind == token.TK_FOR {
        return parse_for_stmt(src, p, nodes)
    }

    if kind == token.TK_RETURN {
        return parse_return_stmt(src, p, nodes)
    }

    if kind == token.TK_MATCH {
        return parse_match_stmt(src, p, nodes)
    }

    if kind == token.TK_BREAK {
        p = lex_end(src, p, kind)
        stmt := AstNode {
            tag: ast.STMT_BREAK,
            int_val: 0,
            str_val: "",
            left: -1,
            right: -1,
            extra: -1,
            type_tag: ast.TYPE_UNKNOWN
        }
        nodes = append(nodes, stmt)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }

    if kind == token.TK_LBRACE {
        return parse_block(src, p, nodes)
    }

    // Check if it's an assignment (ident followed by =) or declaration (ident followed by :=)
    if kind == token.TK_IDENT {
        saved_pos := p
        first_name := lex_string_value(src, p, kind)
        p = lex_end(src, p, kind)
        p = lex_skip(src, p)
        next_kind := lex_kind(src, p)
        if next_kind == token.TK_COMMA {
            // Multi-variable declaration: a, b, c := expr
            ml_names := []string{}
            ml_names = append(ml_names, first_name)
            for lex_kind(src, p) == token.TK_COMMA {
                p = lex_end(src, p, token.TK_COMMA)
                p = lex_skip(src, p)
                if lex_kind(src, p) != token.TK_IDENT { break }
                ml_names = append(ml_names, lex_string_value(src, p, token.TK_IDENT))
                p = lex_end(src, p, token.TK_IDENT)
                p = lex_skip(src, p)
            }
            if lex_kind(src, p) == token.TK_COLONEQUAL {
                p = lex_end(src, p, token.TK_COLONEQUAL)
                p = lex_skip(src, p)
                // Create ast.EXPR_IDENT nodes for each name (consecutive in AST)
                ml_first_ident := len(nodes)
                ml_ni := 0
                for ml_ni < len(ml_names) {
                    new_ident_node(ml_names[ml_ni], nodes)
                    ml_ni = ml_ni + 1
                }
                // Parse RHS
                ml_rhs := parse_expr_with_pos(src, p, nodes)
                if ml_rhs.node_idx >= 0 {
                    ml_stmt := AstNode {
                        tag: ast.STMT_MULTI_LET,
                        int_val: len(ml_names),
                        str_val: "",
                        left: ml_first_ident,
                        right: ml_rhs.node_idx,
                        extra: -1,
                        type_tag: ast.TYPE_UNKNOWN
                    }
                    nodes = append(nodes, ml_stmt)
                    return ParseResult { node_idx: len(nodes) - 1, new_pos: ml_rhs.new_pos }
                }
            }
            p = saved_pos
            p = lex_end(src, p, kind)
            p = lex_skip(src, p)
            next_kind = lex_kind(src, p)
        }
        if next_kind == token.TK_COLONEQUAL {
            return parse_colonequal_stmt(src, saved_pos, nodes)
        }
        if next_kind == token.TK_ASSIGN {
            return parse_assign_stmt(src, saved_pos, nodes)
        }
        if next_kind == token.TK_DOT {
            // Might be field assignment: p.x = val, or method call: p.Method()
            p = saved_pos
            lhs_result := parse_expr_with_pos(src, p, nodes)
            if lhs_result.node_idx >= 0 {
                p = lhs_result.new_pos
                p = lex_skip(src, p)
                if lex_kind(src, p) == token.TK_ASSIGN {
                    // Field assignment: p.field = value
                    p = lex_end(src, p, token.TK_ASSIGN)
                    p = lex_skip(src, p)
                    rhs_result := parse_expr_with_pos(src, p, nodes)
                    if rhs_result.node_idx >= 0 {
                        // Extract base and field name from the LHS ast.EXPR_FIELD node
                        lhs_node := nodes[lhs_result.node_idx]
                        fa_node := AstNode {
                            tag: ast.STMT_FIELD_ASSIGN,
                            int_val: 0,
                            str_val: lhs_node.str_val,
                            left: lhs_node.left,
                            right: rhs_result.node_idx,
                            extra: -1,
                            type_tag: ast.TYPE_UNKNOWN
                        }
                        nodes = append(nodes, fa_node)
                        return ParseResult { node_idx: len(nodes) - 1, new_pos: rhs_result.new_pos }
                    }
                }
                // Not an assignment — wrap as expression statement
                stmt := AstNode {
                    tag: ast.STMT_EXPR,
                    int_val: 0,
                    str_val: "",
                    left: lhs_result.node_idx,
                    right: -1,
                    extra: -1,
                    type_tag: ast.TYPE_UNKNOWN
                }
                nodes = append(nodes, stmt)
                return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
            }
            p = saved_pos
        }
        if next_kind == token.TK_LBRACKET {
            // Might be arr[i] = val (index assignment) or arr[i] (expression statement)
            p = saved_pos
            idx_result := parse_expr_with_pos(src, p, nodes)
            if idx_result.node_idx >= 0 {
                p = idx_result.new_pos
                p = lex_skip(src, p)
                if lex_kind(src, p) == token.TK_ASSIGN {
                    // Index assignment: arr[i] = val
                    p = lex_end(src, p, token.TK_ASSIGN)
                    p = lex_skip(src, p)
                    rhs_result := parse_expr_with_pos(src, p, nodes)
                    if rhs_result.node_idx >= 0 {
                        ia_node := AstNode {
                            tag: ast.STMT_INDEX_ASSIGN,
                            int_val: 0,
                            str_val: "",
                            left: idx_result.node_idx,
                            right: rhs_result.node_idx,
                            extra: -1,
                            type_tag: ast.TYPE_UNKNOWN
                        }
                        nodes = append(nodes, ia_node)
                        return ParseResult { node_idx: len(nodes) - 1, new_pos: rhs_result.new_pos }
                    }
                }
                // Not an assignment — wrap as expression statement
                stmt := AstNode {
                    tag: ast.STMT_EXPR,
                    int_val: 0,
                    str_val: "",
                    left: idx_result.node_idx,
                    right: -1,
                    extra: -1,
                    type_tag: ast.TYPE_UNKNOWN
                }
                nodes = append(nodes, stmt)
                return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
            }
            p = saved_pos
        }
        // Not an assignment or declaration, restore position and parse as expression statement
        p = saved_pos
    }

    // Expression statement
    expr_result := parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx >= 0 {
        stmt := AstNode {
            tag: ast.STMT_EXPR,
            int_val: 0,
            str_val: "",
            left: expr_result.node_idx,
            right: -1,
            extra: -1,
            type_tag: ast.TYPE_UNKNOWN
        }
        nodes = append(nodes, stmt)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: expr_result.new_pos }
    }

    return ParseResult { node_idx: -1, new_pos: p }
}

// Parse function parameter: name: type
fn parse_param(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Parse parameter name
    name_kind := lex_kind(src, p)
    if name_kind != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    param_name := lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect ':'
    colon_kind := lex_kind(src, p)
    if colon_kind != token.TK_COLON {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, colon_kind)
    p = lex_skip(src, p)

    // Parse type name (simple, array, map, or pointer type)
    type_name := ""
    type_kind := lex_kind(src, p)

    if type_kind == token.TK_MAP {
        // Map type: map[KeyType]ValType
        p = lex_end(src, p, type_kind)
        p = lex_skip(src, p)
        map_key_type := ""
        map_val_type := ""
        if lex_kind(src, p) == token.TK_LBRACKET { p = lex_end(src, p, token.TK_LBRACKET) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_IDENT { map_key_type = lex_string_value(src, p, token.TK_IDENT) p = lex_end(src, p, token.TK_IDENT) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_RBRACKET { p = lex_end(src, p, token.TK_RBRACKET) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_IDENT { map_val_type = lex_string_value(src, p, token.TK_IDENT) p = lex_end(src, p, token.TK_IDENT) }
        type_name = "map[" + map_key_type + "]" + map_val_type
    } else if type_kind == token.TK_STAR {
        // Pointer type: *TypeName
        p = lex_end(src, p, type_kind)
        p = lex_skip(src, p)
        if lex_kind(src, p) == token.TK_IDENT {
            type_name = lex_string_value(src, p, token.TK_IDENT)
            p = lex_end(src, p, token.TK_IDENT)
        }
    } else if type_kind == token.TK_LBRACKET {
        // Array type: []ElementType
        type_name = "[]"
        p = lex_end(src, p, type_kind)  // Skip '['
        p = lex_skip(src, p)

        // Expect ']'
        if lex_kind(src, p) == token.TK_RBRACKET {
            p = lex_end(src, p, token.TK_RBRACKET)
            p = lex_skip(src, p)
        }

        // Parse element type
        if lex_kind(src, p) == token.TK_IDENT {
            elem_type := lex_string_value(src, p, token.TK_IDENT)
            type_name = type_name + elem_type
            p = lex_end(src, p, token.TK_IDENT)
        }
    } else if type_kind == token.TK_IDENT {
        // Simple type
        type_name = lex_string_value(src, p, type_kind)
        p = lex_end(src, p, type_kind)
        // Skip generic type arguments: Box[int], Result[int, string]
        p = skip_type_args(src, p)
        // Handle module-qualified types: module.Type -> use Type
        p_check := lex_skip(src, p)
        if lex_kind(src, p_check) == token.TK_DOT {
            p_check = lex_end(src, p_check, token.TK_DOT)
            p_check = lex_skip(src, p_check)
            if lex_kind(src, p_check) == token.TK_IDENT {
                type_name = lex_string_value(src, p_check, token.TK_IDENT)
                p = lex_end(src, p_check, token.TK_IDENT)
                // Skip type args after module-qualified type
                p = skip_type_args(src, p)
            }
        }
    } else {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    // Create parameter node
    // int_val: 1 = array type, 0 = scalar type
    param_type_tag := ast.TYPE_UNKNOWN
    param_is_array := 0
    if type_name == "string" { param_type_tag = ast.TYPE_STRING }
    if type_name == "int" { param_type_tag = ast.TYPE_INT }
    if type_name == "bool" { param_type_tag = ast.TYPE_BOOL }
    if type_name == "float" { param_type_tag = ast.TYPE_FLOAT }
    if type_name == "[]string" { param_type_tag = ast.TYPE_STRING param_is_array = 1 }
    if type_name == "[]int" { param_type_tag = ast.TYPE_INT param_is_array = 1 }
    if type_name == "[]float" { param_type_tag = ast.TYPE_FLOAT param_is_array = 1 }
    if strings.HasPrefix(type_name, "map[") { param_type_tag = ast.TYPE_MAP }
    if param_type_tag == ast.TYPE_UNKNOWN && type_name != "" {
        param_type_tag = ast.TYPE_STRUCT
    }
    param := AstNode {
        tag: ast.DECL_PARAM,
        int_val: param_is_array,
        str_val: param_name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: param_type_tag
    }
    nodes = append(nodes, param)
    if param_type_tag == ast.TYPE_STRUCT || param_type_tag == ast.TYPE_MAP {
        g_type_name_node_idx = append(g_type_name_node_idx, len(nodes) - 1)
        g_type_name_str = append(g_type_name_str, type_name)
    }
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse parameter list: (param1, param2, ...)
fn parse_param_list(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Expect '('
    lparen := lex_kind(src, p)
    if lparen != token.TK_LPAREN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lparen)
    p = lex_skip(src, p)

    // Check for empty parameter list
    next := lex_kind(src, p)
    if next == token.TK_RPAREN {
        p = lex_end(src, p, next)
        return ParseResult { node_idx: -1, new_pos: p }  // No parameters
    }

    // Parse first parameter
    first_result := parse_param(src, p, nodes)
    if first_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    first_param := first_result.node_idx
    p = first_result.new_pos
    p = lex_skip(src, p)

    // Parse remaining parameters
    last_param := first_param
    for {
        comma := lex_kind(src, p)
        if comma != token.TK_COMMA {
            break
        }
        p = lex_end(src, p, comma)
        p = lex_skip(src, p)

        param_result := parse_param(src, p, nodes)
        if param_result.node_idx < 0 {
            break
        }
        // Link as sibling (would need to update nodes array - simplified for now)
        last_param = param_result.node_idx
        p = param_result.new_pos
        p = lex_skip(src, p)
    }

    // Expect ')'
    rparen := lex_kind(src, p)
    if rparen != token.TK_RPAREN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rparen)

    return ParseResult { node_idx: first_param, new_pos: p }
}

// Parse function body: { stmt* }
fn parse_block(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Expect '{'
    lbrace := lex_kind(src, p)
    if lbrace != token.TK_LBRACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lbrace)
    p = lex_skip(src, p)

    // Parse statements until '}'
    first_stmt := -1
    last_stmt_idx := -1
    stmt_count := 0
    for {
        next := lex_kind(src, p)
        if next == token.TK_RBRACE || next == token.TK_EOF {
            break
        }

        stmt_result := parse_stmt(src, p, nodes)
        if stmt_result.node_idx < 0 {
            report_error(src, p, "unexpected " + token.TokenName(lex_kind(src, p)) + " in block")
            break
        }
        stmt_count = stmt_count + 1

        if first_stmt < 0 {
            first_stmt = stmt_result.node_idx
        }
        last_stmt_idx = stmt_result.node_idx
        p = stmt_result.new_pos
        p = lex_skip(src, p)

        // Skip optional semicolon
        semi := lex_kind(src, p)
        if semi == token.TK_SEMI {
            p = lex_end(src, p, semi)
            p = lex_skip(src, p)
        }
    }

    // Expect '}'
    rbrace := lex_kind(src, p)
    if rbrace != token.TK_RBRACE {
        report_error(src, p, "expected '}' but found " + token.TokenName(rbrace))
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rbrace)

    // Create block node
    // left = first statement index
    // right = last statement index (for multi-statement support)
    block := AstNode {
        tag: ast.STMT_BLOCK,
        int_val: 0,
        str_val: "",
        left: first_stmt,
        right: last_stmt_idx,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, block)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse import declaration: import ("path")
fn parse_import_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Expect 'import'
    import_kind := lex_kind(src, p)
    if import_kind != token.TK_IMPORT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, import_kind)
    p = lex_skip(src, p)

    // Expect '('
    if lex_kind(src, p) != token.TK_LPAREN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, token.TK_LPAREN)
    p = lex_skip(src, p)

    // Parse one or more import paths (string literals)
    // Create one ast.DECL_IMPORT node per path
    last_import_idx := -1
    for {
        path_kind := lex_kind(src, p)
        if path_kind == token.TK_RPAREN {
            break
        }
        if path_kind != token.TK_STRING {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        import_path := lex_string_value(src, p, path_kind)
        p = lex_end(src, p, path_kind)
        p = lex_skip(src, p)

        import_node := AstNode {
            tag: ast.DECL_IMPORT,
            int_val: 0,
            str_val: import_path,
            left: -1,
            right: -1,
            extra: -1,
            type_tag: ast.TYPE_UNKNOWN
        }
        nodes = append(nodes, import_node)
        last_import_idx = len(nodes) - 1
    }

    // Expect ')'
    if lex_kind(src, p) != token.TK_RPAREN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, token.TK_RPAREN)

    return ParseResult { node_idx: last_import_idx, new_pos: p }
}

// Parse const declaration: const NAME = literal_expr
fn parse_const_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Expect 'const'
    const_kind := lex_kind(src, p)
    if const_kind != token.TK_CONST {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, const_kind)
    p = lex_skip(src, p)

    // Parse name
    name_kind := lex_kind(src, p)
    if name_kind != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    const_name := lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect '='
    eq_kind := lex_kind(src, p)
    if eq_kind != token.TK_ASSIGN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, eq_kind)
    p = lex_skip(src, p)

    // Parse initializer expression (literal only: int, string, bool, or unary minus)
    init_result := parse_expr_with_pos(src, p, nodes)
    if init_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = init_result.new_pos

    // Infer type from initializer
    init_node := nodes[init_result.node_idx]
    type_tag := ast.TYPE_UNKNOWN
    if init_node.tag == ast.EXPR_INT { type_tag = ast.TYPE_INT }
    if init_node.tag == ast.EXPR_STRING { type_tag = ast.TYPE_STRING }
    if init_node.tag == ast.EXPR_BOOL { type_tag = ast.TYPE_BOOL }
    if init_node.tag == ast.EXPR_FLOAT { type_tag = ast.TYPE_FLOAT }
    if init_node.tag == ast.EXPR_UNARY { type_tag = ast.TYPE_INT }

    // Create ast.DECL_CONST node
    const_node := AstNode {
        tag: ast.DECL_CONST,
        int_val: 0,
        str_val: const_name,
        left: init_result.node_idx,
        right: -1,
        extra: -1,
        type_tag: type_tag
    }
    nodes = append(nodes, const_node)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse function declaration: fn name(params) -> type { body }
// Also handles method receivers: fn (recv: [*]Type) name(params) -> type { body }
fn parse_func_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Expect 'fn'
    fn_kind := lex_kind(src, p)
    if fn_kind != token.TK_FN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, fn_kind)
    p = lex_skip(src, p)

    // Check for method receiver: fn (recv: [*]Type) Name(params)
    recv_name := ""
    recv_type := ""
    first_param_idx := -1

    name_kind := lex_kind(src, p)
    if name_kind == token.TK_LPAREN {
        // Method receiver
        p = lex_end(src, p, token.TK_LPAREN)
        p = lex_skip(src, p)
        recv_name = lex_string_value(src, p, token.TK_IDENT)
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)
        p = lex_end(src, p, token.TK_COLON)
        p = lex_skip(src, p)
        if lex_kind(src, p) == token.TK_STAR {
            p = lex_end(src, p, token.TK_STAR)
            p = lex_skip(src, p)
        }
        recv_type = lex_string_value(src, p, token.TK_IDENT)
        p = lex_end(src, p, token.TK_IDENT)
        // Skip type parameters in receiver type: fn (b: Box[T]) Method()
        p = skip_type_args(src, p)
        p = lex_skip(src, p)
        p = lex_end(src, p, token.TK_RPAREN)
        p = lex_skip(src, p)

        // Create receiver ast.DECL_PARAM node
        recv_param := AstNode {
            tag: ast.DECL_PARAM,
            int_val: 0,
            str_val: recv_name,
            left: -1,
            right: -1,
            extra: -1,
            type_tag: ast.TYPE_STRUCT
        }
        nodes = append(nodes, recv_param)
        recv_param_idx := len(nodes) - 1
        first_param_idx = recv_param_idx
        g_type_name_node_idx = append(g_type_name_node_idx, recv_param_idx)
        g_type_name_str = append(g_type_name_str, recv_type)

        name_kind = lex_kind(src, p)
    }

    // Parse function name
    if name_kind != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    func_name := lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)

    // Parse optional type parameters: fn Name[T](params) -> type { body }
    tp_result := parse_type_params(src, p, func_name)
    p = tp_result.new_pos

    // Mangle method name: Type_Method
    original_method_name := ""
    if recv_type != "" {
        original_method_name = func_name
        func_name = recv_type + "_" + func_name
    }

    // Parse parameter list
    params_result := parse_param_list(src, p, nodes)
    p = params_result.new_pos
    p = lex_skip(src, p)

    // Set first param: receiver if present, otherwise first from param list
    if first_param_idx < 0 {
        first_param_idx = params_result.node_idx
    }

    // Check for '->' (return type is optional)
    ret_type := ""
    arrow := lex_kind(src, p)
    if arrow == token.TK_ARROW {
        p = lex_end(src, p, arrow)
        p = lex_skip(src, p)

        // Parse return type (simple, array, map, tuple, or pointer type)
        ret_type_kind := lex_kind(src, p)

        if ret_type_kind == token.TK_LPAREN {
            // Tuple return type: -> (Type1, Type2, ...)
            p = lex_end(src, p, token.TK_LPAREN)
            p = lex_skip(src, p)
            tuple_types := []string{}
            for lex_kind(src, p) != token.TK_RPAREN {
                if lex_kind(src, p) == token.TK_COMMA {
                    p = lex_end(src, p, token.TK_COMMA)
                    p = lex_skip(src, p)
                }
                tuple_types = append(tuple_types, lex_string_value(src, p, token.TK_IDENT))
                p = lex_end(src, p, token.TK_IDENT)
                p = lex_skip(src, p)
            }
            p = lex_end(src, p, token.TK_RPAREN)
            // Build: "__tuple2:int,string"
            ret_type = "__tuple" + strconv.Itoa(len(tuple_types))
            tti := 0
            for tti < len(tuple_types) {
                if tti == 0 {
                    ret_type = ret_type + ":"
                } else {
                    ret_type = ret_type + ","
                }
                ret_type = ret_type + tuple_types[tti]
                tti = tti + 1
            }
        } else if ret_type_kind == token.TK_MAP {
            // Map return type: map[KeyType]ValType
            p = lex_end(src, p, ret_type_kind)
            p = lex_skip(src, p)
            map_key_type := ""
            map_val_type := ""
            if lex_kind(src, p) == token.TK_LBRACKET { p = lex_end(src, p, token.TK_LBRACKET) p = lex_skip(src, p) }
            if lex_kind(src, p) == token.TK_IDENT { map_key_type = lex_string_value(src, p, token.TK_IDENT) p = lex_end(src, p, token.TK_IDENT) p = lex_skip(src, p) }
            if lex_kind(src, p) == token.TK_RBRACKET { p = lex_end(src, p, token.TK_RBRACKET) p = lex_skip(src, p) }
            if lex_kind(src, p) == token.TK_IDENT { map_val_type = lex_string_value(src, p, token.TK_IDENT) p = lex_end(src, p, token.TK_IDENT) }
            ret_type = "map[" + map_key_type + "]" + map_val_type
        } else if ret_type_kind == token.TK_STAR {
            // Pointer return type: *TypeName
            p = lex_end(src, p, ret_type_kind)
            p = lex_skip(src, p)
            if lex_kind(src, p) == token.TK_IDENT {
                ret_type = lex_string_value(src, p, token.TK_IDENT)
                p = lex_end(src, p, token.TK_IDENT)
            }
        } else if ret_type_kind == token.TK_LBRACKET {
            // Array type: []ElementType
            ret_type = "[]"
            p = lex_end(src, p, ret_type_kind)  // Skip '['
            p = lex_skip(src, p)

            // Expect ']'
            if lex_kind(src, p) == token.TK_RBRACKET {
                p = lex_end(src, p, token.TK_RBRACKET)
                p = lex_skip(src, p)
            }

            // Parse element type
            if lex_kind(src, p) == token.TK_IDENT {
                elem_type := lex_string_value(src, p, token.TK_IDENT)
                ret_type = ret_type + elem_type
                p = lex_end(src, p, token.TK_IDENT)
            }
        } else if ret_type_kind == token.TK_IDENT {
            // Simple type
            ret_type = lex_string_value(src, p, ret_type_kind)
            p = lex_end(src, p, ret_type_kind)
            // Skip generic type arguments in return type
            p = skip_type_args(src, p)
        } else {
            return ParseResult { node_idx: -1, new_pos: p }
        }
    }

    // Parse body
    body_result := parse_block(src, p, nodes)
    if body_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    // Create function declaration node
    // str_val = function name
    // left = parameters (first param node, receiver if method)
    // right = body (block node)
    // type_tag = return type, int_val = is_array_return flag
    ret_type_tag := ast.TYPE_UNKNOWN
    ret_is_array := 0
    if ret_type == "int" { ret_type_tag = ast.TYPE_INT }
    if ret_type == "string" { ret_type_tag = ast.TYPE_STRING }
    if ret_type == "bool" { ret_type_tag = ast.TYPE_BOOL }
    if ret_type == "float" { ret_type_tag = ast.TYPE_FLOAT }
    if ret_type == "[]int" { ret_type_tag = ast.TYPE_INT
        ret_is_array = 1
    }
    if ret_type == "[]string" { ret_type_tag = ast.TYPE_STRING
        ret_is_array = 1
    }
    if ret_type == "[]float" { ret_type_tag = ast.TYPE_FLOAT
        ret_is_array = 1
    }
    if strings.HasPrefix(ret_type, "map[") { ret_type_tag = ast.TYPE_MAP }
    if ret_type_tag == ast.TYPE_UNKNOWN && ret_type != "" {
        ret_type_tag = ast.TYPE_STRUCT
    }

    func := AstNode {
        tag: ast.DECL_FUNC,
        int_val: ret_is_array,
        str_val: func_name,
        left: first_param_idx,
        right: body_result.node_idx,
        extra: -1,
        type_tag: ret_type_tag
    }
    nodes = append(nodes, func)
    func_node_idx := len(nodes) - 1

    // Store struct/map return type name in side table
    if ret_type_tag == ast.TYPE_STRUCT || ret_type_tag == ast.TYPE_MAP {
        g_type_name_node_idx = append(g_type_name_node_idx, func_node_idx)
        g_type_name_str = append(g_type_name_str, ret_type)
    }

    // Store method declaration info
    if recv_type != "" {
        g_method_decl_node_idx = append(g_method_decl_node_idx, func_node_idx)
        g_method_decl_struct = append(g_method_decl_struct, recv_type)
        g_method_decl_name = append(g_method_decl_name, original_method_name)
    }

    return ParseResult { node_idx: func_node_idx, new_pos: body_result.new_pos }
}

// Parse struct field: name: type
fn parse_field(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Parse field name
    name_kind := lex_kind(src, p)
    if name_kind != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    field_name := lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect ':'
    colon := lex_kind(src, p)
    if colon != token.TK_COLON {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, colon)
    p = lex_skip(src, p)

    // Parse type (including array, pointer, map, and struct types)
    type_kind := lex_kind(src, p)
    type_name := ""

    if type_kind == token.TK_MAP {
        // Map type: map[KeyType]ValType
        p = lex_end(src, p, type_kind)
        p = lex_skip(src, p)
        map_key_type := ""
        map_val_type := ""
        if lex_kind(src, p) == token.TK_LBRACKET { p = lex_end(src, p, token.TK_LBRACKET) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_IDENT { map_key_type = lex_string_value(src, p, token.TK_IDENT) p = lex_end(src, p, token.TK_IDENT) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_RBRACKET { p = lex_end(src, p, token.TK_RBRACKET) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_IDENT { map_val_type = lex_string_value(src, p, token.TK_IDENT) p = lex_end(src, p, token.TK_IDENT) }
        type_name = "map[" + map_key_type + "]" + map_val_type
    } else if type_kind == token.TK_STAR {
        // Pointer type: *TypeName
        p = lex_end(src, p, type_kind)
        p = lex_skip(src, p)
        if lex_kind(src, p) == token.TK_IDENT {
            type_name = lex_string_value(src, p, token.TK_IDENT)
            p = lex_end(src, p, token.TK_IDENT)
        }
    } else if type_kind == token.TK_LBRACKET {
        // Array type: []ElementType
        type_name = "[]"
        p = lex_end(src, p, token.TK_LBRACKET)
        p = lex_skip(src, p)

        if lex_kind(src, p) == token.TK_RBRACKET {
            p = lex_end(src, p, token.TK_RBRACKET)
            p = lex_skip(src, p)
        }

        if lex_kind(src, p) == token.TK_IDENT {
            elem_type := lex_string_value(src, p, token.TK_IDENT)
            type_name = type_name + elem_type
            p = lex_end(src, p, token.TK_IDENT)
        }
    } else if type_kind == token.TK_IDENT {
        type_name = lex_string_value(src, p, type_kind)
        p = lex_end(src, p, type_kind)
        // Skip generic type arguments
        p = skip_type_args(src, p)
    } else {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    p = lex_skip(src, p)

    // Skip optional comma
    comma := lex_kind(src, p)
    if comma == token.TK_COMMA {
        p = lex_end(src, p, comma)
    }

    // Resolve type_name to type_tag and is_array
    field_type_tag := ast.TYPE_UNKNOWN
    field_is_array := 0
    if type_name == "int" { field_type_tag = ast.TYPE_INT }
    if type_name == "bool" { field_type_tag = ast.TYPE_BOOL }
    if type_name == "string" { field_type_tag = ast.TYPE_STRING }
    if type_name == "float" { field_type_tag = ast.TYPE_FLOAT }
    if type_name == "[]int" { field_type_tag = ast.TYPE_INT field_is_array = 1 }
    if type_name == "[]bool" { field_type_tag = ast.TYPE_BOOL field_is_array = 1 }
    if type_name == "[]string" { field_type_tag = ast.TYPE_STRING field_is_array = 1 }
    if type_name == "[]float" { field_type_tag = ast.TYPE_FLOAT field_is_array = 1 }
    if strings.HasPrefix(type_name, "map[") { field_type_tag = ast.TYPE_MAP }
    if field_type_tag == ast.TYPE_UNKNOWN && type_name != "" {
        field_type_tag = ast.TYPE_STRUCT
    }

    // Create field node
    field := AstNode {
        tag: ast.DECL_FIELD,
        int_val: field_is_array,
        str_val: field_name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: field_type_tag
    }
    nodes = append(nodes, field)
    if field_type_tag == ast.TYPE_STRUCT || field_type_tag == ast.TYPE_MAP {
        g_type_name_node_idx = append(g_type_name_node_idx, len(nodes) - 1)
        g_type_name_str = append(g_type_name_str, type_name)
    }
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse struct declaration: struct Name { fields }
fn parse_struct_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Expect 'struct'
    struct_kind := lex_kind(src, p)
    if struct_kind != token.TK_STRUCT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, struct_kind)
    p = lex_skip(src, p)

    // Parse struct name
    name_kind := lex_kind(src, p)
    if name_kind != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    struct_name := lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Parse optional type parameters: struct Name[T, U] { ... }
    tp_result := parse_type_params(src, p, struct_name)
    p = tp_result.new_pos
    p = lex_skip(src, p)

    // Expect '{'
    lbrace := lex_kind(src, p)
    if lbrace != token.TK_LBRACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lbrace)
    p = lex_skip(src, p)

    // Parse fields
    first_field := -1
    for {
        next := lex_kind(src, p)
        if next == token.TK_RBRACE || next == token.TK_EOF {
            break
        }

        field_result := parse_field(src, p, nodes)
        if field_result.node_idx < 0 {
            break
        }

        if first_field < 0 {
            first_field = field_result.node_idx
        }
        p = field_result.new_pos
        p = lex_skip(src, p)
    }

    // Expect '}'
    rbrace := lex_kind(src, p)
    if rbrace != token.TK_RBRACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rbrace)

    // Create struct declaration node
    struct_decl := AstNode {
        tag: ast.DECL_STRUCT,
        int_val: 0,
        str_val: struct_name,
        left: first_field,
        right: -1,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, struct_decl)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse enum declaration: enum Name { Variant1, Variant2 { field: type }, ... }
fn parse_enum_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Expect 'enum'
    enum_kind := lex_kind(src, p)
    if enum_kind != token.TK_ENUM {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, enum_kind)
    p = lex_skip(src, p)

    // Parse enum name
    name_kind := lex_kind(src, p)
    if name_kind != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    enum_name := lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Parse optional type parameters: enum Name[T, E] { ... }
    tp_result := parse_type_params(src, p, enum_name)
    p = tp_result.new_pos
    p = lex_skip(src, p)

    // Expect '{'
    lbrace := lex_kind(src, p)
    if lbrace != token.TK_LBRACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lbrace)
    p = lex_skip(src, p)

    // Parse variants
    first_variant := -1
    variant_count := 0
    for {
        next := lex_kind(src, p)
        if next == token.TK_RBRACE || next == token.TK_EOF {
            break
        }

        // Parse variant name
        if lex_kind(src, p) != token.TK_IDENT {
            break
        }
        variant_name := lex_string_value(src, p, token.TK_IDENT)
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)

        // Check for fields: { field: type, ... }
        first_field := -1
        if lex_kind(src, p) == token.TK_LBRACE {
            p = lex_end(src, p, token.TK_LBRACE)
            p = lex_skip(src, p)

            for {
                if lex_kind(src, p) == token.TK_RBRACE || lex_kind(src, p) == token.TK_EOF {
                    break
                }
                field_result := parse_field(src, p, nodes)
                if field_result.node_idx < 0 {
                    break
                }
                if first_field < 0 {
                    first_field = field_result.node_idx
                }
                p = field_result.new_pos
                p = lex_skip(src, p)
            }

            // Expect '}'
            if lex_kind(src, p) == token.TK_RBRACE {
                p = lex_end(src, p, token.TK_RBRACE)
                p = lex_skip(src, p)
            }
        }

        // Create ast.DECL_VARIANT node
        variant := AstNode {
            tag: ast.DECL_VARIANT,
            int_val: variant_count,
            str_val: variant_name,
            left: first_field,
            right: -1,
            extra: -1,
            type_tag: ast.TYPE_UNKNOWN
        }
        nodes = append(nodes, variant)
        variant_idx := len(nodes) - 1

        if first_variant < 0 {
            first_variant = variant_idx
        }
        variant_count = variant_count + 1

        // Skip optional comma
        if lex_kind(src, p) == token.TK_COMMA {
            p = lex_end(src, p, token.TK_COMMA)
            p = lex_skip(src, p)
        }
    }

    // Expect '}'
    rbrace := lex_kind(src, p)
    if rbrace != token.TK_RBRACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rbrace)

    // Create ast.DECL_ENUM node
    enum_decl := AstNode {
        tag: ast.DECL_ENUM,
        int_val: variant_count,
        str_val: enum_name,
        left: first_variant,
        right: -1,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, enum_decl)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse interface declaration: interface Name { Method(params) -> RetType, ... }
fn parse_interface_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Expect 'interface'
    iface_kind := lex_kind(src, p)
    if iface_kind != token.TK_INTERFACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, iface_kind)
    p = lex_skip(src, p)

    // Parse interface name
    name_kind := lex_kind(src, p)
    if name_kind != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    iface_name := lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Parse optional type parameters: interface Name[T] { ... }
    tp_result := parse_type_params(src, p, iface_name)
    p = tp_result.new_pos
    p = lex_skip(src, p)

    // Expect '{'
    lbrace := lex_kind(src, p)
    if lbrace != token.TK_LBRACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lbrace)
    p = lex_skip(src, p)

    // Parse method signatures
    first_method := -1
    method_count := 0
    for {
        next := lex_kind(src, p)
        if next == token.TK_RBRACE || next == token.TK_EOF {
            break
        }

        // Parse method name
        if lex_kind(src, p) != token.TK_IDENT {
            break
        }
        method_name := lex_string_value(src, p, token.TK_IDENT)
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)

        // Expect '('
        if lex_kind(src, p) != token.TK_LPAREN {
            break
        }
        p = lex_end(src, p, token.TK_LPAREN)
        p = lex_skip(src, p)

        // Parse parameters
        first_param := -1
        param_count := 0
        if lex_kind(src, p) != token.TK_RPAREN {
            for {
                param_result := parse_param(src, p, nodes)
                if param_result.node_idx < 0 {
                    break
                }
                if first_param < 0 {
                    first_param = param_result.node_idx
                }
                param_count = param_count + 1
                p = param_result.new_pos
                p = lex_skip(src, p)
                if lex_kind(src, p) == token.TK_COMMA {
                    p = lex_end(src, p, token.TK_COMMA)
                    p = lex_skip(src, p)
                } else {
                    break
                }
            }
        }

        // Expect ')'
        if lex_kind(src, p) == token.TK_RPAREN {
            p = lex_end(src, p, token.TK_RPAREN)
            p = lex_skip(src, p)
        }

        // Parse optional return type
        ret_type_tag := ast.TYPE_UNKNOWN
        ret_is_array := 0
        if lex_kind(src, p) == token.TK_ARROW {
            p = lex_end(src, p, token.TK_ARROW)
            p = lex_skip(src, p)
            ret_kind := lex_kind(src, p)
            if ret_kind == token.TK_LBRACKET {
                p = lex_end(src, p, ret_kind)
                p = lex_skip(src, p)
                if lex_kind(src, p) == token.TK_RBRACKET {
                    p = lex_end(src, p, token.TK_RBRACKET)
                    p = lex_skip(src, p)
                }
                if lex_kind(src, p) == token.TK_IDENT {
                    ret_elem := lex_string_value(src, p, token.TK_IDENT)
                    p = lex_end(src, p, token.TK_IDENT)
                    p = lex_skip(src, p)
                    if ret_elem == "int" { ret_type_tag = ast.TYPE_INT }
                    if ret_elem == "string" { ret_type_tag = ast.TYPE_STRING }
                    if ret_elem == "bool" { ret_type_tag = ast.TYPE_BOOL }
                    if ret_elem == "float" { ret_type_tag = ast.TYPE_FLOAT }
                    ret_is_array = 1
                }
            } else if ret_kind == token.TK_IDENT {
                ret_name := lex_string_value(src, p, ret_kind)
                p = lex_end(src, p, ret_kind)
                p = lex_skip(src, p)
                if ret_name == "int" { ret_type_tag = ast.TYPE_INT }
                if ret_name == "string" { ret_type_tag = ast.TYPE_STRING }
                if ret_name == "bool" { ret_type_tag = ast.TYPE_BOOL }
                if ret_name == "float" { ret_type_tag = ast.TYPE_FLOAT }
                if ret_type_tag == ast.TYPE_UNKNOWN { ret_type_tag = ast.TYPE_STRUCT }
            }
        }

        // Create ast.DECL_IMETHOD node
        imethod := AstNode {
            tag: ast.DECL_IMETHOD,
            int_val: param_count,
            str_val: method_name,
            left: first_param,
            right: -1,
            extra: ret_is_array,
            type_tag: ret_type_tag
        }
        nodes = append(nodes, imethod)
        imethod_idx := len(nodes) - 1

        if first_method < 0 {
            first_method = imethod_idx
        }
        method_count = method_count + 1

        // Skip optional comma
        if lex_kind(src, p) == token.TK_COMMA {
            p = lex_end(src, p, token.TK_COMMA)
            p = lex_skip(src, p)
        }
    }

    // Expect '}'
    rbrace := lex_kind(src, p)
    if rbrace != token.TK_RBRACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rbrace)

    // Create ast.DECL_INTERFACE node
    iface_decl := AstNode {
        tag: ast.DECL_INTERFACE,
        int_val: method_count,
        str_val: iface_name,
        left: first_method,
        right: -1,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, iface_decl)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse match statement: match expr { Pattern => body, ... }
fn parse_match_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Expect 'match'
    match_kind := lex_kind(src, p)
    if match_kind != token.TK_MATCH {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, match_kind)
    p = lex_skip(src, p)

    // Parse the matched expression
    match_expr := parse_expr_with_pos(src, p, nodes)
    if match_expr.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = match_expr.new_pos
    p = lex_skip(src, p)

    // Expect '{'
    if lex_kind(src, p) != token.TK_LBRACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, token.TK_LBRACE)
    p = lex_skip(src, p)

    // Parse match arms
    first_arm := -1
    arm_count := 0
    for {
        if lex_kind(src, p) == token.TK_RBRACE || lex_kind(src, p) == token.TK_EOF {
            break
        }

        // Parse pattern: EnumName::VariantName
        if lex_kind(src, p) != token.TK_IDENT {
            break
        }
        pattern_enum := lex_string_value(src, p, token.TK_IDENT)
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)

        // Expect '::'
        if lex_kind(src, p) != token.TK_COLONCOLON {
            break
        }
        p = lex_end(src, p, token.TK_COLONCOLON)
        p = lex_skip(src, p)

        // Parse variant name
        if lex_kind(src, p) != token.TK_IDENT {
            break
        }
        pattern_variant := lex_string_value(src, p, token.TK_IDENT)
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)

        qualified := pattern_enum + "." + pattern_variant

        // Parse optional bindings: { name1, name2, ... }
        binding_names := []string{}
        if lex_kind(src, p) == token.TK_LBRACE {
            p = lex_end(src, p, token.TK_LBRACE)
            p = lex_skip(src, p)

            for {
                if lex_kind(src, p) == token.TK_RBRACE || lex_kind(src, p) == token.TK_EOF {
                    break
                }
                if lex_kind(src, p) != token.TK_IDENT {
                    break
                }
                bname := lex_string_value(src, p, token.TK_IDENT)
                binding_names = append(binding_names, bname)
                p = lex_end(src, p, token.TK_IDENT)
                p = lex_skip(src, p)

                if lex_kind(src, p) == token.TK_COMMA {
                    p = lex_end(src, p, token.TK_COMMA)
                    p = lex_skip(src, p)
                }
            }

            // Expect '}'
            if lex_kind(src, p) == token.TK_RBRACE {
                p = lex_end(src, p, token.TK_RBRACE)
                p = lex_skip(src, p)
            }
        }

        // Expect '=>'
        if lex_kind(src, p) != token.TK_FATARROW {
            break
        }
        p = lex_end(src, p, token.TK_FATARROW)
        p = lex_skip(src, p)

        // Parse body expression
        body_result := parse_expr_with_pos(src, p, nodes)
        if body_result.node_idx < 0 {
            break
        }
        p = body_result.new_pos
        p = lex_skip(src, p)

        // Create ast.STMT_MATCH_ARM node
        arm := AstNode {
            tag: ast.STMT_MATCH_ARM,
            int_val: len(binding_names),
            str_val: qualified,
            left: body_result.node_idx,
            right: -1,
            extra: -1,
            type_tag: ast.TYPE_UNKNOWN
        }
        nodes = append(nodes, arm)
        arm_idx := len(nodes) - 1

        if first_arm < 0 {
            first_arm = arm_idx
        }

        // Store binding names for this arm
        store_match_arm_bindings(arm_idx, binding_names)

        arm_count = arm_count + 1

        // Skip optional comma
        if lex_kind(src, p) == token.TK_COMMA {
            p = lex_end(src, p, token.TK_COMMA)
            p = lex_skip(src, p)
        }
    }

    // Expect '}'
    if lex_kind(src, p) != token.TK_RBRACE {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, token.TK_RBRACE)

    // Create ast.STMT_MATCH node
    match_node := AstNode {
        tag: ast.STMT_MATCH,
        int_val: arm_count,
        str_val: "",
        left: match_expr.node_idx,
        right: first_arm,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, match_node)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse closure expression: [move] |params| [-> type] { body } or [move] |params| [-> type] expr
// Parse closure parameters: consume params between | delimiters (or || for empty)
fn parse_closure_params(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos

    // Hidden __env parameter (always first)
    env_param := AstNode {
        tag: ast.DECL_PARAM, int_val: 0, str_val: "__env",
        left: -1, right: -1, extra: -1, type_tag: ast.TYPE_INT
    }
    nodes = append(nodes, env_param)
    first_param_idx := len(nodes) - 1

    // Handle || (token.TK_OR) as empty param list, or |params| (token.TK_PIPE delimited)
    if lex_kind(src, p) == token.TK_OR {
        p = lex_end(src, p, token.TK_OR)
        p = lex_skip(src, p)
        return ParseResult { node_idx: first_param_idx, new_pos: p }
    }
    if lex_kind(src, p) == token.TK_PIPE {
        p = lex_end(src, p, token.TK_PIPE)
        p = lex_skip(src, p)
    } else {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    for {
        if lex_kind(src, p) == token.TK_PIPE || lex_kind(src, p) == token.TK_EOF { break }
        param_result := parse_param(src, p, nodes)
        if param_result.node_idx < 0 { break }
        p = param_result.new_pos
        p = lex_skip(src, p)
        if lex_kind(src, p) == token.TK_COMMA {
            p = lex_end(src, p, token.TK_COMMA)
            p = lex_skip(src, p)
        }
    }
    if lex_kind(src, p) == token.TK_PIPE {
        p = lex_end(src, p, token.TK_PIPE)
        p = lex_skip(src, p)
    }
    return ParseResult { node_idx: first_param_idx, new_pos: p }
}

// Parse closure body: block { ... } or single expression (wrapped in return+block)
fn parse_closure_body(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    if lex_kind(src, p) == token.TK_LBRACE {
        return parse_block(src, p, nodes)
    }
    // Single expression body — wrap in ast.STMT_RETURN + ast.STMT_BLOCK
    expr_result := parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx < 0 { return expr_result }
    ret_stmt := AstNode {
        tag: ast.STMT_RETURN, int_val: 0, str_val: "",
        left: expr_result.node_idx, right: -1, extra: -1, type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, ret_stmt)
    ret_idx := len(nodes) - 1
    blk := AstNode {
        tag: ast.STMT_BLOCK, int_val: 1, str_val: "",
        left: ret_idx, right: ret_idx, extra: -1, type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, blk)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: expr_result.new_pos }
}

fn parse_closure_expr(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)

    // Check for optional 'move' keyword
    is_move := 0
    if lex_kind(src, p) == token.TK_IDENT && lex_string_value(src, p, token.TK_IDENT) == "move" {
        is_move = 1
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)
    }

    // Generate unique closure name
    cl_id := len(g_closure_counter)
    g_closure_counter = append(g_closure_counter, 0)
    cl_name := "__closure_" + strconv.Itoa(cl_id)

    // Parse parameters
    params_result := parse_closure_params(src, p, nodes)
    if params_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    first_param_idx := params_result.node_idx
    p = params_result.new_pos

    // Optional return type: -> type
    ret_type_tag := ast.TYPE_UNKNOWN
    if lex_kind(src, p) == token.TK_ARROW {
        p = lex_end(src, p, token.TK_ARROW)
        p = lex_skip(src, p)
        rk := lex_kind(src, p)
        if rk == token.TK_IDENT {
            rt := lex_string_value(src, p, rk)
            if rt == "int" { ret_type_tag = ast.TYPE_INT }
            if rt == "string" { ret_type_tag = ast.TYPE_STRING }
            if rt == "bool" { ret_type_tag = ast.TYPE_BOOL }
            if rt == "float" { ret_type_tag = ast.TYPE_FLOAT }
            p = lex_end(src, p, rk)
            p = lex_skip(src, p)
        }
    }

    // Parse body
    body_result := parse_closure_body(src, p, nodes)
    body_idx := -1
    if body_result.node_idx >= 0 {
        body_idx = body_result.node_idx
        p = body_result.new_pos
    }

    // Create ast.DECL_FUNC node for closure body
    func_node := AstNode {
        tag: ast.DECL_FUNC, int_val: 0, str_val: cl_name,
        left: first_param_idx, right: body_idx, extra: -1, type_tag: ret_type_tag
    }
    nodes = append(nodes, func_node)
    g_closure_func_indices = append(g_closure_func_indices, len(nodes) - 1)
    g_closure_func_names = append(g_closure_func_names, cl_name)

    // Create ast.EXPR_CLOSURE node
    cl_node := AstNode {
        tag: ast.EXPR_CLOSURE, int_val: is_move, str_val: cl_name,
        left: first_param_idx, right: body_idx, extra: -1, type_tag: ret_type_tag
    }
    nodes = append(nodes, cl_node)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

fn parse_string_literal(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    end_pos := lex_end(src, p, token.TK_STRING)
    raw := str_substring(src, p + 1, end_pos - 1)
    if has_interpolation(raw) == 1 {
        result_idx := parse_interp_string(raw, nodes)
        return ParseResult { node_idx: result_idx, new_pos: end_pos }
    }
    val := lex_string_value(src, p, token.TK_STRING)
    node := AstNode {
        tag: ast.EXPR_STRING, int_val: 0, str_val: val,
        left: -1, right: -1, extra: -1, type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, node)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: end_pos }
}

fn has_interpolation(raw: string) -> int {
    raw_len := len(raw)
    si := 0
    for si < raw_len {
        sc := str_char_at(raw, si)
        if sc == 92 {
            si = si + 2
        } else {
            if sc == 36 && si + 1 < raw_len && str_char_at(raw, si + 1) == 123 {
                return 1
            }
            si = si + 1
        }
    }
    return 0
}

fn parse_interp_string(raw: string, nodes: []AstNode) -> int {
    raw_len := len(raw)
    parts := []int{}
    ri := 0
    literal := ""

    for ri < raw_len {
        ch := str_char_at(raw, ri)
        if ch == 92 && ri + 1 < raw_len {
            next := str_char_at(raw, ri + 1)
            if next == 110 { literal = literal + "\n" }
            if next == 116 { literal = literal + "\t" }
            if next == 92  { literal = literal + "\\" }
            if next == 34  { literal = literal + "\"" }
            if next == 48  { poke(literal, len(literal), 0) }
            ri = ri + 2
        } else {
            if ch == 36 && ri + 1 < raw_len && str_char_at(raw, ri + 1) == 123 {
                if len(literal) > 0 {
                    str_node := AstNode {
                        tag: ast.EXPR_STRING, int_val: 0, str_val: literal,
                        left: -1, right: -1, extra: -1, type_tag: ast.TYPE_UNKNOWN
                    }
                    nodes = append(nodes, str_node)
                    parts = append(parts, len(nodes) - 1)
                    literal = ""
                }
                ri = ri + 2
                ident := ""
                for ri < raw_len && str_char_at(raw, ri) != 125 {
                    ident = ident + str_substring(raw, ri, ri + 1)
                    ri = ri + 1
                }
                if ri < raw_len {
                    ri = ri + 1
                }
                dot_pos := -1
                di := 0
                for di < len(ident) {
                    if str_char_at(ident, di) == 46 {
                        dot_pos = di
                        break
                    }
                    di = di + 1
                }
                inner_idx := -1
                if dot_pos >= 0 {
                    obj_name := str_substring(ident, 0, dot_pos)
                    field_name := str_substring(ident, dot_pos + 1, len(ident))
                    obj_idx := new_ident_node(obj_name, nodes)
                    field_node := AstNode {
                        tag: ast.EXPR_FIELD, int_val: 0, str_val: field_name,
                        left: obj_idx, right: -1, extra: -1, type_tag: ast.TYPE_UNKNOWN
                    }
                    nodes = append(nodes, field_node)
                    inner_idx = len(nodes) - 1
                } else {
                    inner_idx = new_ident_node(ident, nodes)
                }
                to_str_node := AstNode {
                    tag: ast.EXPR_TO_STRING, int_val: 0, str_val: "",
                    left: inner_idx, right: -1, extra: -1, type_tag: ast.TYPE_STRING
                }
                nodes = append(nodes, to_str_node)
                parts = append(parts, len(nodes) - 1)
            } else {
                literal = literal + str_substring(raw, ri, ri + 1)
                ri = ri + 1
            }
        }
    }

    if len(literal) > 0 {
        str_node := AstNode {
            tag: ast.EXPR_STRING, int_val: 0, str_val: literal,
            left: -1, right: -1, extra: -1, type_tag: ast.TYPE_UNKNOWN
        }
        nodes = append(nodes, str_node)
        parts = append(parts, len(nodes) - 1)
    }

    if len(parts) == 0 {
        str_node := AstNode {
            tag: ast.EXPR_STRING, int_val: 0, str_val: "",
            left: -1, right: -1, extra: -1, type_tag: ast.TYPE_UNKNOWN
        }
        nodes = append(nodes, str_node)
        return len(nodes) - 1
    }
    if len(parts) == 1 {
        return parts[0]
    }

    result := parts[0]
    i := 1
    for i < len(parts) {
        result = new_binary_node(token.TK_PLUS, result, parts[i], nodes)
        i = i + 1
    }
    return result
}

// Parse atom (literal or identifier - no parentheses yet)
fn parse_atom(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)
    kind := lex_kind(src, p)

    // Closure: |params| body, || body, or move |params| body
    if kind == token.TK_PIPE {
        return parse_closure_expr(src, p, nodes)
    }
    if kind == token.TK_OR {
        // || is no-param closure: || -> type { body }
        return parse_closure_expr(src, p, nodes)
    }
    if kind == token.TK_IDENT && lex_string_value(src, p, kind) == "move" {
        // Check if next non-whitespace token is '|' or '||' — then it's a closure
        saved := lex_end(src, p, kind)
        saved = lex_skip(src, saved)
        if lex_kind(src, saved) == token.TK_PIPE || lex_kind(src, saved) == token.TK_OR {
            return parse_closure_expr(src, p, nodes)
        }
    }
    if kind == token.TK_MATCH {
        return parse_match_stmt(src, p, nodes)
    }
    if kind == token.TK_INT {
        val := lex_int_value(src, p)
        node := new_int_node(val, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == token.TK_FLOAT {
        fval := lex_float_string_value(src, p)
        node := AstNode {
            tag: ast.EXPR_FLOAT,
            int_val: 0,
            str_val: fval,
            left: -1,
            right: -1,
            extra: -1,
            type_tag: ast.TYPE_FLOAT
        }
        nodes = append(nodes, node)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }
    if kind == token.TK_TRUE {
        node := new_bool_node(1, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == token.TK_FALSE {
        node := new_bool_node(0, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == token.TK_STRING {
        return parse_string_literal(src, p, nodes)
    }
    if kind == token.TK_IDENT {
        name := lex_string_value(src, p, kind)
        p = lex_end(src, p, kind)
        p_saved := p
        p_check := lex_skip(src, p)

        // Check for enum variant: Ident::Variant
        if lex_kind(src, p_check) == token.TK_COLONCOLON {
            p = p_check
            p = lex_end(src, p, token.TK_COLONCOLON)
            p = lex_skip(src, p)

            if lex_kind(src, p) == token.TK_IDENT {
                variant_name := lex_string_value(src, p, token.TK_IDENT)
                p = lex_end(src, p, token.TK_IDENT)
                // Skip optional type arguments: Option::Some[int]{ value: 42 }
                record_type_args(src, p, name, count_line_at(src, p))
                p = skip_type_args(src, p)
                p = lex_skip(src, p)
                qualified := name + "." + variant_name

                // Check for field values: { field: value, ... }
                field_value_indices := []int{}
                if lex_kind(src, p) == token.TK_LBRACE {
                    p = lex_end(src, p, token.TK_LBRACE)
                    p = lex_skip(src, p)

                    for {
                        if lex_kind(src, p) == token.TK_RBRACE || lex_kind(src, p) == token.TK_EOF {
                            break
                        }

                        // Parse field name
                        if lex_kind(src, p) != token.TK_IDENT {
                            break
                        }
                        p = lex_end(src, p, token.TK_IDENT)
                        p = lex_skip(src, p)

                        // Expect ':'
                        if lex_kind(src, p) != token.TK_COLON {
                            break
                        }
                        p = lex_end(src, p, token.TK_COLON)
                        p = lex_skip(src, p)

                        // Parse value expression
                        val_result := parse_expr_with_pos(src, p, nodes)
                        if val_result.node_idx < 0 {
                            break
                        }
                        field_value_indices = append(field_value_indices, val_result.node_idx)
                        p = val_result.new_pos
                        p = lex_skip(src, p)

                        if lex_kind(src, p) == token.TK_COMMA {
                            p = lex_end(src, p, token.TK_COMMA)
                            p = lex_skip(src, p)
                        }
                    }

                    // Expect '}'
                    if lex_kind(src, p) == token.TK_RBRACE {
                        p = lex_end(src, p, token.TK_RBRACE)
                    }
                }

                // Create ast.EXPR_ENUM_VARIANT node
                first_field := -1
                if len(field_value_indices) > 0 {
                    first_field = field_value_indices[0]
                }
                ev_node := AstNode {
                    tag: ast.EXPR_ENUM_VARIANT,
                    int_val: len(field_value_indices),
                    str_val: qualified,
                    left: first_field,
                    right: -1,
                    extra: -1,
                    type_tag: ast.TYPE_UNKNOWN
                }
                nodes = append(nodes, ev_node)
                ev_idx := len(nodes) - 1

                // Store field values using existing struct fields side table
                store_struct_fields(ev_idx, field_value_indices)

                return ParseResult { node_idx: ev_idx, new_pos: p }
            }
            // Failed to parse variant, restore
            p = p_saved
        } else {
            p = p_saved
        }

        node := new_ident_node(name, nodes)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == token.TK_MAP {
        // Map literal: map[KeyType]ValType{}
        p = lex_end(src, p, kind)
        p = lex_skip(src, p)
        map_key_type := ""
        map_val_type := ""
        if lex_kind(src, p) == token.TK_LBRACKET { p = lex_end(src, p, token.TK_LBRACKET) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_IDENT { map_key_type = lex_string_value(src, p, token.TK_IDENT) p = lex_end(src, p, token.TK_IDENT) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_RBRACKET { p = lex_end(src, p, token.TK_RBRACKET) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_IDENT { map_val_type = lex_string_value(src, p, token.TK_IDENT) p = lex_end(src, p, token.TK_IDENT) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_LBRACE { p = lex_end(src, p, token.TK_LBRACE) p = lex_skip(src, p) }
        if lex_kind(src, p) == token.TK_RBRACE { p = lex_end(src, p, token.TK_RBRACE) }
        map_type_str := "map[" + map_key_type + "]" + map_val_type
        map_node := AstNode {
            tag: ast.EXPR_MAP_LIT,
            int_val: 0,
            str_val: map_type_str,
            left: -1,
            right: -1,
            extra: -1,
            type_tag: ast.TYPE_MAP
        }
        nodes = append(nodes, map_node)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }
    if kind == token.TK_LBRACKET {
        // Array literal: []Type{elem1, elem2, ...}
        // For bootstrap: simplified to []int{...}
        p = lex_end(src, p, kind)  // Skip '['
        p = lex_skip(src, p)

        // Expect ']'
        if lex_kind(src, p) != token.TK_RBRACKET {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, token.TK_RBRACKET)
        p = lex_skip(src, p)

        // Parse element type name
        elem_type_name := "int"
        if lex_kind(src, p) == token.TK_IDENT {
            elem_type_name = lex_string_value(src, p, token.TK_IDENT)
            p = lex_end(src, p, token.TK_IDENT)
            p = lex_skip(src, p)
        }

        // Expect '{'
        if lex_kind(src, p) != token.TK_LBRACE {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, token.TK_LBRACE)
        p = lex_skip(src, p)

        // Parse elements
        elem_count := 0
        first_elem_idx := -1

        for {
            p = lex_skip(src, p)
            if lex_kind(src, p) == token.TK_RBRACE {
                break
            }

            // Parse element expression
            elem_result := parse_expr_with_pos(src, p, nodes)
            if elem_result.node_idx < 0 {
                break
            }

            if elem_count == 0 {
                first_elem_idx = elem_result.node_idx
            }
            elem_count = elem_count + 1

            p = elem_result.new_pos
            p = lex_skip(src, p)

            // Check for comma
            if lex_kind(src, p) == token.TK_COMMA {
                p = lex_end(src, p, token.TK_COMMA)
                p = lex_skip(src, p)
            } else {
                break
            }
        }

        // Expect '}'
        if lex_kind(src, p) != token.TK_RBRACE {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, token.TK_RBRACE)

        // Create array literal node
        array_node := AstNode {
            tag: ast.EXPR_ARRAY_LIT,
            int_val: elem_count,
            str_val: elem_type_name,  // element type
            left: -1,
            right: first_elem_idx,
            extra: -1,
            type_tag: ast.TYPE_UNKNOWN
        }
        nodes = append(nodes, array_node)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }

    return ParseResult { node_idx: -1, new_pos: p }
}

// Parse unary: - !
fn parse_unary(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    pos := lex_skip(src, start_pos)
    kind := lex_kind(src, pos)

    if kind == token.TK_MINUS {
        new_pos := lex_end(src, pos, kind)
        operand_result := parse_unary(src, new_pos, nodes)
        if operand_result.node_idx < 0 {
            return operand_result
        }
        unary_idx := new_unary_node(kind, operand_result.node_idx, nodes)
        return ParseResult { node_idx: unary_idx, new_pos: operand_result.new_pos }
    }

    if kind == token.TK_NOT {
        new_pos := lex_end(src, pos, kind)
        operand_result := parse_unary(src, new_pos, nodes)
        if operand_result.node_idx < 0 {
            return operand_result
        }
        unary_idx := new_unary_node(kind, operand_result.node_idx, nodes)
        return ParseResult { node_idx: unary_idx, new_pos: operand_result.new_pos }
    }

    if kind == token.TK_AMPERSAND {
        new_pos := lex_end(src, pos, kind)
        operand_result := parse_unary(src, new_pos, nodes)
        if operand_result.node_idx < 0 {
            return operand_result
        }
        unary_idx := new_unary_node(kind, operand_result.node_idx, nodes)
        return ParseResult { node_idx: unary_idx, new_pos: operand_result.new_pos }
    }

    if kind == token.TK_STAR {
        new_pos := lex_end(src, pos, kind)
        operand_result := parse_unary(src, new_pos, nodes)
        if operand_result.node_idx < 0 {
            return operand_result
        }
        unary_idx := new_unary_node(kind, operand_result.node_idx, nodes)
        return ParseResult { node_idx: unary_idx, new_pos: operand_result.new_pos }
    }

    return parse_primary_expr(src, start_pos, nodes)
}

// Parse multiplicative: * / %
fn parse_multiplicative(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    result := parse_unary(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    pos := result.new_pos
    left := result.node_idx

    for {
        pos = lex_skip(src, pos)
        op := lex_kind(src, pos)
        if op != token.TK_STAR && op != token.TK_SLASH && op != token.TK_PERCENT {
            break
        }

        pos = lex_end(src, pos, op)
        right_result := parse_unary(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse additive: + -
fn parse_additive(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    result := parse_multiplicative(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    pos := result.new_pos
    left := result.node_idx

    for {
        pos = lex_skip(src, pos)
        op := lex_kind(src, pos)
        if op != token.TK_PLUS && op != token.TK_MINUS {
            break
        }

        pos = lex_end(src, pos, op)
        right_result := parse_multiplicative(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse comparison: < > <= >= == !=
fn parse_comparison(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    result := parse_additive(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    pos := result.new_pos
    left := result.node_idx

    pos = lex_skip(src, pos)
    op := lex_kind(src, pos)
    if op == token.TK_DOTDOT {
        pos = lex_end(src, pos, op)
        right_result := parse_additive(src, pos, nodes)
        if right_result.node_idx >= 0 {
            left = new_binary_node(op, left, right_result.node_idx, nodes)
            pos = right_result.new_pos
        }
        return ParseResult { node_idx: left, new_pos: pos }
    }
    if op == token.TK_LT || op == token.TK_GT || op == token.TK_LE || op == token.TK_GE ||
       op == token.TK_EQ || op == token.TK_NE {
        pos = lex_end(src, pos, op)
        right_result := parse_additive(src, pos, nodes)
        if right_result.node_idx >= 0 {
            left = new_binary_node(op, left, right_result.node_idx, nodes)
            pos = right_result.new_pos
        }
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse bitwise AND: &
fn parse_bitand(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    result := parse_comparison(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    pos := result.new_pos
    left := result.node_idx

    for {
        pos = lex_skip(src, pos)
        op := lex_kind(src, pos)
        if op != token.TK_AMPERSAND {
            break
        }

        pos = lex_end(src, pos, op)
        right_result := parse_comparison(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse XOR: ^
fn parse_xor(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    result := parse_bitand(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    pos := result.new_pos
    left := result.node_idx

    for {
        pos = lex_skip(src, pos)
        op := lex_kind(src, pos)
        if op != token.TK_CARET {
            break
        }

        pos = lex_end(src, pos, op)
        right_result := parse_bitand(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse bitwise OR: |
fn parse_bitor(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    result := parse_xor(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    pos := result.new_pos
    left := result.node_idx

    for {
        pos = lex_skip(src, pos)
        op := lex_kind(src, pos)
        if op != token.TK_PIPE {
            break
        }

        pos = lex_end(src, pos, op)
        right_result := parse_xor(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse logical AND: &&
fn parse_logical_and(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    result := parse_bitor(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    pos := result.new_pos
    left := result.node_idx

    for {
        pos = lex_skip(src, pos)
        op := lex_kind(src, pos)
        if op != token.TK_AND {
            break
        }

        pos = lex_end(src, pos, op)
        right_result := parse_bitor(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse logical OR: || (top level)
fn parse_expr_with_pos(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    result := parse_logical_and(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    pos := result.new_pos
    left := result.node_idx

    for {
        pos = lex_skip(src, pos)
        op := lex_kind(src, pos)
        if op != token.TK_OR {
            break
        }

        pos = lex_end(src, pos, op)
        right_result := parse_logical_and(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse primary with parentheses support (defined after parse_expr_with_pos)
fn parse_primary_expr(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos
    p = lex_skip(src, p)
    kind := lex_kind(src, p)

    // Check for parenthesized expression first
    if kind == token.TK_LPAREN {
        p = lex_end(src, p, kind)  // Skip '('
        // Recursively parse the full expression inside parentheses
        expr_result := parse_expr_with_pos(src, p, nodes)
        if expr_result.node_idx < 0 {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = expr_result.new_pos
        p = lex_skip(src, p)
        rparen := lex_kind(src, p)
        if rparen != token.TK_RPAREN {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, rparen)  // Skip ')'
        return ParseResult { node_idx: expr_result.node_idx, new_pos: p }
    }

    // Otherwise, parse atom (literal or identifier)
    atom_result := parse_atom(src, pos, nodes)
    if atom_result.node_idx < 0 {
        return atom_result
    }

    // Handle postfix operators (function calls, array indexing, field access) in a loop for chaining
    current_node := atom_result.node_idx
    p = atom_result.new_pos

    for {
        p = lex_skip(src, p)
        next_kind := lex_kind(src, p)

        if next_kind == token.TK_LPAREN {
            // It's a function call
            call_pos := p
            func_name_node := current_node
            p = lex_end(src, p, next_kind)  // Skip '('
            p = lex_skip(src, p)

            // Parse arguments
            first_arg := -1
            arg_indices := []int{}

            // Check if there are any arguments
            if lex_kind(src, p) != token.TK_RPAREN {
                for {
                    arg_result := parse_expr_with_pos(src, p, nodes)
                    if arg_result.node_idx < 0 {
                        break
                    }

                    if first_arg < 0 {
                        first_arg = arg_result.node_idx
                    }
                    arg_indices = append(arg_indices, arg_result.node_idx)

                    p = arg_result.new_pos
                    p = lex_skip(src, p)

                    // Check for comma
                    if lex_kind(src, p) == token.TK_COMMA {
                        p = lex_end(src, p, token.TK_COMMA)
                        p = lex_skip(src, p)
                    } else {
                        break
                    }
                }
            }

            // Expect ')'
            p = lex_skip(src, p)
            if lex_kind(src, p) != token.TK_RPAREN {
                return ParseResult { node_idx: -1, new_pos: p }
            }
            p = lex_end(src, p, token.TK_RPAREN)

            // Create call expression node
            // left = function name node, right = first argument, int_val = arg count
            // If func_name_node is ast.EXPR_FIELD with ast.EXPR_IDENT base, construct qualified name (e.g. "os.ReadFile")
            func_name := nodes[func_name_node].str_val
            if nodes[func_name_node].tag == ast.EXPR_FIELD {
                base_idx := nodes[func_name_node].left
                if base_idx >= 0 && nodes[base_idx].tag == ast.EXPR_IDENT {
                    func_name = nodes[base_idx].str_val + "." + func_name
                }
            }
            call_node := AstNode {
                tag: ast.EXPR_CALL,
                int_val: len(arg_indices),
                str_val: func_name,
                left: func_name_node,
                right: first_arg,
                extra: count_line_at(src, call_pos),
                type_tag: ast.TYPE_UNKNOWN
            }
            nodes = append(nodes, call_node)
            current_node = len(nodes) - 1

            // Store argument indices for this call node
            store_call_args(current_node, arg_indices)
            // Continue to check for more postfix operators
        } else {
            // Note: Struct literals (StructName { field: value }) are currently NOT parsed
            // as postfix operators due to ambiguity with statement blocks. For now, struct
            // literals must be parsed as primary expressions or handled separately.
            if next_kind == token.TK_LBRACE && nodes[current_node].tag == ast.EXPR_IDENT {
                // Struct literal: StructName { field1: value1, field2: value2 }
                // Only parse if identifier starts with uppercase (struct names are capitalized)
                struct_name_node := current_node
                struct_name := nodes[struct_name_node].str_val

                // Check if first character is uppercase (65-90 = A-Z)
                is_uppercase := 0
                if len(struct_name) > 0 {
                    first_char := str_char_at(struct_name, 0)
                    if first_char >= 65 && first_char <= 90 {
                        is_uppercase = 1
                    }
                }

                if is_uppercase == 0 {
                    // Not a struct literal, continue
                    break
                }

                // Look ahead: struct literal must start with { IDENT : or { }
                // This avoids misinterpreting CONST_NAME { ... } as a struct literal
                la_p := lex_end(src, p, next_kind)  // Skip '{'
                la_p = lex_skip(src, la_p)
                looks_like_struct := 0
                if lex_kind(src, la_p) == token.TK_RBRACE {
                    looks_like_struct = 1
                } else if lex_kind(src, la_p) == token.TK_IDENT {
                    la_ident_end := lex_end(src, la_p, token.TK_IDENT)
                    la_after := lex_skip(src, la_ident_end)
                    if lex_kind(src, la_after) == token.TK_COLON {
                        looks_like_struct = 1
                    }
                }
                if looks_like_struct == 0 {
                    break
                }

                p = lex_end(src, p, next_kind)  // Skip '{'
                p = lex_skip(src, p)

                // Parse field initializers (simplified - just count them for now)
                first_field_idx := -1
                field_value_indices := []int{}

                for {
                    p = lex_skip(src, p)
                    if lex_kind(src, p) == token.TK_RBRACE {
                        break
                    }

                    // Parse field name
                    if lex_kind(src, p) != token.TK_IDENT {
                        break
                    }
                    field_name := lex_string_value(src, p, token.TK_IDENT)
                    p = lex_end(src, p, token.TK_IDENT)
                    p = lex_skip(src, p)

                    // Expect ':'
                    if lex_kind(src, p) != token.TK_COLON {
                        break
                    }
                    p = lex_end(src, p, token.TK_COLON)
                    p = lex_skip(src, p)

                    // Parse field value expression
                    value_result := parse_expr_with_pos(src, p, nodes)
                    if value_result.node_idx < 0 {
                        break
                    }

                    if first_field_idx < 0 {
                        first_field_idx = value_result.node_idx
                    }
                    field_value_indices = append(field_value_indices, value_result.node_idx)

                    p = value_result.new_pos
                    p = lex_skip(src, p)

                    // Check for comma
                    if lex_kind(src, p) == token.TK_COMMA {
                        p = lex_end(src, p, token.TK_COMMA)
                        p = lex_skip(src, p)
                    } else {
                        break
                    }
                }

                // Expect '}'
                if lex_kind(src, p) != token.TK_RBRACE {
                    return ParseResult { node_idx: -1, new_pos: p }
                }
                p = lex_end(src, p, token.TK_RBRACE)

                // Create struct literal node
                struct_lit_node := AstNode {
                    tag: ast.EXPR_STRUCT_LIT,
                    int_val: len(field_value_indices),
                    str_val: struct_name,
                    left: struct_name_node,
                    right: first_field_idx,
                    extra: -1,
                    type_tag: ast.TYPE_UNKNOWN
                }
                nodes = append(nodes, struct_lit_node)
                current_node = len(nodes) - 1

                // Store field value indices for this struct literal
                store_struct_fields(current_node, field_value_indices)
                // Continue to check for more postfix operators
            } else {
                if next_kind == token.TK_LBRACKET {
                    // Check if this is generic type args (Name[Type]{ or Name[Type]()
                    // vs array indexing (arr[idx])
                    is_generic_args := 0
                    if nodes[current_node].tag == ast.EXPR_IDENT || nodes[current_node].tag == ast.EXPR_FIELD {
                        gen_name := nodes[current_node].str_val
                        if len(gen_name) > 0 {
                            // Look ahead past [...] to see { or (
                            gen_p := skip_type_args(src, p)
                            gen_p = lex_skip(src, gen_p)
                            gen_after := lex_kind(src, gen_p)
                            gen_fc := str_char_at(gen_name, 0)
                            if gen_after == token.TK_LPAREN {
                                // name[Type](args) — generic function call
                                gen_line := count_line_at(src, p)
                                record_type_args(src, p, gen_name, gen_line)
                                p = gen_p
                                is_generic_args = 1
                            } else if gen_after == token.TK_LBRACE && gen_fc >= 65 && gen_fc <= 90 {
                                // Name[Type]{ fields } — generic struct literal
                                gen_line := count_line_at(src, p)
                                record_type_args(src, p, gen_name, gen_line)
                                p = gen_p
                                is_generic_args = 1
                            }
                        }
                    }
                    if is_generic_args == 0 {
                    // Array indexing or slice
                    array_node := current_node
                    p = lex_end(src, p, next_kind)  // Skip '['
                    p = lex_skip(src, p)

                    // Check for [:end] or [:] — colon before any expression
                    if lex_kind(src, p) == token.TK_COLON {
                        // Slice with default start
                        p = lex_end(src, p, token.TK_COLON)
                        p = lex_skip(src, p)
                        end_node := -1
                        if lex_kind(src, p) != token.TK_RBRACKET {
                            // [:end]
                            end_result := parse_expr_with_pos(src, p, nodes)
                            if end_result.node_idx < 0 {
                                return ParseResult { node_idx: -1, new_pos: p }
                            }
                            end_node = end_result.node_idx
                            p = end_result.new_pos
                            p = lex_skip(src, p)
                        }
                        // Expect ']'
                        if lex_kind(src, p) != token.TK_RBRACKET {
                            return ParseResult { node_idx: -1, new_pos: p }
                        }
                        p = lex_end(src, p, token.TK_RBRACKET)
                        slice_node := AstNode {
                            tag: ast.EXPR_SLICE,
                            int_val: 0,
                            str_val: "",
                            left: array_node,
                            right: -1,
                            extra: end_node,
                            type_tag: ast.TYPE_UNKNOWN
                        }
                        nodes = append(nodes, slice_node)
                        current_node = len(nodes) - 1
                    } else {
                        // Parse first expression (could be index or slice start)
                        index_result := parse_expr_with_pos(src, p, nodes)
                        if index_result.node_idx < 0 {
                            return ParseResult { node_idx: -1, new_pos: p }
                        }
                        p = index_result.new_pos
                        p = lex_skip(src, p)

                        if lex_kind(src, p) == token.TK_COLON {
                            // Slice: arr[start:end] or arr[start:]
                            p = lex_end(src, p, token.TK_COLON)
                            p = lex_skip(src, p)
                            end_node := -1
                            if lex_kind(src, p) != token.TK_RBRACKET {
                                // arr[start:end]
                                end_result := parse_expr_with_pos(src, p, nodes)
                                if end_result.node_idx < 0 {
                                    return ParseResult { node_idx: -1, new_pos: p }
                                }
                                end_node = end_result.node_idx
                                p = end_result.new_pos
                                p = lex_skip(src, p)
                            }
                            // Expect ']'
                            if lex_kind(src, p) != token.TK_RBRACKET {
                                return ParseResult { node_idx: -1, new_pos: p }
                            }
                            p = lex_end(src, p, token.TK_RBRACKET)
                            slice_node := AstNode {
                                tag: ast.EXPR_SLICE,
                                int_val: 0,
                                str_val: "",
                                left: array_node,
                                right: index_result.node_idx,
                                extra: end_node,
                                type_tag: ast.TYPE_UNKNOWN
                            }
                            nodes = append(nodes, slice_node)
                            current_node = len(nodes) - 1
                        } else {
                            // Regular index access: arr[idx]
                            if lex_kind(src, p) != token.TK_RBRACKET {
                                return ParseResult { node_idx: -1, new_pos: p }
                            }
                            p = lex_end(src, p, token.TK_RBRACKET)
                            index_node := AstNode {
                                tag: ast.EXPR_INDEX,
                                int_val: 0,
                                str_val: "",
                                left: array_node,
                                right: index_result.node_idx,
                                extra: -1,
                                type_tag: ast.TYPE_UNKNOWN
                            }
                            nodes = append(nodes, index_node)
                            current_node = len(nodes) - 1
                        }
                    }
                    }
                } else {
                    if next_kind == token.TK_DOT {
                        // Field access
                        base_node := current_node
                        p = lex_end(src, p, next_kind)  // Skip '.'
                        p = lex_skip(src, p)

                        // Parse field name
                        field_kind := lex_kind(src, p)
                        if field_kind != token.TK_IDENT {
                            return ParseResult { node_idx: -1, new_pos: p }
                        }
                        field_name := lex_string_value(src, p, field_kind)
                        p = lex_end(src, p, field_kind)

                        // Create field access node
                        // left = base expression, str_val = field name
                        field_node := AstNode {
                            tag: ast.EXPR_FIELD,
                            int_val: 0,
                            str_val: field_name,
                            left: base_node,
                            right: -1,
                            extra: -1,
                            type_tag: ast.TYPE_UNKNOWN
                        }
                        nodes = append(nodes, field_node)
                        current_node = len(nodes) - 1
                        // Continue to check for more postfix operators
                    } else if next_kind == token.TK_QUESTION {
                        // Try operator: expr?
                        p = lex_end(src, p, next_kind)
                        try_node := AstNode {
                            tag: ast.EXPR_TRY,
                            int_val: 0,
                            str_val: "",
                            left: current_node,
                            right: -1,
                            extra: -1,
                            type_tag: ast.TYPE_UNKNOWN
                        }
                        nodes = append(nodes, try_node)
                        current_node = len(nodes) - 1
                    } else {
                        // No more postfix operators, break the loop
                        break
                    }
                }
            }
        }
    }

    return ParseResult { node_idx: current_node, new_pos: p }
}

// Wrapper for backward compatibility
fn parse_expr_simple(src: string, nodes: []AstNode) -> int {
    result := parse_expr_with_pos(src, 0, nodes)
    return result.node_idx
}

// Extern function declaration side tables
g_extern_decl_names := []string{}
g_extern_decl_param_counts := []int{}
g_extern_decl_param_starts := []int{}
g_extern_decl_param_types := []int{}
g_extern_decl_ret_types := []int{}

fn extern_type_from_name(name: string) -> int {
    if name == "i32" { return EXTERN_I32 }
    if name == "i64" { return EXTERN_I64 }
    if name == "ptr" { return EXTERN_PTR }
    if name == "void" { return EXTERN_VOID }
    return 0
}

// Parse extern fn declaration: extern fn name(param: type, ...) -> ret_type
fn parse_extern_fn_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    p := pos

    // Skip 'extern'
    p = lex_end(src, p, token.TK_EXTERN)
    p = lex_skip(src, p)

    // Expect 'fn'
    if lex_kind(src, p) != token.TK_FN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, token.TK_FN)
    p = lex_skip(src, p)

    // Parse function name
    if lex_kind(src, p) != token.TK_IDENT {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    func_name := lex_string_value(src, p, token.TK_IDENT)
    p = lex_end(src, p, token.TK_IDENT)
    p = lex_skip(src, p)

    // Expect '('
    if lex_kind(src, p) != token.TK_LPAREN {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, token.TK_LPAREN)
    p = lex_skip(src, p)

    // Parse parameters: name: type, ...
    param_types := []int{}
    for lex_kind(src, p) != token.TK_RPAREN {
        if len(param_types) > 0 {
            // Expect comma
            if lex_kind(src, p) == token.TK_COMMA {
                p = lex_end(src, p, token.TK_COMMA)
                p = lex_skip(src, p)
            }
        }
        // Parse param name
        if lex_kind(src, p) != token.TK_IDENT {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)
        // Expect ':'
        if lex_kind(src, p) != token.TK_COLON {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, token.TK_COLON)
        p = lex_skip(src, p)
        // Parse type name (i32, i64, ptr)
        type_name := lex_string_value(src, p, token.TK_IDENT)
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)
        param_types = append(param_types, extern_type_from_name(type_name))
    }

    // Skip ')'
    p = lex_end(src, p, token.TK_RPAREN)
    p = lex_skip(src, p)

    // Parse return type (optional: -> type)
    ret_type := EXTERN_VOID
    if lex_kind(src, p) == token.TK_ARROW {
        p = lex_end(src, p, token.TK_ARROW)
        p = lex_skip(src, p)
        ret_name := lex_string_value(src, p, token.TK_IDENT)
        p = lex_end(src, p, token.TK_IDENT)
        p = lex_skip(src, p)
        ret_type = extern_type_from_name(ret_name)
    }

    // Store in side tables
    g_extern_decl_names = append(g_extern_decl_names, func_name)
    g_extern_decl_param_counts = append(g_extern_decl_param_counts, len(param_types))
    g_extern_decl_param_starts = append(g_extern_decl_param_starts, len(g_extern_decl_param_types))
    ei := 0
    for ei < len(param_types) {
        g_extern_decl_param_types = append(g_extern_decl_param_types, param_types[ei])
        ei = ei + 1
    }
    g_extern_decl_ret_types = append(g_extern_decl_ret_types, ret_type)

    // Create a ast.DECL_FUNC node with right = -1 (no body)
    func_node := AstNode {
        tag: ast.DECL_FUNC,
        int_val: 0,
        str_val: func_name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: ast.TYPE_UNKNOWN
    }
    nodes = append(nodes, func_node)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}
