// ============================================================
// Side table: match arm bindings
// ============================================================

g_match_arm_bindings := []int{}
g_match_arm_binding_names := []string{}

fn store_match_arm_bindings(arm_node_idx: int, names: []string) {
    g_match_arm_bindings = append(g_match_arm_bindings, arm_node_idx)
    g_match_arm_bindings = append(g_match_arm_bindings, len(names))
    start := len(g_match_arm_binding_names)
    g_match_arm_bindings = append(g_match_arm_bindings, start)
    i := 0
    for i < len(names) {
        g_match_arm_binding_names = append(g_match_arm_binding_names, names[i])
        i = i + 1
    }
}

fn get_match_arm_bindings(arm_node_idx: int) -> []string {
    i := 0
    for i < len(g_match_arm_bindings) {
        if g_match_arm_bindings[i] == arm_node_idx {
            count := g_match_arm_bindings[i + 1]
            start := g_match_arm_bindings[i + 2]
            result := []string{}
            j := 0
            for j < count {
                result = append(result, g_match_arm_binding_names[start + j])
                j = j + 1
            }
            return result
        }
        i = i + 3
    }
    return []string{}
}

// ============================================================
// Field type registry
// ============================================================

g_field_reg_names := []string{}
g_field_reg_types := []int{}
g_field_reg_is_array := []int{}
g_field_reg_struct_names := []string{}

fn register_field_type(name: string, field_type: int, is_array: int) {
    i := 0
    for i < len(g_field_reg_names) {
        if g_field_reg_names[i] == name { return }
        i = i + 1
    }
    g_field_reg_names = append(g_field_reg_names, name)
    g_field_reg_types = append(g_field_reg_types, field_type)
    g_field_reg_is_array = append(g_field_reg_is_array, is_array)
    g_field_reg_struct_names = append(g_field_reg_struct_names, "")
}

fn register_field_struct_name(name: string, sname: string) {
    i := 0
    for i < len(g_field_reg_names) {
        if g_field_reg_names[i] == name {
            g_field_reg_struct_names[i] = sname
            return
        }
        i = i + 1
    }
}

fn lookup_field_struct_name(name: string) -> string {
    i := 0
    for i < len(g_field_reg_names) {
        if g_field_reg_names[i] == name {
            return g_field_reg_struct_names[i]
        }
        i = i + 1
    }
    return ""
}

fn lookup_field_type(name: string) -> int {
    i := 0
    for i < len(g_field_reg_names) {
        if g_field_reg_names[i] == name {
            return g_field_reg_types[i]
        }
        i = i + 1
    }
    return TYPE_UNKNOWN
}

fn lookup_field_is_array(name: string) -> int {
    i := 0
    for i < len(g_field_reg_names) {
        if g_field_reg_names[i] == name {
            return g_field_reg_is_array[i]
        }
        i = i + 1
    }
    return 0
}

// ============================================================
// Function return type registry
// ============================================================

g_func_ret_names := []string{}
g_func_ret_types := []int{}
g_func_ret_is_array := []int{}
g_func_ret_struct_names := []string{}
g_func_ret_tuple_types := []int{}
g_func_ret_tuple_starts := []int{}
g_func_ret_tuple_counts := []int{}

fn parse_type_name_to_tag(t: string) -> int {
    if t == "int" { return TYPE_INT }
    if t == "string" { return TYPE_STRING }
    if t == "bool" { return TYPE_BOOL }
    if t == "float" { return TYPE_FLOAT }
    return TYPE_UNKNOWN
}

fn register_func_return_type(name: string, ret_type: int, is_array: int, struct_name: string) {
    g_func_ret_names = append(g_func_ret_names, name)
    g_func_ret_types = append(g_func_ret_types, ret_type)
    g_func_ret_is_array = append(g_func_ret_is_array, is_array)
    g_func_ret_struct_names = append(g_func_ret_struct_names, struct_name)
    // Check for tuple return type: struct_name starts with "__tuple"
    if strings.HasPrefix(struct_name, "__tuple") {
        // Parse "__tupleN:type1,type2,..."
        // Find ':' separator
        colon_pos := -1
        ci := 0
        for ci < len(struct_name) {
            if str_char_at(struct_name, ci) == 58 { colon_pos = ci break }
            ci = ci + 1
        }
        if colon_pos > 0 {
            g_func_ret_tuple_starts = append(g_func_ret_tuple_starts, len(g_func_ret_tuple_types))
            // Parse comma-separated types after ':'
            types_str := str_substring(struct_name, colon_pos + 1, len(struct_name))
            count := 0
            tstart := 0
            ti := 0
            for ti <= len(types_str) {
                if ti == len(types_str) || str_char_at(types_str, ti) == 44 {
                    tname := str_substring(types_str, tstart, ti)
                    g_func_ret_tuple_types = append(g_func_ret_tuple_types, parse_type_name_to_tag(tname))
                    count = count + 1
                    tstart = ti + 1
                }
                ti = ti + 1
            }
            g_func_ret_tuple_counts = append(g_func_ret_tuple_counts, count)
        } else {
            g_func_ret_tuple_starts = append(g_func_ret_tuple_starts, len(g_func_ret_tuple_types))
            g_func_ret_tuple_counts = append(g_func_ret_tuple_counts, 0)
        }
    } else {
        g_func_ret_tuple_starts = append(g_func_ret_tuple_starts, len(g_func_ret_tuple_types))
        g_func_ret_tuple_counts = append(g_func_ret_tuple_counts, 0)
    }
}

fn lookup_func_return_tuple_count(name: string) -> int {
    i := len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_tuple_counts[i]
        }
        i = i - 1
    }
    return 0
}

fn lookup_func_return_tuple_type(name: string, elem_idx: int) -> int {
    i := len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            start := g_func_ret_tuple_starts[i]
            return g_func_ret_tuple_types[start + elem_idx]
        }
        i = i - 1
    }
    return TYPE_UNKNOWN
}

fn IsFunctionDefined(name: string) -> int {
    i := 0
    for i < len(g_func_ret_names) {
        if g_func_ret_names[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

fn lookup_func_return_type(name: string) -> int {
    i := len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_types[i]
        }
        i = i - 1
    }
    return TYPE_UNKNOWN
}

fn lookup_func_return_is_array(name: string) -> int {
    i := len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_is_array[i]
        }
        i = i - 1
    }
    return 0
}

fn lookup_func_return_struct_name(name: string) -> string {
    i := len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_struct_names[i]
        }
        i = i - 1
    }
    return ""
}

// ============================================================
// Method registry
// ============================================================

g_method_struct_names := []string{}
g_method_names := []string{}
g_method_func_names := []string{}

fn lookup_method(struct_name: string, method_name: string) -> string {
    i := 0
    for i < len(g_method_struct_names) {
        if g_method_struct_names[i] == struct_name && g_method_names[i] == method_name {
            return g_method_func_names[i]
        }
        i = i + 1
    }
    return ""
}

fn RegisterMethod(struct_name: string, method_name: string, func_name: string) {
    g_method_struct_names = append(g_method_struct_names, struct_name)
    g_method_names = append(g_method_names, method_name)
    g_method_func_names = append(g_method_func_names, func_name)
}

// ============================================================
// Function parameter type registry
// ============================================================

g_func_param_names := []string{}
g_func_param_indices := []int{}
g_func_param_type_names := []string{}

fn lookup_func_param_type_name(func_name: string, param_idx: int) -> string {
    i := 0
    for i < len(g_func_param_names) {
        if g_func_param_names[i] == func_name && g_func_param_indices[i] == param_idx {
            return g_func_param_type_names[i]
        }
        i = i + 1
    }
    return ""
}

fn RegisterFuncParam(func_name: string, param_idx: int, type_name: string) {
    g_func_param_names = append(g_func_param_names, func_name)
    g_func_param_indices = append(g_func_param_indices, param_idx)
    g_func_param_type_names = append(g_func_param_type_names, type_name)
}

// ============================================================
// Interface vtable tracking
// ============================================================

g_vtable_struct_names := []string{}
g_vtable_iface_names := []string{}

fn struct_satisfies_interface(struct_name: string, iface_name: string) -> int {
    mc := iface_method_count(iface_name)
    mi := 0
    for mi < mc {
        mname := iface_method_name(iface_name, mi)
        if lookup_method(struct_name, mname) == "" {
            return 0
        }
        mi = mi + 1
    }
    return 1
}

fn record_vtable_pair(struct_name: string, iface_name: string) {
    i := 0
    for i < len(g_vtable_struct_names) {
        if g_vtable_struct_names[i] == struct_name && g_vtable_iface_names[i] == iface_name {
            return
        }
        i = i + 1
    }
    g_vtable_struct_names = append(g_vtable_struct_names, struct_name)
    g_vtable_iface_names = append(g_vtable_iface_names, iface_name)
}

fn VtableCount() -> int {
    return len(g_vtable_struct_names)
}

fn VtableStructName(i: int) -> string {
    return g_vtable_struct_names[i]
}

fn VtableIfaceName(i: int) -> string {
    return g_vtable_iface_names[i]
}

// ============================================================
// Constants registry
// ============================================================

g_const_names := []string{}
g_const_int_values := []int{}
g_const_str_values := []string{}
g_const_types := []int{}

fn register_const(nodes: []AstNode, const_idx: int) {
    cnode := nodes[const_idx]
    g_const_names = append(g_const_names, cnode.str_val)
    g_const_types = append(g_const_types, cnode.type_tag)
    // Evaluate the literal value from the initializer
    init_idx := cnode.left
    if init_idx < 0 {
        g_const_int_values = append(g_const_int_values, 0)
        g_const_str_values = append(g_const_str_values, "")
        return
    }
    init := nodes[init_idx]
    if init.tag == EXPR_INT {
        g_const_int_values = append(g_const_int_values, init.int_val)
        g_const_str_values = append(g_const_str_values, "")
    } else if init.tag == EXPR_BOOL {
        g_const_int_values = append(g_const_int_values, init.int_val)
        g_const_str_values = append(g_const_str_values, "")
    } else if init.tag == EXPR_STRING {
        g_const_int_values = append(g_const_int_values, 0)
        g_const_str_values = append(g_const_str_values, init.str_val)
    } else if init.tag == EXPR_UNARY {
        // Negative int: -N => 0 - N (need to evaluate the child)
        if init.left >= 0 {
            child := nodes[init.left]
            g_const_int_values = append(g_const_int_values, 0 - child.int_val)
        } else {
            g_const_int_values = append(g_const_int_values, 0)
        }
        g_const_str_values = append(g_const_str_values, "")
    } else if init.tag == EXPR_FLOAT {
        g_const_int_values = append(g_const_int_values, 0)
        g_const_str_values = append(g_const_str_values, init.str_val)
    } else {
        g_const_int_values = append(g_const_int_values, 0)
        g_const_str_values = append(g_const_str_values, "")
    }
}

fn ConstCount() -> int {
    return len(g_const_names)
}

fn ConstName(i: int) -> string {
    return g_const_names[i]
}

fn ConstType(i: int) -> int {
    if i < len(g_const_types) {
        return g_const_types[i]
    }
    return TYPE_UNKNOWN
}

fn ConstIntValue(i: int) -> int {
    if i < len(g_const_int_values) {
        return g_const_int_values[i]
    }
    return 0
}

fn ConstStrValue(i: int) -> string {
    if i < len(g_const_str_values) {
        return g_const_str_values[i]
    }
    return ""
}

// ============================================================
// Rename table
// ============================================================

g_rename_from := []string{}
g_rename_to := []string{}

fn lookup_rename(name: string) -> string {
    i := 0
    for i < len(g_rename_from) {
        if g_rename_from[i] == name {
            return g_rename_to[i]
        }
        i = i + 1
    }
    return name
}

fn AddRename(from: string, to: string) {
    g_rename_from = append(g_rename_from, from)
    g_rename_to = append(g_rename_to, to)
}

// ============================================================
// Import tracking
// ============================================================

g_import_paths := []string{}
g_import_names := []string{}

fn AddImport(path: string, name: string) {
    g_import_paths = append(g_import_paths, path)
    g_import_names = append(g_import_names, name)
}

fn IsModuleLoaded(name: string) -> int {
    i := 0
    for i < len(g_import_names) {
        if g_import_names[i] == name {
            return 1
        }
        i = i + 1
    }
    return 0
}

// ============================================================
// Utility functions
// ============================================================

// Find the position of '.' in a string, returns -1 if not found
fn find_dot(name: string) -> int {
    i := 0
    for i < len(name) {
        if str_char_at(name, i) == 46 { return i }
        i = i + 1
    }
    return -1
}

// Find the last '/' in a string, returns -1 if not found
fn find_last_slash(path: string) -> int {
    i := len(path) - 1
    for i >= 0 {
        if str_char_at(path, i) == 47 { return i }
        i = i - 1
    }
    return -1
}

// Extract module name from import path: "./lexer" -> "lexer", "./sub/parser" -> "parser"
fn extract_module_name(import_path: string) -> string {
    slash_pos := find_last_slash(import_path)
    if slash_pos >= 0 {
        return str_substring(import_path, slash_pos + 1, len(import_path))
    }
    return import_path
}

// Resolve import base path relative to source file: "./lexer" -> "dir/lexer"
fn resolve_import_base(source_path: string, import_path: string) -> string {
    slash_pos := find_last_slash(source_path)
    dir := "."
    if slash_pos >= 0 {
        dir = str_substring(source_path, 0, slash_pos)
    }
    // Strip leading "./" from import_path if present
    rel_path := import_path
    if len(import_path) >= 2 && str_char_at(import_path, 0) == 46 && str_char_at(import_path, 1) == 47 {
        rel_path = str_substring(import_path, 2, len(import_path))
    }
    return dir + "/" + rel_path
}

// Resolve import path relative to source file: "./lexer" -> "dir/lexer.ease"
// For directories, returns the directory path (without .ease)
fn resolve_import_path(source_path: string, import_path: string) -> string {
    base := resolve_import_base(source_path, import_path)
    // Check if path is a directory first
    if os.IsDir(base) == 1 {
        return base
    }
    return base + ".ease"
}

// Check if a string ends with ".ease" (used for filtering directory entries)
fn has_ease_suffix(s: string) -> int {
    slen := len(s)
    if slen < 5 { return 0 }
    if str_char_at(s, slen - 5) != 46 { return 0 }
    if str_char_at(s, slen - 4) != 101 { return 0 }
    if str_char_at(s, slen - 3) != 97 { return 0 }
    if str_char_at(s, slen - 2) != 115 { return 0 }
    if str_char_at(s, slen - 1) != 101 { return 0 }
    return 1
}

// Check if a name starts with an uppercase letter (A-Z = 65-90)
fn is_exported(name: string) -> int {
    if len(name) == 0 { return 0 }
    ch := str_char_at(name, 0)
    if ch >= 65 && ch <= 90 { return 1 }
    return 0
}

// Check if a string ends with "_test.ease"
fn has_test_suffix(s: string) -> int {
    slen := len(s)
    if slen < 10 { return 0 }
    // Check "_test.ease" (10 chars from end)
    suffix := str_substring(s, slen - 10, slen)
    if suffix == "_test.ease" { return 1 }
    return 0
}

// Check if a function name starts with "Test" (uppercase T)
fn is_test_func(name: string) -> int {
    if len(name) < 5 { return 0 }
    if str_char_at(name, 0) != 84 { return 0 }  // T
    if str_char_at(name, 1) != 101 { return 0 } // e
    if str_char_at(name, 2) != 115 { return 0 } // s
    if str_char_at(name, 3) != 116 { return 0 } // t
    return 1
}

fn is_benchmark_func(name: string) -> int {
    if len(name) < 10 { return 0 }
    if str_char_at(name, 0) != 66 { return 0 }
    if str_char_at(name, 1) != 101 { return 0 }
    if str_char_at(name, 2) != 110 { return 0 }
    if str_char_at(name, 3) != 99 { return 0 }
    if str_char_at(name, 4) != 104 { return 0 }
    if str_char_at(name, 5) != 109 { return 0 }
    if str_char_at(name, 6) != 97 { return 0 }
    if str_char_at(name, 7) != 114 { return 0 }
    if str_char_at(name, 8) != 107 { return 0 }
    return 1
}

fn count_func_params(nodes: []AstNode, func_idx: int) -> int {
    node := nodes[func_idx]
    if node.left < 0 { return 0 }
    count := 0
    pi := node.left
    nodes_len := len(nodes)
    for pi < nodes_len {
        if nodes[pi].tag == DECL_PARAM {
            count = count + 1
        } else {
            break
        }
        pi = pi + 1
    }
    return count
}

fn infer_init_type(nodes: []AstNode, init_idx: int) -> int {
    if init_idx < 0 { return TYPE_UNKNOWN }
    init_node := nodes[init_idx]
    if init_node.tag == EXPR_INT { return TYPE_INT }
    if init_node.tag == EXPR_UNARY { return TYPE_INT }
    if init_node.tag == EXPR_STRING { return TYPE_STRING }
    if init_node.tag == EXPR_BOOL { return TYPE_BOOL }
    if init_node.tag == EXPR_FLOAT { return TYPE_FLOAT }
    if init_node.tag == EXPR_ARRAY_LIT {
        if init_node.str_val == "string" { return TYPE_STRING_ARRAY }
        return TYPE_INT_ARRAY
    }
    if init_node.tag == EXPR_CLOSURE { return TYPE_CLOSURE }
    return TYPE_UNKNOWN
}

// Extract doc comment lines preceding a declaration at position dpos.
// Scans backward in the raw source to find consecutive // comment lines.
// Returns the combined comment text (without // prefix), or "" if none.
fn extract_doc_comment(source: string, dpos: int) -> string {
    slen := len(source)
    if dpos <= 0 { return "" }

    // Step 1: From dpos, scan left past spaces/tabs to find the preceding newline
    p := dpos - 1
    for p >= 0 {
        ch := str_char_at(source, p)
        if ch == 32 || ch == 9 {
            p = p - 1
        } else {
            break
        }
    }
    // p should now be at a newline (10) or at start of file or at some other char
    if p < 0 { return "" }
    if str_char_at(source, p) != 10 { return "" }

    // Step 2: Scan backward line-by-line collecting comment lines
    result := ""
    for {
        // We're at a newline position. Find the start of this line.
        line_end := p
        p = p - 1
        if p < 0 { break }

        // Find start of line (after previous newline or start of file)
        line_start := p
        for line_start > 0 {
            if str_char_at(source, line_start - 1) == 10 { break }
            line_start = line_start - 1
        }

        // Extract the line content
        line := str_substring(source, line_start, line_end)

        // Skip leading whitespace to find first non-space char
        li := 0
        line_len := len(line)
        for li < line_len {
            lch := str_char_at(line, li)
            if lch != 32 && lch != 9 { break }
            li = li + 1
        }

        // Check if this line starts with "//"
        if li + 1 < line_len && str_char_at(line, li) == 47 && str_char_at(line, li + 1) == 47 {
            // Strip "// " or "//" prefix
            comment_start := li + 2
            if comment_start < line_len && str_char_at(line, comment_start) == 32 {
                comment_start = comment_start + 1
            }
            comment_text := ""
            if comment_start < line_len {
                comment_text = str_substring(line, comment_start, line_len)
            }
            // Prepend to result (building bottom-up)
            if len(result) > 0 {
                result = comment_text + "\n" + result
            } else {
                result = comment_text
            }
            // Move to previous line
            p = line_start - 1
            if p < 0 { break }
        } else {
            // Not a comment line — stop
            break
        }
    }
    return result
}

// ============================================================
// Closure capture side tables
// ============================================================

g_closure_capture_func_names := []string{}
g_closure_capture_starts := []int{}
g_closure_capture_counts := []int{}
g_closure_capture_names := []string{}

fn StoreClosureCaptures(func_name: string, names: []string) {
    g_closure_capture_func_names = append(g_closure_capture_func_names, func_name)
    g_closure_capture_starts = append(g_closure_capture_starts, len(g_closure_capture_names))
    g_closure_capture_counts = append(g_closure_capture_counts, len(names))
    i := 0
    for i < len(names) {
        g_closure_capture_names = append(g_closure_capture_names, names[i])
        i = i + 1
    }
}

fn ClosureCaptureCount(func_name: string) -> int {
    i := 0
    for i < len(g_closure_capture_func_names) {
        if g_closure_capture_func_names[i] == func_name {
            return g_closure_capture_counts[i]
        }
        i = i + 1
    }
    return 0
}

fn ClosureCaptureName(func_name: string, idx: int) -> string {
    i := 0
    for i < len(g_closure_capture_func_names) {
        if g_closure_capture_func_names[i] == func_name {
            start := g_closure_capture_starts[i]
            return g_closure_capture_names[start + idx]
        }
        i = i + 1
    }
    return ""
}

// ============================================================
// Generic type parameter registry
// ============================================================

g_type_param_decl_names := []string{}
g_type_param_starts := []int{}
g_type_param_counts := []int{}

g_type_param_names := []string{}
g_type_param_constraints := []string{}

fn RegisterTypeParams(decl_name: string, param_names: []string, constraints: []string) {
    g_type_param_decl_names = append(g_type_param_decl_names, decl_name)
    g_type_param_starts = append(g_type_param_starts, len(g_type_param_names))
    g_type_param_counts = append(g_type_param_counts, len(param_names))
    i := 0
    for i < len(param_names) {
        g_type_param_names = append(g_type_param_names, param_names[i])
        g_type_param_constraints = append(g_type_param_constraints, constraints[i])
        i = i + 1
    }
}

fn TypeParamCount(decl_name: string) -> int {
    i := 0
    for i < len(g_type_param_decl_names) {
        if g_type_param_decl_names[i] == decl_name {
            return g_type_param_counts[i]
        }
        i = i + 1
    }
    return 0
}

fn TypeParamName(decl_name: string, idx: int) -> string {
    i := 0
    for i < len(g_type_param_decl_names) {
        if g_type_param_decl_names[i] == decl_name {
            start := g_type_param_starts[i]
            return g_type_param_names[start + idx]
        }
        i = i + 1
    }
    return ""
}

fn TypeParamConstraint(decl_name: string, idx: int) -> string {
    i := 0
    for i < len(g_type_param_decl_names) {
        if g_type_param_decl_names[i] == decl_name {
            start := g_type_param_starts[i]
            return g_type_param_constraints[start + idx]
        }
        i = i + 1
    }
    return ""
}

fn IsTypeParam(decl_name: string, name: string) -> int {
    i := 0
    for i < len(g_type_param_decl_names) {
        if g_type_param_decl_names[i] == decl_name {
            start := g_type_param_starts[i]
            count := g_type_param_counts[i]
            j := 0
            for j < count {
                if g_type_param_names[start + j] == name { return 1 }
                j = j + 1
            }
        }
        i = i + 1
    }
    return 0
}

// ============================================================
// Generic type argument instantiation tracking
// ============================================================

g_type_inst_decl_names := []string{}
g_type_inst_param_idx := []int{}
g_type_inst_concrete := []string{}
g_type_inst_lines := []int{}

fn RecordTypeInstantiation(decl_name: string, param_idx: int, concrete: string, line: int) {
    g_type_inst_decl_names = append(g_type_inst_decl_names, decl_name)
    g_type_inst_param_idx = append(g_type_inst_param_idx, param_idx)
    g_type_inst_concrete = append(g_type_inst_concrete, concrete)
    g_type_inst_lines = append(g_type_inst_lines, line)
}

fn ValidateTypeConstraints() -> int {
    errors := 0
    i := 0
    for i < len(g_type_inst_decl_names) {
        decl_name := g_type_inst_decl_names[i]
        param_idx := g_type_inst_param_idx[i]
        concrete := g_type_inst_concrete[i]
        constraint := TypeParamConstraint(decl_name, param_idx)
        if len(constraint) > 0 {
            if is_interface(constraint) == 1 {
                if struct_satisfies_interface(concrete, constraint) == 0 {
                    print("error: type '" + concrete + "' does not satisfy interface '" + constraint + "' (required by " + decl_name + ")\n")
                    errors = errors + 1
                }
            }
        }
        i = i + 1
    }
    return errors
}
