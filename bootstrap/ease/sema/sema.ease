package sema

// Semantic analysis — side tables, registries, rename table, and utility functions

// ============================================================
// Side table: function call arguments
// ============================================================

g_call_args := []int{}

fn store_call_args(call_node_idx: int, arg_indices: []int) {
    g_call_args = append(g_call_args, call_node_idx)
    g_call_args = append(g_call_args, len(arg_indices))
    i := 0
    count := len(arg_indices)
    for i < count {
        g_call_args = append(g_call_args, arg_indices[i])
        i = i + 1
    }
}

fn get_call_args(call_node_idx: int) -> []int {
    i := 0
    for {
        if i >= len(g_call_args) {
            break
        }
        if g_call_args[i] == call_node_idx {
            arg_count := g_call_args[i + 1]
            result := []int{}
            j := 0
            for j < arg_count {
                result = append(result, g_call_args[i + 2 + j])
                j = j + 1
            }
            return result
        }
        arg_count := g_call_args[i + 1]
        i = i + 2 + arg_count
    }
    return []int{}
}

