package io

// I/O functions for the Ease bootstrap compiler

interface Writer {
    Write(s: string) -> int,
}

interface StringWriter {
    WriteString(s: string) -> int,
}

interface Closer {
    Close() -> int,
}

struct StdoutWriter { fd: int }

fn (w: StdoutWriter) Write(s: string) -> int {
    syscall.write(w.fd, s, len(s))
    return len(s)
}

fn (w: StdoutWriter) WriteString(s: string) -> int {
    return w.Write(s)
}

fn (w: StdoutWriter) Close() -> int {
    return 0
}

fn NewStdoutWriter() -> StdoutWriter {
    return StdoutWriter { fd: 1 }
}

fn NewStderrWriter() -> StdoutWriter {
    return StdoutWriter { fd: 2 }
}

fn Print(s: string) {
    syscall.write(1, s, len(s))
}

fn WriteFd(fd: int, s: string) {
    syscall.write(fd, s, len(s))
}

fn ReadN(fd: int, n: int) -> string {
    if n <= 0 { return "" }
    buf := heap_alloc(n + 1)
    total := 0
    for total < n {
        got := syscall.read(fd, buf + total, n - total)
        if got <= 0 { break }
        total = total + got
    }
    poke(buf + total, 0)
    return buf
}

fn ReadLine(fd: int) -> string {
    buf_size := 4096
    buf := heap_alloc(buf_size + 1)
    pos := 0
    for pos < buf_size {
        got := syscall.read(fd, buf + pos, 1)
        if got <= 0 { break }
        ch := peek(buf + pos)
        if ch == 10 {
            poke(buf + pos, 0)
            return buf
        }
        pos = pos + 1
    }
    poke(buf + pos, 0)
    return buf
}

interface Reader {
    Read(n: int) -> string,
}

struct StdinReader { fd: int }

fn (r: StdinReader) Read(n: int) -> string {
    if n <= 0 { return "" }
    buf := heap_alloc(n + 1)
    total := 0
    for total < n {
        got := syscall.read(r.fd, buf + total, n - total)
        if got <= 0 { break }
        total = total + got
    }
    poke(buf + total, 0)
    return buf
}

fn (r: StdinReader) Close() -> int {
    return 0
}

fn NewStdinReader() -> StdinReader {
    return StdinReader { fd: 0 }
}
