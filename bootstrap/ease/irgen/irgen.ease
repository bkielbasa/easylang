    mode_vreg := gen_ir_from_ast_with_symtab(arg_indices[2], nodes, instrs, symtab_names, symtab_vregs)
    result_vreg := len(instrs)
    push(instrs, IRInstr { op: OP_SYSCALL_OPEN(), dest: result_vreg, arg1: path_vreg, arg2: flags_vreg, arg3: mode_vreg, str_val: "" })
    return result_vreg
}

