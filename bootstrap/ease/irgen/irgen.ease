    }
    addr_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    result_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOAD, dest: result_vreg, arg1: addr_vreg, arg2: 0, arg3: 0, str_val: "" })
    set_vreg_type(result_vreg, TYPE_INT)
    return result_vreg
}

// Helper: Generate IR for poke64() builtin — 8-byte write (reuses OP_STORE)
fn gen_ir_call_poke64(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 2 {
        return -1
    }
    addr_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    value_vreg := gen_ir_from_ast_with_symtab(arg_indices[1], nodes, instrs, symtab_names, symtab_vregs)
    instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: addr_vreg, arg2: value_vreg, arg3: 0, str_val: "" })
    return -1
}

