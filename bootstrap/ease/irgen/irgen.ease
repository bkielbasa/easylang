package irgen

// IR generation - translates AST to IR instructions for the Ease bootstrap compiler

// Type system: vreg-to-type mapping
// New vregs are always monotonically increasing (instruction indices), so we can
// grow the array with append and set the type at the correct position.
fn set_vreg_type(vreg: int, vtype: int) {
    if vreg < 0 { return }
    if vreg >= 90000 {
        // Parameter vreg — store in g_param_types (offset by g_param_types_start for scoping)
        pidx := (vreg - 90000) + g_param_types_start
        for len(g_param_types) < pidx {
            g_param_types = append(g_param_types, 0)
        }
        if len(g_param_types) == pidx {
            g_param_types = append(g_param_types, vtype)
        }
        return
    }
    // Regular vreg — store in g_vreg_types
    for len(g_vreg_types) < vreg {
        g_vreg_types = append(g_vreg_types, 0)
    }
    if len(g_vreg_types) == vreg {
        g_vreg_types = append(g_vreg_types, vtype)
    } else {
        // Retroactive update — use patches table
        g_vreg_type_patches_idx = append(g_vreg_type_patches_idx, vreg)
        g_vreg_type_patches_val = append(g_vreg_type_patches_val, vtype)
    }
}

fn get_vreg_type(vreg: int) -> int {
    if vreg < 0 { return TYPE_UNKNOWN }
    if vreg >= 90000 {
        pidx := (vreg - 90000) + g_param_types_start
        if pidx < len(g_param_types) {
            return g_param_types[pidx]
        }
        return TYPE_UNKNOWN
    }
    // Check patches first (last patch wins)
    pi := len(g_vreg_type_patches_idx) - 1
    for pi >= 0 {
        if g_vreg_type_patches_idx[pi] == vreg {
            return g_vreg_type_patches_val[pi]
        }
        pi = pi - 1
    }
    if vreg < len(g_vreg_types) {
        return g_vreg_types[vreg]
    }
    return TYPE_UNKNOWN
}

fn make_type(type_tag: int, is_array: int) -> int {
    if is_array == 1 {
        if type_tag == TYPE_INT { return TYPE_INT_ARRAY }
        if type_tag == TYPE_STRING { return TYPE_STRING_ARRAY }
        if type_tag == TYPE_BOOL { return TYPE_BOOL_ARRAY }
        if type_tag == TYPE_FLOAT { return TYPE_FLOAT_ARRAY }
    }
    if type_tag == TYPE_INT { return TYPE_INT }
    if type_tag == TYPE_STRING { return TYPE_STRING }
    if type_tag == TYPE_BOOL { return TYPE_BOOL }
    if type_tag == TYPE_FLOAT { return TYPE_FLOAT }
    return type_tag
}

// Current function name — set by compiler before each function's IR generation
// Uses []string array workaround since string globals can't be reassigned
g_current_func_name_arr := []string{}

// Current source file — set by compiler before each function's IR generation
g_irgen_current_file_arr := []string{}

// Error counter for undefined function calls etc.
g_irgen_error_count := 0

// Struct name tracking: parallel arrays mapping vregs to struct type names
g_vreg_struct_names := []string{}
g_param_struct_names := []string{}
g_param_struct_names_start := 0

fn set_vreg_struct_name(vreg: int, name: string) {
    if vreg < 0 { return }
    if name == "" { return }
    if vreg >= 90000 {
        pidx := (vreg - 90000) + g_param_struct_names_start
        for len(g_param_struct_names) < pidx {
            g_param_struct_names = append(g_param_struct_names, "")
        }
        if len(g_param_struct_names) == pidx {
            g_param_struct_names = append(g_param_struct_names, name)
        }
        return
    }
    for len(g_vreg_struct_names) < vreg {
        g_vreg_struct_names = append(g_vreg_struct_names, "")
    }
    if len(g_vreg_struct_names) == vreg {
        g_vreg_struct_names = append(g_vreg_struct_names, name)
    }
}

fn get_vreg_struct_name(vreg: int) -> string {
    if vreg < 0 { return "" }
    if vreg >= 90000 {
        pidx := (vreg - 90000) + g_param_struct_names_start
        if pidx < len(g_param_struct_names) {
            return g_param_struct_names[pidx]
        }
        return ""
    }
    if vreg < len(g_vreg_struct_names) {
        return g_vreg_struct_names[vreg]
    }
    return ""
}

fn map_key_type_str(map_type: string) -> string {
    // Extract key type from "map[KEY]VAL" — chars between '[' and ']'
    i := 4
    for i < len(map_type) {
        if str_char_at(map_type, i) == 93 { return str_substring(map_type, 4, i) }
        i = i + 1
    }
    return "string"
}

fn map_val_type_str(map_type: string) -> string {
    // Extract value type from "map[KEY]VAL" — chars after ']'
    i := 4
    for i < len(map_type) {
        if str_char_at(map_type, i) == 93 { return str_substring(map_type, i + 1, len(map_type)) }
        i = i + 1
    }
    return "int"
}

fn map_key_type_code(map_type: string) -> int {
    // 0 = string key, 1 = int/bool key
    kt := map_key_type_str(map_type)
    if kt == "string" { return 0 }
    return 1
}

fn type_tag_from_name(name: string) -> int {
    if name == "int" { return TYPE_INT }
    if name == "string" { return TYPE_STRING }
    if name == "bool" { return TYPE_BOOL }
    return TYPE_INT
}

fn is_type_string(t: int) -> int {
    if t == TYPE_STRING { return 1 }
    return 0
}

fn is_type_string_array(t: int) -> int {
    if t == TYPE_STRING_ARRAY { return 1 }
    return 0
}

// Helper: Generate IR for len() builtin
fn gen_ir_call_len(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 1 {
        return -1
    }
    array_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    result_vreg := len(instrs)
    op := OP_ARRAY_LEN
    if get_vreg_type(array_vreg) == TYPE_STRING {
        op = OP_STR_LEN
    }
    if get_vreg_type(array_vreg) == TYPE_MAP {
        op = OP_MAP_LEN
    }
    len_instr := IRInstr { op: op, dest: result_vreg, arg1: array_vreg, arg2: 0, arg3: 0, str_val: "" }
    instrs = append(instrs, len_instr)
    set_vreg_type(result_vreg, TYPE_INT)
    return result_vreg
}

// Helper: Generate IR for append() builtin
fn gen_ir_call_push(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 2 {
        return -1
    }
    array_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    elem_vreg := gen_ir_from_ast_with_symtab(arg_indices[1], nodes, instrs, symtab_names, symtab_vregs)
    push_instr := IRInstr { op: OP_ARRAY_PUSH, dest: -1, arg1: array_vreg, arg2: elem_vreg, arg3: 0, str_val: "" }
    instrs = append(instrs, push_instr)
    // Returns the array vreg — type already set from definition
    return array_vreg
}

// Helper: Generate IR for poke() builtin
fn gen_ir_call_poke(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 2 {
        return -1
    }
    addr_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    value_vreg := gen_ir_from_ast_with_symtab(arg_indices[1], nodes, instrs, symtab_names, symtab_vregs)
    poke_instr := IRInstr { op: OP_POKE, dest: -1, arg1: addr_vreg, arg2: value_vreg, arg3: 0, str_val: "" }
    instrs = append(instrs, poke_instr)
    return -1  // poke returns nothing
}

// Helper: Generate IR for peek() builtin
fn gen_ir_call_peek(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 1 {
        return -1
    }
    addr_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    result_vreg := len(instrs)
    peek_instr := IRInstr { op: OP_PEEK, dest: result_vreg, arg1: addr_vreg, arg2: 0, arg3: 0, str_val: "" }
    instrs = append(instrs, peek_instr)
    set_vreg_type(result_vreg, TYPE_INT)
    return result_vreg  // peek returns the byte value
}

// Helper: Generate IR for peek64() builtin — 8-byte read (reuses OP_LOAD)
fn gen_ir_call_peek64(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 1 {
