// Dynamic field offset registry (for user-defined structs)
g_all_field_names := []string{}
g_all_field_offsets := []int{}

fn RegisterFieldOffset(name: string, offset: int) {
    // Only register if not already present (first definition wins)
    i := 0
    for i < len(g_all_field_names) {
        if g_all_field_names[i] == name { return }
        i = i + 1
    }
    g_all_field_names = append(g_all_field_names, name)
    g_all_field_offsets = append(g_all_field_offsets, offset)
}

fn get_field_offset(name: string) -> int {
    off := 0
    // AstNode fields
    if name == "tag" { off = 0 }
    if name == "int_val" { off = 8 }
    if name == "str_val" { off = 16 }
    if name == "left" { off = 24 }
    if name == "right" { off = 32 }
    if name == "extra" { off = 40 }
    if name == "type_tag" { off = 48 }
    // ParseResult fields (unique names)
    if name == "node_idx" { off = 0 }
    if name == "new_pos" { off = 8 }
    // IRInstr fields (unique names only - str_val collision handled in gen_ir_field)
    if name == "op" { off = 0 }
    if name == "dest" { off = 8 }
    if name == "arg1" { off = 16 }
    if name == "arg2" { off = 24 }
    if name == "arg3" { off = 32 }
    // Look up in dynamic registry for user-defined struct fields
    di := 0
    for di < len(g_all_field_names) {
        if g_all_field_names[di] == name { return g_all_field_offsets[di] }
        di = di + 1
    }
    return off
}

fn gen_ir_eval_args(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> []int {
    arg_vregs := []int{}
    arg_indices := get_call_args(ast_idx)
    i := 0
    for i < len(arg_indices) {
        vreg := gen_ir_from_ast_with_symtab(arg_indices[i], nodes, instrs, st_names, st_vregs)
        arg_vregs = append(arg_vregs, vreg)
        i = i + 1
    }
    return arg_vregs
}

fn gen_ir_index(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    arr := gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_names, st_vregs)
    idx := gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_names, st_vregs)
    // Map indexing: m["key"] → Option/StringOption via branchless construction
    if get_vreg_type(arr) == TYPE_MAP {
        // Step 1: Get value and has-flag
        get_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_MAP_GET, dest: get_vreg, arg1: arr, arg2: idx, arg3: 0, str_val: "" })
        map_type := get_vreg_struct_name(arr)
        val_type := TYPE_INT
        if map_type != "" { val_type = type_tag_from_name(map_val_type_str(map_type)) }
        set_vreg_type(get_vreg, val_type)

        has_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_MAP_HAS, dest: has_vreg, arg1: arr, arg2: idx, arg3: 0, str_val: "" })
        set_vreg_type(has_vreg, TYPE_INT)

        // Step 2: Allocate 16-byte Option struct (tag@0, value@8)
        size_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: size_vreg, arg1: 16, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(size_vreg, TYPE_INT)
        ptr_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_HEAP_ALLOC, dest: ptr_vreg, arg1: size_vreg, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(ptr_vreg, TYPE_INT)

        // Step 3: Compute tag = 1 - has (Some=0 when found, None=1 when not)
        one_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: one_vreg, arg1: 1, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(one_vreg, TYPE_INT)
        tag_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_SUB, dest: tag_vreg, arg1: one_vreg, arg2: has_vreg, arg3: 0, str_val: "" })
        set_vreg_type(tag_vreg, TYPE_INT)

        // Step 4: Store tag at offset 0
        instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: ptr_vreg, arg2: tag_vreg, arg3: 0, str_val: "" })

        // Step 5: Store value at offset 8 (INDEXADDR uses immediate offset, not vreg)
        addr_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr_vreg, arg1: ptr_vreg, arg2: 8, arg3: 0, str_val: "" })
        set_vreg_type(addr_vreg, TYPE_INT)
        instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: addr_vreg, arg2: get_vreg, arg3: 0, str_val: "" })

        // Step 6: Set vreg type to struct with Option or StringOption
        opt_name := "Option"
        if val_type == TYPE_STRING { opt_name = "StringOption" }
        set_vreg_type(ptr_vreg, TYPE_STRUCT)
        set_vreg_struct_name(ptr_vreg, opt_name)
        return ptr_vreg
    }
    res := len(instrs)
    instr := IRInstr { op: OP_LOAD, dest: res, arg1: arr, arg2: idx, arg3: 0, str_val: "array_index" }
    instrs = append(instrs, instr)
    // Derive element type from array type
    arr_type := get_vreg_type(arr)
    elem_type := TYPE_INT
    if arr_type == TYPE_STRING_ARRAY { elem_type = TYPE_STRING }
    if arr_type == TYPE_INT_ARRAY { elem_type = TYPE_INT }
    if arr_type == TYPE_BOOL_ARRAY { elem_type = TYPE_BOOL }
    set_vreg_type(res, elem_type)
    return res
}

fn gen_ir_field(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    base := gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_names, st_vregs)
    off := get_field_offset(node.str_val)
    // Handle str_val collision: AstNode.str_val is at offset 16, IRInstr.str_val is at offset 40
    // Detect IRInstr access by checking the base expression variable name
    if node.str_val == "str_val" {
        left := nodes[node.left]
        if left.tag == EXPR_IDENT && left.str_val == "instr" {
            off = 40
        }
        if left.tag == EXPR_INDEX {
            arr := nodes[left.left]
            if arr.tag == EXPR_IDENT && arr.str_val == "instrs" {
                off = 40
            }
        }
    }
    res := len(instrs)
    instr := IRInstr { op: OP_LOAD, dest: res, arg1: base, arg2: off, arg3: 0, str_val: node.str_val }
    instrs = append(instrs, instr)
    set_vreg_type(res, make_type(lookup_field_type(node.str_val), lookup_field_is_array(node.str_val)))
    sname := lookup_field_struct_name(node.str_val)
    if sname != "" { set_vreg_struct_name(res, sname) }
    return res
}

fn gen_ir_array_lit(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    elem_count := node.int_val
    if elem_count == 0 {
        // Empty array: allocate a 24-byte fat pointer (ptr, len, cap) initialized to zero
        size_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: size_vreg, arg1: 24, arg2: 0, arg3: 0, str_val: "" })
        r := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_HEAP_ALLOC, dest: r, arg1: size_vreg, arg2: 0, arg3: 0, str_val: "" })
        arr_type := TYPE_INT_ARRAY
        if node.str_val == "string" { arr_type = TYPE_STRING_ARRAY }
        set_vreg_type(r, arr_type)
        return r
    }
    // Non-empty array: generate IR for each element, collect vregs
    elem_vregs := []int{}
    i := node.right
    cnt := 0
    for i < len(nodes) && cnt < elem_count {
        if nodes[i].tag < STMT_LET {
            v := gen_ir_from_ast_with_symtab(i, nodes, instrs, st_n, st_v)
            elem_vregs = append(elem_vregs, v)
            cnt = cnt + 1
        }
        i = i + 1
    }
    // Allocate element data storage: elem_count * 8 bytes
    data_size_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: data_size_vreg, arg1: elem_count * 8, arg2: 0, arg3: 0, str_val: "" })
    data_ptr := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_HEAP_ALLOC, dest: data_ptr, arg1: data_size_vreg, arg2: 0, arg3: 0, str_val: "" })
    // Store each element at data_ptr + (j * 8)
    j := 0
    for j < len(elem_vregs) {
        addr := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr, arg1: data_ptr, arg2: j * 8, arg3: 0, str_val: "" })
        instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: addr, arg2: elem_vregs[j], arg3: 0, str_val: "" })
        j = j + 1
    }
    // Allocate fat pointer (24 bytes: ptr, len, cap)
    fp_size_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: fp_size_vreg, arg1: 24, arg2: 0, arg3: 0, str_val: "" })
    fat_ptr := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_HEAP_ALLOC, dest: fat_ptr, arg1: fp_size_vreg, arg2: 0, arg3: 0, str_val: "" })
    // Store data_ptr at fat_ptr + 0
    instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: fat_ptr, arg2: data_ptr, arg3: 0, str_val: "" })
    // Store len at fat_ptr + 8
    len_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: len_vreg, arg1: elem_count, arg2: 0, arg3: 0, str_val: "" })
    len_addr := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: len_addr, arg1: fat_ptr, arg2: 8, arg3: 0, str_val: "" })
    instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: len_addr, arg2: len_vreg, arg3: 0, str_val: "" })
    // Store cap at fat_ptr + 16 (cap = len for literals)
    cap_addr := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: cap_addr, arg1: fat_ptr, arg2: 16, arg3: 0, str_val: "" })
    instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: cap_addr, arg2: len_vreg, arg3: 0, str_val: "" })
    lit_type := TYPE_INT_ARRAY
    if node.str_val == "string" { lit_type = TYPE_STRING_ARRAY }
    set_vreg_type(fat_ptr, lit_type)
    return fat_ptr
}

fn gen_ir_store_struct_fields(ptr: int, sname: string, idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    vals := get_struct_fields(idx)
    fnames := get_struct_field_names(sname)
    i := 0
    for i < len(vals) && i < len(fnames) {
        v := gen_ir_from_ast_with_symtab(vals[i], nodes, instrs, st_names, st_vregs)
        off := field_offset(sname, fnames[i])
        addr := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr, arg1: ptr, arg2: off, arg3: 0, str_val: fnames[i] })
        instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: addr, arg2: v, arg3: 0, str_val: "" })
        i = i + 1
    }
    return 0 }

fn gen_ir_struct_lit(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    size := struct_size(node.str_val)
    ptr := len(instrs)
    alloc := IRInstr { op: OP_ALLOCA, dest: ptr, arg1: size, arg2: 0, arg3: 0, str_val: node.str_val }
    instrs = append(instrs, alloc)
    set_vreg_type(ptr, TYPE_STRUCT)
    set_vreg_struct_name(ptr, node.str_val)
    gen_ir_store_struct_fields(ptr, node.str_val, ast_idx, nodes, instrs, st_names, st_vregs)
    return ptr
}

fn gen_ir_call_user(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    call_name := lookup_rename(node.str_val)
    // Check if function is defined (sema registry or extern)
    if sema.IsFunctionDefined(call_name) == 0 && is_extern(call_name) == 0 {
        cur_file := "<unknown>"
        if len(g_irgen_current_file_arr) > 0 {
            cur_file = g_irgen_current_file_arr[len(g_irgen_current_file_arr) - 1]
        }
        cur_fn := "<unknown>"
        if len(g_current_func_name_arr) > 0 {
            cur_fn = g_current_func_name_arr[len(g_current_func_name_arr) - 1]
        }
        line_info := ""
        if node.extra > 0 {
            line_info = ":" + strconv.Itoa(node.extra)
        }
        print(cur_file + line_info + ": error: undefined function '" + call_name + "' (in " + cur_fn + ")\n")
        g_irgen_error_count = g_irgen_error_count + 1
    }
    args := gen_ir_eval_args(ast_idx, nodes, instrs, st_names, st_vregs)
    // Emit OP_ARG for each arg, wrapping if the param expects an interface
    i := 0
    for i < len(args) {
        arg_vreg := args[i]
        param_type_name := lookup_func_param_type_name(call_name, i)
        if param_type_name != "" && is_interface(param_type_name) == 1 {
            arg_struct_name := get_vreg_struct_name(arg_vreg)
            if arg_struct_name != "" && struct_satisfies_interface(arg_struct_name, param_type_name) == 1 {
                wrap := len(instrs)
                instrs = append(instrs, IRInstr { op: OP_IFACE_WRAP, dest: wrap, arg1: arg_vreg, arg2: 0, arg3: 0, str_val: param_type_name + "." + arg_struct_name })
                set_vreg_type(wrap, TYPE_STRUCT)
                set_vreg_struct_name(wrap, param_type_name)
                record_vtable_pair(arg_struct_name, param_type_name)
                arg_vreg = wrap
            }
        }
        instrs = append(instrs, IRInstr { op: OP_ARG, dest: i, arg1: arg_vreg, arg2: -1, arg3: 0, str_val: "" })
        i = i + 1
    }
    res := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_CALL, dest: res, arg1: 0, arg2: node.int_val, arg3: 0, str_val: call_name })
    set_vreg_type(res, make_type(lookup_func_return_type(call_name), lookup_func_return_is_array(call_name)))
    set_vreg_struct_name(res, lookup_func_return_struct_name(call_name))
    return res
}

fn gen_ir_method_call(recv_vreg: int, func_name: string, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // First argument is the receiver
    instrs = append(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: recv_vreg, arg2: -1, arg3: 0, str_val: "" })
    // Remaining arguments from the call
    args := gen_ir_eval_args(ast_idx, nodes, instrs, st_n, st_v)
    i := 0
    for i < len(args) {
        instrs = append(instrs, IRInstr { op: OP_ARG, dest: i + 1, arg1: args[i], arg2: -1, arg3: 0, str_val: "" })
        i = i + 1
    }
    res := len(instrs)
    arg_count := len(args) + 1
    instrs = append(instrs, IRInstr { op: OP_CALL, dest: res, arg1: 0, arg2: arg_count, arg3: 0, str_val: func_name })
    set_vreg_type(res, make_type(lookup_func_return_type(func_name), lookup_func_return_is_array(func_name)))
    set_vreg_struct_name(res, lookup_func_return_struct_name(func_name))
    return res
}

// Helper: Generate IR for binary operations
fn gen_ir_binary_op(token_op: int) -> int {
    op := OP_ADD
    if token_op == TK_PLUS { op = OP_ADD }
    if token_op == TK_MINUS { op = OP_SUB }
    if token_op == TK_STAR { op = OP_MUL }
    if token_op == TK_SLASH { op = OP_DIV }
    if token_op == TK_LT { op = OP_CMP_LT }
    if token_op == TK_GT { op = OP_CMP_GT }
    if token_op == TK_LE { op = OP_CMP_LE }
    if token_op == TK_GE { op = OP_CMP_GE }
    if token_op == TK_EQ { op = OP_CMP_EQ }
    if token_op == TK_NE { op = OP_CMP_NE }
    if token_op == TK_AND { op = OP_AND }
    if token_op == TK_OR { op = OP_OR }
    if token_op == TK_PERCENT { op = OP_MOD }
    if token_op == TK_CARET { op = OP_XOR }
    if token_op == TK_AMPERSAND { op = OP_BITAND }
    if token_op == TK_PIPE { op = OP_BITOR }
    return op
}

fn gen_ir_binary(node: AstNode, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    left_vreg := gen_ir_from_ast_with_symtab(node.left, nodes, instrs, symtab_names, symtab_vregs)
    right_vreg := gen_ir_from_ast_with_symtab(node.right, nodes, instrs, symtab_names, symtab_vregs)
    op := gen_ir_binary_op(node.int_val)
    // Detect string concatenation: if + and either operand is string-typed
    if node.int_val == TK_PLUS {
        if get_vreg_type(left_vreg) == TYPE_STRING || get_vreg_type(right_vreg) == TYPE_STRING {
            op = OP_STR_CONCAT
        }
    }
    // Detect string equality: if == and either operand is string-typed
    if node.int_val == TK_EQ {
        if get_vreg_type(left_vreg) == TYPE_STRING || get_vreg_type(right_vreg) == TYPE_STRING {
            op = OP_STR_EQ
        }
    }
    // Detect string inequality: if != and either operand is string-typed
    if node.int_val == TK_NE {
        if get_vreg_type(left_vreg) == TYPE_STRING || get_vreg_type(right_vreg) == TYPE_STRING {
            op = OP_STR_NE
        }
    }
    // Float dispatch: if either operand is float, promote int operands and use float ops
    left_type := get_vreg_type(left_vreg)
    right_type := get_vreg_type(right_vreg)
    if left_type == TYPE_FLOAT || right_type == TYPE_FLOAT {
        // Promote int to float if needed
        if left_type != TYPE_FLOAT {
            conv := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_INT_TO_FLOAT, dest: conv, arg1: left_vreg, arg2: 0, arg3: 0, str_val: "" })
            set_vreg_type(conv, TYPE_FLOAT)
            left_vreg = conv
        }
        if right_type != TYPE_FLOAT {
            conv := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_INT_TO_FLOAT, dest: conv, arg1: right_vreg, arg2: 0, arg3: 0, str_val: "" })
            set_vreg_type(conv, TYPE_FLOAT)
            right_vreg = conv
        }
        fop := OP_FADD
        is_cmp := 0
        if node.int_val == TK_PLUS { fop = OP_FADD }
        if node.int_val == TK_MINUS { fop = OP_FSUB }
        if node.int_val == TK_STAR { fop = OP_FMUL }
        if node.int_val == TK_SLASH { fop = OP_FDIV }
        if node.int_val == TK_PERCENT { fop = OP_FMOD }
        if node.int_val == TK_LT { fop = OP_FCMP_LT is_cmp = 1 }
        if node.int_val == TK_GT { fop = OP_FCMP_GT is_cmp = 1 }
        if node.int_val == TK_LE { fop = OP_FCMP_LE is_cmp = 1 }
        if node.int_val == TK_GE { fop = OP_FCMP_GE is_cmp = 1 }
        if node.int_val == TK_EQ { fop = OP_FCMP_EQ is_cmp = 1 }
        if node.int_val == TK_NE { fop = OP_FCMP_NE is_cmp = 1 }
        dest_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: fop, dest: dest_vreg, arg1: left_vreg, arg2: right_vreg, arg3: 0, str_val: "" })
        if is_cmp == 1 {
            set_vreg_type(dest_vreg, TYPE_BOOL)
        } else {
            set_vreg_type(dest_vreg, TYPE_FLOAT)
        }
        return dest_vreg
    }
    dest_vreg := len(instrs)
    instr := IRInstr { op: op, dest: dest_vreg, arg1: left_vreg, arg2: right_vreg, arg3: 0, str_val: "" }
    instrs = append(instrs, instr)
    // Set result type: string concat → string, comparisons/logic → bool, arithmetic → int
    if op == OP_STR_CONCAT {
        set_vreg_type(dest_vreg, TYPE_STRING)
    } else if op == OP_CMP_LT || op == OP_CMP_GT || op == OP_CMP_LE || op == OP_CMP_GE || op == OP_CMP_EQ || op == OP_CMP_NE || op == OP_STR_EQ || op == OP_STR_NE || op == OP_AND || op == OP_OR {
        set_vreg_type(dest_vreg, TYPE_BOOL)
    } else {
        set_vreg_type(dest_vreg, TYPE_INT)
    }
    return dest_vreg
}

// Helper: Generate IR for simple expression nodes
fn gen_ir_expr(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    if node.tag == EXPR_INT {
        vreg := len(instrs)
        instr := IRInstr { op: OP_LOADCONST, dest: vreg, arg1: node.int_val, arg2: 0, arg3: 0, str_val: "" }
        instrs = append(instrs, instr)
        set_vreg_type(vreg, TYPE_INT)
        return vreg
    }

    if node.tag == EXPR_BOOL {
        vreg := len(instrs)
        instr := IRInstr { op: OP_LOADCONST, dest: vreg, arg1: node.int_val, arg2: 0, arg3: 0, str_val: "" }
        instrs = append(instrs, instr)
        set_vreg_type(vreg, TYPE_BOOL)
        return vreg
    }

    if node.tag == EXPR_IDENT {
        // Search backwards to find the most recent binding (handles variable shadowing)
        found_vreg := -1
        symtab_len := len(symtab_names)
        idx1 := symtab_len - 1
        for idx1 >= 0 {
            if symtab_names[idx1] == node.str_val {
                found_vreg = symtab_vregs[idx1]
                break
            }
            idx1 = idx1 - 1
        }
        if found_vreg <= -2000 {
            // Const sentinel - inline the constant value directly
            ci := -(found_vreg + 2000)
            ctype := ConstType(ci)
            vreg := len(instrs)
            if ctype == TYPE_STRING {
                cstr := ConstStrValue(ci)
                instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: vreg, arg1: 0, arg2: 0, arg3: 0, str_val: cstr })
                set_vreg_type(vreg, TYPE_STRING)
            } else {
                cval := ConstIntValue(ci)
                instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: vreg, arg1: cval, arg2: 0, arg3: 0, str_val: "" })
                if ctype == TYPE_BOOL {
                    set_vreg_type(vreg, TYPE_BOOL)
                } else {
                    set_vreg_type(vreg, TYPE_INT)
                }
            }
            return vreg
        }
        if found_vreg <= -1000 {
            // Global variable sentinel - emit OP_LOAD_GLOBAL
            gvar_idx := -(found_vreg + 1000)
            gvar_type := TYPE_UNKNOWN
            if gvar_idx < len(g_global_var_types) {
                gvar_type = g_global_var_types[gvar_idx]
            }
            vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_LOAD_GLOBAL, dest: vreg, arg1: 0, arg2: 0, arg3: 0, str_val: node.str_val })
            if is_scalar_global(node.str_val) == 1 {
                // For scalar globals, dereference the address to get the value
                val_vreg := len(instrs)
                instrs = append(instrs, IRInstr { op: OP_LOAD, dest: val_vreg, arg1: vreg, arg2: 0, arg3: 0, str_val: "" })
                set_vreg_type(val_vreg, gvar_type)
                return val_vreg
            }
            set_vreg_type(vreg, gvar_type)
            return vreg
        }
        if found_vreg < 0 {
            return -1
        }
        return found_vreg
    }

    if node.tag == EXPR_STRING {
        // String literal - will be loaded from string table
        vreg := len(instrs)
        // Store string index in arg1, use str_val to store the actual string for later embedding
        instr := IRInstr { op: OP_LOADCONST, dest: vreg, arg1: 0, arg2: 0, arg3: 0, str_val: node.str_val }
        instrs = append(instrs, instr)
        set_vreg_type(vreg, TYPE_STRING)
        return vreg
    }

    if node.tag == EXPR_FLOAT {
        vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOADFLOAT, dest: vreg, arg1: 0, arg2: 0, arg3: 0, str_val: node.str_val })
        set_vreg_type(vreg, TYPE_FLOAT)
        return vreg
    }

    return 0
}

fn gen_ir_stmt_ret(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // Multi-return: pack values into a heap-allocated tuple
    if node.int_val > 0 && node.left >= 0 {
        total := node.int_val + 1
        expr_indices := get_multi_ret_exprs(ast_idx)
        // Evaluate each expression
        ret_vregs := []int{}
        ri := 0
        for ri < len(expr_indices) {
            rv := gen_ir_from_ast_with_symtab(expr_indices[ri], nodes, instrs, st_n, st_v)
            ret_vregs = append(ret_vregs, rv)
            ri = ri + 1
        }
        // Allocate tuple: total * 8 bytes
        ptr := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_ALLOCA, dest: ptr, arg1: total * 8, arg2: 0, arg3: 0, str_val: "" })
        // Store each value at ptr + (i * 8)
        mri := 0
        for mri < len(ret_vregs) {
            addr := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr, arg1: ptr, arg2: mri * 8, arg3: 0, str_val: "" })
            instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: addr, arg2: ret_vregs[mri], arg3: 0, str_val: "" })
            mri = mri + 1
        }
        set_vreg_type(ptr, TYPE_STRUCT)
        instrs = append(instrs, IRInstr { op: OP_RET, dest: ptr, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
        return ptr
    }

    v := -1
    if node.left >= 0 {
        v = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_n, st_v)
    }
    // Check if function returns an interface type — wrap if needed
    if v >= 0 && len(g_current_func_name_arr) > 0 {
        cur_fn := g_current_func_name_arr[len(g_current_func_name_arr) - 1]
        ret_struct_name := lookup_func_return_struct_name(cur_fn)
        if ret_struct_name != "" && is_interface(ret_struct_name) == 1 {
            val_struct_name := get_vreg_struct_name(v)
            if val_struct_name != "" && val_struct_name != ret_struct_name && struct_satisfies_interface(val_struct_name, ret_struct_name) == 1 {
                wrap := len(instrs)
                instrs = append(instrs, IRInstr { op: OP_IFACE_WRAP, dest: wrap, arg1: v, arg2: 0, arg3: 0, str_val: ret_struct_name + "." + val_struct_name })
                set_vreg_type(wrap, TYPE_STRUCT)
                set_vreg_struct_name(wrap, ret_struct_name)
                record_vtable_pair(val_struct_name, ret_struct_name)
                v = wrap
            }
        }
    }
    instrs = append(instrs, IRInstr { op: OP_RET, dest: v, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    return v
}

fn gen_ir_stmt_let(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    v := gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v)
    if v < 0 { return -1 }
    // Always create a new vreg via COPY to prevent aliasing when init is a variable reference.
    // Without this, "end := pos" would map end to pos's vreg, and modifying end would corrupt pos.
    new_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_COPY, dest: new_vreg, arg1: v, arg2: 0, arg3: 0, str_val: "" })
    set_vreg_type(new_vreg, get_vreg_type(v))
    set_vreg_struct_name(new_vreg, get_vreg_struct_name(v))
    st_n = append(st_n, node.str_val)
    st_v = append(st_v, new_vreg)
    return new_vreg
}

fn gen_ir_multi_let(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // Evaluate RHS (function call returning tuple pointer)
    tuple_vreg := gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v)

    // Get called function name for type lookups
    rhs_node := nodes[node.right]
    call_name := ""
    if rhs_node.tag == EXPR_CALL {
        call_name = lookup_rename(rhs_node.str_val)
    }

    // Load each element and add to symtab
    mli := 0
    for mli < node.int_val {
        name_node := nodes[node.left + mli]
        // Load from tuple_vreg + (i * 8)
        load_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOAD, dest: load_vreg, arg1: tuple_vreg, arg2: mli * 8, arg3: 0, str_val: "" })
        elem_type := TYPE_UNKNOWN
        if call_name != "" {
            elem_type = lookup_func_return_tuple_type(call_name, mli)
        }
        set_vreg_type(load_vreg, elem_type)
        // Copy (same as gen_ir_stmt_let)
        new_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_COPY, dest: new_vreg, arg1: load_vreg, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(new_vreg, elem_type)
        st_n = append(st_n, name_node.str_val)
        st_v = append(st_v, new_vreg)
        mli = mli + 1
    }
    return tuple_vreg
}

fn gen_ir_stmt_assign(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    val_vreg := gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v)
    if val_vreg < 0 { return -1 }

    // Look up the target variable in the symbol table
    target_name := node.str_val
    var_vreg := -1
    si := 0
    st_len := len(st_n)
    for si < st_len {
        if st_n[si] == target_name {
            var_vreg = st_v[si]
        }
        si = si + 1
    }

    if var_vreg <= -2000 {
        // Const - cannot assign
        print("ERROR: cannot assign to constant '" + target_name + "'\n")
        return -1
    }
    if var_vreg <= -1000 {
        // Global variable - emit store through address
        if is_scalar_global(target_name) == 1 {
            addr_vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_LOAD_GLOBAL, dest: addr_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: target_name })
            instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: addr_vreg, arg2: val_vreg, arg3: 0, str_val: "" })
        }
    } else if var_vreg >= 0 && var_vreg != val_vreg {
        // Emit copy from result vreg to variable vreg
        instrs = append(instrs, IRInstr { op: OP_COPY, dest: var_vreg, arg1: val_vreg, arg2: 0, arg3: 0, str_val: "" })
    }
    return val_vreg
}

fn gen_ir_index_assign(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // node.left = EXPR_INDEX node (the arr[i] LHS)
    // node.right = value expression (the RHS)
    idx_node := nodes[node.left]
    arr_vreg := gen_ir_from_ast_with_symtab(idx_node.left, nodes, instrs, st_n, st_v)
    index_vreg := gen_ir_from_ast_with_symtab(idx_node.right, nodes, instrs, st_n, st_v)
    val_vreg := gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v)
    // Map index assignment: m["key"] = val → OP_MAP_SET
    if get_vreg_type(arr_vreg) == TYPE_MAP {
        res := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_MAP_SET, dest: res, arg1: arr_vreg, arg2: index_vreg, arg3: val_vreg, str_val: "" })
        set_vreg_type(res, TYPE_INT)
        return res
    }
    instrs = append(instrs, IRInstr { op: OP_STORE_INDEX, dest: -1, arg1: arr_vreg, arg2: index_vreg, arg3: val_vreg, str_val: "" })
    return val_vreg
}

fn gen_ir_field_assign(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // node.left = base struct expression, node.str_val = field name, node.right = value expression
    base_vreg := gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_n, st_v)
    val_vreg := gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v)
    off := get_field_offset(node.str_val)
    addr := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr, arg1: base_vreg, arg2: off, arg3: 0, str_val: "" })
    instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: addr, arg2: val_vreg, arg3: 0, str_val: "" })
    return val_vreg
}

fn gen_ir_stmt_if(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    c := gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_n, st_v)
    if c < 0 { return -1 }
    el := g_next_label
    g_next_label = g_next_label + 1
    en := g_next_label
    g_next_label = g_next_label + 1
    instrs = append(instrs, IRInstr { op: OP_BRANCH, dest: c, arg1: el, arg2: 0, arg3: 0, str_val: "" })
    if node.right >= 0 { gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v) }
    instrs = append(instrs, IRInstr { op: OP_JUMP, dest: en, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    instrs = append(instrs, IRInstr { op: OP_LABEL, dest: el, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    if node.extra >= 0 { gen_ir_from_ast_with_symtab(node.extra, nodes, instrs, st_n, st_v) }
    instrs = append(instrs, IRInstr { op: OP_LABEL, dest: en, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    return 0
}

fn gen_ir_stmt_for(n: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    if n.str_val != "" {
        range_node := nodes[n.left]
        is_range := range_node.tag == EXPR_BINARY && range_node.int_val == TK_DOTDOT

        if is_range {
            // Range-based for loop: for i in start..end { body }
            start_vreg := gen_ir_from_ast_with_symtab(range_node.left, nodes, instrs, st_n, st_v)
            end_vreg := gen_ir_from_ast_with_symtab(range_node.right, nodes, instrs, st_n, st_v)

            // Initialize loop variable with a copy of start
            loop_vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_COPY, dest: loop_vreg, arg1: start_vreg, arg2: 0, arg3: 0, str_val: "" })
            set_vreg_type(loop_vreg, TYPE_INT)
            st_n = append(st_n, n.str_val)
            st_v = append(st_v, loop_vreg)

            s := g_next_label
            g_next_label = g_next_label + 1
            e := g_next_label
            g_next_label = g_next_label + 1

            // Loop header: compare loop_vreg < end_vreg
            instrs = append(instrs, IRInstr { op: OP_LABEL, dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            cmp_vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_CMP_LT, dest: cmp_vreg, arg1: loop_vreg, arg2: end_vreg, arg3: 0, str_val: "" })
            instrs = append(instrs, IRInstr { op: OP_BRANCH, dest: cmp_vreg, arg1: e, arg2: 0, arg3: 0, str_val: "" })

            // Body
            saved_break := g_break_label
            g_break_label = e
            if n.right >= 0 { gen_ir_from_ast_with_symtab(n.right, nodes, instrs, st_n, st_v) }
            g_break_label = saved_break

            // Increment: loop_vreg = loop_vreg + 1
            one_vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: one_vreg, arg1: 1, arg2: 0, arg3: 0, str_val: "" })
            inc_vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_ADD, dest: inc_vreg, arg1: loop_vreg, arg2: one_vreg, arg3: 0, str_val: "" })
            instrs = append(instrs, IRInstr { op: OP_COPY, dest: loop_vreg, arg1: inc_vreg, arg2: 0, arg3: 0, str_val: "" })

            instrs = append(instrs, IRInstr { op: OP_JUMP, dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            instrs = append(instrs, IRInstr { op: OP_LABEL, dest: e, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            return 0
        }

        // Array iteration: for x in arr { body }
        arr_vreg := gen_ir_from_ast_with_symtab(n.left, nodes, instrs, st_n, st_v)

        // Get array length
        len_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_ARRAY_LEN, dest: len_vreg, arg1: arr_vreg, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(len_vreg, TYPE_INT)

        // Hidden index counter, initialized to 0
        zero_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: zero_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
        idx_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_COPY, dest: idx_vreg, arg1: zero_vreg, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(idx_vreg, TYPE_INT)

        // Derive element type from array type
        arr_type := get_vreg_type(arr_vreg)
        elem_type := TYPE_INT
        if arr_type == TYPE_STRING_ARRAY { elem_type = TYPE_STRING }
        if arr_type == TYPE_BOOL_ARRAY { elem_type = TYPE_BOOL }

        // Loop variable (dummy initial value, updated each iteration)
        elem_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_COPY, dest: elem_vreg, arg1: zero_vreg, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(elem_vreg, elem_type)
        st_n = append(st_n, n.str_val)
        st_v = append(st_v, elem_vreg)

        s := g_next_label
        g_next_label = g_next_label + 1
        e := g_next_label
        g_next_label = g_next_label + 1

        // Loop header: compare idx < len
        instrs = append(instrs, IRInstr { op: OP_LABEL, dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
        cmp_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_CMP_LT, dest: cmp_vreg, arg1: idx_vreg, arg2: len_vreg, arg3: 0, str_val: "" })
        instrs = append(instrs, IRInstr { op: OP_BRANCH, dest: cmp_vreg, arg1: e, arg2: 0, arg3: 0, str_val: "" })

        // Load current element: elem = arr[idx]
        load_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOAD, dest: load_vreg, arg1: arr_vreg, arg2: idx_vreg, arg3: 0, str_val: "array_index" })
        set_vreg_type(load_vreg, elem_type)
        instrs = append(instrs, IRInstr { op: OP_COPY, dest: elem_vreg, arg1: load_vreg, arg2: 0, arg3: 0, str_val: "" })

        // Body
        saved_break := g_break_label
        g_break_label = e
        if n.right >= 0 { gen_ir_from_ast_with_symtab(n.right, nodes, instrs, st_n, st_v) }
        g_break_label = saved_break

        // Increment hidden index: idx = idx + 1
        one_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: one_vreg, arg1: 1, arg2: 0, arg3: 0, str_val: "" })
        inc_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_ADD, dest: inc_vreg, arg1: idx_vreg, arg2: one_vreg, arg3: 0, str_val: "" })
        instrs = append(instrs, IRInstr { op: OP_COPY, dest: idx_vreg, arg1: inc_vreg, arg2: 0, arg3: 0, str_val: "" })

        instrs = append(instrs, IRInstr { op: OP_JUMP, dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
        instrs = append(instrs, IRInstr { op: OP_LABEL, dest: e, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
        return 0
    }

    // Condition-based or infinite for loop (existing behavior)
    s := g_next_label
    g_next_label = g_next_label + 1
    e := g_next_label
    g_next_label = g_next_label + 1
    instrs = append(instrs, IRInstr { op: OP_LABEL, dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    if n.left >= 0 {
        c := gen_ir_from_ast_with_symtab(n.left, nodes, instrs, st_n, st_v)
        if c < 0 { return -1 }
        instrs = append(instrs, IRInstr { op: OP_BRANCH, dest: c, arg1: e, arg2: 0, arg3: 0, str_val: "" })
    }
    // Save/restore break label for proper nesting
    saved_break := g_break_label
    g_break_label = e
    if n.right >= 0 { gen_ir_from_ast_with_symtab(n.right, nodes, instrs, st_n, st_v) }
    g_break_label = saved_break
    instrs = append(instrs, IRInstr { op: OP_JUMP, dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    instrs = append(instrs, IRInstr { op: OP_LABEL, dest: e, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    return 0
}

fn gen_ir_stmt_block(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // First pass: collect child node indices from IF/FOR statements
    // These nodes and their descendants shouldn't be processed as top-level statements
    child_indices := []int{}
    scan_i := node.left
    e := node.right + 1
    nodes_len := len(nodes)
    if scan_i < 0 { return -1 }
    if e > nodes_len { e = nodes_len }
    for scan_i < e {
        if scan_i >= nodes_len { break }
        scan_tag := nodes[scan_i].tag
        if scan_tag == STMT_MATCH {
            // Mark matched expression and all nodes from first_arm to the match node as children
            scan_node := nodes[scan_i]
            if scan_node.left >= 0 { child_indices = append(child_indices, scan_node.left) }
            // Mark everything between first_arm and the match node itself
            mark_i := scan_node.right
            for mark_i < scan_i {
                child_indices = append(child_indices, mark_i)
                mark_i = mark_i + 1
            }
        }
        if scan_tag == EXPR_CLOSURE {
            // Mark all closure-internal nodes (params, body, func decl) as children
            scan_node := nodes[scan_i]
            if scan_node.left >= 0 {
                mark_i := scan_node.left
                for mark_i < scan_i {
                    child_indices = append(child_indices, mark_i)
                    mark_i = mark_i + 1
                }
            }
        }
        if scan_tag == STMT_IF || scan_tag == STMT_FOR {
            scan_node := nodes[scan_i]
            // Mark direct children
            if scan_node.left >= 0 { child_indices = append(child_indices, scan_node.left) }
            if scan_node.right >= 0 {
                child_indices = append(child_indices, scan_node.right)
                // If child is a block, also mark all nodes in that block's range
                if scan_node.right < len(nodes) {
                    child_node := nodes[scan_node.right]
                    if child_node.tag == STMT_BLOCK {
                        block_i := child_node.left
                        block_e := child_node.right + 1
                        for block_i < block_e {
                            child_indices = append(child_indices, block_i)
                            block_i = block_i + 1
                        }
                    }
                }
            }
            if scan_node.extra >= 0 {
                child_indices = append(child_indices, scan_node.extra)
                // If child is a block, also mark all nodes in that block's range
                if scan_node.extra < len(nodes) {
                    child_node := nodes[scan_node.extra]
                    if child_node.tag == STMT_BLOCK {
                        block_i := child_node.left
                        block_e := child_node.right + 1
                        for block_i < block_e {
                            child_indices = append(child_indices, block_i)
                            block_i = block_i + 1
                        }
                    }
                }
            }
        }
        scan_i = scan_i + 1
    }

    // Second pass: process statements, skipping child nodes
    last := -1
    i := node.left
    for i < e {
        if i >= nodes_len { break }
        node_tag := nodes[i].tag
        // Skip declaration nodes that belong to closures or other non-statement constructs
        if node_tag != DECL_PARAM && node_tag != DECL_FUNC && node_tag != EXPR_CLOSURE {
            if node_tag >= STMT_LET && node_tag != STMT_BLOCK {
                // Check if this node is a child of another statement
                is_child := 0
                check_j := 0
                child_count := len(child_indices)
                for check_j < child_count {
                    if child_indices[check_j] == i {
                        is_child = 1
                        break
                    }
                    check_j = check_j + 1
                }
                if is_child == 0 {
                    last = gen_ir_from_ast_with_symtab(i, nodes, instrs, st_n, st_v)
                }
            }
        }
        i = i + 1
    }
    return last
}

// Helper: split "Enum.Variant" at the dot → returns the part before dot
fn split_dot_left(s: string) -> string {
    i := 0
    for i < len(s) {
        if str_char_at(s, i) == 46 { return str_substring(s, 0, i) }
        i = i + 1
    }
    return s
}

// Helper: split "Enum.Variant" at the dot → returns the part after dot
fn split_dot_right(s: string) -> string {
    i := 0
    for i < len(s) {
        if str_char_at(s, i) == 46 { return str_substring(s, i + 1, len(s)) }
        i = i + 1
    }
    return s
}

fn gen_ir_enum_variant(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // node.str_val = "Enum.Variant", node.int_val = field count
    ename := split_dot_left(node.str_val)
    vname := split_dot_right(node.str_val)

    // Allocate consistent size for the enum type
    alloc_size := enum_max_size(ename)
    size_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: size_vreg, arg1: alloc_size, arg2: 0, arg3: 0, str_val: "" })
    ptr := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_HEAP_ALLOC, dest: ptr, arg1: size_vreg, arg2: 0, arg3: 0, str_val: "" })

    // Store tag at offset 0
    tag_val := enum_tag(ename, vname)
    tag_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: tag_vreg, arg1: tag_val, arg2: 0, arg3: 0, str_val: "" })
    instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: ptr, arg2: tag_vreg, arg3: 0, str_val: "" })

    // Store field values
    field_vals := get_struct_fields(ast_idx)
    fi := 0
    for fi < len(field_vals) {
        fname := enum_variant_field_name(ename, vname, fi)
        foff := enum_variant_field_offset(ename, vname, fname)
        v := gen_ir_from_ast_with_symtab(field_vals[fi], nodes, instrs, st_n, st_v)
        addr := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr, arg1: ptr, arg2: foff, arg3: 0, str_val: "" })
        instrs = append(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: addr, arg2: v, arg3: 0, str_val: "" })
        fi = fi + 1
    }

    set_vreg_type(ptr, TYPE_STRUCT)
    set_vreg_struct_name(ptr, ename)
    return ptr
}

fn gen_ir_try_expr(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // Evaluate inner expression
    expr_vreg := gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_n, st_v)

    // Get enum type name
    ename := get_vreg_struct_name(expr_vreg)

    // Determine success variant: "Ok" for Result, "Some" for Option/StringOption
    success_variant := "Some"
    if enum_tag(ename, "Ok") >= 0 {
        success_variant = "Ok"
    }

    // Load tag from expr at offset 0
    tag_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOAD, dest: tag_vreg, arg1: expr_vreg, arg2: 0, arg3: 0, str_val: "" })

    // Load success tag constant
    success_tag := enum_tag(ename, success_variant)
    tag_const := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: tag_const, arg1: success_tag, arg2: 0, arg3: 0, str_val: "" })

    // Compare: tag == success_tag
    cmp_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_CMP_EQ, dest: cmp_vreg, arg1: tag_vreg, arg2: tag_const, arg3: 0, str_val: "" })

    // Branch to error_label if cmp == 0 (tag != success_tag)
    error_label := g_next_label
    g_next_label = g_next_label + 1
    continue_label := g_next_label
    g_next_label = g_next_label + 1

    instrs = append(instrs, IRInstr { op: OP_BRANCH, dest: cmp_vreg, arg1: error_label, arg2: 0, arg3: 0, str_val: "" })

    // OK path: extract "value" field
    foff := enum_variant_field_offset(ename, success_variant, "value")
    addr_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr_vreg, arg1: expr_vreg, arg2: foff, arg3: 0, str_val: "" })
    value_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOAD, dest: value_vreg, arg1: addr_vreg, arg2: 0, arg3: 0, str_val: "" })

    // Set type of extracted value
    ftype := enum_variant_field_type(ename, success_variant, "value")
    set_vreg_type(value_vreg, ftype)

    // Jump to continue
    instrs = append(instrs, IRInstr { op: OP_JUMP, dest: continue_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

    // Error path: early return with the enum value
    instrs = append(instrs, IRInstr { op: OP_LABEL, dest: error_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    instrs = append(instrs, IRInstr { op: OP_RET, dest: expr_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

    // Continue label
    instrs = append(instrs, IRInstr { op: OP_LABEL, dest: continue_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

    return value_vreg
}

fn gen_ir_match(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // node.left = matched expr, node.right = first arm, node.int_val = arm count
    match_ptr := gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_n, st_v)

    // Load tag from offset 0
    tag_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOAD, dest: tag_vreg, arg1: match_ptr, arg2: 0, arg3: 0, str_val: "" })

    // Allocate result vreg
    result_vreg := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: result_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

    match_end_label := g_next_label
    g_next_label = g_next_label + 1

    // Collect arm node indices by scanning from first_arm for STMT_MATCH_ARM nodes
    arm_indices := []int{}
    scan := node.right
    nodes_count := len(nodes)
    for scan < nodes_count {
        if nodes[scan].tag == STMT_MATCH_ARM {
            arm_indices = append(arm_indices, scan)
            if len(arm_indices) == node.int_val { break }
        }
        scan = scan + 1
    }

    // Process arms
    ai := 0
    for ai < len(arm_indices) {
        arm_idx := arm_indices[ai]
        arm := nodes[arm_idx]
        ename := split_dot_left(arm.str_val)
        vname := split_dot_right(arm.str_val)

        // Compare tag
        arm_tag := enum_tag(ename, vname)
        tag_const := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: tag_const, arg1: arm_tag, arg2: 0, arg3: 0, str_val: "" })
        cmp := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_CMP_EQ, dest: cmp, arg1: tag_vreg, arg2: tag_const, arg3: 0, str_val: "" })

        next_arm_label := g_next_label
        g_next_label = g_next_label + 1

        // Branch: CBZ semantics — jump to next_arm_label if cmp==0 (not equal)
        instrs = append(instrs, IRInstr { op: OP_BRANCH, dest: cmp, arg1: next_arm_label, arg2: 0, arg3: 0, str_val: "" })

        // Bind fields: load from match_ptr and add to symtab
        binding_names := get_match_arm_bindings(arm_idx)
        bi := 0
        for bi < len(binding_names) {
            bname := binding_names[bi]
            foff := enum_variant_field_offset(ename, vname, bname)
            addr := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr, arg1: match_ptr, arg2: foff, arg3: 0, str_val: "" })
            val := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_LOAD, dest: val, arg1: addr, arg2: 0, arg3: 0, str_val: "" })
            st_n = append(st_n, bname)
            st_v = append(st_v, val)
            ftype := enum_variant_field_type(ename, vname, bname)
            set_vreg_type(val, ftype)
            bi = bi + 1
        }

        // Evaluate arm body
        body_result := gen_ir_from_ast_with_symtab(arm.left, nodes, instrs, st_n, st_v)

        // Copy result
        instrs = append(instrs, IRInstr { op: OP_COPY, dest: result_vreg, arg1: body_result, arg2: 0, arg3: 0, str_val: "" })

        // Jump to end
        instrs = append(instrs, IRInstr { op: OP_JUMP, dest: match_end_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

        // Next arm label
        instrs = append(instrs, IRInstr { op: OP_LABEL, dest: next_arm_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

        ai = ai + 1
    }

    // Match end label
    instrs = append(instrs, IRInstr { op: OP_LABEL, dest: match_end_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

    // Set result type from last arm body (all arms should produce same type)
    set_vreg_type(result_vreg, get_vreg_type(body_result))
    return result_vreg
}

fn gen_ir_from_ast_with_symtab(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    if ast_idx < 0 {
        return -1
    }

    node := nodes[ast_idx]

    // Dispatch simple expressions to helper
    if node.tag == EXPR_INT || node.tag == EXPR_BOOL || node.tag == EXPR_IDENT || node.tag == EXPR_STRING || node.tag == EXPR_FLOAT {
        return gen_ir_expr(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_TO_STRING {
        inner_vreg := gen_ir_from_ast_with_symtab(node.left, nodes, instrs, symtab_names, symtab_vregs)
        inner_type := get_vreg_type(inner_vreg)
        if inner_type == TYPE_STRING {
            return inner_vreg
        }
        vreg := len(instrs)
        if inner_type == TYPE_FLOAT {
            instrs = append(instrs, IRInstr { op: OP_FLOAT_TO_STR, dest: vreg, arg1: inner_vreg, arg2: 0, arg3: 0, str_val: "" })
        } else {
            if inner_type == TYPE_BOOL {
                instrs = append(instrs, IRInstr { op: OP_BOOL_TO_STR, dest: vreg, arg1: inner_vreg, arg2: 0, arg3: 0, str_val: "" })
            } else {
                instrs = append(instrs, IRInstr { op: OP_INT_TO_STR, dest: vreg, arg1: inner_vreg, arg2: 0, arg3: 0, str_val: "" })
            }
        }
        set_vreg_type(vreg, TYPE_STRING)
        return vreg
    }

    if node.tag == EXPR_UNARY {
        operand := gen_ir_from_ast_with_symtab(node.left, nodes, instrs, symtab_names, symtab_vregs)
        if node.int_val == TK_MINUS {
            if get_vreg_type(operand) == TYPE_FLOAT {
                // Float unary minus: 0.0 - operand
                zero_vreg := len(instrs)
                instrs = append(instrs, IRInstr { op: OP_LOADFLOAT, dest: zero_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "0.0" })
                set_vreg_type(zero_vreg, TYPE_FLOAT)
                result_vreg := len(instrs)
                instrs = append(instrs, IRInstr { op: OP_FSUB, dest: result_vreg, arg1: zero_vreg, arg2: operand, arg3: 0, str_val: "" })
                set_vreg_type(result_vreg, TYPE_FLOAT)
                return result_vreg
            }
            // Int unary minus: 0 - operand
            zero_vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: zero_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            result_vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_SUB, dest: result_vreg, arg1: zero_vreg, arg2: operand, arg3: 0, str_val: "" })
            set_vreg_type(result_vreg, TYPE_INT)
            return result_vreg
        }
        if node.int_val == TK_NOT {
            // Logical NOT: operand == 0
            zero_vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: zero_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            result_vreg := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_CMP_EQ, dest: result_vreg, arg1: operand, arg2: zero_vreg, arg3: 0, str_val: "" })
            set_vreg_type(result_vreg, TYPE_BOOL)
            return result_vreg
        }
        if node.int_val == TK_AMPERSAND {
            // Address-of: structs are already pointers, identity op
            set_vreg_struct_name(operand, get_vreg_struct_name(operand))
            return operand
        }
        if node.int_val == TK_STAR {
            // Dereference: structs are already pointers, identity op
            return operand
        }
        return operand
    }

    if node.tag == EXPR_BINARY {
        return gen_ir_binary(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_CALL {
        func_name := lookup_rename(node.str_val)
        // Check if callee is a local variable (closure or closure-as-int)
        cl_vreg := symtab_lookup_linear(symtab_names, symtab_vregs, func_name)
        if cl_vreg >= 0 {
            cl_type := get_vreg_type(cl_vreg)
            if cl_type == TYPE_CLOSURE || cl_type == TYPE_INT {
                return gen_ir_closure_call(cl_vreg, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
            }
        }
        if func_name == "len" {
            return gen_ir_call_len(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "append" {
            return gen_ir_call_push(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "poke" {
            return gen_ir_call_poke(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "peek" {
            return gen_ir_call_peek(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "peek64" {
            return gen_ir_call_peek64(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "poke64" {
            return gen_ir_call_poke64(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "delete" {
            return gen_ir_call_delete(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "heap_alloc" {
            return gen_ir_call_heap_alloc(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "os.Argc" {
            return gen_ir_call_argc(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "os.Argv" {
            return gen_ir_call_argv(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "str_char_at" {
            return gen_ir_call_str_char_at(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "syscall.open" {
            return gen_ir_call_syscall_open(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "syscall.write" {
            return gen_ir_call_syscall_write(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "syscall.close" {
            return gen_ir_call_syscall_close(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "syscall.read" {
            return gen_ir_call_syscall_read(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "os.IsDir" {
            return gen_ir_call_is_dir(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "os.ListDir" {
            return gen_ir_call_list_dir(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "test_fail" {
            instrs = append(instrs, IRInstr { op: OP_TEST_FAIL, dest: -1, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            return -1
        }
        if func_name == "time_wallclock_nanos" {
            dest := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_TIME_WALLCLOCK, dest: dest, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            set_vreg_type(dest, TYPE_INT)
            return dest
        }
        if func_name == "strconv.FloatToStr" {
            arg_vregs := gen_ir_eval_args(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
            dest := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_FLOAT_TO_STR, dest: dest, arg1: arg_vregs[0], arg2: 0, arg3: 0, str_val: "" })
            set_vreg_type(dest, TYPE_STRING)
            return dest
        }
        if func_name == "strconv.IntToFloat" {
            arg_vregs := gen_ir_eval_args(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
            dest := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_INT_TO_FLOAT, dest: dest, arg1: arg_vregs[0], arg2: 0, arg3: 0, str_val: "" })
            set_vreg_type(dest, TYPE_FLOAT)
            return dest
        }
        if func_name == "strconv.FloatToInt" {
            arg_vregs := gen_ir_eval_args(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
            dest := len(instrs)
            instrs = append(instrs, IRInstr { op: OP_FLOAT_TO_INT, dest: dest, arg1: arg_vregs[0], arg2: 0, arg3: 0, str_val: "" })
            set_vreg_type(dest, TYPE_INT)
            return dest
        }
        // Check for method call: "varname.MethodName"
        dot_pos := find_dot(func_name)
        if dot_pos > 0 {
            receiver_name := str_substring(func_name, 0, dot_pos)
            method_name := str_substring(func_name, dot_pos + 1, len(func_name))
            // Check if receiver is a local variable in the symbol table
            recv_vreg := -1
            rsi := len(symtab_names) - 1
            for rsi >= 0 {
                if symtab_names[rsi] == receiver_name {
                    recv_vreg = symtab_vregs[rsi]
                    break
                }
                rsi = rsi - 1
            }
            if recv_vreg >= 0 && recv_vreg > -1000 {
                struct_name := get_vreg_struct_name(recv_vreg)
                if struct_name != "" {
                    // Check if receiver is an interface type
                    if is_interface(struct_name) == 1 {
                        vtable_idx := iface_method_index(struct_name, method_name)
                        if vtable_idx >= 0 {
                            // Emit OP_ARG for interface value + remaining args
                            instrs = append(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: recv_vreg, arg2: -1, arg3: 0, str_val: "" })
                            ic_args := gen_ir_eval_args(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
                            ic_ai := 0
                            for ic_ai < len(ic_args) {
                                instrs = append(instrs, IRInstr { op: OP_ARG, dest: ic_ai + 1, arg1: ic_args[ic_ai], arg2: -1, arg3: 0, str_val: "" })
                                ic_ai = ic_ai + 1
                            }
                            ic_total_args := len(ic_args) + 1
                            ic_res := len(instrs)
                            instrs = append(instrs, IRInstr { op: OP_IFACE_CALL, dest: ic_res, arg1: vtable_idx, arg2: ic_total_args, arg3: 0, str_val: struct_name })
                            // Set return type from interface method signature
                            ic_ret := iface_method_ret_type(struct_name, vtable_idx)
                            ic_ret_arr := iface_method_ret_is_array(struct_name, vtable_idx)
                            set_vreg_type(ic_res, make_type(ic_ret, ic_ret_arr))
                            return ic_res
                        }
                    }
                    internal_name := lookup_method(struct_name, method_name)
                    if internal_name != "" {
                        actual_name := lookup_rename(internal_name)
                        return gen_ir_method_call(recv_vreg, actual_name, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
                    }
                }
            }
        }
        return gen_ir_call_user(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_MAP_LIT {
        map_type := node.str_val
        kt_code := map_key_type_code(map_type)
        result_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_MAP_NEW, dest: result_vreg, arg1: kt_code, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(result_vreg, TYPE_MAP)
        set_vreg_struct_name(result_vreg, map_type)
        return result_vreg
    }

    if node.tag == EXPR_ARRAY_LIT {
        return gen_ir_array_lit(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_INDEX {
        return gen_ir_index(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_FIELD {
        return gen_ir_field(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_STRUCT_LIT {
        return gen_ir_struct_lit(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_ENUM_VARIANT {
        return gen_ir_enum_variant(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_TRY {
        return gen_ir_try_expr(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_MATCH {
        return gen_ir_match(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_RETURN {
        return gen_ir_stmt_ret(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_LET {
        return gen_ir_stmt_let(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_MULTI_LET {
        return gen_ir_multi_let(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_ASSIGN {
        return gen_ir_stmt_assign(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_INDEX_ASSIGN {
        return gen_ir_index_assign(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_FIELD_ASSIGN {
        return gen_ir_field_assign(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_EXPR {
        // Expression statement (e.g., function call without using result)
        // node.left = expression
        // Just evaluate the expression and return its vreg
        return gen_ir_from_ast_with_symtab(node.left, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_IF {
        return gen_ir_stmt_if(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_FOR {
        return gen_ir_stmt_for(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_BLOCK {
        return gen_ir_stmt_block(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_BREAK {
        // Use global break label (set by gen_ir_stmt_for with save/restore)
        if g_break_label >= 0 {
            instrs = append(instrs, IRInstr { op: OP_JUMP, dest: g_break_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
        }
        return 0
    }

    if node.tag == DECL_FUNC {
        // Generate function with parameters
        // node.left = first parameter index (or -1 if no parameters)
        // node.right = body node

        // Add all parameters to symbol table.
        // Use 90000+ offset for parameter vregs to avoid collision with instruction-based vregs.
        // Parameters are stored consecutively in nodes array starting at node.left
        if node.left >= 0 {
            // Iterate through consecutive parameter nodes
            param_idx := node.left
            param_reg := 90000  // 90000, 90001, 90002, etc.

            // Find how many consecutive DECL_PARAM nodes there are
            param_i := node.left
            nodes_len2 := len(nodes)
            for param_i < nodes_len2 {
                param_node := nodes[param_i]
                if param_node.tag == DECL_PARAM {
                    // Add parameter to symbol table
                    symtab_names = append(symtab_names, param_node.str_val)
                    symtab_vregs = append(symtab_vregs, param_reg)
                    ptype := make_type(param_node.type_tag, param_node.int_val)
                    set_vreg_type(param_reg, ptype)
                    // Set struct name for struct/map-typed params
                    if param_node.type_tag == TYPE_STRUCT || param_node.type_tag == TYPE_MAP {
                        param_sname := lookup_type_name(param_i)
                        set_vreg_struct_name(param_reg, param_sname)
                    }
                    param_reg = param_reg + 1
                } else {
                    // Stop when we hit a non-parameter node
                    break
                }
                param_i = param_i + 1
            }
        }

        // If this is a closure function, load captures from env (param 0 = __env)
        if strings.HasPrefix(node.str_val, "__closure_") {
            cap_count := sema.ClosureCaptureCount(node.str_val)
            if cap_count > 0 {
                env_reg := 90000  // __env is always param 0
                cap_i := 0
                for cap_i < cap_count {
                    cap_name := sema.ClosureCaptureName(node.str_val, cap_i)
                    addr_vreg := len(instrs)
                    instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr_vreg, arg1: env_reg, arg2: cap_i * 8, arg3: 0, str_val: "" })
                    set_vreg_type(addr_vreg, TYPE_INT)
                    val_vreg := len(instrs)
                    instrs = append(instrs, IRInstr { op: OP_LOAD, dest: val_vreg, arg1: addr_vreg, arg2: 0, arg3: 0, str_val: "" })
                    set_vreg_type(val_vreg, TYPE_INT)
                    symtab_names = append(symtab_names, cap_name)
                    symtab_vregs = append(symtab_vregs, val_vreg)
                    cap_i = cap_i + 1
                }
            }
        }

        // Generate body
        if node.right >= 0 {
            return gen_ir_from_ast_with_symtab(node.right, nodes, instrs, symtab_names, symtab_vregs)
        }
    }

    if node.tag == EXPR_CLOSURE {
        return gen_ir_closure(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    return 0
}

// Generate IR for closure creation (EXPR_CLOSURE)
fn gen_ir_closure(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    cl_name := node.str_val
    // Analyze captures: walk closure body, find references to enclosing scope
    capture_names := analyze_captures(node, nodes, st_n)
    env_vreg := -1
    if len(capture_names) > 0 {
        // Allocate environment: num_captures * 8 bytes
        env_size := len(capture_names) * 8
        size_vreg := len(instrs)
        instrs = append(instrs, IRInstr { op: OP_LOADCONST, dest: size_vreg, arg1: env_size, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(size_vreg, TYPE_INT)
        env_vreg = len(instrs)
        instrs = append(instrs, IRInstr { op: OP_HEAP_ALLOC, dest: env_vreg, arg1: size_vreg, arg2: 0, arg3: 0, str_val: "" })
        set_vreg_type(env_vreg, TYPE_INT)
        // Store each captured variable into the environment
        ci := 0
        for ci < len(capture_names) {
            cap_vreg := symtab_lookup_linear(st_n, st_v, capture_names[ci])
            if cap_vreg >= 0 || cap_vreg <= -1000 {
                addr_vreg := len(instrs)
                instrs = append(instrs, IRInstr { op: OP_INDEXADDR, dest: addr_vreg, arg1: env_vreg, arg2: ci * 8, arg3: 0, str_val: "" })
                set_vreg_type(addr_vreg, TYPE_INT)
                instrs = append(instrs, IRInstr { op: OP_STORE, dest: addr_vreg, arg1: addr_vreg, arg2: cap_vreg, arg3: 0, str_val: "" })
            }
            ci = ci + 1
        }
        // Store capture info in sema
        sema.StoreClosureCaptures(cl_name, capture_names)
    }
    // Emit OP_CLOSURE_NEW
    res := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_CLOSURE_NEW, dest: res, arg1: env_vreg, arg2: 0, arg3: 0, str_val: cl_name })
    set_vreg_type(res, TYPE_CLOSURE)
    return res
}

fn symtab_lookup_linear(names: []string, vregs: []int, name: string) -> int {
    i := len(names) - 1
    for i >= 0 {
        if names[i] == name { return vregs[i] }
        i = i - 1
    }
    return -1
}

// Generate IR for calling a closure
fn gen_ir_closure_call(closure_vreg: int, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    args := gen_ir_eval_args(ast_idx, nodes, instrs, st_n, st_v)
    // Emit OP_ARG for each user argument
    i := 0
    for i < len(args) {
        instrs = append(instrs, IRInstr { op: OP_ARG, dest: i, arg1: args[i], arg2: -1, arg3: 0, str_val: "" })
        i = i + 1
    }
    res := len(instrs)
    instrs = append(instrs, IRInstr { op: OP_CLOSURE_CALL, dest: res, arg1: closure_vreg, arg2: len(args), arg3: 0, str_val: "" })
    set_vreg_type(res, TYPE_INT)
    return res
}

// Analyze which variables from enclosing scope are referenced in the closure body
fn analyze_captures(closure_node: AstNode, nodes: []AstNode, enclosing_names: []string) -> []string {
    captures := []string{}
    if closure_node.right < 0 { return captures }
    // Collect parameter names to exclude them
    param_names := []string{}
    if closure_node.left >= 0 {
        pi := closure_node.left
        for pi < len(nodes) {
            if nodes[pi].tag == DECL_PARAM {
                param_names = append(param_names, nodes[pi].str_val)
            } else {
                break
            }
            pi = pi + 1
        }
    }
    // Walk body AST recursively collecting EXPR_IDENT references
    collect_ident_refs(closure_node.right, nodes, param_names, enclosing_names, captures)
    return captures
}

fn collect_ident_refs(idx: int, nodes: []AstNode, params: []string, enclosing: []string, captures: []string) {
    if idx < 0 || idx >= len(nodes) { return }
    node := nodes[idx]
    if node.tag == EXPR_IDENT {
        name := node.str_val
        // Skip if it's a parameter
        pi := 0
        for pi < len(params) {
            if params[pi] == name { return }
            pi = pi + 1
        }
        // Skip if already captured
        ci := 0
        for ci < len(captures) {
            if captures[ci] == name { return }
            ci = ci + 1
        }
        // Check if it's in the enclosing scope
        ei := 0
        for ei < len(enclosing) {
            if enclosing[ei] == name {
                captures = append(captures, name)
                return
            }
            ei = ei + 1
        }
        return
    }
    // Recurse into children
    if node.left >= 0 { collect_ident_refs(node.left, nodes, params, enclosing, captures) }
    if node.right >= 0 { collect_ident_refs(node.right, nodes, params, enclosing, captures) }
    if node.extra >= 0 { collect_ident_refs(node.extra, nodes, params, enclosing, captures) }
    // For block nodes, walk all statements
    if node.tag == STMT_BLOCK && node.int_val > 0 {
        si := node.left
        sc := 0
        for sc < node.int_val && si >= 0 && si < len(nodes) {
            collect_ident_refs(si, nodes, params, enclosing, captures)
            si = si + 1
            sc = sc + 1
        }
    }
    // For call nodes, walk arguments
    if node.tag == EXPR_CALL {
        call_args := get_call_args(idx)
        ai := 0
        for ai < len(call_args) {
            collect_ident_refs(call_args[ai], nodes, params, enclosing, captures)
            ai = ai + 1
        }
    }
}
