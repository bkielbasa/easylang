    index_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    result_vreg := len(instrs)
    argv_instr := IRInstr { op: OP_ARGV(), dest: result_vreg, arg1: index_vreg, arg2: 0, arg3: 0, str_val: "" }
    push(instrs, argv_instr)
    return result_vreg
}


