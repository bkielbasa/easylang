package irgen

// IR generation - translates AST to IR instructions for the Ease bootstrap compiler

// Helper: check if an AST expression produces a string value
fn is_string_expr(idx: int, nodes: []AstNode) -> int {
    if idx < 0 { return 0 }
    node := nodes[idx]
    if node.tag == EXPR_STRING() { return 1 }
    if node.tag == EXPR_IDENT() {
        // Check if this variable was tracked as holding a string (current function scope only)
        si := g_string_vars_start
        slen := len(g_string_vars)
        for si < slen {
            if g_string_vars[si] == node.str_val { return 1 }
            si = si + 1
        }
        return 0
    }
    if node.tag == EXPR_CALL() {
        call_name := lookup_rename(node.str_val)
        ret_type := lookup_func_return_type(call_name)
        if ret_type == TYPE_STRING() {
            if lookup_func_return_is_array(call_name) == 0 {
                return 1
            }
        }
        return 0
    }
    if node.tag == EXPR_FIELD() {
        // Field access: look up field type in the struct field type registry
        ft := lookup_field_type(node.str_val)
        if ft == TYPE_STRING() && lookup_field_is_array(node.str_val) == 0 { return 1 }
        return 0
    }
    if node.tag == EXPR_INDEX() {
        // Array indexing: check if base array is a known string array (current function scope only)
        base := nodes[node.left]
        if base.tag == EXPR_IDENT() {
            sai := g_string_array_vars_start
            for sai < len(g_string_array_vars) {
                if g_string_array_vars[sai] == base.str_val { return 1 }
                sai = sai + 1
            }
        }
        return 0
    }
    // NOTE: EXPR_ARRAY_LIT is NOT a string - it's an array.
    // []string{} is a string ARRAY, not a string value.
    // String array detection is in is_string_array_expr.
    if node.tag == EXPR_BINARY() {
        if node.int_val == TK_PLUS() {
            if is_string_expr(node.left, nodes) == 1 { return 1 }
            if is_string_expr(node.right, nodes) == 1 { return 1 }
        }
        return 0
    }
    return 0
}

fn is_string_array_expr(idx: int, nodes: []AstNode) -> int {
    if idx < 0 { return 0 }
    node := nodes[idx]
    if node.tag == EXPR_ARRAY_LIT() {
        if node.str_val == "string" { return 1 }
        return 0
    }
    if node.tag == EXPR_IDENT() {
        i := g_string_array_vars_start
        for i < len(g_string_array_vars) {
            if g_string_array_vars[i] == node.str_val { return 1 }
            i = i + 1
        }
        return 0
    }
    if node.tag == EXPR_CALL() {
        call_name := lookup_rename(node.str_val)
        ret_type := lookup_func_return_type(call_name)
        if ret_type == TYPE_STRING() && lookup_func_return_is_array(call_name) == 1 {
            return 1
        }
        return 0
    }
    if node.tag == EXPR_FIELD() {
        // Field access: check if the field is a []string array
        ft := lookup_field_type(node.str_val)
        if ft == TYPE_STRING() && lookup_field_is_array(node.str_val) == 1 { return 1 }
        return 0
    }
    return 0
}

// Helper: Generate IR for len() builtin
fn gen_ir_call_len(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 1 {
        return -1
    }
    array_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    result_vreg := len(instrs)
    op := OP_ARRAY_LEN()
    if is_string_expr(arg_indices[0], nodes) == 1 {
        op = OP_STR_LEN()
    }
    len_instr := IRInstr { op: op, dest: result_vreg, arg1: array_vreg, arg2: 0, arg3: 0, str_val: "" }
    push(instrs, len_instr)
    return result_vreg
}

// Helper: Generate IR for push() builtin
fn gen_ir_call_push(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 2 {
        return -1
    }
    array_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    elem_vreg := gen_ir_from_ast_with_symtab(arg_indices[1], nodes, instrs, symtab_names, symtab_vregs)
    push_instr := IRInstr { op: OP_ARRAY_PUSH(), dest: -1, arg1: array_vreg, arg2: elem_vreg, arg3: 0, str_val: "" }
    push(instrs, push_instr)
    return array_vreg
}

// Helper: Generate IR for poke() builtin
fn gen_ir_call_poke(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 2 {
        return -1
    }
    addr_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    value_vreg := gen_ir_from_ast_with_symtab(arg_indices[1], nodes, instrs, symtab_names, symtab_vregs)
    poke_instr := IRInstr { op: OP_POKE(), dest: -1, arg1: addr_vreg, arg2: value_vreg, arg3: 0, str_val: "" }
    push(instrs, poke_instr)
    return -1  // poke returns nothing
}

// Helper: Generate IR for peek() builtin
fn gen_ir_call_peek(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 1 {
        return -1
    }
    addr_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    result_vreg := len(instrs)
    peek_instr := IRInstr { op: OP_PEEK(), dest: result_vreg, arg1: addr_vreg, arg2: 0, arg3: 0, str_val: "" }
    push(instrs, peek_instr)
    return result_vreg  // peek returns the byte value
}

// Helper: Generate IR for heap_alloc() builtin
fn gen_ir_call_heap_alloc(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    arg_indices := get_call_args(ast_idx)
    if len(arg_indices) != 1 {
        return -1
    }
    size_vreg := gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    result_vreg := len(instrs)
    heap_alloc_instr := IRInstr { op: OP_HEAP_ALLOC(), dest: result_vreg, arg1: size_vreg, arg2: 0, arg3: 0, str_val: "" }
    push(instrs, heap_alloc_instr)
    return result_vreg  // heap_alloc returns the allocated pointer
}

fn gen_ir_call_argc(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    // os.Argc() -> int
    result_vreg := len(instrs)
    argc_instr := IRInstr { op: OP_ARGC(), dest: result_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" }
    push(instrs, argc_instr)
    return result_vreg
}

