package ast

// AST node types, structs, and constructors for the Ease bootstrap compiler

struct AstNode {
    tag: int,           // Node type (expression, statement, declaration)
    int_val: int,       // Integer value or operator type
    str_val: string,    // Identifier name or string value
    left: int,          // Left child or first child (-1 if none)
    right: int,         // Right child or second child (-1 if none)
    extra: int,         // Extra child or metadata (-1 if none)
    type_tag: int,      // Type information (0=unknown, 1=int, 2=bool, etc.)
}

// Expression node types
const EXPR_INT = 1
const EXPR_BOOL = 2
const EXPR_IDENT = 3
const EXPR_BINARY = 4
const EXPR_UNARY = 5
const EXPR_CALL = 6
const EXPR_INDEX = 7
const EXPR_FIELD = 8
const EXPR_ARRAY_LIT = 9
const EXPR_STRUCT_LIT = 10
const EXPR_STRING = 11

// Statement node types
const STMT_LET = 20
const STMT_RETURN = 21
const STMT_IF = 22
const STMT_FOR = 23
const STMT_ASSIGN = 24
const STMT_EXPR = 25
const STMT_BLOCK = 26
const STMT_BREAK = 27

// Declaration node types
const DECL_FUNC = 40
const DECL_STRUCT = 41
const DECL_PARAM = 42
const DECL_FIELD = 43
const DECL_IMPORT = 44
const DECL_ENUM = 45
const DECL_VARIANT = 46
const EXPR_ENUM_VARIANT = 47
const STMT_MATCH = 48
const STMT_MATCH_ARM = 49
const EXPR_TRY = 50
const DECL_CONST = 51
const DECL_INTERFACE = 52
const DECL_IMETHOD = 53

// Type tags
const TYPE_UNKNOWN = 0
const TYPE_INT = 1
const TYPE_BOOL = 2
const TYPE_STRING = 3
const TYPE_INT_ARRAY = 4
const TYPE_STRING_ARRAY = 5
const TYPE_BOOL_ARRAY = 6
const TYPE_STRUCT = 7
const TYPE_PTR = 8
const TYPE_INTERFACE = 9

struct ParseResult {
    node_idx: int,
    new_pos: int,
}

// Helper functions for creating AST nodes
fn new_int_node(val: int, nodes: []AstNode) -> int {
    node := AstNode {
        tag: EXPR_INT,
        int_val: val,
        str_val: "",
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_INT
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_bool_node(val: int, nodes: []AstNode) -> int {
    node := AstNode {
        tag: EXPR_BOOL,
        int_val: val,
        str_val: "",
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_BOOL
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_ident_node(name: string, nodes: []AstNode) -> int {
    node := AstNode {
        tag: EXPR_IDENT,
        int_val: 0,
        str_val: name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_binary_node(op: int, left_idx: int, right_idx: int, nodes: []AstNode) -> int {
    node := AstNode {
        tag: EXPR_BINARY,
        int_val: op,
        str_val: "",
        left: left_idx,
        right: right_idx,
        extra: -1,
        type_tag: TYPE_UNKNOWN
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_unary_node(op: int, operand: int, nodes: []AstNode) -> int {
    node := AstNode {
        tag: EXPR_UNARY,
        int_val: op,
        str_val: "",
        left: operand,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN
    }
    push(nodes, node)
    return len(nodes) - 1
}
