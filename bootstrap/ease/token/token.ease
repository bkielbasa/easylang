package token

// Token type constants for the Ease bootstrap compiler

fn TK_IDENT() -> int { return 1 }
fn TK_INT() -> int { return 2 }
fn TK_STRING() -> int { return 3 }

// Keywords
fn TK_FN() -> int { return 10 }
fn TK_LET() -> int { return 11 }
fn TK_MUT() -> int { return 12 }
fn TK_IF() -> int { return 13 }
fn TK_ELSE() -> int { return 14 }
fn TK_FOR() -> int { return 15 }
fn TK_IN() -> int { return 16 }
fn TK_RETURN() -> int { return 17 }
fn TK_BREAK() -> int { return 18 }
fn TK_STRUCT() -> int { return 19 }
fn TK_TRUE() -> int { return 20 }
fn TK_FALSE() -> int { return 21 }
fn TK_IMPORT() -> int { return 22 }
fn TK_PACKAGE() -> int { return 23 }
fn TK_ENUM() -> int { return 24 }
fn TK_MATCH() -> int { return 25 }

// Arithmetic operators
fn TK_PLUS() -> int { return 30 }
fn TK_MINUS() -> int { return 31 }
fn TK_STAR() -> int { return 32 }
fn TK_SLASH() -> int { return 33 }
fn TK_PERCENT() -> int { return 34 }

// Comparison operators
fn TK_LT() -> int { return 35 }
fn TK_GT() -> int { return 36 }
fn TK_LE() -> int { return 37 }
fn TK_GE() -> int { return 38 }
fn TK_EQ() -> int { return 39 }
fn TK_NE() -> int { return 40 }

// Logical operators
fn TK_AND() -> int { return 41 }
fn TK_OR() -> int { return 42 }
fn TK_NOT() -> int { return 43 }
fn TK_CARET() -> int { return 44 }  // XOR operator ^
fn TK_AMPERSAND() -> int { return 46 }  // Bitwise AND operator &
fn TK_PIPE() -> int { return 50 }  // Bitwise OR operator |

// Assignment
fn TK_ASSIGN() -> int { return 45 }

// Delimiters
fn TK_ARROW() -> int { return 47 }
fn TK_DOT() -> int { return 48 }
fn TK_DOTDOT() -> int { return 49 }

fn TK_LPAREN() -> int { return 51 }
fn TK_RPAREN() -> int { return 52 }
fn TK_LBRACE() -> int { return 53 }
fn TK_RBRACE() -> int { return 54 }
fn TK_LBRACKET() -> int { return 55 }
fn TK_RBRACKET() -> int { return 56 }
fn TK_COMMA() -> int { return 57 }
fn TK_COLON() -> int { return 58 }
fn TK_SEMI() -> int { return 59 }
fn TK_COLONEQUAL() -> int { return 60 }
fn TK_COLONCOLON() -> int { return 61 }
fn TK_FATARROW() -> int { return 62 }
fn TK_QUESTION() -> int { return 63 }

fn TK_EOF() -> int { return 100 }

fn TokenName(kind: int) -> string {
    if kind == 1 { return "identifier" }
    if kind == 2 { return "integer" }
    if kind == 3 { return "string" }
    if kind == 10 { return "'fn'" }
    if kind == 11 { return "'let'" }
    if kind == 12 { return "'mut'" }
    if kind == 13 { return "'if'" }
    if kind == 14 { return "'else'" }
    if kind == 15 { return "'for'" }
    if kind == 16 { return "'in'" }
    if kind == 17 { return "'return'" }
    if kind == 18 { return "'break'" }
    if kind == 19 { return "'struct'" }
    if kind == 20 { return "'true'" }
    if kind == 21 { return "'false'" }
    if kind == 22 { return "'import'" }
    if kind == 23 { return "'package'" }
    if kind == 24 { return "'enum'" }
    if kind == 25 { return "'match'" }
    if kind == 30 { return "'+'" }
    if kind == 31 { return "'-'" }
    if kind == 32 { return "'*'" }
    if kind == 33 { return "'/'" }
    if kind == 34 { return "'%'" }
    if kind == 35 { return "'<'" }
    if kind == 36 { return "'>'" }
    if kind == 37 { return "'<='" }
    if kind == 38 { return "'>='" }
    if kind == 39 { return "'=='" }
    if kind == 40 { return "'!='" }
    if kind == 41 { return "'&&'" }
    if kind == 42 { return "'||'" }
    if kind == 43 { return "'!'" }
    if kind == 44 { return "'^'" }
    if kind == 45 { return "'='" }
    if kind == 46 { return "'&'" }
    if kind == 47 { return "'->'" }
    if kind == 48 { return "'.'" }
    if kind == 49 { return "'..'" }
    if kind == 50 { return "'|'" }
    if kind == 51 { return "'('" }
    if kind == 52 { return "')'" }
    if kind == 53 { return "'{'" }
    if kind == 54 { return "'}'" }
    if kind == 55 { return "'['" }
    if kind == 56 { return "']'" }
    if kind == 57 { return "','" }
    if kind == 58 { return "':'" }
    if kind == 59 { return "';'" }
    if kind == 60 { return "':='" }
    if kind == 61 { return "'::'" }
    if kind == 62 { return "'=>'" }
    if kind == 63 { return "'?'" }
    if kind == 100 { return "end of file" }
    return "unknown"
}
