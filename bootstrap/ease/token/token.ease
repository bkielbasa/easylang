package token

// Token type constants for the Ease bootstrap compiler

const TK_IDENT = 1
const TK_INT = 2
const TK_STRING = 3
const TK_FLOAT = 4

// Keywords
const TK_FN = 10
const TK_LET = 11
const TK_MUT = 12
const TK_IF = 13
const TK_ELSE = 14
const TK_FOR = 15
const TK_IN = 16
const TK_RETURN = 17
const TK_BREAK = 18
const TK_STRUCT = 19
const TK_TRUE = 20
const TK_FALSE = 21
const TK_IMPORT = 22
const TK_PACKAGE = 23
const TK_ENUM = 24
const TK_MATCH = 25
const TK_CONST = 26
const TK_INTERFACE = 27
const TK_MAP = 28
const TK_EXTERN = 29

// Arithmetic operators
const TK_PLUS = 30
const TK_MINUS = 31
const TK_STAR = 32
const TK_SLASH = 33
const TK_PERCENT = 34

// Comparison operators
const TK_LT = 35
const TK_GT = 36
const TK_LE = 37
const TK_GE = 38
const TK_EQ = 39
const TK_NE = 40

// Logical operators
const TK_AND = 41
const TK_OR = 42
const TK_NOT = 43
const TK_CARET = 44  // XOR operator ^
const TK_AMPERSAND = 46  // Bitwise AND operator &
const TK_PIPE = 50  // Bitwise OR operator |

// Assignment
const TK_ASSIGN = 45

// Delimiters
const TK_ARROW = 47
const TK_DOT = 48
const TK_DOTDOT = 49

const TK_LPAREN = 51
const TK_RPAREN = 52
const TK_LBRACE = 53
const TK_RBRACE = 54
const TK_LBRACKET = 55
const TK_RBRACKET = 56
const TK_COMMA = 57
const TK_COLON = 58
const TK_SEMI = 59
const TK_COLONEQUAL = 60
const TK_COLONCOLON = 61
const TK_FATARROW = 62
const TK_QUESTION = 63

const TK_EOF = 100

fn TokenName(kind: int) -> string {
    if kind == 1 { return "identifier" }
    if kind == 2 { return "integer" }
    if kind == 3 { return "string" }
    if kind == 4 { return "float" }
    if kind == 10 { return "'fn'" }
    if kind == 11 { return "'let'" }
    if kind == 12 { return "'mut'" }
    if kind == 13 { return "'if'" }
    if kind == 14 { return "'else'" }
    if kind == 15 { return "'for'" }
    if kind == 16 { return "'in'" }
    if kind == 17 { return "'return'" }
    if kind == 18 { return "'break'" }
    if kind == 19 { return "'struct'" }
    if kind == 20 { return "'true'" }
    if kind == 21 { return "'false'" }
    if kind == 22 { return "'import'" }
    if kind == 23 { return "'package'" }
    if kind == 24 { return "'enum'" }
    if kind == 25 { return "'match'" }
    if kind == 26 { return "'const'" }
    if kind == 27 { return "'interface'" }
    if kind == 28 { return "'map'" }
    if kind == 29 { return "'extern'" }
    if kind == 30 { return "'+'" }
    if kind == 31 { return "'-'" }
    if kind == 32 { return "'*'" }
    if kind == 33 { return "'/'" }
    if kind == 34 { return "'%'" }
    if kind == 35 { return "'<'" }
    if kind == 36 { return "'>'" }
    if kind == 37 { return "'<='" }
    if kind == 38 { return "'>='" }
    if kind == 39 { return "'=='" }
    if kind == 40 { return "'!='" }
    if kind == 41 { return "'&&'" }
    if kind == 42 { return "'||'" }
    if kind == 43 { return "'!'" }
    if kind == 44 { return "'^'" }
    if kind == 45 { return "'='" }
    if kind == 46 { return "'&'" }
    if kind == 47 { return "'->'" }
    if kind == 48 { return "'.'" }
    if kind == 49 { return "'..'" }
    if kind == 50 { return "'|'" }
    if kind == 51 { return "'('" }
    if kind == 52 { return "')'" }
    if kind == 53 { return "'{'" }
    if kind == 54 { return "'}'" }
    if kind == 55 { return "'['" }
    if kind == 56 { return "']'" }
    if kind == 57 { return "','" }
    if kind == 58 { return "':'" }
    if kind == 59 { return "';'" }
    if kind == 60 { return "':='" }
    if kind == 61 { return "'::'" }
    if kind == 62 { return "'=>'" }
    if kind == 63 { return "'?'" }
    if kind == 100 { return "end of file" }
    return "unknown"
}
