package strconv

// String conversion functions for the Ease bootstrap compiler

fn Itoa(n: int) -> string {
    if n == 0 { return "0" }
    val := n
    negative := false
    if val < 0 {
        negative = true
        val = 0 - val
    }
    result := ""
    for val > 0 {
        digit := val - ((val / 10) * 10)
        val = val / 10
        ch := "0"
        if digit == 1 { ch = "1" }
        if digit == 2 { ch = "2" }
        if digit == 3 { ch = "3" }
        if digit == 4 { ch = "4" }
        if digit == 5 { ch = "5" }
        if digit == 6 { ch = "6" }
        if digit == 7 { ch = "7" }
        if digit == 8 { ch = "8" }
        if digit == 9 { ch = "9" }
        result = ch + result
    }
    if negative { result = "-" + result }
    return result
}

fn Atoi(s: string) -> int {
    result := 0
    negative := 0
    slen := len(s)
    i := 0
    if slen > 0 && str_char_at(s, 0) == 45 {
        negative = 1
        i = 1
    }
    for i < slen {
        ch := str_char_at(s, i)
        if ch >= 48 && ch <= 57 {
            result = result * 10 + (ch - 48)
        } else {
            break
        }
        i = i + 1
    }
    if negative == 1 { result = 0 - result }
    return result
}
