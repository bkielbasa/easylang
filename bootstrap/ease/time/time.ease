package time

struct Time {
    sec: int,
    nsec: int,
}

fn Now() -> Time {
    nanos := time_wallclock_nanos()
    sec := nanos / 1000000000
    nsec := nanos - sec * 1000000000
    return Time { sec: sec, nsec: nsec }
}

fn UnixNano(t: Time) -> int {
    return t.sec * 1000000000 + t.nsec
}

fn Unix(t: Time) -> int {
    return t.sec
}

fn Sub(t1: Time, t2: Time) -> int {
    return UnixNano(t1) - UnixNano(t2)
}

fn Since(start: Time) -> int {
    now := Now()
    return UnixNano(now) - UnixNano(start)
}

fn Add(t: Time, nanos: int) -> Time {
    total := UnixNano(t) + nanos
    sec := total / 1000000000
    nsec := total - sec * 1000000000
    return Time { sec: sec, nsec: nsec }
}

fn Before(t1: Time, t2: Time) -> int {
    if t1.sec < t2.sec { return 1 }
    if t1.sec > t2.sec { return 0 }
    if t1.nsec < t2.nsec { return 1 }
    return 0
}

fn After(t1: Time, t2: Time) -> int {
    if t1.sec > t2.sec { return 1 }
    if t1.sec < t2.sec { return 0 }
    if t1.nsec > t2.nsec { return 1 }
    return 0
}
