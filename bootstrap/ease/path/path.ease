package path

fn last_slash(p: string) -> int {
    i := len(p) - 1
    for i >= 0 {
        if str_char_at(p, i) == 47 { return i }
        i = i - 1
    }
    return -1
}

fn last_dot(p: string, start: int) -> int {
    i := len(p) - 1
    for i >= start {
        if str_char_at(p, i) == 46 { return i }
        i = i - 1
    }
    return -1
}

fn Join(a: string, b: string) -> string {
    if len(a) == 0 { return b }
    if len(b) == 0 { return a }
    if str_char_at(a, len(a) - 1) == 47 {
        return a + b
    }
    return a + "/" + b
}

fn Base(p: string) -> string {
    if len(p) == 0 { return "." }
    // Strip trailing slashes
    end := len(p)
    for end > 0 {
        if str_char_at(p, end - 1) != 47 { break }
        end = end - 1
    }
    if end == 0 { return "/" }
    i := end - 1
    for i >= 0 {
        if str_char_at(p, i) == 47 {
            return str_substring(p, i + 1, end)
        }
        i = i - 1
    }
    return str_substring(p, 0, end)
}

fn Dir(p: string) -> string {
    if len(p) == 0 { return "." }
    i := last_slash(p)
    if i < 0 { return "." }
    if i == 0 { return "/" }
    // Strip trailing slashes from dir
    end := i
    for end > 0 {
        if str_char_at(p, end - 1) != 47 { break }
        end = end - 1
    }
    if end == 0 { return "/" }
    return str_substring(p, 0, end)
}

fn Ext(p: string) -> string {
    // Find the base name first
    slash := last_slash(p)
    start := slash + 1
    dot := last_dot(p, start)
    if dot < 0 { return "" }
    return str_substring(p, dot, len(p))
}

fn IsAbs(p: string) -> int {
    if len(p) == 0 { return 0 }
    if str_char_at(p, 0) == 47 { return 1 }
    return 0
}

fn Clean(p: string) -> string {
    if len(p) == 0 { return "." }

    is_abs := IsAbs(p)

    // Split into components, filtering . and empty, resolving ..
    parts := []string{}
    start := 0
    plen := len(p)
    i := 0
    for i <= plen {
        if i == plen {
            if i > start {
                seg := str_substring(p, start, i)
                if seg == ".." {
                    if len(parts) > 0 {
                        if parts[len(parts) - 1] != ".." {
                            parts = parts[0:len(parts) - 1]
                        } else if is_abs == 0 {
                            parts = append(parts, "..")
                        }
                    } else if is_abs == 0 {
                        parts = append(parts, "..")
                    }
                } else if seg != "." {
                    parts = append(parts, seg)
                }
            }
            break
        }
        if str_char_at(p, i) == 47 {
            if i > start {
                seg := str_substring(p, start, i)
                if seg == ".." {
                    if len(parts) > 0 {
                        if parts[len(parts) - 1] != ".." {
                            parts = parts[0:len(parts) - 1]
                        } else if is_abs == 0 {
                            parts = append(parts, "..")
                        }
                    } else if is_abs == 0 {
                        parts = append(parts, "..")
                    }
                } else if seg != "." {
                    parts = append(parts, seg)
                }
            }
            start = i + 1
        }
        i = i + 1
    }

    if len(parts) == 0 {
        if is_abs == 1 { return "/" }
        return "."
    }

    result := ""
    if is_abs == 1 { result = "/" }
    j := 0
    for j < len(parts) {
        if j > 0 { result = result + "/" }
        result = result + parts[j]
        j = j + 1
    }
    return result
}
