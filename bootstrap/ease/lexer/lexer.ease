package lexer

// Lexer - tokenizer functions for the Ease bootstrap compiler

fn is_digit(ch: int) -> bool {
    return ch >= 48 && ch <= 57  // '0' to '9'
}

fn is_alpha(ch: int) -> bool {
    return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95  // A-Z, a-z, _
}

fn is_hex_digit(ch: int) -> bool {
    return is_digit(ch) || (ch >= 97 && ch <= 102) || (ch >= 65 && ch <= 70)  // 0-9, a-f, A-F
}

fn lex_peek(src: string, pos: int) -> int {
    if pos >= len(src) {
        return 0
    }
    return str_char_at(src, pos)
}

fn lex_skip(src: string, pos: int) -> int {
    src_len := len(src)
    p := pos
    for p < src_len {
        ch := lex_peek(src, p)

        // Skip whitespace
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {  // space, tab, newline, CR
            p = p + 1
        } else {
            // Check for comments: //
            if ch == 47 && p + 1 < src_len {  // '/' character
                next_ch := lex_peek(src, p + 1)
                if next_ch == 47 {  // Second '/' - it's a comment
                    // Skip until end of line
                    p = p + 2  // Skip //
                    for p < src_len {
                        comment_ch := lex_peek(src, p)
                        if comment_ch == 10 || comment_ch == 13 {  // newline or CR
                            break
                        }
                        p = p + 1
                    }
                } else {
                    break  // Not a comment, stop skipping
                }
            } else {
                break  // Not whitespace or comment
            }
        }
    }
    return p
}

fn lex_kind(src: string, pos: int) -> int {
    src_len := len(src)
    if pos >= src_len {
        return TK_EOF()
    }

    ch := lex_peek(src, pos)
    next := 0
    if pos + 1 < src_len {
        next = lex_peek(src, pos + 1)
    }

    // Two-character tokens
    if ch == 45 && next == 62 { return TK_ARROW() }      // ->
    if ch == 60 && next == 61 { return TK_LE() }         // <=
    if ch == 62 && next == 61 { return TK_GE() }         // >=
    if ch == 61 && next == 61 { return TK_EQ() }         // ==
    if ch == 33 && next == 61 { return TK_NE() }         // !=
    if ch == 38 && next == 38 { return TK_AND() }        // &&
    if ch == 124 && next == 124 { return TK_OR() }       // ||
    if ch == 46 && next == 46 { return TK_DOTDOT() }     // ..
    if ch == 58 && next == 58 { return TK_COLONCOLON() }  // ::
    if ch == 61 && next == 62 { return TK_FATARROW() }    // =>

    // Single-char tokens
    if ch == 40 { return TK_LPAREN() }    // (
    if ch == 41 { return TK_RPAREN() }    // )
    if ch == 123 { return TK_LBRACE() }   // {
    if ch == 125 { return TK_RBRACE() }   // }
    if ch == 91 { return TK_LBRACKET() }  // [
    if ch == 93 { return TK_RBRACKET() }  // ]
    if ch == 44 { return TK_COMMA() }     // ,
    if ch == 58 && next == 61 { return TK_COLONEQUAL() }  // :=
    if ch == 58 { return TK_COLON() }     // :
    if ch == 59 { return TK_SEMI() }      // ;
    if ch == 46 { return TK_DOT() }       // .
    if ch == 43 { return TK_PLUS() }      // +
    if ch == 45 { return TK_MINUS() }     // -
    if ch == 42 { return TK_STAR() }      // *
    if ch == 47 { return TK_SLASH() }     // /
    if ch == 37 { return TK_PERCENT() }   // %
    if ch == 94 { return TK_CARET() }     // ^ (XOR)
    if ch == 38 { return TK_AMPERSAND() } // & (bitwise AND, after && check)
    if ch == 124 { return TK_PIPE() }     // | (bitwise OR, after || check)
    if ch == 60 { return TK_LT() }        // <
    if ch == 62 { return TK_GT() }        // >
    if ch == 61 { return TK_ASSIGN() }    // =
    if ch == 33 { return TK_NOT() }       // !

    // Numbers
    if is_digit(ch) {
        return TK_INT()
    }

    // String literals
    if ch == 34 {  // " character
        return TK_STRING()
    }

    // Identifiers and keywords
    if is_alpha(ch) {
        end := pos
        for end < src_len && (is_alpha(lex_peek(src, end)) || is_digit(lex_peek(src, end))) {
            end = end + 1
        }
        word := str_substring(src, pos, end)
        if word == "fn" { return TK_FN() }
        if word == "if" { return TK_IF() }
        if word == "else" { return TK_ELSE() }
        if word == "for" { return TK_FOR() }
        if word == "in" { return TK_IN() }
        if word == "return" { return TK_RETURN() }
        if word == "break" { return TK_BREAK() }
        if word == "struct" { return TK_STRUCT() }
        if word == "enum" { return TK_ENUM() }
        if word == "match" { return TK_MATCH() }
        if word == "true" { return TK_TRUE() }
        if word == "false" { return TK_FALSE() }
        if word == "import" { return TK_IMPORT() }
        if word == "package" { return TK_PACKAGE() }
        return TK_IDENT()
    }

    return TK_EOF()
}

fn lex_end(src: string, pos: int, kind: int) -> int {
    if kind == TK_EOF() { return pos }

    // Two-character tokens
    if kind == TK_ARROW() || kind == TK_LE() || kind == TK_GE() ||
       kind == TK_EQ() || kind == TK_NE() || kind == TK_AND() ||
       kind == TK_OR() || kind == TK_DOTDOT() || kind == TK_COLONEQUAL() ||
       kind == TK_COLONCOLON() || kind == TK_FATARROW() {
        return pos + 2
    }

    // Single-character tokens
    if kind == TK_LPAREN() || kind == TK_RPAREN() || kind == TK_LBRACE() ||
       kind == TK_RBRACE() || kind == TK_LBRACKET() || kind == TK_RBRACKET() ||
       kind == TK_COMMA() || kind == TK_COLON() || kind == TK_SEMI() || kind == TK_DOT() ||
       kind == TK_PLUS() || kind == TK_MINUS() || kind == TK_STAR() || kind == TK_SLASH() ||
       kind == TK_PERCENT() || kind == TK_CARET() || kind == TK_AMPERSAND() || kind == TK_PIPE() || kind == TK_LT() || kind == TK_GT() || kind == TK_ASSIGN() || kind == TK_NOT() {
        return pos + 1
    }

    // Numbers (decimal and hexadecimal)
    if kind == TK_INT() {
        end := pos
        // Check for hex literal: 0x...
        if end + 1 < len(src) && lex_peek(src, end) == 48 && lex_peek(src, end + 1) == 120 {  // '0' and 'x'
            end = end + 2  // Skip "0x"
            for end < len(src) && is_hex_digit(lex_peek(src, end)) {
                end = end + 1
            }
        } else {
            // Decimal number
            for end < len(src) && is_digit(lex_peek(src, end)) {
                end = end + 1
            }
        }
        return end
    }

    // String literals
    if kind == TK_STRING() {
        end := pos + 1  // Skip opening quote
        for end < len(src) {
            ch := lex_peek(src, end)
            if ch == 34 {  // Closing quote
                return end + 1  // Include closing quote
            }
            if ch == 92 {  // Backslash (escape)
                end = end + 2  // Skip escape sequence
            } else {
                end = end + 1
            }
        }
        return end  // Unterminated string (return what we have)
    }

    // Identifiers and keywords
    if kind == TK_IDENT() || kind == TK_FN() ||
       kind == TK_IF() || kind == TK_ELSE() || kind == TK_FOR() || kind == TK_IN() ||
       kind == TK_RETURN() || kind == TK_BREAK() || kind == TK_STRUCT() ||
       kind == TK_TRUE() || kind == TK_FALSE() || kind == TK_IMPORT() ||
       kind == TK_PACKAGE() || kind == TK_ENUM() || kind == TK_MATCH() {
        end := pos
        for end < len(src) && (is_alpha(lex_peek(src, end)) || is_digit(lex_peek(src, end))) {
            end = end + 1
        }
        return end
    }

    // Two-character operators
    if kind == TK_ARROW() || kind == TK_LE() || kind == TK_GE() ||
       kind == TK_EQ() || kind == TK_NE() || kind == TK_AND() ||
       kind == TK_OR() || kind == TK_DOTDOT() || kind == TK_COLONEQUAL() ||
       kind == TK_COLONCOLON() || kind == TK_FATARROW() {
        return pos + 2
    }

    return pos + 1
}

fn lex_string_value(src: string, pos: int, kind: int) -> string {
    if kind == TK_IDENT() || kind == TK_FN() ||
       kind == TK_IF() || kind == TK_ELSE() || kind == TK_FOR() || kind == TK_IN() ||
       kind == TK_RETURN() || kind == TK_BREAK() || kind == TK_STRUCT() ||
       kind == TK_TRUE() || kind == TK_FALSE() || kind == TK_IMPORT() ||
       kind == TK_PACKAGE() || kind == TK_ENUM() || kind == TK_MATCH() {
        end := lex_end(src, pos, kind)
        return str_substring(src, pos, end)
    }
    if kind == TK_STRING() {
        // Extract string content without quotes, decode escape sequences
        end := lex_end(src, pos, kind)
        raw := str_substring(src, pos + 1, end - 1)
        raw_len := len(raw)
        result := ""
        ri := 0
        for ri < raw_len {
            ch := str_char_at(raw, ri)
            if ch == 92 && ri + 1 < raw_len {
                next := str_char_at(raw, ri + 1)
                if next == 110 { result = result + "\n" }
                if next == 116 { result = result + "\t" }
                if next == 92  { result = result + "\\" }
                if next == 34  { result = result + "\"" }
                if next == 48  { poke(result, len(result), 0) }
                ri = ri + 2
            } else {
                result = result + str_substring(raw, ri, ri + 1)
                ri = ri + 1
            }
        }
        return result
    }
    return ""
}

fn lex_int_value(src: string, pos: int) -> int {
    end := lex_end(src, pos, TK_INT())
    s := str_substring(src, pos, end)
    val := 0
    i := 0
    s_len := len(s)

    // Check for hex: "0x..."
    if s_len >= 2 && str_char_at(s, 0) == 48 && str_char_at(s, 1) == 120 {  // '0' and 'x'
        // Parse hex
        i = 2  // Skip "0x"
        for i < s_len {
            ch := str_char_at(s, i)
            digit := 0
            if ch >= 48 && ch <= 57 { digit = ch - 48 }            // '0'-'9'
            if ch >= 97 && ch <= 102 { digit = ch - 97 + 10 }      // 'a'-'f'
            if ch >= 65 && ch <= 70 { digit = ch - 65 + 10 }       // 'A'-'F'
            val = val * 16 + digit
            i = i + 1
        }
    } else {
        // Parse decimal
        for i < s_len {
            ch := str_char_at(s, i)
            val = val * 10 + (ch - 48)
            i = i + 1
        }
    }
    return val
}
