package main

// Test different expressions with the integrated compiler

// Copy all the code from compiler.ease...
// (Simplified version just to test multiplication)

fn TK_INT() -> int { return 2 }
fn TK_STAR() -> int { return 32 }
fn TK_EOF() -> int { return 100 }

fn is_digit(ch: int) -> bool {
    return ch >= 48 && ch <= 57
}

fn lex_peek(src: string, pos: int) -> int {
    if pos >= len(src) {
        return 0
    }
    return str_char_at(src, pos)
}

fn lex_skip(src: string, pos: int) -> int {
    src_len := len(src)
    p := pos
    for p < src_len {
        ch := lex_peek(src, p)
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
            p = p + 1
        } else {
            break
        }
    }
    return p
}

fn lex_kind(src: string, pos: int) -> int {
    src_len := len(src)
    if pos >= src_len {
        return TK_EOF()
    }
    ch := lex_peek(src, pos)
    if ch == 42 { return TK_STAR() }
    if is_digit(ch) { return TK_INT() }
    return TK_EOF()
}

fn lex_end(src: string, pos: int, kind: int) -> int {
    if kind == TK_EOF() { return pos }
    if kind == TK_STAR() { return pos + 1 }
    if kind == TK_INT() {
        end := pos
        for end < len(src) && is_digit(lex_peek(src, end)) {
            end = end + 1
        }
        return end
    }
    return pos + 1
}

fn lex_int_value(src: string, pos: int) -> int {
    end := lex_end(src, pos, TK_INT())
    s := str_substring(src, pos, end)
    val := 0
    for i in 0..len(s) {
        ch := str_char_at(s, i)
        val = val * 10 + (ch - 48)
    }
    return val
}

struct IRInstr {
    op: int,
    dest: int,
    arg1: int,
    arg2: int,
}

fn OP_MUL() -> int { return 4 }

fn encode_mul(rd: int, rn: int, rm: int) -> int {
    return 0x9b007c00 + (rm * 0x10000) + (rn * 0x20) + rd
}

fn main() -> int {
    print("=== Testing: 3 * 7 ===\n\n")

    source := "3 * 7"

    // Lex
    pos := 0
    pos = lex_skip(source, pos)
    val1 := lex_int_value(source, pos)
    pos = lex_end(source, pos, TK_INT())

    pos = lex_skip(source, pos)
    op := lex_kind(source, pos)
    pos = lex_end(source, pos, op)

    pos = lex_skip(source, pos)
    val2 := lex_int_value(source, pos)

    print("Parsed: ")
    print(strconv.Itoa(val1))
    print(" * ")
    print(strconv.Itoa(val2))
    print("\n\n")

    // Generate IR
    instrs := []IRInstr{}
    push(instrs, IRInstr { op: 1, dest: 0, arg1: val1, arg2: 0 })  // loadconst val1
    push(instrs, IRInstr { op: 1, dest: 1, arg1: val2, arg2: 0 })  // loadconst val2
    push(instrs, IRInstr { op: OP_MUL(), dest: 2, arg1: 0, arg2: 1 })  // mul

    print("IR: v2 = mul v0, v1\n\n")

    // Generate code
    encoded := encode_mul(2, 0, 1)
    print("ARM64: 0x")
    // Print hex
    v := encoded
    digits := []int{}
    for i in 0..8 {
        push(digits, v % 16)
        v = v / 16
    }
    for i in 0..8 {
        d := digits[7 - i]
        if d < 10 {
            print(strconv.Itoa(d))
        } else {
            if d == 10 { print("a") }
            if d == 11 { print("b") }
            if d == 12 { print("c") }
            if d == 13 { print("d") }
            if d == 14 { print("e") }
            if d == 15 { print("f") }
        }
    }
    print("  # MUL x2, x0, x1\n")

    print("\nExpected result: 21 (decimal), 0x15 (hex)\n")

    return 0
}
