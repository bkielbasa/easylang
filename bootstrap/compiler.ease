//     offset = offset + write_pagezero_segment(buf + offset)
//     offset = offset + write_text_segment(buf + offset, code_size, header_size)
//     offset = offset + write_main_cmd(buf + offset, 0)
//
//     let code_offset = header_size
//     let mut i = 0
//     for i < len(code) {
