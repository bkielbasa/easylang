// Bootstrap Compiler Integration Demo
// Demonstrates all compilation phases working together:
// Source Code -> Lexer -> Parser -> Sema -> IR -> Codegen

import (
    "strconv"
)

// ============================================================================
// Token Definitions (from token.ease)
// ============================================================================

fn TK_IDENT() -> int { return 1 }
fn TK_INT() -> int { return 2 }
fn TK_STRING() -> int { return 3 }

// Keywords
fn TK_FN() -> int { return 10 }
fn TK_LET() -> int { return 11 }
fn TK_MUT() -> int { return 12 }
fn TK_IF() -> int { return 13 }
fn TK_ELSE() -> int { return 14 }
fn TK_FOR() -> int { return 15 }
fn TK_IN() -> int { return 16 }
fn TK_RETURN() -> int { return 17 }
fn TK_BREAK() -> int { return 18 }
fn TK_STRUCT() -> int { return 19 }
fn TK_TRUE() -> int { return 20 }
fn TK_FALSE() -> int { return 21 }
fn TK_IMPORT() -> int { return 22 }

// Arithmetic operators
fn TK_PLUS() -> int { return 30 }
fn TK_MINUS() -> int { return 31 }
fn TK_STAR() -> int { return 32 }
fn TK_SLASH() -> int { return 33 }
fn TK_PERCENT() -> int { return 34 }

// Comparison operators
fn TK_LT() -> int { return 35 }
fn TK_GT() -> int { return 36 }
fn TK_LE() -> int { return 37 }
fn TK_GE() -> int { return 38 }
fn TK_EQ() -> int { return 39 }
fn TK_NE() -> int { return 40 }

// Logical operators
fn TK_AND() -> int { return 41 }
fn TK_OR() -> int { return 42 }
fn TK_NOT() -> int { return 43 }
fn TK_CARET() -> int { return 44 }  // XOR operator ^
fn TK_AMPERSAND() -> int { return 46 }  // Bitwise AND operator &
fn TK_PIPE() -> int { return 50 }  // Bitwise OR operator |

// Assignment
fn TK_ASSIGN() -> int { return 45 }

// Delimiters
fn TK_ARROW() -> int { return 47 }
fn TK_DOT() -> int { return 48 }
fn TK_DOTDOT() -> int { return 49 }

fn TK_LPAREN() -> int { return 51 }
fn TK_RPAREN() -> int { return 52 }
fn TK_LBRACE() -> int { return 53 }
fn TK_RBRACE() -> int { return 54 }
fn TK_LBRACKET() -> int { return 55 }
fn TK_RBRACKET() -> int { return 56 }
fn TK_COMMA() -> int { return 57 }
fn TK_COLON() -> int { return 58 }
fn TK_SEMI() -> int { return 59 }

fn TK_EOF() -> int { return 100 }

// ============================================================================
// Simplified Lexer (from lexer.ease)
// ============================================================================

fn is_digit(ch: int) -> bool {
    return ch >= 48 && ch <= 57  // '0' to '9'
}

fn is_alpha(ch: int) -> bool {
    return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95  // A-Z, a-z, _
}

fn is_hex_digit(ch: int) -> bool {
    return is_digit(ch) || (ch >= 97 && ch <= 102) || (ch >= 65 && ch <= 70)  // 0-9, a-f, A-F
}

fn lex_peek(src: string, pos: int) -> int {
    if pos >= len(src) {
        return 0
    }
    return str_char_at(src, pos)
}

fn lex_skip(src: string, pos: int) -> int {
    let src_len = len(src)
    let mut p = pos
    for p < src_len {
        let ch = lex_peek(src, p)

        // Skip whitespace
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {  // space, tab, newline, CR
            p = p + 1
        } else {
            // Check for comments: //
            if ch == 47 && p + 1 < src_len {  // '/' character
                let next_ch = lex_peek(src, p + 1)
                if next_ch == 47 {  // Second '/' - it's a comment
                    // Skip until end of line
                    p = p + 2  // Skip //
                    for p < src_len {
                        let comment_ch = lex_peek(src, p)
                        if comment_ch == 10 || comment_ch == 13 {  // newline or CR
                            break
                        }
                        p = p + 1
                    }
                } else {
                    break  // Not a comment, stop skipping
                }
            } else {
                break  // Not whitespace or comment
            }
        }
    }
    return p
}

fn lex_kind(src: string, pos: int) -> int {
    let src_len = len(src)
    if pos >= src_len {
        return TK_EOF()
    }

    let ch = lex_peek(src, pos)
    let mut next = 0
    if pos + 1 < src_len {
        next = lex_peek(src, pos + 1)
    }

    // Two-character tokens
    if ch == 45 && next == 62 { return TK_ARROW() }      // ->
    if ch == 60 && next == 61 { return TK_LE() }         // <=
    if ch == 62 && next == 61 { return TK_GE() }         // >=
    if ch == 61 && next == 61 { return TK_EQ() }         // ==
    if ch == 33 && next == 61 { return TK_NE() }         // !=
    if ch == 38 && next == 38 { return TK_AND() }        // &&
    if ch == 124 && next == 124 { return TK_OR() }       // ||
    if ch == 46 && next == 46 { return TK_DOTDOT() }     // ..

    // Single-char tokens
    if ch == 40 { return TK_LPAREN() }    // (
    if ch == 41 { return TK_RPAREN() }    // )
    if ch == 123 { return TK_LBRACE() }   // {
    if ch == 125 { return TK_RBRACE() }   // }
    if ch == 91 { return TK_LBRACKET() }  // [
    if ch == 93 { return TK_RBRACKET() }  // ]
    if ch == 44 { return TK_COMMA() }     // ,
    if ch == 58 { return TK_COLON() }     // :
    if ch == 59 { return TK_SEMI() }      // ;
    if ch == 46 { return TK_DOT() }       // .
    if ch == 43 { return TK_PLUS() }      // +
    if ch == 45 { return TK_MINUS() }     // -
    if ch == 42 { return TK_STAR() }      // *
    if ch == 47 { return TK_SLASH() }     // /
    if ch == 37 { return TK_PERCENT() }   // %
    if ch == 94 { return TK_CARET() }     // ^ (XOR)
    if ch == 38 { return TK_AMPERSAND() } // & (bitwise AND, after && check)
    if ch == 124 { return TK_PIPE() }     // | (bitwise OR, after || check)
    if ch == 60 { return TK_LT() }        // <
    if ch == 62 { return TK_GT() }        // >
    if ch == 61 { return TK_ASSIGN() }    // =
    if ch == 33 { return TK_NOT() }       // !

    // Numbers
    if is_digit(ch) {
        return TK_INT()
    }

    // String literals
    if ch == 34 {  // " character
        return TK_STRING()
    }

    // Identifiers and keywords
    if is_alpha(ch) {
        let mut end = pos
        for end < src_len && (is_alpha(lex_peek(src, end)) || is_digit(lex_peek(src, end))) {
            end = end + 1
        }
        let word = str_substring(src, pos, end)
        if word == "fn" { return TK_FN() }
        if word == "let" { return TK_LET() }
        if word == "mut" { return TK_MUT() }
        if word == "if" { return TK_IF() }
        if word == "else" { return TK_ELSE() }
        if word == "for" { return TK_FOR() }
        if word == "in" { return TK_IN() }
        if word == "return" { return TK_RETURN() }
        if word == "break" { return TK_BREAK() }
        if word == "struct" { return TK_STRUCT() }
        if word == "true" { return TK_TRUE() }
        if word == "false" { return TK_FALSE() }
        if word == "import" { return TK_IMPORT() }
        return TK_IDENT()
    }

    return TK_EOF()
}

fn lex_end(src: string, pos: int, kind: int) -> int {
    if kind == TK_EOF() { return pos }

    // Two-character tokens
    if kind == TK_ARROW() || kind == TK_LE() || kind == TK_GE() ||
       kind == TK_EQ() || kind == TK_NE() || kind == TK_AND() ||
       kind == TK_OR() || kind == TK_DOTDOT() {
        return pos + 2
    }

    // Single-character tokens
    if kind == TK_LPAREN() || kind == TK_RPAREN() || kind == TK_LBRACE() ||
       kind == TK_RBRACE() || kind == TK_LBRACKET() || kind == TK_RBRACKET() ||
       kind == TK_COMMA() || kind == TK_COLON() || kind == TK_SEMI() || kind == TK_DOT() ||
       kind == TK_PLUS() || kind == TK_MINUS() || kind == TK_STAR() || kind == TK_SLASH() ||
       kind == TK_PERCENT() || kind == TK_CARET() || kind == TK_AMPERSAND() || kind == TK_PIPE() || kind == TK_LT() || kind == TK_GT() || kind == TK_ASSIGN() || kind == TK_NOT() {
        return pos + 1
    }

    // Numbers (decimal and hexadecimal)
    if kind == TK_INT() {
        let mut end = pos
        // Check for hex literal: 0x...
        if end + 1 < len(src) && lex_peek(src, end) == 48 && lex_peek(src, end + 1) == 120 {  // '0' and 'x'
            end = end + 2  // Skip "0x"
            for end < len(src) && is_hex_digit(lex_peek(src, end)) {
                end = end + 1
            }
        } else {
            // Decimal number
            for end < len(src) && is_digit(lex_peek(src, end)) {
                end = end + 1
            }
        }
        return end
    }

    // String literals
    if kind == TK_STRING() {
        let mut end = pos + 1  // Skip opening quote
        for end < len(src) {
            let ch = lex_peek(src, end)
            if ch == 34 {  // Closing quote
                return end + 1  // Include closing quote
            }
            if ch == 92 {  // Backslash (escape)
                end = end + 2  // Skip escape sequence
            } else {
                end = end + 1
            }
        }
        return end  // Unterminated string (return what we have)
    }

    // Identifiers and keywords
    if kind == TK_IDENT() || kind == TK_FN() || kind == TK_LET() || kind == TK_MUT() ||
       kind == TK_IF() || kind == TK_ELSE() || kind == TK_FOR() || kind == TK_IN() ||
       kind == TK_RETURN() || kind == TK_BREAK() || kind == TK_STRUCT() ||
       kind == TK_TRUE() || kind == TK_FALSE() || kind == TK_IMPORT() {
        let mut end = pos
        for end < len(src) && (is_alpha(lex_peek(src, end)) || is_digit(lex_peek(src, end))) {
            end = end + 1
        }
        return end
    }

    // Two-character operators
    if kind == TK_ARROW() || kind == TK_LE() || kind == TK_GE() ||
       kind == TK_EQ() || kind == TK_NE() || kind == TK_AND() ||
       kind == TK_OR() || kind == TK_DOTDOT() {
        return pos + 2
    }

    return pos + 1
}

fn lex_string_value(src: string, pos: int, kind: int) -> string {
    if kind == TK_IDENT() || kind == TK_FN() || kind == TK_LET() || kind == TK_MUT() ||
       kind == TK_IF() || kind == TK_ELSE() || kind == TK_FOR() || kind == TK_IN() ||
       kind == TK_RETURN() || kind == TK_BREAK() || kind == TK_STRUCT() ||
       kind == TK_TRUE() || kind == TK_FALSE() || kind == TK_IMPORT() {
        let end = lex_end(src, pos, kind)
        return str_substring(src, pos, end)
    }
    if kind == TK_STRING() {
        // Extract string content without quotes, decode escape sequences
        let end = lex_end(src, pos, kind)
        let raw = str_substring(src, pos + 1, end - 1)
        let raw_len = len(raw)
        let mut result = ""
        let mut ri = 0
        for ri < raw_len {
            let ch = str_char_at(raw, ri)
            if ch == 92 && ri + 1 < raw_len {
                let next = str_char_at(raw, ri + 1)
                if next == 110 { result = result + "\n" }
                if next == 116 { result = result + "\t" }
                if next == 92  { result = result + "\\" }
                if next == 34  { result = result + "\"" }
                if next == 48  { poke(result, len(result), 0) }
                ri = ri + 2
            } else {
                result = result + str_substring(raw, ri, ri + 1)
                ri = ri + 1
            }
        }
        return result
    }
    return ""
}

fn lex_int_value(src: string, pos: int) -> int {
    let end = lex_end(src, pos, TK_INT())
    let s = str_substring(src, pos, end)
    let mut val = 0
    let mut i = 0
    let s_len = len(s)

    // Check for hex: "0x..."
    if s_len >= 2 && str_char_at(s, 0) == 48 && str_char_at(s, 1) == 120 {  // '0' and 'x'
        // Parse hex
        i = 2  // Skip "0x"
        for i < s_len {
            let ch = str_char_at(s, i)
            let mut digit = 0
            if ch >= 48 && ch <= 57 { digit = ch - 48 }            // '0'-'9'
            if ch >= 97 && ch <= 102 { digit = ch - 97 + 10 }      // 'a'-'f'
            if ch >= 65 && ch <= 70 { digit = ch - 65 + 10 }       // 'A'-'F'
            val = val * 16 + digit
            i = i + 1
        }
    } else {
        // Parse decimal
        for i < s_len {
            let ch = str_char_at(s, i)
            val = val * 10 + (ch - 48)
            i = i + 1
        }
    }
    return val
}

// ============================================================================
// Parser and AST (expanded for full language)
// ============================================================================

struct AstNode {
    tag: int,           // Node type (expression, statement, declaration)
    int_val: int,       // Integer value or operator type
    str_val: string,    // Identifier name or string value
    left: int,          // Left child or first child (-1 if none)
    right: int,         // Right child or second child (-1 if none)
    extra: int,         // Extra child or metadata (-1 if none)
    type_tag: int,      // Type information (0=unknown, 1=int, 2=bool, etc.)
}

// Expression node types
fn EXPR_INT() -> int { return 1 }
fn EXPR_BOOL() -> int { return 2 }
fn EXPR_IDENT() -> int { return 3 }
fn EXPR_BINARY() -> int { return 4 }
fn EXPR_UNARY() -> int { return 5 }
fn EXPR_CALL() -> int { return 6 }
fn EXPR_INDEX() -> int { return 7 }
fn EXPR_FIELD() -> int { return 8 }
fn EXPR_ARRAY_LIT() -> int { return 9 }
fn EXPR_STRUCT_LIT() -> int { return 10 }
fn EXPR_STRING() -> int { return 11 }

// Statement node types
fn STMT_LET() -> int { return 20 }
fn STMT_RETURN() -> int { return 21 }
fn STMT_IF() -> int { return 22 }
fn STMT_FOR() -> int { return 23 }
fn STMT_ASSIGN() -> int { return 24 }
fn STMT_EXPR() -> int { return 25 }
fn STMT_BLOCK() -> int { return 26 }
fn STMT_BREAK() -> int { return 27 }

// Declaration node types
fn DECL_FUNC() -> int { return 40 }
fn DECL_STRUCT() -> int { return 41 }
fn DECL_PARAM() -> int { return 42 }
fn DECL_FIELD() -> int { return 43 }
fn DECL_IMPORT() -> int { return 44 }

// Type tags
fn TYPE_UNKNOWN() -> int { return 0 }
fn TYPE_INT() -> int { return 1 }
fn TYPE_BOOL() -> int { return 2 }
fn TYPE_STRING() -> int { return 3 }

// Global storage for function call arguments (workaround for immutability)
// Maps call node index -> argument indices
// Layout: [call_idx1, arg_count1, arg1_idx, arg2_idx, ..., call_idx2, arg_count2, ...]
// TODO: Re-enable when parser supports top-level let
let mut g_call_args = []int{}

fn store_call_args(call_node_idx: int, arg_indices: []int) {
    push(g_call_args, call_node_idx)
    push(g_call_args, len(arg_indices))
    let mut i = 0
    let count = len(arg_indices)
    for i < count {
        push(g_call_args, arg_indices[i])
        i = i + 1
    }
}

fn get_call_args(call_node_idx: int) -> []int {
    // Search for call_node_idx in g_call_args
    let mut i = 0
    for {
        if i >= len(g_call_args) {
            break
        }
        if g_call_args[i] == call_node_idx {
            // Found it - next element is arg_count
            let arg_count = g_call_args[i + 1]
            let mut result = []int{}
            let mut j = 0
            for j < arg_count {
                push(result, g_call_args[i + 2 + j])
                j = j + 1
            }
            return result
        }
        // Skip to next entry: current + 1 (count) + count (args)
        let arg_count = g_call_args[i + 1]
        i = i + 2 + arg_count
    }
    return []int{}
}

// Global storage for struct literal field values
// Maps struct_lit node index -> field value indices
// Layout: same as g_call_args
// TODO: Re-enable when parser supports top-level let
let mut g_struct_fields = []int{}
let mut g_string_vars = []string{}
let mut g_string_array_vars = []string{}
let mut g_string_vars_start = 0
let mut g_string_array_vars_start = 0
let mut g_scalar_globals = []string{}
let mut g_break_label = -1
let mut g_next_label = 100000
let mut g_func_ret_names = []string{}
let mut g_func_ret_types = []int{}
let mut g_func_ret_is_array = []int{}

fn register_func_return_type(name: string, ret_type: int, is_array: int) {
    push(g_func_ret_names, name)
    push(g_func_ret_types, ret_type)
    push(g_func_ret_is_array, is_array)
}

fn lookup_func_return_type(name: string) -> int {
    let mut i = len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_types[i]
        }
        i = i - 1
    }
    return TYPE_UNKNOWN()
}

fn lookup_func_return_is_array(name: string) -> int {
    let mut i = len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_is_array[i]
        }
        i = i - 1
    }
    return 0
}

fn store_struct_fields(struct_node_idx: int, field_indices: []int) {
    push(g_struct_fields, struct_node_idx)
    push(g_struct_fields, len(field_indices))
    let mut i = 0
    let count = len(field_indices)
    for i < count {
        push(g_struct_fields, field_indices[i])
        i = i + 1
    }
}

fn get_struct_fields(struct_node_idx: int) -> []int {
    let mut i = 0
    for {
        if i >= len(g_struct_fields) {
            break
        }
        if g_struct_fields[i] == struct_node_idx {
            let field_count = g_struct_fields[i + 1]
            let mut result = []int{}
            let mut j = 0
            for j < field_count {
                push(result, g_struct_fields[i + 2 + j])
                j = j + 1
            }
            return result
        }
        let field_count = g_struct_fields[i + 1]
        i = i + 2 + field_count
    }
    return []int{}
}

// Helper functions for creating AST nodes
fn new_int_node(val: int, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_INT(),
        int_val: val,
        str_val: "",
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_INT()
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_bool_node(val: int, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_BOOL(),
        int_val: val,
        str_val: "",
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_BOOL()
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_ident_node(name: string, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_IDENT(),
        int_val: 0,
        str_val: name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_binary_node(op: int, left_idx: int, right_idx: int, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_BINARY(),
        int_val: op,
        str_val: "",
        left: left_idx,
        right: right_idx,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_unary_node(op: int, operand: int, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_UNARY(),
        int_val: op,
        str_val: "",
        left: operand,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, node)
    return len(nodes) - 1
}

// Simplified parser using mutable position tracking
// Note: A production compiler would use a proper Parser struct with methods

fn parse_primary(src: string, pos: int, nodes: []AstNode) -> int {
    let kind = lex_kind(src, pos)

    if kind == TK_INT() {
        let val = lex_int_value(src, pos)
        return new_int_node(val, nodes)
    }

    if kind == TK_TRUE() {
        return new_bool_node(1, nodes)
    }

    if kind == TK_FALSE() {
        return new_bool_node(0, nodes)
    }

    if kind == TK_IDENT() {
        let name = lex_string_value(src, pos, kind)
        return new_ident_node(name, nodes)
    }

    if kind == TK_LPAREN() {
        // Parenthesized expression
        let mut new_pos = lex_end(src, pos, kind)
        new_pos = lex_skip(src, new_pos)
        // TODO: recursively parse expression
        return -1
    }

    return -1
}

// ============================================================================
// Parser Helper Structures
// ============================================================================

struct ParseResult {
    node_idx: int,
    new_pos: int,
}

// ============================================================================
// Statement Parser
// ============================================================================

// Parse variable declaration: let [mut] name = expr
fn parse_let_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'let' token
    let mut p = pos
    let kind = lex_kind(src, p)
    if kind != TK_LET() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Check for 'mut'
    let mut is_mut = 0
    let next_kind = lex_kind(src, p)
    if next_kind == TK_MUT() {
        is_mut = 1
        p = lex_end(src, p, next_kind)
        p = lex_skip(src, p)
    }

    // Parse identifier
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let name = lex_string_value(src, p, name_kind)
    let name_node = new_ident_node(name, nodes)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect '='
    let eq_kind = lex_kind(src, p)
    if eq_kind != TK_ASSIGN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, eq_kind)
    p = lex_skip(src, p)

    // Parse initializer expression
    let expr_result = parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let expr_node = expr_result.node_idx
    p = expr_result.new_pos

    // Create let statement node
    // left = name, right = expr, int_val = is_mut
    let stmt = AstNode {
        tag: STMT_LET(),
        int_val: is_mut,
        str_val: name,
        left: name_node,
        right: expr_node,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse return statement: return [expr]
fn parse_if_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'if' token
    let mut p = pos
    let kind = lex_kind(src, p)
    if kind != TK_IF() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Parse condition expression
    let cond_result = parse_expr_with_pos(src, p, nodes)
    if cond_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let cond_node = cond_result.node_idx
    p = cond_result.new_pos
    p = lex_skip(src, p)

    // Parse then block
    let then_result = parse_block(src, p, nodes)
    if then_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let then_node = then_result.node_idx
    p = then_result.new_pos
    p = lex_skip(src, p)

    // Check for else
    let mut else_node = -1
    let next_kind = lex_kind(src, p)
    if next_kind == TK_ELSE() {
        p = lex_end(src, p, next_kind)
        p = lex_skip(src, p)
        // Check for else if
        let else_kind = lex_kind(src, p)
        if else_kind == TK_IF() {
            // else if -> parse as nested if statement
            let else_if_result = parse_if_stmt(src, p, nodes)
            if else_if_result.node_idx >= 0 {
                else_node = else_if_result.node_idx
                p = else_if_result.new_pos
            }
        } else {
            // else { block }
            let else_result = parse_block(src, p, nodes)
            if else_result.node_idx >= 0 {
                else_node = else_result.node_idx
                p = else_result.new_pos
            }
        }
    }

    // Create if statement node
    // left = condition, right = then block, extra = else block
    let stmt = AstNode {
        tag: STMT_IF(),
        int_val: 0,
        str_val: "",
        left: cond_node,
        right: then_node,
        extra: else_node,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

fn parse_for_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'for' token
    let mut p = pos
    let kind = lex_kind(src, p)
    if kind != TK_FOR() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Check for range-based for loop: for i in range { }
    let next_kind = lex_kind(src, p)
    let mut cond_node = -1
    let mut loop_var = ""

    if next_kind == TK_IDENT() {
        // Might be: for i in range or for condition
        let saved_pos = p
        let var_name = lex_string_value(src, p, next_kind)
        p = lex_end(src, p, next_kind)
        p = lex_skip(src, p)

        if lex_kind(src, p) == TK_IN() {
            // It's a range-based for loop: for i in range
            loop_var = var_name
            p = lex_end(src, p, TK_IN())
            p = lex_skip(src, p)

            // Parse range expression
            let range_result = parse_expr_with_pos(src, p, nodes)
            if range_result.node_idx >= 0 {
                cond_node = range_result.node_idx
                p = range_result.new_pos
                p = lex_skip(src, p)
            }
        } else {
            // Not 'in', so restore and parse as condition expression
            p = saved_pos
            let cond_result = parse_expr_with_pos(src, p, nodes)
            if cond_result.node_idx >= 0 {
                cond_node = cond_result.node_idx
                p = cond_result.new_pos
                p = lex_skip(src, p)
            }
        }
    } else if next_kind != TK_LBRACE() {
        // Parse condition expression (not identifier, not lbrace)
        let cond_result = parse_expr_with_pos(src, p, nodes)
        if cond_result.node_idx >= 0 {
            cond_node = cond_result.node_idx
            p = cond_result.new_pos
            p = lex_skip(src, p)
        }
    }

    // Parse body block
    let body_result = parse_block(src, p, nodes)
    if body_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let body_node = body_result.node_idx
    p = body_result.new_pos

    // Create for statement node
    // left = condition/range (-1 for infinite loop), right = body block
    // str_val = loop variable name (for range-based loops)
    let stmt = AstNode {
        tag: STMT_FOR(),
        int_val: 0,
        str_val: loop_var,
        left: cond_node,
        right: body_node,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

fn parse_return_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'return' token
    let mut p = pos
    let kind = lex_kind(src, p)
    if kind != TK_RETURN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Check if there's an expression to return
    let next_kind = lex_kind(src, p)
    let mut expr_node = -1

    // If not EOF, semicolon, or close brace, parse expression
    if next_kind != TK_EOF() && next_kind != TK_SEMI() && next_kind != TK_RBRACE() {
        let expr_result = parse_expr_with_pos(src, p, nodes)
        expr_node = expr_result.node_idx
        p = expr_result.new_pos
    }

    // Create return statement node
    let stmt = AstNode {
        tag: STMT_RETURN(),
        int_val: 0,
        str_val: "",
        left: expr_node,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse assignment: ident = expr
fn parse_assign_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at identifier
    let mut p = pos
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let name = lex_string_value(src, p, name_kind)
    let name_node = new_ident_node(name, nodes)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect '='
    let eq_kind = lex_kind(src, p)
    if eq_kind != TK_ASSIGN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, eq_kind)
    p = lex_skip(src, p)

    // Parse expression
    let expr_result = parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let expr_node = expr_result.node_idx
    p = expr_result.new_pos

    // Create assignment node
    let stmt = AstNode {
        tag: STMT_ASSIGN(),
        int_val: 0,
        str_val: name,
        left: name_node,
        right: expr_node,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse a statement (dispatcher)
fn parse_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)
    let kind = lex_kind(src, p)

    if kind == TK_LET() {
        return parse_let_stmt(src, p, nodes)
    }

    if kind == TK_IF() {
        return parse_if_stmt(src, p, nodes)
    }

    if kind == TK_FOR() {
        return parse_for_stmt(src, p, nodes)
    }

    if kind == TK_RETURN() {
        return parse_return_stmt(src, p, nodes)
    }

    if kind == TK_BREAK() {
        p = lex_end(src, p, kind)
        let stmt = AstNode {
            tag: STMT_BREAK(),
            int_val: 0,
            str_val: "",
            left: -1,
            right: -1,
            extra: -1,
            type_tag: TYPE_UNKNOWN()
        }
        push(nodes, stmt)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }

    if kind == TK_LBRACE() {
        return parse_block(src, p, nodes)
    }

    // Check if it's an assignment (ident followed by =)
    if kind == TK_IDENT() {
        let saved_pos = p
        p = lex_end(src, p, kind)
        p = lex_skip(src, p)
        let next_kind = lex_kind(src, p)
        if next_kind == TK_ASSIGN() {
            return parse_assign_stmt(src, saved_pos, nodes)
        }
        // Not an assignment, restore position and parse as expression statement
        p = saved_pos
    }

    // Expression statement
    let expr_result = parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx >= 0 {
        let stmt = AstNode {
            tag: STMT_EXPR(),
            int_val: 0,
            str_val: "",
            left: expr_result.node_idx,
            right: -1,
            extra: -1,
            type_tag: TYPE_UNKNOWN()
        }
        push(nodes, stmt)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: expr_result.new_pos }
    }

    return ParseResult { node_idx: -1, new_pos: p }
}

// ============================================================================
// Declaration Parser
// ============================================================================

// Parse function parameter: name: type
fn parse_param(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Parse parameter name
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let param_name = lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect ':'
    let colon_kind = lex_kind(src, p)
    if colon_kind != TK_COLON() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, colon_kind)
    p = lex_skip(src, p)

    // Parse type name (simple or array type)
    let mut type_name = ""
    let type_kind = lex_kind(src, p)

    if type_kind == TK_LBRACKET() {
        // Array type: []ElementType
        type_name = "[]"
        p = lex_end(src, p, type_kind)  // Skip '['
        p = lex_skip(src, p)

        // Expect ']'
        if lex_kind(src, p) == TK_RBRACKET() {
            p = lex_end(src, p, TK_RBRACKET())
            p = lex_skip(src, p)
        }

        // Parse element type
        if lex_kind(src, p) == TK_IDENT() {
            let elem_type = lex_string_value(src, p, TK_IDENT())
            type_name = type_name + elem_type
            p = lex_end(src, p, TK_IDENT())
        }
    } else if type_kind == TK_IDENT() {
        // Simple type
        type_name = lex_string_value(src, p, type_kind)
        p = lex_end(src, p, type_kind)
    } else {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    // Create parameter node
    // int_val: 1 = array type, 0 = scalar type
    let mut param_type_tag = TYPE_UNKNOWN()
    let mut param_is_array = 0
    if type_name == "string" { param_type_tag = TYPE_STRING() }
    if type_name == "int" { param_type_tag = TYPE_INT() }
    if type_name == "[]string" { param_type_tag = TYPE_STRING() param_is_array = 1 }
    if type_name == "[]int" { param_type_tag = TYPE_INT() param_is_array = 1 }
    let param = AstNode {
        tag: DECL_PARAM(),
        int_val: param_is_array,
        str_val: param_name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: param_type_tag
    }
    push(nodes, param)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse parameter list: (param1, param2, ...)
fn parse_param_list(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect '('
    let lparen = lex_kind(src, p)
    if lparen != TK_LPAREN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lparen)
    p = lex_skip(src, p)

    // Check for empty parameter list
    let next = lex_kind(src, p)
    if next == TK_RPAREN() {
        p = lex_end(src, p, next)
        return ParseResult { node_idx: -1, new_pos: p }  // No parameters
    }

    // Parse first parameter
    let first_result = parse_param(src, p, nodes)
    if first_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let mut first_param = first_result.node_idx
    p = first_result.new_pos
    p = lex_skip(src, p)

    // Parse remaining parameters
    let mut last_param = first_param
    for {
        let comma = lex_kind(src, p)
        if comma != TK_COMMA() {
            break
        }
        p = lex_end(src, p, comma)
        p = lex_skip(src, p)

        let param_result = parse_param(src, p, nodes)
        if param_result.node_idx < 0 {
            break
        }
        // Link as sibling (would need to update nodes array - simplified for now)
        last_param = param_result.node_idx
        p = param_result.new_pos
        p = lex_skip(src, p)
    }

    // Expect ')'
    let rparen = lex_kind(src, p)
    if rparen != TK_RPAREN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rparen)

    return ParseResult { node_idx: first_param, new_pos: p }
}

// Parse function body: { stmt* }
fn parse_block(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect '{'
    let lbrace = lex_kind(src, p)
    if lbrace != TK_LBRACE() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lbrace)
    p = lex_skip(src, p)

    // Parse statements until '}'
    let mut first_stmt = -1
    let mut last_stmt_idx = -1
    let mut stmt_count = 0
    for {
        let next = lex_kind(src, p)
        if next == TK_RBRACE() || next == TK_EOF() {
            break
        }

        let stmt_result = parse_stmt(src, p, nodes)
        if stmt_result.node_idx < 0 {
            print("PARSE_BLOCK: stmt failed at pos ")
            print(strconv.Itoa(p))
            print(", token=")
            print(strconv.Itoa(lex_kind(src, p)))
            print(", stmts_so_far=")
            print(strconv.Itoa(stmt_count))
            print(", nodes=")
            print(strconv.Itoa(len(nodes)))
            print(", context=")
            let mut ctx_e = p + 60
            if ctx_e > len(src) { ctx_e = len(src) }
            print(str_substring(src, p, ctx_e))
            print("\n")
            break
        }
        stmt_count = stmt_count + 1

        if first_stmt < 0 {
            first_stmt = stmt_result.node_idx
        } else {
            // Link previous statement to this one via extra field
            // TODO: Cannot mutate array elements in Ease yet
            // if last_stmt_idx >= 0 {
            //     nodes[last_stmt_idx].extra = stmt_result.node_idx
            // }
        }
        last_stmt_idx = stmt_result.node_idx
        p = stmt_result.new_pos
        p = lex_skip(src, p)

        // Skip optional semicolon
        let semi = lex_kind(src, p)
        if semi == TK_SEMI() {
            p = lex_end(src, p, semi)
            p = lex_skip(src, p)
        }
    }

    // Expect '}'
    let rbrace = lex_kind(src, p)
    if rbrace != TK_RBRACE() {
        print("PARSE_BLOCK: expected RBRACE at pos ")
        print(strconv.Itoa(p))
        print(", got token=")
        print(strconv.Itoa(rbrace))
        print(", stmt_count=")
        print(strconv.Itoa(stmt_count))
        print(", context=")
        let mut ctx_e2 = p + 60
        if ctx_e2 > len(src) { ctx_e2 = len(src) }
        print(str_substring(src, p, ctx_e2))
        print("\n")
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rbrace)

    // Create block node
    // left = first statement index
    // right = last statement index (for multi-statement support)
    let block = AstNode {
        tag: STMT_BLOCK(),
        int_val: 0,
        str_val: "",
        left: first_stmt,
        right: last_stmt_idx,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, block)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse import declaration: import ("path")
fn parse_import_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect 'import'
    let import_kind = lex_kind(src, p)
    if import_kind != TK_IMPORT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, import_kind)
    p = lex_skip(src, p)

    // Expect '('
    if lex_kind(src, p) != TK_LPAREN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, TK_LPAREN())
    p = lex_skip(src, p)

    // Parse one or more import paths (string literals)
    // For now, we only use the first path (multi-import support limited)
    let mut import_path = ""
    let mut first_import = 1
    for {
        let path_kind = lex_kind(src, p)
        if path_kind == TK_RPAREN() {
            break
        }
        if path_kind != TK_STRING() {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        // Save only the first import path
        if first_import == 1 {
            import_path = lex_string_value(src, p, path_kind)
            first_import = 0
        }
        p = lex_end(src, p, path_kind)
        p = lex_skip(src, p)
    }

    // Expect ')'
    if lex_kind(src, p) != TK_RPAREN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, TK_RPAREN())

    // Create import declaration node
    // str_val = import path
    let import_node = AstNode {
        tag: DECL_IMPORT(),
        int_val: 0,
        str_val: import_path,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, import_node)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse function declaration: fn name(params) -> type { body }
fn parse_func_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect 'fn'
    let fn_kind = lex_kind(src, p)
    if fn_kind != TK_FN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, fn_kind)
    p = lex_skip(src, p)

    // Parse function name
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let func_name = lex_string_value(src, p, name_kind)
    print(func_name)
    print("\n")
    p = lex_end(src, p, name_kind)

    // Parse parameter list
    let params_result = parse_param_list(src, p, nodes)
    p = params_result.new_pos
    p = lex_skip(src, p)

    // Check for '->' (return type is optional)
    let mut ret_type = ""
    let arrow = lex_kind(src, p)
    if arrow == TK_ARROW() {
        p = lex_end(src, p, arrow)
        p = lex_skip(src, p)

        // Parse return type (simple or array type)
        let ret_type_kind = lex_kind(src, p)

        if ret_type_kind == TK_LBRACKET() {
            // Array type: []ElementType
            ret_type = "[]"
            p = lex_end(src, p, ret_type_kind)  // Skip '['
            p = lex_skip(src, p)

            // Expect ']'
            if lex_kind(src, p) == TK_RBRACKET() {
                p = lex_end(src, p, TK_RBRACKET())
                p = lex_skip(src, p)
            }

            // Parse element type
            if lex_kind(src, p) == TK_IDENT() {
                let elem_type = lex_string_value(src, p, TK_IDENT())
                ret_type = ret_type + elem_type
                p = lex_end(src, p, TK_IDENT())
            }
        } else if ret_type_kind == TK_IDENT() {
            // Simple type
            ret_type = lex_string_value(src, p, ret_type_kind)
            p = lex_end(src, p, ret_type_kind)
        } else {
            return ParseResult { node_idx: -1, new_pos: p }
        }
    }

    // Parse body
    let body_result = parse_block(src, p, nodes)
    if body_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    // Create function declaration node
    // str_val = function name
    // left = parameters (first param node)
    // right = body (block node)
    // type_tag = return type, int_val = is_array_return flag
    let mut ret_type_tag = TYPE_UNKNOWN()
    let mut ret_is_array = 0
    if ret_type == "int" { ret_type_tag = TYPE_INT() }
    if ret_type == "string" { ret_type_tag = TYPE_STRING() }
    if ret_type == "bool" { ret_type_tag = TYPE_BOOL() }
    if ret_type == "[]int" { ret_type_tag = TYPE_INT()
        ret_is_array = 1
    }
    if ret_type == "[]string" { ret_type_tag = TYPE_STRING()
        ret_is_array = 1
    }

    let func = AstNode {
        tag: DECL_FUNC(),
        int_val: ret_is_array,
        str_val: func_name,
        left: params_result.node_idx,
        right: body_result.node_idx,
        extra: -1,
        type_tag: ret_type_tag
    }
    push(nodes, func)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: body_result.new_pos }
}

// Parse struct field: name: type
fn parse_field(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Parse field name
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let field_name = lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect ':'
    let colon = lex_kind(src, p)
    if colon != TK_COLON() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, colon)
    p = lex_skip(src, p)

    // Parse type (including array types like []int or []string)
    let type_kind = lex_kind(src, p)
    let mut type_name = ""

    if type_kind == TK_LBRACKET() {
        // Array type: []ElementType
        type_name = "[]"
        p = lex_end(src, p, TK_LBRACKET())
        p = lex_skip(src, p)

        if lex_kind(src, p) == TK_RBRACKET() {
            p = lex_end(src, p, TK_RBRACKET())
            p = lex_skip(src, p)
        }

        if lex_kind(src, p) == TK_IDENT() {
            let elem_type = lex_string_value(src, p, TK_IDENT())
            type_name = type_name + elem_type
            p = lex_end(src, p, TK_IDENT())
        }
    } else if type_kind == TK_IDENT() {
        type_name = lex_string_value(src, p, type_kind)
        p = lex_end(src, p, type_kind)
    } else {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    p = lex_skip(src, p)

    // Skip optional comma
    let comma = lex_kind(src, p)
    if comma == TK_COMMA() {
        p = lex_end(src, p, comma)
    }

    // Create field node
    let field = AstNode {
        tag: DECL_FIELD(),
        int_val: 0,
        str_val: field_name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, field)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse struct declaration: struct Name { fields }
fn parse_struct_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect 'struct'
    let struct_kind = lex_kind(src, p)
    if struct_kind != TK_STRUCT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, struct_kind)
    p = lex_skip(src, p)

    // Parse struct name
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let struct_name = lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect '{'
    let lbrace = lex_kind(src, p)
    if lbrace != TK_LBRACE() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lbrace)
    p = lex_skip(src, p)

    // Parse fields
    let mut first_field = -1
    for {
        let next = lex_kind(src, p)
        if next == TK_RBRACE() || next == TK_EOF() {
            break
        }

        let field_result = parse_field(src, p, nodes)
        if field_result.node_idx < 0 {
            break
        }

        if first_field < 0 {
            first_field = field_result.node_idx
        }
        p = field_result.new_pos
        p = lex_skip(src, p)
    }

    // Expect '}'
    let rbrace = lex_kind(src, p)
    if rbrace != TK_RBRACE() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rbrace)

    // Create struct declaration node
    let struct_decl = AstNode {
        tag: DECL_STRUCT(),
        int_val: 0,
        str_val: struct_name,
        left: first_field,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, struct_decl)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// ============================================================================
// Expression Parser
// ============================================================================

// Parse atom (literal or identifier - no parentheses yet)
fn parse_atom(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)
    let kind = lex_kind(src, p)

    if kind == TK_INT() {
        let val = lex_int_value(src, p)
        let node = new_int_node(val, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == TK_TRUE() {
        let node = new_bool_node(1, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == TK_FALSE() {
        let node = new_bool_node(0, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == TK_STRING() {
        let val = lex_string_value(src, p, kind)
        let node = AstNode {
            tag: EXPR_STRING(),
            int_val: 0,
            str_val: val,
            left: -1,
            right: -1,
            extra: -1,
            type_tag: TYPE_UNKNOWN()
        }
        push(nodes, node)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }
    if kind == TK_IDENT() {
        let name = lex_string_value(src, p, kind)
        let node = new_ident_node(name, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == TK_LBRACKET() {
        // Array literal: []Type{elem1, elem2, ...}
        // For bootstrap: simplified to []int{...}
        p = lex_end(src, p, kind)  // Skip '['
        p = lex_skip(src, p)

        // Expect ']'
        if lex_kind(src, p) != TK_RBRACKET() {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, TK_RBRACKET())
        p = lex_skip(src, p)

        // Parse element type name
        let mut elem_type_name = "int"
        if lex_kind(src, p) == TK_IDENT() {
            elem_type_name = lex_string_value(src, p, TK_IDENT())
            p = lex_end(src, p, TK_IDENT())
            p = lex_skip(src, p)
        }

        // Expect '{'
        if lex_kind(src, p) != TK_LBRACE() {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, TK_LBRACE())
        p = lex_skip(src, p)

        // Parse elements
        let mut elem_count = 0
        let mut first_elem_idx = -1

        for {
            p = lex_skip(src, p)
            if lex_kind(src, p) == TK_RBRACE() {
                break
            }

            // Parse element expression
            let elem_result = parse_expr_with_pos(src, p, nodes)
            if elem_result.node_idx < 0 {
                break
            }

            if elem_count == 0 {
                first_elem_idx = elem_result.node_idx
            }
            elem_count = elem_count + 1

            p = elem_result.new_pos
            p = lex_skip(src, p)

            // Check for comma
            if lex_kind(src, p) == TK_COMMA() {
                p = lex_end(src, p, TK_COMMA())
                p = lex_skip(src, p)
            } else {
                break
            }
        }

        // Expect '}'
        if lex_kind(src, p) != TK_RBRACE() {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, TK_RBRACE())

        // Create array literal node
        let array_node = AstNode {
            tag: EXPR_ARRAY_LIT(),
            int_val: elem_count,
            str_val: elem_type_name,  // element type
            left: -1,
            right: first_elem_idx,
            extra: -1,
            type_tag: TYPE_UNKNOWN()
        }
        push(nodes, array_node)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }

    return ParseResult { node_idx: -1, new_pos: p }
}

// Parse multiplicative: * /
// Parse unary: - !
fn parse_unary(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let pos = lex_skip(src, start_pos)
    let kind = lex_kind(src, pos)

    if kind == TK_MINUS() {
        let mut new_pos = lex_end(src, pos, kind)
        let operand_result = parse_unary(src, new_pos, nodes)
        if operand_result.node_idx < 0 {
            return operand_result
        }
        let unary_idx = new_unary_node(kind, operand_result.node_idx, nodes)
        return ParseResult { node_idx: unary_idx, new_pos: operand_result.new_pos }
    }

    return parse_primary_expr(src, start_pos, nodes)
}

fn parse_multiplicative(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_unary(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_STAR() && op != TK_SLASH() && op != TK_PERCENT() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_unary(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse additive: + -
fn parse_additive(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_multiplicative(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_PLUS() && op != TK_MINUS() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_multiplicative(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse comparison: < > <= >=
fn parse_comparison(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_additive(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    pos = lex_skip(src, pos)
    let op = lex_kind(src, pos)
    if op == TK_LT() || op == TK_GT() || op == TK_LE() || op == TK_GE() ||
       op == TK_EQ() || op == TK_NE() {
        pos = lex_end(src, pos, op)
        let right_result = parse_additive(src, pos, nodes)
        if right_result.node_idx >= 0 {
            left = new_binary_node(op, left, right_result.node_idx, nodes)
            pos = right_result.new_pos
        }
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse XOR: ^
// Parse bitwise AND: &
fn parse_bitand(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_comparison(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_AMPERSAND() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_comparison(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse XOR: ^
fn parse_xor(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_bitand(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_CARET() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_bitand(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse bitwise OR: |
fn parse_bitor(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_xor(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_PIPE() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_xor(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse logical AND: &&
fn parse_logical_and(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_bitor(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_AND() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_bitor(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse logical OR: || (top level)
fn parse_expr_with_pos(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_logical_and(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_OR() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_logical_and(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse primary with parentheses support (defined after parse_expr_with_pos)
fn parse_primary_expr(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)
    let kind = lex_kind(src, p)

    // Check for parenthesized expression first
    if kind == TK_LPAREN() {
        p = lex_end(src, p, kind)  // Skip '('
        // Recursively parse the full expression inside parentheses
        let expr_result = parse_expr_with_pos(src, p, nodes)
        if expr_result.node_idx < 0 {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = expr_result.new_pos
        p = lex_skip(src, p)
        let rparen = lex_kind(src, p)
        if rparen != TK_RPAREN() {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, rparen)  // Skip ')'
        return ParseResult { node_idx: expr_result.node_idx, new_pos: p }
    }

    // Otherwise, parse atom (literal or identifier)
    let atom_result = parse_atom(src, pos, nodes)
    if atom_result.node_idx < 0 {
        return atom_result
    }

    // Handle postfix operators (function calls, array indexing, field access) in a loop for chaining
    let mut current_node = atom_result.node_idx
    p = atom_result.new_pos

    for {
        p = lex_skip(src, p)
        let next_kind = lex_kind(src, p)

        if next_kind == TK_LPAREN() {
            // It's a function call
            let func_name_node = current_node
            p = lex_end(src, p, next_kind)  // Skip '('
            p = lex_skip(src, p)

            // Parse arguments
            let mut first_arg = -1
            let mut arg_indices = []int{}

            // Check if there are any arguments
            if lex_kind(src, p) != TK_RPAREN() {
                for {
                    let arg_result = parse_expr_with_pos(src, p, nodes)
                    if arg_result.node_idx < 0 {
                        break
                    }

                    if first_arg < 0 {
                        first_arg = arg_result.node_idx
                    }
                    push(arg_indices, arg_result.node_idx)

                    p = arg_result.new_pos
                    p = lex_skip(src, p)

                    // Check for comma
                    if lex_kind(src, p) == TK_COMMA() {
                        p = lex_end(src, p, TK_COMMA())
                        p = lex_skip(src, p)
                    } else {
                        break
                    }
                }
            }

            // Expect ')'
            p = lex_skip(src, p)
            if lex_kind(src, p) != TK_RPAREN() {
                return ParseResult { node_idx: -1, new_pos: p }
            }
            p = lex_end(src, p, TK_RPAREN())

            // Create call expression node
            // left = function name node, right = first argument, int_val = arg count
            let func_name = nodes[func_name_node].str_val
            let call_node = AstNode {
                tag: EXPR_CALL(),
                int_val: len(arg_indices),
                str_val: func_name,
                left: func_name_node,
                right: first_arg,
                extra: -1,
                type_tag: TYPE_UNKNOWN()
            }
            push(nodes, call_node)
            current_node = len(nodes) - 1

            // Store argument indices for this call node
            store_call_args(current_node, arg_indices)
            // Continue to check for more postfix operators
        } else {
            // Note: Struct literals (StructName { field: value }) are currently NOT parsed
            // as postfix operators due to ambiguity with statement blocks. For now, struct
            // literals must be parsed as primary expressions or handled separately.
            if next_kind == TK_LBRACE() && nodes[current_node].tag == EXPR_IDENT() {
                // Struct literal: StructName { field1: value1, field2: value2 }
                // Only parse if identifier starts with uppercase (struct names are capitalized)
                let struct_name_node = current_node
                let struct_name = nodes[struct_name_node].str_val

                // Check if first character is uppercase (65-90 = A-Z)
                let mut is_uppercase = 0
                if len(struct_name) > 0 {
                    let first_char = str_char_at(struct_name, 0)
                    if first_char >= 65 && first_char <= 90 {
                        is_uppercase = 1
                    }
                }

                if is_uppercase == 0 {
                    // Not a struct literal, continue
                    break
                }
                p = lex_end(src, p, next_kind)  // Skip '{'
                p = lex_skip(src, p)

                // Parse field initializers (simplified - just count them for now)
                let mut first_field_idx = -1
                let mut field_value_indices = []int{}

                for {
                    p = lex_skip(src, p)
                    if lex_kind(src, p) == TK_RBRACE() {
                        break
                    }

                    // Parse field name
                    if lex_kind(src, p) != TK_IDENT() {
                        break
                    }
                    let field_name = lex_string_value(src, p, TK_IDENT())
                    p = lex_end(src, p, TK_IDENT())
                    p = lex_skip(src, p)

                    // Expect ':'
                    if lex_kind(src, p) != TK_COLON() {
                        break
                    }
                    p = lex_end(src, p, TK_COLON())
                    p = lex_skip(src, p)

                    // Parse field value expression
                    let value_result = parse_expr_with_pos(src, p, nodes)
                    if value_result.node_idx < 0 {
                        break
                    }

                    if first_field_idx < 0 {
                        first_field_idx = value_result.node_idx
                    }
                    push(field_value_indices, value_result.node_idx)

                    p = value_result.new_pos
                    p = lex_skip(src, p)

                    // Check for comma
                    if lex_kind(src, p) == TK_COMMA() {
                        p = lex_end(src, p, TK_COMMA())
                        p = lex_skip(src, p)
                    } else {
                        break
                    }
                }

                // Expect '}'
                if lex_kind(src, p) != TK_RBRACE() {
                    return ParseResult { node_idx: -1, new_pos: p }
                }
                p = lex_end(src, p, TK_RBRACE())

                // Create struct literal node
                let struct_lit_node = AstNode {
                    tag: EXPR_STRUCT_LIT(),
                    int_val: len(field_value_indices),
                    str_val: struct_name,
                    left: struct_name_node,
                    right: first_field_idx,
                    extra: -1,
                    type_tag: TYPE_UNKNOWN()
                }
                push(nodes, struct_lit_node)
                current_node = len(nodes) - 1

                // Store field value indices for this struct literal
                store_struct_fields(current_node, field_value_indices)
                // Continue to check for more postfix operators
            } else {
                if next_kind == TK_LBRACKET() {
                    // Array indexing
                    let array_node = current_node
                    p = lex_end(src, p, next_kind)  // Skip '['
                    p = lex_skip(src, p)

                    // Parse index expression
                    let index_result = parse_expr_with_pos(src, p, nodes)
                    if index_result.node_idx < 0 {
                        return ParseResult { node_idx: -1, new_pos: p }
                    }
                    p = index_result.new_pos
                    p = lex_skip(src, p)

                    // Expect ']'
                    if lex_kind(src, p) != TK_RBRACKET() {
                        return ParseResult { node_idx: -1, new_pos: p }
                    }
                    p = lex_end(src, p, TK_RBRACKET())

                    // Create array index node
                    // left = array expression, right = index expression
                    let index_node = AstNode {
                        tag: EXPR_INDEX(),
                        int_val: 0,
                        str_val: "",
                        left: array_node,
                        right: index_result.node_idx,
                        extra: -1,
                        type_tag: TYPE_UNKNOWN()
                    }
                    push(nodes, index_node)
                    current_node = len(nodes) - 1
                    // Continue to check for more postfix operators
                } else {
                    if next_kind == TK_DOT() {
                        // Field access
                        let base_node = current_node
                        p = lex_end(src, p, next_kind)  // Skip '.'
                        p = lex_skip(src, p)

                        // Parse field name
                        let field_kind = lex_kind(src, p)
                        if field_kind != TK_IDENT() {
                            return ParseResult { node_idx: -1, new_pos: p }
                        }
                        let field_name = lex_string_value(src, p, field_kind)
                        p = lex_end(src, p, field_kind)

                        // Create field access node
                        // left = base expression, str_val = field name
                        let field_node = AstNode {
                            tag: EXPR_FIELD(),
                            int_val: 0,
                            str_val: field_name,
                            left: base_node,
                            right: -1,
                            extra: -1,
                            type_tag: TYPE_UNKNOWN()
                        }
                        push(nodes, field_node)
                        current_node = len(nodes) - 1
                        // Continue to check for more postfix operators
                    } else {
                        // No more postfix operators, break the loop
                        break
                    }
                }
            }
        }
    }

    return ParseResult { node_idx: current_node, new_pos: p }
}

// Wrapper for backward compatibility
fn parse_expr_simple(src: string, nodes: []AstNode) -> int {
    let result = parse_expr_with_pos(src, 0, nodes)
    return result.node_idx
}

// ============================================================================
// Symbol Table for Variables (with Type Tracking)
// ============================================================================

struct SymbolTable {
    names: []string,  // Variable names
    vregs: []int,     // Corresponding virtual registers
    types: []int,     // Type tags (TYPE_INT, TYPE_BOOL, etc.)
}

fn symtab_new() -> SymbolTable {
    return SymbolTable {
        names: []string{},
        vregs: []int{}
    }
}

fn symtab_add(st: SymbolTable, name: string, vreg: int) {
    push(st.names, name)
    push(st.vregs, vreg)
}

fn symtab_lookup(st: SymbolTable, name: string) -> int {
    // Search backwards to find the most recent binding (handles shadowing)
    let mut i = len(st.names) - 1
    for i >= 0 {
        if st.names[i] == name {
            return st.vregs[i]
        }
        i = i - 1
    }
    return -1  // Not found
}

// ============================================================================
// Simplified IR Generator (from ir.ease)
// ============================================================================

struct IRInstr {
    op: int,       // Instruction opcode
    dest: int,     // Destination vreg or label id
    arg1: int,     // First argument vreg or immediate
    arg2: int,     // Second argument vreg or label id
    arg3: int,     // Third argument vreg (for operations like str_substring)
    str_val: string, // For function names, variable names, etc.
}

// IR Opcodes
fn OP_LOADCONST() -> int { return 1 }
fn OP_ADD() -> int { return 2 }
fn OP_SUB() -> int { return 3 }
fn OP_MUL() -> int { return 4 }
fn OP_DIV() -> int { return 5 }
fn OP_CMP_LT() -> int { return 6 }
fn OP_CMP_GT() -> int { return 7 }
fn OP_CMP_LE() -> int { return 8 }
fn OP_CMP_GE() -> int { return 9 }
fn OP_CMP_EQ() -> int { return 10 }
fn OP_CMP_NE() -> int { return 11 }
fn OP_AND() -> int { return 12 }
fn OP_OR() -> int { return 13 }
fn OP_NOT() -> int { return 14 }
fn OP_XOR() -> int { return 15 }
fn OP_BITAND() -> int { return 16 }
fn OP_BITOR() -> int { return 17 }
fn OP_ALLOCA() -> int { return 20 }
fn OP_STORE() -> int { return 21 }
fn OP_LOAD() -> int { return 22 }
fn OP_INDEXADDR() -> int { return 23 }  // Pointer arithmetic: base + offset
fn OP_MEMCOPY() -> int { return 24 }    // Memory copy: src, dest, size
fn OP_ARRAY_PUSH() -> int { return 25 } // Array push: array, elem, elem_size
fn OP_ARRAY_LEN() -> int { return 26 }  // Array length: returns len from fat pointer
fn OP_STR_CHAR_AT() -> int { return 27 } // String char at: str, index -> char (int)
fn OP_STR_SUBSTRING() -> int { return 28 } // String substring: str, start, end -> str
fn OP_POKE() -> int { return 29 }  // Write byte to memory: addr, value
fn OP_RET() -> int { return 30 }
fn OP_PEEK() -> int { return 31 }  // Read byte from memory: addr -> value
fn OP_HEAP_ALLOC() -> int { return 32 }  // Allocate memory: size -> pointer

// Struct definitions and offsets (hardcoded for known structs)
// AstNode: tag(8), int_val(8), str_val(8), left(8), right(8), extra(8), type_tag(8) = 56 bytes
// IRInstr: op(8), dest(8), arg1(8), arg2(8), arg3(8), str_val(8) = 48 bytes
// ParseResult: node_idx(8), new_pos(8) = 16 bytes

fn struct_size(struct_name: string) -> int {
    if struct_name == "AstNode" { return 56 }
    if struct_name == "IRInstr" { return 48 }
    if struct_name == "ParseResult" { return 16 }
    return 64  // Default: 8 fields * 8 bytes
}

fn field_offset(struct_name: string, field_name: string) -> int {
    // AstNode fields
    if struct_name == "AstNode" {
        if field_name == "tag" { return 0 }
        if field_name == "int_val" { return 8 }
        if field_name == "str_val" { return 16 }
        if field_name == "left" { return 24 }
        if field_name == "right" { return 32 }
        if field_name == "extra" { return 40 }
        if field_name == "type_tag" { return 48 }
    }
    // IRInstr fields
    if struct_name == "IRInstr" {
        if field_name == "op" { return 0 }
        if field_name == "dest" { return 8 }
        if field_name == "arg1" { return 16 }
        if field_name == "arg2" { return 24 }
        if field_name == "arg3" { return 32 }
        if field_name == "str_val" { return 40 }
    }
    // ParseResult fields
    if struct_name == "ParseResult" {
        if field_name == "node_idx" { return 0 }
        if field_name == "new_pos" { return 8 }
    }
    return 0  // Unknown field, return 0
}
fn OP_CALL() -> int { return 33 }
fn OP_ARG() -> int { return 34 }
fn OP_READFILE() -> int { return 35 }  // Read file: path -> content string
fn OP_ARGC() -> int { return 36 }     // Get argument count -> int
fn OP_ARGV() -> int { return 37 }     // Get argument at index: index -> string
fn OP_INT_TO_STR() -> int { return 38 } // Convert int to string: int -> string
fn OP_PRINT() -> int { return 39 } // Print string to stdout: string -> ()
fn OP_LABEL() -> int { return 40 }
fn OP_JUMP() -> int { return 41 }
fn OP_BRANCH() -> int { return 42 }
fn OP_SYSCALL_OPEN() -> int { return 43 }
fn OP_SYSCALL_WRITE() -> int { return 44 }
fn OP_SYSCALL_CLOSE() -> int { return 45 }
fn OP_STR_EQ() -> int { return 46 }
fn OP_STR_NE() -> int { return 47 }
fn OP_STR_CONCAT() -> int { return 48 }
fn OP_COPY() -> int { return 49 }
fn OP_LOAD_GLOBAL() -> int { return 50 }
fn OP_STR_LEN() -> int { return 51 }

fn is_scalar_global(name: string) -> int {
    let mut i = 0
    for i < len(g_scalar_globals) {
        if g_scalar_globals[i] == name { return 1 }
        i = i + 1
    }
    return 0
}

// Helper: check if an AST expression produces a string value
fn is_string_expr(idx: int, nodes: []AstNode) -> int {
    if idx < 0 { return 0 }
    let node = nodes[idx]
    if node.tag == EXPR_STRING() { return 1 }
    if node.tag == EXPR_IDENT() {
        // Check if this variable was tracked as holding a string (current function scope only)
        let mut si = g_string_vars_start
        let slen = len(g_string_vars)
        for si < slen {
            if g_string_vars[si] == node.str_val { return 1 }
            si = si + 1
        }
        return 0
    }
    if node.tag == EXPR_CALL() {
        let ret_type = lookup_func_return_type(node.str_val)
        if ret_type == TYPE_STRING() {
            if lookup_func_return_is_array(node.str_val) == 0 {
                return 1
            }
        }
        return 0
    }
    if node.tag == EXPR_FIELD() {
        // Field access: check if the field name is known to be a string
        if node.str_val == "str_val" { return 1 }
        return 0
    }
    if node.tag == EXPR_INDEX() {
        // Array indexing: check if base array is a known string array (current function scope only)
        let base = nodes[node.left]
        if base.tag == EXPR_IDENT() {
            let mut sai = g_string_array_vars_start
            for sai < len(g_string_array_vars) {
                if g_string_array_vars[sai] == base.str_val { return 1 }
                sai = sai + 1
            }
        }
        return 0
    }
    // NOTE: EXPR_ARRAY_LIT is NOT a string - it's an array.
    // []string{} is a string ARRAY, not a string value.
    // String array detection is in is_string_array_expr.
    if node.tag == EXPR_BINARY() {
        if node.int_val == TK_PLUS() {
            if is_string_expr(node.left, nodes) == 1 { return 1 }
            if is_string_expr(node.right, nodes) == 1 { return 1 }
        }
        return 0
    }
    return 0
}

fn is_string_array_expr(idx: int, nodes: []AstNode) -> int {
    if idx < 0 { return 0 }
    let node = nodes[idx]
    if node.tag == EXPR_ARRAY_LIT() {
        if node.str_val == "string" { return 1 }
        return 0
    }
    if node.tag == EXPR_IDENT() {
        let mut i = g_string_array_vars_start
        for i < len(g_string_array_vars) {
            if g_string_array_vars[i] == node.str_val { return 1 }
            i = i + 1
        }
        return 0
    }
    if node.tag == EXPR_CALL() {
        let ret_type = lookup_func_return_type(node.str_val)
        if ret_type == TYPE_STRING() && lookup_func_return_is_array(node.str_val) == 1 {
            return 1
        }
        return 0
    }
    return 0
}

// Helper: Generate IR for len() builtin
fn gen_ir_call_len(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    let arg_indices = get_call_args(ast_idx)
    if len(arg_indices) != 1 {
        return -1
    }
    let array_vreg = gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    let result_vreg = len(instrs)
    let mut op = OP_ARRAY_LEN()
    if is_string_expr(arg_indices[0], nodes) == 1 {
        op = OP_STR_LEN()
    }
    let len_instr = IRInstr { op: op, dest: result_vreg, arg1: array_vreg, arg2: 0, arg3: 0, str_val: "" }
    push(instrs, len_instr)
    return result_vreg
}

// Helper: Generate IR for push() builtin
fn gen_ir_call_push(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    let arg_indices = get_call_args(ast_idx)
    if len(arg_indices) != 2 {
        return -1
    }
    let array_vreg = gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    let elem_vreg = gen_ir_from_ast_with_symtab(arg_indices[1], nodes, instrs, symtab_names, symtab_vregs)
    let push_instr = IRInstr { op: OP_ARRAY_PUSH(), dest: -1, arg1: array_vreg, arg2: elem_vreg, arg3: 0, str_val: "" }
    push(instrs, push_instr)
    return array_vreg
}

// Helper: Generate IR for poke() builtin
fn gen_ir_call_poke(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    let arg_indices = get_call_args(ast_idx)
    if len(arg_indices) != 2 {
        return -1
    }
    let addr_vreg = gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    let value_vreg = gen_ir_from_ast_with_symtab(arg_indices[1], nodes, instrs, symtab_names, symtab_vregs)
    let poke_instr = IRInstr { op: OP_POKE(), dest: -1, arg1: addr_vreg, arg2: value_vreg, arg3: 0, str_val: "" }
    push(instrs, poke_instr)
    return -1  // poke returns nothing
}

// Helper: Generate IR for peek() builtin
fn gen_ir_call_peek(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    let arg_indices = get_call_args(ast_idx)
