fn main() -> int {
    print("=== Bootstrap Ease Compiler ===\n\n")

    // Get command-line arguments
    let argc = os.Argc()
    let mut source = ""

    if argc > 1 {
        // Read source from file
        let filename = os.Argv(1)
        print("Reading file: ")
        print(filename)
        print("\n")

        source = os.ReadFile(filename)
        print("File loaded successfully\n\n")
    } else {
        // Fall back to hardcoded test for demo
        source = "fn add(x: int, y: int) -> int { return x + y } fn main() -> int { let p = ParseResult { node_idx: 5, new_pos: 10 } let mut arr = []int{1, 2} push(arr, p.node_idx) return add(len(arr), p.new_pos) }"
        print("No file specified, using test program\n")
        print("Compiling: ")
        print(source)
        print("\n\n")
    }

    // Phase 1: Lexing
    print("Phase 1: Lexing\n")
    print("Tokens: ")
    let mut pos = 0
    for {
        pos = lex_skip(source, pos)
        let kind = lex_kind(source, pos)
        if kind == TK_INT() {
            print("INT(")
            print(strconv.Itoa(lex_int_value(source, pos)))
            print(") ")
        }
        if kind == TK_STRING() {
            print("STRING(")
            print(lex_string_value(source, pos, kind))
            print(") ")
        }
        if kind == TK_IDENT() {
            print("IDENT(")
            print(lex_string_value(source, pos, kind))
            print(") ")
        }
        if kind == TK_FN() { print("FN ") }
        if kind == TK_LET() { print("LET ") }
        if kind == TK_MUT() { print("MUT ") }
        if kind == TK_IF() { print("IF ") }
        if kind == TK_ELSE() { print("ELSE ") }
        if kind == TK_FOR() { print("FOR ") }
        if kind == TK_IN() { print("IN ") }
        if kind == TK_RETURN() { print("RETURN ") }
        if kind == TK_STRUCT() { print("STRUCT ") }
        if kind == TK_IMPORT() { print("IMPORT ") }
        if kind == TK_ASSIGN() { print("ASSIGN ") }
        if kind == TK_ARROW() { print("ARROW ") }
        if kind == TK_LBRACE() { print("LBRACE ") }
        if kind == TK_RBRACE() { print("RBRACE ") }
        if kind == TK_LBRACKET() { print("LBRACKET ") }
        if kind == TK_RBRACKET() { print("RBRACKET ") }
        if kind == TK_COLON() { print("COLON ") }
        if kind == TK_PLUS() { print("PLUS ") }
        if kind == TK_MINUS() { print("MINUS ") }
        if kind == TK_STAR() { print("STAR ") }
        if kind == TK_SLASH() { print("SLASH ") }
        if kind == TK_LPAREN() { print("LPAREN ") }
        if kind == TK_RPAREN() { print("RPAREN ") }
        if kind == TK_COMMA() { print("COMMA ") }
        if kind == TK_DOT() { print("DOT ") }
        if kind == TK_LT() { print("LT ") }
        if kind == TK_GT() { print("GT ") }
        if kind == TK_LE() { print("LE ") }
        if kind == TK_GE() { print("GE ") }
        if kind == TK_EQ() { print("EQ ") }
        if kind == TK_NE() { print("NE ") }
        if kind == TK_AND() { print("AND ") }
        if kind == TK_OR() { print("OR ") }
        if kind == TK_TRUE() { print("TRUE ") }
        if kind == TK_FALSE() { print("FALSE ") }
        pos = lex_end(source, pos, kind)
        if kind == TK_EOF() { break }
    }
    print("\n\n")

    // Phase 2: Parsing (Multiple Functions)
    print("Phase 2: Parsing\n")
    let mut nodes = []AstNode{}
    let mut func_names = []string{}
    let mut func_indices = []int{}

    // Parse all top-level declarations (imports, structs, and functions)
    let mut parse_pos = 0
    let mut import_count = 0
    let mut struct_count = 0
    for {
        parse_pos = lex_skip(source, parse_pos)
        let kind = lex_kind(source, parse_pos)
        print(strconv.Itoa(kind))
        print(", pos: ")
        print(strconv.Itoa(parse_pos))
        print("\n")
        if kind == TK_EOF() {
            break
        }

        // Try parsing import first
        if kind == TK_IMPORT() {
            let import_result = parse_import_decl(source, parse_pos, nodes)
            if import_result.node_idx >= 0 {
                import_count = import_count + 1
                parse_pos = import_result.new_pos
                parse_pos = lex_skip(source, parse_pos)
            } else {
                break
            }
        } else if kind == TK_STRUCT() {
            // Parse struct declaration
            let struct_result = parse_struct_decl(source, parse_pos, nodes)
            if struct_result.node_idx >= 0 {
                // Struct parsed successfully, continue to next declaration
                struct_count = struct_count + 1
                parse_pos = struct_result.new_pos
                parse_pos = lex_skip(source, parse_pos)
            } else {
                break
            }
        } else if kind == TK_LET() {
            // Top-level global variable declaration
            // Parse it as a statement and store in AST
            let global_result = parse_let_stmt(source, parse_pos, nodes)
            if global_result.node_idx >= 0 {
                // Global parsed successfully, continue
                parse_pos = global_result.new_pos
                parse_pos = lex_skip(source, parse_pos)
            } else {
                // Failed to parse, break
                break
            }
        } else if kind == TK_FN() {
            // Parse function declaration
            let parse_result = parse_func_decl(source, parse_pos, nodes)
            if parse_result.node_idx < 0 {
                print("ERROR: Failed to parse function at position ")
                print(strconv.Itoa(parse_pos))
                print("\n")
                print("Context: ")
                let ctx_start = parse_pos
                let mut ctx_end = parse_pos + 100
                if ctx_end > len(source) {
                    ctx_end = len(source)
                }
                print(str_substring(source, ctx_start, ctx_end))
                print("\n")
                break
            }

            let func_idx = parse_result.node_idx
            let func_node = nodes[func_idx]
            push(func_names, func_node.str_val)
            push(func_indices, func_idx)
            print(func_node.str_val)
            print(" (total: ")
            print(strconv.Itoa(len(func_names)))
            print(")\n")

            parse_pos = parse_result.new_pos
            parse_pos = lex_skip(source, parse_pos)
        } else {
            // Unknown top-level declaration, stop parsing
            print(strconv.Itoa(kind))
            print("\n")
            break
        }
    }

    if import_count > 0 {
        print("Parsed ")
        print(strconv.Itoa(import_count))
        print(" imports\n")
    }

    if struct_count > 0 {
        print("Parsed ")
        print(strconv.Itoa(struct_count))
        print(" structs\n")
    }

    print("Parsed ")
    print(strconv.Itoa(len(func_names)))
    print(" functions:\n")
    let mut print_fn_i = 0
    let fn_count = len(func_names)
    for print_fn_i < fn_count {
        print("  [")
        print(strconv.Itoa(print_fn_i))
        print("] ")
        print(func_names[print_fn_i])
        print(" (AST index: ")
        print(strconv.Itoa(func_indices[print_fn_i]))
        print(")\n")
        print_fn_i = print_fn_i + 1
    }
    print("\n")

    // Find main function for compilation
    let mut main_idx = -1
    let mut find_main_i = 0
    for find_main_i < fn_count {
        if func_names[find_main_i] == "main" {
            main_idx = func_indices[find_main_i]
            break
        }
        find_main_i = find_main_i + 1
    }

    let ast_root = main_idx

    // Phase 3: IR Generation (All Functions)
    print("Phase 3: IR Generation\n")
    let mut instrs = []IRInstr{}
    let mut func_label_ids = []int{}
    let mut func_label_names = []string{}

    // Generate IR for all functions
    let mut gen_all_i = 0
    for gen_all_i < fn_count {
        let func_idx = func_indices[gen_all_i]
        let func_name = func_names[gen_all_i]

        // Add function label (using index 5000 + i to avoid conflicts)
        let func_label = 5000 + gen_all_i
        push(func_label_ids, func_label)
        push(func_label_names, func_name)

        let label_instr = IRInstr {
            op: OP_LABEL(),
            dest: func_label,
            arg1: 0,
            arg2: 0,
            arg3: 0,
            str_val: func_name
        }
        push(instrs, label_instr)

        // Generate IR for function body
        let mut symtab_names = []string{}
        let mut symtab_vregs = []int{}
        gen_ir_from_ast_with_symtab(func_idx, nodes, instrs, symtab_names, symtab_vregs)
        gen_all_i = gen_all_i + 1
    }

    if len(instrs) > 0 {
        print("Generated ")
        print(strconv.Itoa(len(instrs)))
        print(" IR instructions:\n")
        let mut print_ir_i = 0
        let instrs_count = len(instrs)
        for print_ir_i < instrs_count {
            let instr = instrs[print_ir_i]
            print("  [")
            print(strconv.Itoa(print_ir_i))
            print("] ")
            if instr.op == OP_LOADCONST() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = loadconst ")
                print(strconv.Itoa(instr.arg1))
            }
            if instr.op == OP_ADD() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = add v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_SUB() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = sub v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_MUL() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = mul v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_DIV() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = div v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_RET() {
                print("ret")
                if instr.dest >= 0 {
                    print(" v")
                    print(strconv.Itoa(instr.dest))
                }
            }
            if instr.op == OP_LABEL() {
                print("L")
                print(strconv.Itoa(instr.dest))
                print(":")
            }
            if instr.op == OP_JUMP() {
                print("jump L")
                print(strconv.Itoa(instr.dest))
            }
            if instr.op == OP_BRANCH() {
                print("branch_if_zero v")
                print(strconv.Itoa(instr.dest))
                print(", L")
                print(strconv.Itoa(instr.arg1))
            }
            if instr.op == OP_CALL() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = call ")
                print(instr.str_val)
                print("(")
                if instr.arg1 >= 0 {
                    print("v")
                    print(strconv.Itoa(instr.arg1))
                }
                print(")")
            }
            if instr.op == OP_LOAD() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = load [v")
                print(strconv.Itoa(instr.arg1))
                print(" + ")
                print(strconv.Itoa(instr.arg2))
                print("] // ")
                print(instr.str_val)
            }
            if instr.op == OP_ALLOCA() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = alloca ")
                print(strconv.Itoa(instr.arg1))
                print(" // ")
                print(instr.str_val)
            }
            if instr.op == OP_INDEXADDR() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = indexaddr v")
                print(strconv.Itoa(instr.arg1))
                print(" + ")
                print(strconv.Itoa(instr.arg2))
                print(" // ")
                print(instr.str_val)
            }
            if instr.op == OP_STORE() {
                print("store v")
                print(strconv.Itoa(instr.arg2))
                print(" to [v")
                print(strconv.Itoa(instr.arg1))
                print("]")
            }
            if instr.op == OP_ARRAY_LEN() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = array_len v")
                print(strconv.Itoa(instr.arg1))
            }
            if instr.op == OP_ARRAY_PUSH() {
                print("array_push v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_STR_CHAR_AT() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = str_char_at v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_STR_SUBSTRING() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = str_substring v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
                print(", v")
                print(strconv.Itoa(instr.arg3))
            }
            print("\n")
            print_ir_i = print_ir_i + 1
        }
        print("\n")
    }

    // Phase 4: Code Generation
    print("Phase 4: ARM64 Code Generation\n")
    // Use the IR generated in Phase 3 for all functions
    let mut code = []int{}
    gen_code_from_ir(instrs, code)
        print("Generated ")
        print(strconv.Itoa(len(code)))
        print(" machine instructions:\n")
        let mut print_code_i = 0
        let code_count = len(code)
        for print_code_i < code_count {
            print("  [")
            print(strconv.Itoa(print_code_i))
            print("] ")
            print_hex(code[print_code_i])
            print("\n")
            print_code_i = print_code_i + 1
        }
        print("\n")

        // Phase 5: Mach-O Binary Structure (demonstration)
        print("Phase 5: Mach-O Binary Structure\n")

        let code_size = len(code) * 4
        let header_size = 32 + 72 + 152 + 24  // header + PAGEZERO + TEXT + MAIN
        let file_size = align_up(header_size + code_size, PAGE_SIZE())

        print("  Header size: ")
        print(strconv.Itoa(header_size))
        print(" bytes\n")

        print("  Code size: ")
        print(strconv.Itoa(code_size))
        print(" bytes\n")

        print("  Total file size: ")
        print(strconv.Itoa(file_size))
        print(" bytes (aligned to ")
        print(strconv.Itoa(PAGE_SIZE()))
        print(")\n")

        print("  Entry point: 0x")
        print_hex(4294967296)
        print("\n")

        print("\n  Mach-O structure:\n")
        print("    - Mach-O header (32 bytes)\n")
        print("    - __PAGEZERO segment (72 bytes)\n")
        print("    - __TEXT segment (152 bytes)\n")
        print("    - LC_MAIN command (24 bytes)\n")
        print("    - Machine code (")
        print(strconv.Itoa(code_size))
        print(" bytes)\n")
        print("\n")

    print("=== Compilation Pipeline Complete ===\n")
    print("All phases: Lex → Parse → IR → Codegen → Binary!\n")

    // Phase 6: Write Binary to File
    print("\nPhase 6: Writing Binary\n")
    let output_path = "./tmp/test_output"

    // Complete binary with full code signature
    // Load commands: PAGEZERO(72) + TEXT(152) + LINKEDIT(72) + DYLINKER(32) + MAIN(24) + BUILD_VERSION(24) + SYMTAB(24) + DYSYMTAB(80) + CODE_SIGNATURE(16)
    let load_cmds_size = 72 + 152 + 72 + 32 + 24 + 24 + 24 + 80 + 16
    let new_header_size = 32 + load_cmds_size

    // Calculate __LINKEDIT layout
    let linkedit_offset = align_up(new_header_size + code_size, PAGE_SIZE())
    let symtab_offset = linkedit_offset
    let nsyms = 1  // One symbol entry
    let symtab_size = nsyms * 16  // nlist_64 is 16 bytes
    let strtab_offset = symtab_offset + symtab_size
    let strtab_size = 16  // Minimal string table
    let codesig_offset = align_up(strtab_offset + strtab_size, 16)
    let codesig_size = 256  // Reserve space for signature
    let linkedit_size = (codesig_offset - linkedit_offset) + codesig_size

    let new_file_size = align_up(linkedit_offset + linkedit_size, PAGE_SIZE())

    // Allocate buffer for Mach-O binary
    let buf_size = new_file_size
    let buf = heap_alloc(buf_size)
    if buf == 0 {
        print("ERROR: Failed to allocate buffer\n")
        return 1
    }

    // Zero out buffer
    write_zeros(buf, buf_size)

    // Write Mach-O header (9 load commands)
    let mut offset = 0
    offset = offset + write_mach_header(buf + offset, 9, load_cmds_size)

    // Write load commands
    offset = offset + write_pagezero_segment(buf + offset)
    offset = offset + write_text_segment(buf + offset, code_size, new_header_size)
    offset = offset + write_linkedit_segment(buf + offset, linkedit_offset, linkedit_size)
    offset = offset + write_dylinker_command(buf + offset)
    offset = offset + write_main_cmd(buf + offset, new_header_size)
    offset = offset + write_build_version_cmd(buf + offset)
    offset = offset + write_symtab_cmd(buf + offset, symtab_offset, nsyms, strtab_offset, strtab_size)
    offset = offset + write_dysymtab_cmd(buf + offset)
    offset = offset + write_code_signature_cmd(buf + offset, codesig_offset, codesig_size)

    // Copy code to buffer
    let code_offset = new_header_size
    let mut code_i = 0
    for code_i < len(code) {
        write_u32_le(buf + code_offset + (code_i * 4), code[code_i])
        code_i = code_i + 1
    }

    // Write __LINKEDIT data
    print("  Writing __LINKEDIT data...\n")

    // Symbol table: 1 entry (all zeros for minimal binary)
    write_zeros(buf + symtab_offset, symtab_size)

    // String table: starts with null byte
    write_zeros(buf + strtab_offset, strtab_size)
    poke(buf + strtab_offset, 0)

    // Write code signature
    print("  Writing code signature...\n")
    let sig_size = write_code_signature_blob(buf + codesig_offset, buf, codesig_offset, codesig_offset, "main")
    print("  Signature: ")
    print(strconv.Itoa(sig_size))
    print(" bytes\n")

    // Write to file
    print("  Writing to: ")
    print(output_path)
    print("\n")

    let fd = syscall.open(output_path, 1537, 493)  // O_WRONLY|O_CREAT|O_TRUNC, 0755
    if fd < 0 {
        print("ERROR: Failed to open output file\n")
        return 1
    }

    let written = syscall.write(fd, buf, buf_size)
    syscall.close(fd)

    if written != buf_size {
        print("ERROR: Write failed (wrote ")
        print(strconv.Itoa(written))
        print(" of ")
        print(strconv.Itoa(buf_size))
        print(" bytes)\n")
        return 1
    }

    print("  Success! Generated ")
    print(strconv.Itoa(written))
    print(" byte executable\n")
    print("\nTo run the generated program:\n")
    print("  ")
    print(output_path)
    print("\n")
    print("  echo $?  # Check exit code\n")

    return 0
}
