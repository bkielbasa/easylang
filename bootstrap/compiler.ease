fn main() -> int {
    print("=== Bootstrap Ease Compiler ===\n\n")

    // Test: For loop
    let source = "fn main() -> int { for 1 { return 42 } }"
    print("Compiling: ")
    print(source)
    print("\n\n")

    // Phase 1: Lexing
    print("Phase 1: Lexing\n")
    print("Tokens: ")
    let mut pos = 0
    for {
        pos = lex_skip(source, pos)
        let kind = lex_kind(source, pos)
        if kind == TK_INT() {
            print("INT(")
            print(strconv.Itoa(lex_int_value(source, pos)))
            print(") ")
        }
        if kind == TK_IDENT() {
            print("IDENT(")
            print(lex_string_value(source, pos, kind))
            print(") ")
        }
        if kind == TK_FN() { print("FN ") }
        if kind == TK_LET() { print("LET ") }
        if kind == TK_MUT() { print("MUT ") }
        if kind == TK_IF() { print("IF ") }
        if kind == TK_ELSE() { print("ELSE ") }
        if kind == TK_FOR() { print("FOR ") }
        if kind == TK_IN() { print("IN ") }
        if kind == TK_RETURN() { print("RETURN ") }
        if kind == TK_STRUCT() { print("STRUCT ") }
        if kind == TK_ASSIGN() { print("ASSIGN ") }
        if kind == TK_ARROW() { print("ARROW ") }
        if kind == TK_LBRACE() { print("LBRACE ") }
        if kind == TK_RBRACE() { print("RBRACE ") }
        if kind == TK_COLON() { print("COLON ") }
        if kind == TK_PLUS() { print("PLUS ") }
        if kind == TK_MINUS() { print("MINUS ") }
        if kind == TK_STAR() { print("STAR ") }
        if kind == TK_SLASH() { print("SLASH ") }
        if kind == TK_LPAREN() { print("LPAREN ") }
        if kind == TK_RPAREN() { print("RPAREN ") }
        if kind == TK_COMMA() { print("COMMA ") }
        if kind == TK_LT() { print("LT ") }
        if kind == TK_GT() { print("GT ") }
        if kind == TK_AND() { print("AND ") }
        if kind == TK_OR() { print("OR ") }
        if kind == TK_TRUE() { print("TRUE ") }
        if kind == TK_FALSE() { print("FALSE ") }
        pos = lex_end(source, pos, kind)
        if kind == TK_EOF() { break }
    }
    print("\n\n")

    // Phase 2: Parsing
    print("Phase 2: Parsing\n")
    let mut nodes = []AstNode{}
    let parse_result = parse_func_decl(source, 0, nodes)
    let ast_root = parse_result.node_idx
    if ast_root >= 0 {
        print("AST root index: ")
        print(strconv.Itoa(ast_root))
        print("\n")
        print("AST root tag: ")
        print(strconv.Itoa(nodes[ast_root].tag))
        print(" (")
        if nodes[ast_root].tag == DECL_FUNC() { print("DECL_FUNC") }
        if nodes[ast_root].tag == DECL_STRUCT() { print("DECL_STRUCT") }
        print(")\n")
        if nodes[ast_root].tag == DECL_FUNC() {
            print("Function name: ")
            print(nodes[ast_root].str_val)
            print("\n")
            print("Params node: ")
            print(strconv.Itoa(nodes[ast_root].left))
            print("\n")
            print("Body node: ")
            print(strconv.Itoa(nodes[ast_root].right))
            print("\n")
            if nodes[ast_root].right >= 0 {
                let body = nodes[nodes[ast_root].right]
                print("Body tag: ")
                print(strconv.Itoa(body.tag))
                print(" (STMT_BLOCK=")
                print(strconv.Itoa(STMT_BLOCK()))
                print(")\n")
                print("First statement: ")
                print(strconv.Itoa(body.left))
                print("\n")
            }
        }
    } else {
        print("Parse failed\n")
    }
    print("\n")

    // Phase 3: IR Generation
    print("Phase 3: IR Generation\n")
    if ast_root >= 0 {
        let mut instrs = []IRInstr{}
        let mut symtab_names = []string{}
        let mut symtab_vregs = []int{}
        let result_vreg = gen_ir_from_ast_with_symtab(ast_root, nodes, instrs, symtab_names, symtab_vregs)
        print("Generated ")
        print(strconv.Itoa(len(instrs)))
        print(" IR instructions:\n")
        for i in 0..len(instrs) {
            let instr = instrs[i]
            print("  [")
            print(strconv.Itoa(i))
            print("] ")
            if instr.op == OP_LOADCONST() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = loadconst ")
                print(strconv.Itoa(instr.arg1))
            }
            if instr.op == OP_ADD() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = add v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_SUB() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = sub v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_MUL() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = mul v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_DIV() {
                print("v")
                print(strconv.Itoa(instr.dest))
                print(" = div v")
                print(strconv.Itoa(instr.arg1))
                print(", v")
                print(strconv.Itoa(instr.arg2))
            }
            if instr.op == OP_RET() {
                print("ret")
                if instr.dest >= 0 {
                    print(" v")
                    print(strconv.Itoa(instr.dest))
                }
            }
            if instr.op == OP_LABEL() {
                print("L")
                print(strconv.Itoa(instr.dest))
                print(":")
            }
            if instr.op == OP_JUMP() {
                print("jump L")
                print(strconv.Itoa(instr.dest))
            }
            if instr.op == OP_BRANCH() {
                print("branch_if_zero v")
                print(strconv.Itoa(instr.dest))
                print(", L")
                print(strconv.Itoa(instr.arg1))
            }
            print("\n")
        }
        print("\n")
    }

    // Phase 4: Code Generation
    print("Phase 4: ARM64 Code Generation\n")
    if ast_root >= 0 {
        let mut instrs = []IRInstr{}
        let mut symtab_names = []string{}
        let mut symtab_vregs = []int{}
        let result_vreg = gen_ir_from_ast_with_symtab(ast_root, nodes, instrs, symtab_names, symtab_vregs)
        let mut code = []int{}
        gen_code_from_ir(instrs, code)
        print("Generated ")
        print(strconv.Itoa(len(code)))
        print(" machine instructions:\n")
        for i in 0..len(code) {
            print("  [")
            print(strconv.Itoa(i))
            print("] ")
            print_hex(code[i])
            print("\n")
        }
        print("\n")

        // Phase 5: Mach-O Binary Structure (demonstration)
        print("Phase 5: Mach-O Binary Structure\n")

        let code_size = len(code) * 4
        let header_size = 32 + 72 + 152 + 24  // header + PAGEZERO + TEXT + MAIN
        let file_size = align_up(header_size + code_size, PAGE_SIZE())

        print("  Header size: ")
        print(strconv.Itoa(header_size))
        print(" bytes\n")

        print("  Code size: ")
        print(strconv.Itoa(code_size))
        print(" bytes\n")

        print("  Total file size: ")
        print(strconv.Itoa(file_size))
        print(" bytes (aligned to ")
        print(strconv.Itoa(PAGE_SIZE()))
        print(")\n")

        print("  Entry point: 0x")
        print_hex(4294967296)
        print("\n")

        print("\n  Mach-O structure:\n")
        print("    - Mach-O header (32 bytes)\n")
        print("    - __PAGEZERO segment (72 bytes)\n")
        print("    - __TEXT segment (152 bytes)\n")
        print("    - LC_MAIN command (24 bytes)\n")
        print("    - Machine code (")
        print(strconv.Itoa(code_size))
        print(" bytes)\n")
        print("\n")
    }

    print("=== Compilation Pipeline Complete ===\n")
    print("All phases: Lex → Parse → IR → Codegen → Binary!\n")
    print("\nTo run the generated program:\n")
    print("  ./tmp/test_output\n")
    print("  echo $?  # Check exit code\n")

    return 0
}
