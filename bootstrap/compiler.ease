package main

// Bootstrap Ease Compiler (LLVM IR backend)
// Main entry point — imports domain modules and orchestrates compilation pipeline

import (
    "./ease/strconv"
    "./ease/token"
    "./ease/lexer"
    "./ease/ast"
    "./ease/parser"
    "./ease/ir"
    "./ease/irgen"
    "./ease/llvm"
    "./ease/lsp"
)

// Global storage for function call arguments (workaround for immutability)
// Maps call node index -> argument indices
// Layout: [call_idx1, arg_count1, arg1_idx, arg2_idx, ..., call_idx2, arg_count2, ...]
g_call_args := []int{}

fn store_call_args(call_node_idx: int, arg_indices: []int) {
    push(g_call_args, call_node_idx)
    push(g_call_args, len(arg_indices))
    i := 0
    count := len(arg_indices)
    for i < count {
        push(g_call_args, arg_indices[i])
        i = i + 1
    }
}

fn get_call_args(call_node_idx: int) -> []int {
    // Search for call_node_idx in g_call_args
    i := 0
    for {
        if i >= len(g_call_args) {
            break
        }
        if g_call_args[i] == call_node_idx {
            // Found it - next element is arg_count
            arg_count := g_call_args[i + 1]
            result := []int{}
            j := 0
            for j < arg_count {
                push(result, g_call_args[i + 2 + j])
                j = j + 1
            }
            return result
        }
        // Skip to next entry: current + 1 (count) + count (args)
        arg_count := g_call_args[i + 1]
        i = i + 2 + arg_count
    }
    return []int{}
}

// Global storage for struct literal field values
// Maps struct_lit node index -> field value indices
// Layout: same as g_call_args
g_struct_fields := []int{}
g_scalar_globals := []string{}
g_vreg_types := []int{}
g_param_types := []int{}
g_param_types_start := 0
g_global_var_types := []int{}
g_vreg_type_patches_idx := []int{}
g_vreg_type_patches_val := []int{}
g_current_file_list := []string{}
g_break_label := -1
g_next_label := 100000
g_func_ret_names := []string{}
g_func_ret_types := []int{}
g_func_ret_is_array := []int{}
g_import_paths := []string{}
g_import_names := []string{}
g_rename_from := []string{}
g_rename_to := []string{}
g_field_reg_names := []string{}
g_field_reg_types := []int{}
g_field_reg_is_array := []int{}
g_func_ret_struct_names := []string{}
g_method_struct_names := []string{}
g_method_names := []string{}
g_method_func_names := []string{}

// Const storage: compile-time constants inlined at use sites
g_const_names := []string{}
g_const_int_values := []int{}
g_const_str_values := []string{}
g_const_types := []int{}

// LSP mode globals
g_lsp_mode := 0
g_lsp_diag_lines := []int{}
g_lsp_diag_cols := []int{}
g_lsp_diag_msgs := []string{}
g_lsp_sym_names := []string{}
g_lsp_sym_offsets := []int{}
g_lsp_sym_sigs := []string{}
g_lsp_sym_kinds := []int{}

fn lsp_diagnostic_count() -> int {
    return len(g_lsp_diag_msgs)
}

fn lsp_diagnostic_line(i: int) -> int {
    return g_lsp_diag_lines[i]
}

fn lsp_diagnostic_col(i: int) -> int {
    return g_lsp_diag_cols[i]
}

fn lsp_diagnostic_msg(i: int) -> string {
    return g_lsp_diag_msgs[i]
}

fn lsp_symbol_count() -> int {
    return len(g_lsp_sym_names)
}

fn lsp_symbol_name(i: int) -> string {
    return g_lsp_sym_names[i]
}

fn lsp_symbol_offset(i: int) -> int {
    return g_lsp_sym_offsets[i]
}

fn lsp_symbol_sig(i: int) -> string {
    return g_lsp_sym_sigs[i]
}

fn lsp_symbol_kind(i: int) -> int {
    return g_lsp_sym_kinds[i]
}

fn lsp_type_str(type_tag: int, is_array: int, node_idx: int) -> string {
    if is_array == 1 {
        if type_tag == TYPE_INT { return "[]int" }
        if type_tag == TYPE_STRING { return "[]string" }
        if type_tag == TYPE_BOOL { return "[]bool" }
    }
    if type_tag == TYPE_INT { return "int" }
    if type_tag == TYPE_STRING { return "string" }
    if type_tag == TYPE_BOOL { return "bool" }
    if type_tag == TYPE_STRUCT {
        sname := lookup_type_name(node_idx)
        if len(sname) > 0 { return sname }
    }
    return ""
}

fn register_field_type(name: string, field_type: int, is_array: int) {
    // Only register if not already present (first definition wins)
    i := 0
    for i < len(g_field_reg_names) {
        if g_field_reg_names[i] == name { return }
        i = i + 1
    }
    push(g_field_reg_names, name)
    push(g_field_reg_types, field_type)
    push(g_field_reg_is_array, is_array)
}

fn lookup_field_type(name: string) -> int {
    i := 0
    for i < len(g_field_reg_names) {
        if g_field_reg_names[i] == name {
            return g_field_reg_types[i]
        }
        i = i + 1
    }
    return TYPE_UNKNOWN
}

fn lookup_field_is_array(name: string) -> int {
    i := 0
    for i < len(g_field_reg_names) {
        if g_field_reg_names[i] == name {
            return g_field_reg_is_array[i]
        }
        i = i + 1
    }
    return 0
}

fn register_func_return_type(name: string, ret_type: int, is_array: int, struct_name: string) {
    push(g_func_ret_names, name)
    push(g_func_ret_types, ret_type)
    push(g_func_ret_is_array, is_array)
    push(g_func_ret_struct_names, struct_name)
}

fn lookup_func_return_type(name: string) -> int {
    i := len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_types[i]
        }
        i = i - 1
    }
    return TYPE_UNKNOWN
}

fn lookup_func_return_is_array(name: string) -> int {
    i := len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_is_array[i]
        }
        i = i - 1
    }
    return 0
}

fn lookup_func_return_struct_name(name: string) -> string {
    i := len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_struct_names[i]
        }
        i = i - 1
    }
    return ""
}

fn lookup_method(struct_name: string, method_name: string) -> string {
    i := 0
    for i < len(g_method_struct_names) {
        if g_method_struct_names[i] == struct_name && g_method_names[i] == method_name {
            return g_method_func_names[i]
        }
        i = i + 1
    }
    return ""
}

// Find the position of '.' in a string, returns -1 if not found
fn find_dot(name: string) -> int {
    i := 0
    for i < len(name) {
        if str_char_at(name, i) == 46 { return i }
        i = i + 1
    }
    return -1
}

// Find the last '/' in a string, returns -1 if not found
fn find_last_slash(path: string) -> int {
    i := len(path) - 1
    for i >= 0 {
        if str_char_at(path, i) == 47 { return i }
        i = i - 1
    }
    return -1
}

// Extract module name from import path: "./lexer" -> "lexer", "./sub/parser" -> "parser"
fn extract_module_name(import_path: string) -> string {
    slash_pos := find_last_slash(import_path)
    if slash_pos >= 0 {
        return str_substring(import_path, slash_pos + 1, len(import_path))
    }
    return import_path
}

// Resolve import base path relative to source file: "./lexer" -> "dir/lexer"
fn resolve_import_base(source_path: string, import_path: string) -> string {
    slash_pos := find_last_slash(source_path)
    dir := "."
    if slash_pos >= 0 {
        dir = str_substring(source_path, 0, slash_pos)
    }
    // Strip leading "./" from import_path if present
    rel_path := import_path
    if len(import_path) >= 2 && str_char_at(import_path, 0) == 46 && str_char_at(import_path, 1) == 47 {
        rel_path = str_substring(import_path, 2, len(import_path))
    }
    return dir + "/" + rel_path
}

// Resolve import path relative to source file: "./lexer" -> "dir/lexer.ease"
// For directories, returns the directory path (without .ease)
fn resolve_import_path(source_path: string, import_path: string) -> string {
    base := resolve_import_base(source_path, import_path)
    // Check if path is a directory first
    if os.IsDir(base) == 1 {
        return base
    }
    return base + ".ease"
}

// Check if a string ends with ".ease" (used for filtering directory entries)
fn has_ease_suffix(s: string) -> int {
    slen := len(s)
    if slen < 5 { return 0 }
    if str_char_at(s, slen - 5) != 46 { return 0 }
    if str_char_at(s, slen - 4) != 101 { return 0 }
    if str_char_at(s, slen - 3) != 97 { return 0 }
    if str_char_at(s, slen - 2) != 115 { return 0 }
    if str_char_at(s, slen - 1) != 101 { return 0 }
    return 1
}

// Check if a name starts with an uppercase letter (A-Z = 65-90)
fn is_exported(name: string) -> int {
    if len(name) == 0 { return 0 }
    ch := str_char_at(name, 0)
    if ch >= 65 && ch <= 90 { return 1 }
    return 0
}

// Look up a function name in the rename table; returns qualified name or original
fn lookup_rename(name: string) -> string {
    i := 0
    for i < len(g_rename_from) {
        if g_rename_from[i] == name {
            return g_rename_to[i]
        }
        i = i + 1
    }
    return name
}

fn report_error(src: string, offset: int, msg: string) {
    if g_lsp_mode == 1 {
        // LSP mode: collect diagnostics (0-based line/col)
        line := 0
        col := 0
        ri := 0
        for ri < offset {
            if ri >= len(src) { break }
            if str_char_at(src, ri) == 10 {
                line = line + 1
                col = 0
            } else {
                col = col + 1
            }
            ri = ri + 1
        }
        push(g_lsp_diag_lines, line)
        push(g_lsp_diag_cols, col)
        push(g_lsp_diag_msgs, msg)
        return
    }
    filename := "<unknown>"
    cf_len := len(g_current_file_list)
    if cf_len > 0 { filename = g_current_file_list[cf_len - 1] }
    loc := strings.OffsetToLineCol(src, offset)
    print(filename + ":" + loc + ": error: " + msg + "\n")
    line_text := strings.GetSourceLine(src, offset)
    if len(line_text) > 0 {
        print("    " + line_text + "\n")
        col := strings.GetColumn(src, offset)
        spaces := "    "
        si := 1
        for si < col { spaces = spaces + " "
            si = si + 1
        }
        print(spaces + "^\n")
    }
}

fn parse_for_diagnostics(source: string) {
    // Clear previous diagnostics
    g_lsp_diag_lines = []int{}
    g_lsp_diag_cols = []int{}
    g_lsp_diag_msgs = []string{}
    g_lsp_sym_names = []string{}
    g_lsp_sym_offsets = []int{}
    g_lsp_sym_sigs = []string{}
    g_lsp_sym_kinds = []int{}
    g_lsp_mode = 1

    // Phase 1: Lexing
    lpos := 0
    for {
        lpos = lex_skip(source, lpos)
        lkind := lex_kind(source, lpos)
        if lkind == TK_EOF {
            if lpos < len(source) {
                report_error(source, lpos, "unexpected character")
                lpos = lpos + 1
            } else {
                break
            }
        } else {
            lpos = lex_end(source, lpos, lkind)
        }
    }

    // Phase 2: Parsing
    diag_nodes := []AstNode{}
    dpos := 0
    dpos = lex_skip(source, dpos)
    for {
        dpos = lex_skip(source, dpos)
        dkind := lex_kind(source, dpos)
        if dkind == TK_EOF { break }

        if dkind == TK_PACKAGE {
            dpos = lex_end(source, dpos, dkind)
            dpos = lex_skip(source, dpos)
            dpos = lex_end(source, dpos, lex_kind(source, dpos))
        } else if dkind == TK_IMPORT {
            dimp := parse_import_decl(source, dpos, diag_nodes)
            if dimp.node_idx >= 0 {
                dpos = dimp.new_pos
                dpos = lex_skip(source, dpos)
            } else {
                break
            }
        } else if dkind == TK_STRUCT {
            dstruct := parse_struct_decl(source, dpos, diag_nodes)
            if dstruct.node_idx >= 0 {
                push(g_lsp_sym_names, diag_nodes[dstruct.node_idx].str_val)
                push(g_lsp_sym_offsets, dpos)
                // Build struct signature: struct Name { field1: type1, field2: type2 }
                ssig := "struct " + diag_nodes[dstruct.node_idx].str_val + " { "
                sfi := diag_nodes[dstruct.node_idx].left
                sfirst := 1
                for sfi >= 0 && sfi < len(diag_nodes) {
                    if diag_nodes[sfi].tag != DECL_FIELD { break }
                    if sfirst == 0 { ssig = ssig + ", " }
                    ssig = ssig + diag_nodes[sfi].str_val + ": " + lsp_type_str(diag_nodes[sfi].type_tag, diag_nodes[sfi].int_val, sfi)
                    sfirst = 0
                    sfi = sfi + 1
                }
                ssig = ssig + " }"
                push(g_lsp_sym_sigs, ssig)
                push(g_lsp_sym_kinds, 23)
            }
            dpos = dstruct.new_pos
        } else if dkind == TK_ENUM {
            denum := parse_enum_decl(source, dpos, diag_nodes)
            if denum.node_idx >= 0 {
                push(g_lsp_sym_names, diag_nodes[denum.node_idx].str_val)
                push(g_lsp_sym_offsets, dpos)
                // Build enum signature: enum Name { V1, V2 { f: type } }
                esig := "enum " + diag_nodes[denum.node_idx].str_val + " { "
                evi := diag_nodes[denum.node_idx].left
                efirst := 1
                for evi >= 0 && evi < denum.node_idx {
                    if diag_nodes[evi].tag == DECL_VARIANT {
                        if efirst == 0 { esig = esig + ", " }
                        esig = esig + diag_nodes[evi].str_val
                        // Check for variant fields
                        evfi := diag_nodes[evi].left
                        if evfi >= 0 {
                            esig = esig + " { "
                            evffirst := 1
                            for evfi >= 0 && evfi < evi {
                                if diag_nodes[evfi].tag != DECL_FIELD { break }
                                if evffirst == 0 { esig = esig + ", " }
                                esig = esig + diag_nodes[evfi].str_val + ": " + lsp_type_str(diag_nodes[evfi].type_tag, diag_nodes[evfi].int_val, evfi)
                                evffirst = 0
                                evfi = evfi + 1
                            }
                            esig = esig + " }"
                        }
                        efirst = 0
                    }
                    evi = evi + 1
                }
                esig = esig + " }"
                push(g_lsp_sym_sigs, esig)
                push(g_lsp_sym_kinds, 10)
            }
            dpos = denum.new_pos
        } else if dkind == TK_IDENT {
            dce_end := lex_end(source, dpos, dkind)
            dce_next := lex_skip(source, dce_end)
            if lex_kind(source, dce_next) == TK_COLONEQUAL {
                dce := parse_colonequal_stmt(source, dpos, diag_nodes)
                if dce.node_idx >= 0 {
                    push(g_lsp_sym_names, diag_nodes[dce.node_idx].str_val)
                    push(g_lsp_sym_offsets, dpos)
                    push(g_lsp_sym_sigs, diag_nodes[dce.node_idx].str_val + " := ...")
                    push(g_lsp_sym_kinds, 13)
                }
                dpos = dce.new_pos
            } else {
                break
            }
        } else if dkind == TK_FN {
            dfunc := parse_func_decl(source, dpos, diag_nodes)
            if dfunc.node_idx < 0 {
                report_error(source, dpos, "failed to parse function")
                break
            }
            push(g_lsp_sym_names, diag_nodes[dfunc.node_idx].str_val)
            push(g_lsp_sym_offsets, dpos)
            // Build function signature: fn name(p1: type1, p2: type2) -> rettype
            fsig := "fn " + diag_nodes[dfunc.node_idx].str_val + "("
            fpi := diag_nodes[dfunc.node_idx].left
            fpfirst := 1
            for fpi >= 0 && fpi < len(diag_nodes) {
                if diag_nodes[fpi].tag != DECL_PARAM { break }
                if fpfirst == 0 { fsig = fsig + ", " }
                fsig = fsig + diag_nodes[fpi].str_val + ": " + lsp_type_str(diag_nodes[fpi].type_tag, diag_nodes[fpi].int_val, fpi)
                fpfirst = 0
                fpi = fpi + 1
            }
            fsig = fsig + ")"
            frt := lsp_type_str(diag_nodes[dfunc.node_idx].type_tag, diag_nodes[dfunc.node_idx].int_val, dfunc.node_idx)
            if len(frt) > 0 {
                fsig = fsig + " -> " + frt
            }
            push(g_lsp_sym_sigs, fsig)
            push(g_lsp_sym_kinds, 12)
            dpos = dfunc.new_pos
            dpos = lex_skip(source, dpos)
        } else {
            break
        }
    }

    g_lsp_mode = 0
}

fn store_struct_fields(struct_node_idx: int, field_indices: []int) {
    push(g_struct_fields, struct_node_idx)
    push(g_struct_fields, len(field_indices))
    i := 0
    count := len(field_indices)
    for i < count {
        push(g_struct_fields, field_indices[i])
        i = i + 1
    }
}

fn get_struct_fields(struct_node_idx: int) -> []int {
    i := 0
    for {
        if i >= len(g_struct_fields) {
            break
        }
        if g_struct_fields[i] == struct_node_idx {
            field_count := g_struct_fields[i + 1]
            result := []int{}
            j := 0
            for j < field_count {
                push(result, g_struct_fields[i + 2 + j])
                j = j + 1
            }
            return result
        }
        field_count := g_struct_fields[i + 1]
        i = i + 2 + field_count
    }
    return []int{}
}

// Match arm bindings side table
// Maps arm node index -> binding names
// Layout: [arm_idx, count, name1_idx, name2_idx, ...]
// But since we store strings, we use a parallel approach
g_match_arm_bindings := []int{}
g_match_arm_binding_names := []string{}

fn store_match_arm_bindings(arm_node_idx: int, names: []string) {
    push(g_match_arm_bindings, arm_node_idx)
    push(g_match_arm_bindings, len(names))
    start := len(g_match_arm_binding_names)
    push(g_match_arm_bindings, start)
    i := 0
    for i < len(names) {
        push(g_match_arm_binding_names, names[i])
        i = i + 1
    }
}

fn get_match_arm_bindings(arm_node_idx: int) -> []string {
    i := 0
    for i < len(g_match_arm_bindings) {
        if g_match_arm_bindings[i] == arm_node_idx {
            count := g_match_arm_bindings[i + 1]
            start := g_match_arm_bindings[i + 2]
            result := []string{}
            j := 0
            for j < count {
                push(result, g_match_arm_binding_names[start + j])
                j = j + 1
            }
            return result
        }
        i = i + 3
    }
    return []string{}
}

// Check if a string ends with "_test.ease"
fn has_test_suffix(s: string) -> int {
    slen := len(s)
    if slen < 10 { return 0 }
    // Check "_test.ease" (10 chars from end)
    suffix := str_substring(s, slen - 10, slen)
    if suffix == "_test.ease" { return 1 }
    return 0
}

// Check if a function name starts with "Test" (uppercase T)
fn is_test_func(name: string) -> int {
    if len(name) < 5 { return 0 }
    if str_char_at(name, 0) != 84 { return 0 }  // T
    if str_char_at(name, 1) != 101 { return 0 } // e
    if str_char_at(name, 2) != 115 { return 0 } // s
    if str_char_at(name, 3) != 116 { return 0 } // t
    return 1
}

fn is_benchmark_func(name: string) -> int {
    if len(name) < 10 { return 0 }
    if str_char_at(name, 0) != 66 { return 0 }
    if str_char_at(name, 1) != 101 { return 0 }
    if str_char_at(name, 2) != 110 { return 0 }
    if str_char_at(name, 3) != 99 { return 0 }
    if str_char_at(name, 4) != 104 { return 0 }
    if str_char_at(name, 5) != 109 { return 0 }
    if str_char_at(name, 6) != 97 { return 0 }
    if str_char_at(name, 7) != 114 { return 0 }
    if str_char_at(name, 8) != 107 { return 0 }
    return 1
}

fn count_func_params(nodes: []AstNode, func_idx: int) -> int {
    node := nodes[func_idx]
    if node.left < 0 { return 0 }
    count := 0
    pi := node.left
    nodes_len := len(nodes)
    for pi < nodes_len {
        if nodes[pi].tag == DECL_PARAM {
            count = count + 1
        } else {
            break
        }
        pi = pi + 1
    }
    return count
}

fn infer_init_type(nodes: []AstNode, init_idx: int) -> int {
    if init_idx < 0 { return TYPE_UNKNOWN }
    init_node := nodes[init_idx]
    if init_node.tag == EXPR_INT { return TYPE_INT }
    if init_node.tag == EXPR_UNARY { return TYPE_INT }
    if init_node.tag == EXPR_STRING { return TYPE_STRING }
    if init_node.tag == EXPR_BOOL { return TYPE_BOOL }
    if init_node.tag == EXPR_ARRAY_LIT {
        if init_node.str_val == "string" { return TYPE_STRING_ARRAY }
        return TYPE_INT_ARRAY
    }
    return TYPE_UNKNOWN
}

fn register_const(nodes: []AstNode, const_idx: int) {
    cnode := nodes[const_idx]
    push(g_const_names, cnode.str_val)
    push(g_const_types, cnode.type_tag)
    // Evaluate the literal value from the initializer
    init_idx := cnode.left
    if init_idx < 0 {
        push(g_const_int_values, 0)
        push(g_const_str_values, "")
        return
    }
    init := nodes[init_idx]
    if init.tag == EXPR_INT {
        push(g_const_int_values, init.int_val)
        push(g_const_str_values, "")
    } else if init.tag == EXPR_BOOL {
        push(g_const_int_values, init.int_val)
        push(g_const_str_values, "")
    } else if init.tag == EXPR_STRING {
        push(g_const_int_values, 0)
        push(g_const_str_values, init.str_val)
    } else if init.tag == EXPR_UNARY {
        // Negative int: -N => 0 - N (need to evaluate the child)
        if init.left >= 0 {
            child := nodes[init.left]
            push(g_const_int_values, 0 - child.int_val)
        } else {
            push(g_const_int_values, 0)
        }
        push(g_const_str_values, "")
    } else {
        push(g_const_int_values, 0)
        push(g_const_str_values, "")
    }
}

// Parse all top-level declarations from a source string into nodes/func arrays
// Returns the parse position (or -1 on error)
fn parse_source_file(source: string, nodes: []AstNode, func_names: []string, func_indices: []int, global_var_names: []string, skip_main: int) -> int {
    parse_pos := 0
    parse_pos = lex_skip(source, parse_pos)

    for {
        parse_pos = lex_skip(source, parse_pos)
        kind := lex_kind(source, parse_pos)
        if kind == TK_EOF { break }

        if kind == TK_PACKAGE {
            parse_pos = lex_end(source, parse_pos, kind)
            parse_pos = lex_skip(source, parse_pos)
            parse_pos = lex_end(source, parse_pos, lex_kind(source, parse_pos))
        } else if kind == TK_IMPORT {
            import_result := parse_import_decl(source, parse_pos, nodes)
            if import_result.node_idx >= 0 {
                parse_pos = import_result.new_pos
                parse_pos = lex_skip(source, parse_pos)
            } else {
                break
            }
        } else if kind == TK_STRUCT {
            struct_result := parse_struct_decl(source, parse_pos, nodes)
            parse_pos = struct_result.new_pos
        } else if kind == TK_ENUM {
            enum_result := parse_enum_decl(source, parse_pos, nodes)
            parse_pos = enum_result.new_pos
        } else if kind == TK_CONST {
            const_result := parse_const_decl(source, parse_pos, nodes)
            if const_result.node_idx >= 0 {
                register_const(nodes, const_result.node_idx)
            }
            parse_pos = const_result.new_pos
        } else if kind == TK_IDENT {
            ce_end := lex_end(source, parse_pos, kind)
            ce_next_pos := lex_skip(source, ce_end)
            if lex_kind(source, ce_next_pos) == TK_COLONEQUAL {
                ce_result := parse_colonequal_stmt(source, parse_pos, nodes)
                if ce_result.node_idx >= 0 {
                    ce_node := nodes[ce_result.node_idx]
                    push(global_var_names, ce_node.str_val)
                    push(g_global_var_types, infer_init_type(nodes, ce_node.right))
                    if ce_node.right >= 0 {
                        ce_init := nodes[ce_node.right]
                        if ce_init.tag == EXPR_INT {
                            push(g_scalar_globals, ce_node.str_val)
                        }
                        if ce_init.tag == EXPR_UNARY {
                            push(g_scalar_globals, ce_node.str_val)
                        }
                    }
                }
                parse_pos = ce_result.new_pos
            } else {
                break
            }
        } else if kind == TK_FN {
            parse_result := parse_func_decl(source, parse_pos, nodes)
            if parse_result.node_idx < 0 {
                break
            }
            func_idx := parse_result.node_idx
            func_node := nodes[func_idx]
            // Skip main() if requested (test mode replaces it)
            if skip_main == 1 && func_node.str_val == "main" {
                parse_pos = parse_result.new_pos
                parse_pos = lex_skip(source, parse_pos)
            } else {
                push(func_names, func_node.str_val)
                push(func_indices, func_idx)
                parse_pos = parse_result.new_pos
                parse_pos = lex_skip(source, parse_pos)
            }
        } else {
            break
        }
    }
    return 0
}

fn run_test_mode(test_path: string, run_bench: int) -> int {
    // Determine directory to scan
    dir := test_path
    if len(dir) == 0 { dir = "." }
    // Strip trailing slash
    if len(dir) > 1 && str_char_at(dir, len(dir) - 1) == 47 {
        dir = str_substring(dir, 0, len(dir) - 1)
    }

    // List files in directory
    entries := os.ListDir(dir)
    source_files := []string{}
    test_files := []string{}

    epos := 0
    estart := 0
    entries_len := len(entries)
    for epos <= entries_len {
        if epos == entries_len || str_char_at(entries, epos) == 10 {
            if epos > estart {
                entry := str_substring(entries, estart, epos)
                if has_ease_suffix(entry) == 1 {
                    full_path := dir + "/" + entry
                    if has_test_suffix(entry) == 1 {
                        push(test_files, full_path)
                    } else {
                        push(source_files, full_path)
                    }
                }
            }
            estart = epos + 1
        }
        epos = epos + 1
    }

    if len(test_files) == 0 {
        print("No test files found (expecting *_test.ease)\n")
        return 0
    }

    // Parse all source and test files
    nodes := []AstNode{}
    func_names := []string{}
    func_indices := []int{}
    global_var_names := []string{}

    // Parse source files (skip main — test runner replaces it)
    sf_i := 0
    for sf_i < len(source_files) {
        src := os.ReadFile(source_files[sf_i])
        parse_source_file(src, nodes, func_names, func_indices, global_var_names, 1)
        sf_i = sf_i + 1
    }

    // Parse test files (also skip any main)
    test_func_names := []string{}
    bench_func_names := []string{}
    tf_i := 0
    for tf_i < len(test_files) {
        tsrc := os.ReadFile(test_files[tf_i])
        // Track func count before parsing to identify new test/bench funcs
        before_count := len(func_names)
        parse_source_file(tsrc, nodes, func_names, func_indices, global_var_names, 1)
        // Identify test and benchmark functions from newly parsed ones
        tfi := before_count
        for tfi < len(func_names) {
            if is_test_func(func_names[tfi]) == 1 && count_func_params(nodes, func_indices[tfi]) == 1 {
                push(test_func_names, func_names[tfi])
            }
            if run_bench == 1 && is_benchmark_func(func_names[tfi]) == 1 && count_func_params(nodes, func_indices[tfi]) == 1 {
                push(bench_func_names, func_names[tfi])
            }
            tfi = tfi + 1
        }
        tf_i = tf_i + 1
    }

    if len(test_func_names) == 0 && len(bench_func_names) == 0 {
        print("No test or benchmark functions found\n")
        return 0
    }

    // Process imports from parsed DECL_IMPORT nodes
    imp_i := 0
    main_node_count := len(nodes)
    for imp_i < main_node_count {
        if nodes[imp_i].tag == DECL_IMPORT {
            import_path := nodes[imp_i].str_val
            if len(import_path) >= 2 && str_char_at(import_path, 0) == 46 && str_char_at(import_path, 1) == 47 {
                mod_name := extract_module_name(import_path)
                resolved := resolve_import_path(dir + "/dummy.ease", import_path)
                is_dir_flag := os.IsDir(resolved)

                mod_func_names := []string{}
                mod_func_indices := []int{}

                if is_dir_flag == 1 {
                    push(g_import_paths, resolved)
                    push(g_import_names, mod_name)

                    dir_entries := os.ListDir(resolved)
                    depos := 0
                    destart := 0
                    dir_entries_len := len(dir_entries)
                    for depos <= dir_entries_len {
                        if depos == dir_entries_len || str_char_at(dir_entries, depos) == 10 {
                            if depos > destart {
                                dentry := str_substring(dir_entries, destart, depos)
                                if has_ease_suffix(dentry) == 1 {
                                    file_path := resolved + "/" + dentry
                                    dir_source := os.ReadFile(file_path)
                                    dir_pos := 0
                                    dir_pos = lex_skip(dir_source, dir_pos)
                                    for {
                                        dir_pos = lex_skip(dir_source, dir_pos)
                                        dir_kind := lex_kind(dir_source, dir_pos)
                                        if dir_kind == TK_EOF { break }
                                        if dir_kind == TK_PACKAGE {
                                            dir_pos = lex_end(dir_source, dir_pos, dir_kind)
                                            dir_pos = lex_skip(dir_source, dir_pos)
                                            dir_pos = lex_end(dir_source, dir_pos, lex_kind(dir_source, dir_pos))
                                        } else if dir_kind == TK_IMPORT {
                                            dir_imp := parse_import_decl(dir_source, dir_pos, nodes)
                                            dir_pos = dir_imp.new_pos
                                            dir_pos = lex_skip(dir_source, dir_pos)
                                        } else if dir_kind == TK_STRUCT {
                                            dir_struct := parse_struct_decl(dir_source, dir_pos, nodes)
                                            dir_pos = dir_struct.new_pos
                                        } else if dir_kind == TK_ENUM {
                                            dir_enum := parse_enum_decl(dir_source, dir_pos, nodes)
                                            dir_pos = dir_enum.new_pos
                                        } else if dir_kind == TK_CONST {
                                            dir_const := parse_const_decl(dir_source, dir_pos, nodes)
                                            if dir_const.node_idx >= 0 {
                                                register_const(nodes, dir_const.node_idx)
                                            }
                                            dir_pos = dir_const.new_pos
                                        } else if dir_kind == TK_IDENT {
                                            dir_ce_end := lex_end(dir_source, dir_pos, dir_kind)
                                            dir_ce_next := lex_skip(dir_source, dir_ce_end)
                                            if lex_kind(dir_source, dir_ce_next) == TK_COLONEQUAL {
                                                dir_ce := parse_colonequal_stmt(dir_source, dir_pos, nodes)
                                                if dir_ce.node_idx >= 0 {
                                                    dir_ce_node := nodes[dir_ce.node_idx]
                                                    push(global_var_names, dir_ce_node.str_val)
                                                    push(g_global_var_types, infer_init_type(nodes, dir_ce_node.right))
                                                    if dir_ce_node.right >= 0 {
                                                        dir_ce_init := nodes[dir_ce_node.right]
                                                        if dir_ce_init.tag == EXPR_INT {
                                                            push(g_scalar_globals, dir_ce_node.str_val)
                                                        }
                                                        if dir_ce_init.tag == EXPR_UNARY {
                                                            push(g_scalar_globals, dir_ce_node.str_val)
                                                        }
                                                    }
                                                }
                                                dir_pos = dir_ce.new_pos
                                            } else {
                                                break
                                            }
                                        } else if dir_kind == TK_FN {
                                            dir_func := parse_func_decl(dir_source, dir_pos, nodes)
                                            if dir_func.node_idx < 0 { break }
                                            dir_func_idx := dir_func.node_idx
                                            dir_orig := nodes[dir_func_idx].str_val
                                            push(mod_func_names, dir_orig)
                                            push(mod_func_indices, dir_func_idx)
                                            dir_pos = dir_func.new_pos
                                            dir_pos = lex_skip(dir_source, dir_pos)
                                        } else {
                                            break
                                        }
                                    }
                                }
                            }
                            destart = depos + 1
                        }
                        depos = depos + 1
                    }

                    mfi := 0
                    for mfi < len(mod_func_names) {
                        qualified := mod_name + "." + mod_func_names[mfi]
                        push(func_names, qualified)
                        push(func_indices, mod_func_indices[mfi])
                        if is_exported(mod_func_names[mfi]) == 1 {
                            push(g_rename_from, mod_func_names[mfi])
                            push(g_rename_to, qualified)
                        }
                        mfi = mfi + 1
                    }
                    ipfi := 0
                    for ipfi < len(mod_func_names) {
                        if is_exported(mod_func_names[ipfi]) == 0 {
                            push(g_rename_from, mod_func_names[ipfi])
                            push(g_rename_to, mod_name + "." + mod_func_names[ipfi])
                        }
                        ipfi = ipfi + 1
                    }
                } else {
                    // Single file import
                    mod_source := os.ReadFile(resolved)
                    push(g_import_paths, resolved)
                    push(g_import_names, mod_name)

                    mod_pos := 0
                    mod_pos = lex_skip(mod_source, mod_pos)
                    for {
                        mod_pos = lex_skip(mod_source, mod_pos)
                        mod_kind := lex_kind(mod_source, mod_pos)
                        if mod_kind == TK_EOF { break }
                        if mod_kind == TK_PACKAGE {
                            mod_pos = lex_end(mod_source, mod_pos, mod_kind)
                            mod_pos = lex_skip(mod_source, mod_pos)
                            mod_pos = lex_end(mod_source, mod_pos, lex_kind(mod_source, mod_pos))
                        } else if mod_kind == TK_IMPORT {
                            mod_import_result := parse_import_decl(mod_source, mod_pos, nodes)
                            mod_pos = mod_import_result.new_pos
                            mod_pos = lex_skip(mod_source, mod_pos)
                        } else if mod_kind == TK_STRUCT {
                            mod_struct_result := parse_struct_decl(mod_source, mod_pos, nodes)
                            mod_pos = mod_struct_result.new_pos
                        } else if mod_kind == TK_ENUM {
                            mod_enum_result := parse_enum_decl(mod_source, mod_pos, nodes)
                            mod_pos = mod_enum_result.new_pos
                        } else if mod_kind == TK_CONST {
                            mod_const := parse_const_decl(mod_source, mod_pos, nodes)
                            if mod_const.node_idx >= 0 {
                                register_const(nodes, mod_const.node_idx)
                            }
                            mod_pos = mod_const.new_pos
                        } else if mod_kind == TK_IDENT {
                            mod_ce_end := lex_end(mod_source, mod_pos, mod_kind)
                            mod_ce_next := lex_skip(mod_source, mod_ce_end)
                            if lex_kind(mod_source, mod_ce_next) == TK_COLONEQUAL {
                                mod_ce := parse_colonequal_stmt(mod_source, mod_pos, nodes)
                                if mod_ce.node_idx >= 0 {
                                    mod_ce_node := nodes[mod_ce.node_idx]
                                    push(global_var_names, mod_ce_node.str_val)
                                    push(g_global_var_types, infer_init_type(nodes, mod_ce_node.right))
                                    if mod_ce_node.right >= 0 {
                                        mod_ce_init := nodes[mod_ce_node.right]
                                        if mod_ce_init.tag == EXPR_INT {
                                            push(g_scalar_globals, mod_ce_node.str_val)
                                        }
                                        if mod_ce_init.tag == EXPR_UNARY {
                                            push(g_scalar_globals, mod_ce_node.str_val)
                                        }
                                    }
                                }
                                mod_pos = mod_ce.new_pos
                            } else {
                                break
                            }
                        } else if mod_kind == TK_FN {
                            mod_func_result := parse_func_decl(mod_source, mod_pos, nodes)
                            if mod_func_result.node_idx < 0 { break }
                            mod_func_idx := mod_func_result.node_idx
                            orig_name := nodes[mod_func_idx].str_val
                            push(mod_func_names, orig_name)
                            push(mod_func_indices, mod_func_idx)
                            mod_pos = mod_func_result.new_pos
                            mod_pos = lex_skip(mod_source, mod_pos)
                        } else {
                            break
                        }
                    }

                    mfi := 0
                    for mfi < len(mod_func_names) {
                        qualified := mod_name + "." + mod_func_names[mfi]
                        push(func_names, qualified)
                        push(func_indices, mod_func_indices[mfi])
                        push(g_rename_from, mod_func_names[mfi])
                        push(g_rename_to, qualified)
                        mfi = mfi + 1
                    }
                }
            }
        }
        imp_i = imp_i + 1
    }

    // Load stdlib modules (io, strings, os, strconv, testing, time)
    stdlib_mods := []string{"./ease/io", "./ease/strings", "./ease/os", "./ease/strconv", "./ease/testing", "./ease/time", "./ease/result", "./ease/json"}
    smi := 0
    for smi < len(stdlib_mods) {
        smod_path := stdlib_mods[smi]
        smod_name := extract_module_name(smod_path)

        already_loaded := 0
        ali := 0
        for ali < len(g_import_names) {
            if g_import_names[ali] == smod_name {
                already_loaded = 1
                break
            }
            ali = ali + 1
        }
        if already_loaded == 0 {

        // Try bootstrap/ease/{name} for stdlib
        smod_resolved := "bootstrap/ease/" + smod_name
        smod_is_dir := os.IsDir(smod_resolved)
        if smod_is_dir == 0 {
            smod_resolved = smod_resolved + ".ease"
        }

        push(g_import_paths, smod_resolved)
        push(g_import_names, smod_name)

        smod_files := []string{}
        if smod_is_dir == 1 {
            smod_entries := os.ListDir(smod_resolved)
            sepos := 0
            sestart := 0
            smod_entries_len := len(smod_entries)
            for sepos <= smod_entries_len {
                if sepos == smod_entries_len || str_char_at(smod_entries, sepos) == 10 {
                    if sepos > sestart {
                        smod_entry := str_substring(smod_entries, sestart, sepos)
                        if has_ease_suffix(smod_entry) == 1 {
                            push(smod_files, smod_resolved + "/" + smod_entry)
                        }
                    }
                    sestart = sepos + 1
                }
                sepos = sepos + 1
            }
        } else {
            push(smod_files, smod_resolved)
        }

        sfi := 0
        for sfi < len(smod_files) {
            smod_file := smod_files[sfi]
            smod_source := os.ReadFile(smod_file)
            smod_pos := 0
            smod_pos = lex_skip(smod_source, smod_pos)
            for {
                smod_pos = lex_skip(smod_source, smod_pos)
                smod_kind := lex_kind(smod_source, smod_pos)
                if smod_kind == TK_EOF { break }
                if smod_kind == TK_PACKAGE {
                    smod_pos = lex_end(smod_source, smod_pos, smod_kind)
                    smod_pos = lex_skip(smod_source, smod_pos)
                    smod_pos = lex_end(smod_source, smod_pos, lex_kind(smod_source, smod_pos))
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_FN {
                    smod_result := parse_func_decl(smod_source, smod_pos, nodes)
                    if smod_result.node_idx < 0 { break }
                    smod_func_idx := smod_result.node_idx
                    smod_orig := nodes[smod_func_idx].str_val
                    smod_qualified := smod_name + "." + smod_orig
                    push(func_names, smod_qualified)
                    push(func_indices, smod_func_idx)
                    push(g_rename_from, smod_orig)
                    push(g_rename_to, smod_qualified)
                    smod_pos = smod_result.new_pos
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_STRUCT {
                    smod_struct := parse_struct_decl(smod_source, smod_pos, nodes)
                    smod_pos = smod_struct.new_pos
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_ENUM {
                    smod_enum := parse_enum_decl(smod_source, smod_pos, nodes)
                    smod_pos = smod_enum.new_pos
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_CONST {
                    smod_const := parse_const_decl(smod_source, smod_pos, nodes)
                    if smod_const.node_idx >= 0 {
                        register_const(nodes, smod_const.node_idx)
                    }
                    smod_pos = smod_const.new_pos
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_IDENT {
                    smod_ce_end := lex_end(smod_source, smod_pos, smod_kind)
                    smod_ce_next := lex_skip(smod_source, smod_ce_end)
                    if lex_kind(smod_source, smod_ce_next) == TK_COLONEQUAL {
                        smod_ce := parse_colonequal_stmt(smod_source, smod_pos, nodes)
                        if smod_ce.node_idx >= 0 {
                            smod_ce_node := nodes[smod_ce.node_idx]
                            push(global_var_names, smod_ce_node.str_val)
                            push(g_global_var_types, infer_init_type(nodes, smod_ce_node.right))
                            if smod_ce_node.right >= 0 {
                                smod_ce_init := nodes[smod_ce_node.right]
                                if smod_ce_init.tag == EXPR_INT {
                                    push(g_scalar_globals, smod_ce_node.str_val)
                                }
                                if smod_ce_init.tag == EXPR_UNARY {
                                    push(g_scalar_globals, smod_ce_node.str_val)
                                }
                            }
                        }
                        smod_pos = smod_ce.new_pos
                        smod_pos = lex_skip(smod_source, smod_pos)
                    } else {
                        smod_pos = lex_end(smod_source, smod_pos, smod_kind)
                        smod_pos = lex_skip(smod_source, smod_pos)
                    }
                } else {
                    smod_pos = lex_end(smod_source, smod_pos, smod_kind)
                    smod_pos = lex_skip(smod_source, smod_pos)
                }
            }
            sfi = sfi + 1
        }

        } // end if not already_loaded
        smi = smi + 1
    }

    // Bridge print -> io.Print
    push(g_rename_from, "print")
    push(g_rename_to, "io.Print")

    // Build struct field type registry
    sfi := 0
    nodes_len := len(nodes)
    for sfi < nodes_len {
        if nodes[sfi].tag == DECL_STRUCT {
            struct_name := nodes[sfi].str_val
            field_names_list := []string{}
            fi := nodes[sfi].left
            if fi >= 0 {
                field_idx := 0
                for fi < nodes_len {
                    if nodes[fi].tag != DECL_FIELD { break }
                    push(field_names_list, nodes[fi].str_val)
                    if nodes[fi].type_tag != TYPE_UNKNOWN {
                        register_field_type(nodes[fi].str_val, nodes[fi].type_tag, nodes[fi].int_val)
                    }
                    RegisterFieldOffset(nodes[fi].str_val, field_idx * 8)
                    field_idx = field_idx + 1
                    fi = fi + 1
                }
            }
            RegisterStruct(struct_name, field_names_list)
        }
        sfi = sfi + 1
    }

    // Register enums
    efi := 0
    for efi < nodes_len {
        if nodes[efi].tag == DECL_ENUM {
            ename := nodes[efi].str_val
            evariants := []string{}
            efield_counts := []int{}
            efield_names := []string{}
            efield_types := []int{}
            evi := nodes[efi].left
            evc := nodes[efi].int_val
            evci := 0
            for evci < evc {
                if evi >= nodes_len { break }
                if nodes[evi].tag != DECL_VARIANT { break }
                push(evariants, nodes[evi].str_val)
                vfi := nodes[evi].left
                vfc := 0
                if vfi >= 0 {
                    for vfi < nodes_len {
                        if nodes[vfi].tag != DECL_FIELD { break }
                        push(efield_names, nodes[vfi].str_val)
                        push(efield_types, nodes[vfi].type_tag)
                        vfc = vfc + 1
                        vfi = vfi + 1
                    }
                }
                push(efield_counts, vfc)
                evi = evi + 1
                evci = evci + 1
            }
            RegisterEnum(ename, evariants, efield_counts, efield_names, efield_types)
        }
        efi = efi + 1
    }

    // Build function return type registry
    register_func_return_type("os.Argv", TYPE_STRING, 0, "")
    register_func_return_type("os.IsDir", TYPE_INT, 0, "")
    register_func_return_type("os.ListDir", TYPE_STRING, 0, "")

    // Build method registry from parser side table
    mri := 0
    for mri < len(g_method_decl_node_idx) {
        mstruct := g_method_decl_struct[mri]
        mmethod := g_method_decl_name[mri]
        mfunc := mstruct + "_" + mmethod
        push(g_method_struct_names, mstruct)
        push(g_method_names, mmethod)
        push(g_method_func_names, mfunc)
        mri = mri + 1
    }

    reg_i := 0
    for reg_i < len(func_indices) {
        fn_node := nodes[func_indices[reg_i]]
        ret_sname := lookup_type_name(func_indices[reg_i])
        register_func_return_type(func_names[reg_i], fn_node.type_tag, fn_node.int_val, ret_sname)
        reg_i = reg_i + 1
    }

    // IR Generation — compile all user functions
    instrs := []IRInstr{}

    fn_count := len(func_names)
    gen_all_i := 0
    for gen_all_i < fn_count {
        g_param_types_start = len(g_param_types)
        g_param_struct_names_start = len(g_param_struct_names)

        func_idx := func_indices[gen_all_i]
        func_name := func_names[gen_all_i]
        param_count := count_func_params(nodes, func_idx)

        func_label := 5000 + gen_all_i
        label_instr := IRInstr {
            op: OP_LABEL,
            dest: func_label,
            arg1: param_count,
            arg2: 0,
            arg3: 0,
            str_val: func_name
        }
        push(instrs, label_instr)

        symtab_names := []string{}
        symtab_vregs := []int{}
        gvi := 0
        for gvi < len(global_var_names) {
            push(symtab_names, global_var_names[gvi])
            push(symtab_vregs, -1000 - gvi)
            gvi = gvi + 1
        }
        // Add constants to symtab with sentinel vregs (<= -2000)
        ci := 0
        for ci < len(g_const_names) {
            push(symtab_names, g_const_names[ci])
            push(symtab_vregs, -2000 - ci)
            ci = ci + 1
        }
        gen_ir_from_ast_with_symtab(func_idx, nodes, instrs, symtab_names, symtab_vregs)
        gen_all_i = gen_all_i + 1
    }

    // Generate synthetic test runner main()
    // This replaces the user's main() with a test harness

    // Emit function label for main
    main_label := 5000 + fn_count
    push(instrs, IRInstr { op: OP_LABEL, dest: main_label, arg1: 0, arg2: 0, arg3: 0, str_val: "main" })

    // Initialize failed counter: failed = 0
    failed_vreg := len(instrs)
    push(instrs, IRInstr { op: OP_LOADCONST, dest: failed_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

    zero_vreg := len(instrs)
    push(instrs, IRInstr { op: OP_LOADCONST, dest: zero_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

    one_vreg := len(instrs)
    push(instrs, IRInstr { op: OP_LOADCONST, dest: one_vreg, arg1: 1, arg2: 0, arg3: 0, str_val: "" })

    // For each test function, generate:
    //   io.Print("=== RUN   TestXxx\n")
    //   result = setjmp()
    //   if result == 0 { call TestXxx(); io.Print("--- PASS: TestXxx\n"); jump next }
    //   else { io.Print("--- FAIL: TestXxx\n"); failed++ ; jump next }
    //   next:
    ti := 0
    for ti < len(test_func_names) {
        tname := test_func_names[ti]

        // Print "=== RUN   TestXxx\n" via io.Print
        run_msg_vreg := len(instrs)
        push(instrs, IRInstr { op: OP_LOADCONST, dest: run_msg_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "=== RUN   " + tname + "\n" })
        push(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: run_msg_vreg, arg2: -1, arg3: 0, str_val: "" })
        run_call := len(instrs)
        push(instrs, IRInstr { op: OP_CALL, dest: run_call, arg1: 0, arg2: 1, arg3: 0, str_val: "io.Print" })

        // setjmp
        sjmp_vreg := len(instrs)
        push(instrs, IRInstr { op: OP_SETJMP, dest: sjmp_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

        // Compare: sjmp_vreg == 0 ?
        cmp_vreg := len(instrs)
        push(instrs, IRInstr { op: OP_CMP_EQ, dest: cmp_vreg, arg1: sjmp_vreg, arg2: zero_vreg, arg3: 0, str_val: "" })

        // Branch: if cmp_vreg == 0 (i.e., setjmp returned non-zero = failure), go to fail label
        fail_label := g_next_label
        g_next_label = g_next_label + 1
        next_label := g_next_label
        g_next_label = g_next_label + 1

        push(instrs, IRInstr { op: OP_BRANCH, dest: cmp_vreg, arg1: fail_label, arg2: 0, arg3: 0, str_val: "" })

        // Pass path: create T struct and call TestXxx(t)
        t_alloc := len(instrs)
        push(instrs, IRInstr { op: OP_ALLOCA, dest: t_alloc, arg1: 8, arg2: 0, arg3: 0, str_val: "" })
        name_const := len(instrs)
        push(instrs, IRInstr { op: OP_LOADCONST, dest: name_const, arg1: 0, arg2: 0, arg3: 0, str_val: tname })
        name_addr := len(instrs)
        push(instrs, IRInstr { op: OP_INDEXADDR, dest: name_addr, arg1: t_alloc, arg2: 0, arg3: 0, str_val: "" })
        push(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: name_addr, arg2: name_const, arg3: 0, str_val: "" })
        push(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: t_alloc, arg2: -1, arg3: 0, str_val: "" })
        call_vreg := len(instrs)
        push(instrs, IRInstr { op: OP_CALL, dest: call_vreg, arg1: 0, arg2: 1, arg3: 0, str_val: tname })

        // Print "--- PASS: TestXxx\n" via io.Print
        pass_msg_vreg := len(instrs)
        push(instrs, IRInstr { op: OP_LOADCONST, dest: pass_msg_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "--- PASS: " + tname + "\n" })
        push(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: pass_msg_vreg, arg2: -1, arg3: 0, str_val: "" })
        pass_call := len(instrs)
        push(instrs, IRInstr { op: OP_CALL, dest: pass_call, arg1: 0, arg2: 1, arg3: 0, str_val: "io.Print" })

        // Jump to next
        push(instrs, IRInstr { op: OP_JUMP, dest: next_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

        // Fail path
        push(instrs, IRInstr { op: OP_LABEL, dest: fail_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

        // Print "--- FAIL: TestXxx\n" via io.Print
        fail_msg_vreg := len(instrs)
        push(instrs, IRInstr { op: OP_LOADCONST, dest: fail_msg_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "--- FAIL: " + tname + "\n" })
        push(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: fail_msg_vreg, arg2: -1, arg3: 0, str_val: "" })
        fail_call := len(instrs)
        push(instrs, IRInstr { op: OP_CALL, dest: fail_call, arg1: 0, arg2: 1, arg3: 0, str_val: "io.Print" })

        // Increment failed counter: failed = failed + 1
        new_failed := len(instrs)
        push(instrs, IRInstr { op: OP_ADD, dest: new_failed, arg1: failed_vreg, arg2: one_vreg, arg3: 0, str_val: "" })
        push(instrs, IRInstr { op: OP_COPY, dest: failed_vreg, arg1: new_failed, arg2: 0, arg3: 0, str_val: "" })

        // Jump to next
        push(instrs, IRInstr { op: OP_JUMP, dest: next_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

        // Next label
        push(instrs, IRInstr { op: OP_LABEL, dest: next_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

        ti = ti + 1
    }

    // Benchmark runner — only runs if tests all passed and benchmarks exist
    if len(bench_func_names) > 0 {
        // Skip benchmarks if any test failed: CMP_EQ(failed, 0) → skip if != 0
        bench_skip_cmp := len(instrs)
        push(instrs, IRInstr { op: OP_CMP_EQ, dest: bench_skip_cmp, arg1: failed_vreg, arg2: zero_vreg, arg3: 0, str_val: "" })
        bench_skip_label := g_next_label
        g_next_label = g_next_label + 1
        push(instrs, IRInstr { op: OP_BRANCH, dest: bench_skip_cmp, arg1: bench_skip_label, arg2: 0, arg3: 0, str_val: "" })

        // Constants for benchmark calibration
        billion_vreg := len(instrs)
        push(instrs, IRInstr { op: OP_LOADCONST, dest: billion_vreg, arg1: 1000000000, arg2: 0, arg3: 0, str_val: "" })
        two_vreg := len(instrs)
        push(instrs, IRInstr { op: OP_LOADCONST, dest: two_vreg, arg1: 2, arg2: 0, arg3: 0, str_val: "" })

        bi := 0
        for bi < len(bench_func_names) {
            bname := bench_func_names[bi]

            // Print "BenchmarkXxx\t"
            bname_vreg := len(instrs)
            push(instrs, IRInstr { op: OP_LOADCONST, dest: bname_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: bname + "\t" })
            push(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: bname_vreg, arg2: -1, arg3: 0, str_val: "" })
            bname_call := len(instrs)
            push(instrs, IRInstr { op: OP_CALL, dest: bname_call, arg1: 0, arg2: 1, arg3: 0, str_val: "io.Print" })

            // n = 1
            n_vreg := len(instrs)
            push(instrs, IRInstr { op: OP_LOADCONST, dest: n_vreg, arg1: 1, arg2: 0, arg3: 0, str_val: "" })

            // elapsed = 0
            elapsed_vreg := len(instrs)
            push(instrs, IRInstr { op: OP_LOADCONST, dest: elapsed_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

            // loop_start:
            loop_start_label := g_next_label
            g_next_label = g_next_label + 1
            push(instrs, IRInstr { op: OP_LABEL, dest: loop_start_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

            // Allocate B struct (16 bytes): name at offset 0, n at offset 8
            b_alloc := len(instrs)
            push(instrs, IRInstr { op: OP_ALLOCA, dest: b_alloc, arg1: 16, arg2: 0, arg3: 0, str_val: "" })
            // Set B.name
            b_name_const := len(instrs)
            push(instrs, IRInstr { op: OP_LOADCONST, dest: b_name_const, arg1: 0, arg2: 0, arg3: 0, str_val: bname })
            b_name_addr := len(instrs)
            push(instrs, IRInstr { op: OP_INDEXADDR, dest: b_name_addr, arg1: b_alloc, arg2: 0, arg3: 0, str_val: "" })
            push(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: b_name_addr, arg2: b_name_const, arg3: 0, str_val: "" })
            // Set B.n = n_vreg
            b_n_addr := len(instrs)
            push(instrs, IRInstr { op: OP_INDEXADDR, dest: b_n_addr, arg1: b_alloc, arg2: 8, arg3: 0, str_val: "" })
            push(instrs, IRInstr { op: OP_STORE, dest: -1, arg1: b_n_addr, arg2: n_vreg, arg3: 0, str_val: "" })

            // start = TIME_NANOS()
            start_vreg := len(instrs)
            push(instrs, IRInstr { op: OP_TIME_NANOS, dest: start_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

            // Call BenchmarkXxx(b)
            push(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: b_alloc, arg2: -1, arg3: 0, str_val: "" })
            bench_call := len(instrs)
            push(instrs, IRInstr { op: OP_CALL, dest: bench_call, arg1: 0, arg2: 1, arg3: 0, str_val: bname })

            // end = TIME_NANOS()
            end_vreg := len(instrs)
            push(instrs, IRInstr { op: OP_TIME_NANOS, dest: end_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

            // elapsed = end - start
            new_elapsed := len(instrs)
            push(instrs, IRInstr { op: OP_SUB, dest: new_elapsed, arg1: end_vreg, arg2: start_vreg, arg3: 0, str_val: "" })
            push(instrs, IRInstr { op: OP_COPY, dest: elapsed_vreg, arg1: new_elapsed, arg2: 0, arg3: 0, str_val: "" })

            // ge_cmp = CMP_GE(elapsed, 1_000_000_000)
            ge_cmp := len(instrs)
            push(instrs, IRInstr { op: OP_CMP_GE, dest: ge_cmp, arg1: elapsed_vreg, arg2: billion_vreg, arg3: 0, str_val: "" })

            // If elapsed < 1s (ge_cmp == 0), jump to double_label
            double_label := g_next_label
            g_next_label = g_next_label + 1
            done_label := g_next_label
            g_next_label = g_next_label + 1

            push(instrs, IRInstr { op: OP_BRANCH, dest: ge_cmp, arg1: double_label, arg2: 0, arg3: 0, str_val: "" })

            // Falls through: elapsed >= 1s, jump to done
            push(instrs, IRInstr { op: OP_JUMP, dest: done_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

            // double_label: n = n * 2, goto loop_start
            push(instrs, IRInstr { op: OP_LABEL, dest: double_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            new_n := len(instrs)
            push(instrs, IRInstr { op: OP_MUL, dest: new_n, arg1: n_vreg, arg2: two_vreg, arg3: 0, str_val: "" })
            push(instrs, IRInstr { op: OP_COPY, dest: n_vreg, arg1: new_n, arg2: 0, arg3: 0, str_val: "" })
            push(instrs, IRInstr { op: OP_JUMP, dest: loop_start_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

            // done_label: compute and print results
            push(instrs, IRInstr { op: OP_LABEL, dest: done_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

            // ns_per_op = elapsed / n
            ns_per_op := len(instrs)
            push(instrs, IRInstr { op: OP_DIV, dest: ns_per_op, arg1: elapsed_vreg, arg2: n_vreg, arg3: 0, str_val: "" })

            // Print: n_str + "\t" + ns_per_op_str + " ns/op\n"
            n_str := len(instrs)
            push(instrs, IRInstr { op: OP_INT_TO_STR, dest: n_str, arg1: n_vreg, arg2: 0, arg3: 0, str_val: "" })
            tab_vreg := len(instrs)
            push(instrs, IRInstr { op: OP_LOADCONST, dest: tab_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "\t" })
            nsop_str := len(instrs)
            push(instrs, IRInstr { op: OP_INT_TO_STR, dest: nsop_str, arg1: ns_per_op, arg2: 0, arg3: 0, str_val: "" })
            suffix_vreg := len(instrs)
            push(instrs, IRInstr { op: OP_LOADCONST, dest: suffix_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: " ns/op\n" })

            // Concatenate: n_str + "\t" + nsop_str + " ns/op\n"
            cat1 := len(instrs)
            push(instrs, IRInstr { op: OP_STR_CONCAT, dest: cat1, arg1: n_str, arg2: tab_vreg, arg3: 0, str_val: "" })
            cat2 := len(instrs)
            push(instrs, IRInstr { op: OP_STR_CONCAT, dest: cat2, arg1: cat1, arg2: nsop_str, arg3: 0, str_val: "" })
            cat3 := len(instrs)
            push(instrs, IRInstr { op: OP_STR_CONCAT, dest: cat3, arg1: cat2, arg2: suffix_vreg, arg3: 0, str_val: "" })

            // Print result line
            push(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: cat3, arg2: -1, arg3: 0, str_val: "" })
            bench_print_call := len(instrs)
            push(instrs, IRInstr { op: OP_CALL, dest: bench_print_call, arg1: 0, arg2: 1, arg3: 0, str_val: "io.Print" })

            bi = bi + 1
        }

        // bench_skip_label — falls through to summary
        push(instrs, IRInstr { op: OP_LABEL, dest: bench_skip_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    }

    // Print summary via io.Print
    // if failed > 0: print "FAIL\n" and return 1; else print "ok\n" and return 0
    summary_cmp := len(instrs)
    push(instrs, IRInstr { op: OP_CMP_GT, dest: summary_cmp, arg1: failed_vreg, arg2: zero_vreg, arg3: 0, str_val: "" })

    summary_fail_label := g_next_label
    g_next_label = g_next_label + 1

    push(instrs, IRInstr { op: OP_BRANCH, dest: summary_cmp, arg1: summary_fail_label, arg2: 0, arg3: 0, str_val: "" })

    // failed > 0 path: print FAIL, return 1
    fail_str_vreg := len(instrs)
    push(instrs, IRInstr { op: OP_LOADCONST, dest: fail_str_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "FAIL\n" })
    push(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: fail_str_vreg, arg2: -1, arg3: 0, str_val: "" })
    fail_sum_call := len(instrs)
    push(instrs, IRInstr { op: OP_CALL, dest: fail_sum_call, arg1: 0, arg2: 1, arg3: 0, str_val: "io.Print" })
    push(instrs, IRInstr { op: OP_RET, dest: one_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

    // failed == 0 path: print ok, return 0
    push(instrs, IRInstr { op: OP_LABEL, dest: summary_fail_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    ok_str_vreg := len(instrs)
    push(instrs, IRInstr { op: OP_LOADCONST, dest: ok_str_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "ok\n" })
    push(instrs, IRInstr { op: OP_ARG, dest: 0, arg1: ok_str_vreg, arg2: -1, arg3: 0, str_val: "" })
    ok_sum_call := len(instrs)
    push(instrs, IRInstr { op: OP_CALL, dest: ok_sum_call, arg1: 0, arg2: 1, arg3: 0, str_val: "io.Print" })
    push(instrs, IRInstr { op: OP_RET, dest: zero_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })

    // LLVM IR Generation
    output_ll := "./tmp/output.ll"
    result := emit_llvm_ir(instrs, output_ll)
    if result != 0 {
        return 1
    }

    return 0
}

fn main() -> int {
    // Check for test mode: ease test <path> [--bench]
    argc := os.Argc()
    if argc > 1 {
        if os.Argv(1) == "test" {
            test_path := "."
            run_bench := 0
            argi := 2
            for argi < argc {
                arg := os.Argv(argi)
                if arg == "--bench" {
                    run_bench = 1
                } else {
                    test_path = arg
                }
                argi = argi + 1
            }
            return run_test_mode(test_path, run_bench)
        }
        if os.Argv(1) == "lsp" {
            return lsp.Run()
        }
    }

    // Get command-line arguments
    source := ""
    filename := ""

    if argc > 1 {
        filename = os.Argv(1)
        source = os.ReadFile(filename)
    } else {
        print("ERROR: No input file specified\n")
        print("Usage: compiler <source.ease>\n")
        return 1
    }

    push(g_current_file_list, filename)

    // Phase 1: Lexing
    pos := 0
    token_count := 0
    for {
        pos = lex_skip(source, pos)
        kind := lex_kind(source, pos)
        if kind == TK_EOF {
            if pos < len(source) {
                report_error(source, pos, "unexpected character")
                pos = pos + 1
            } else {
                break
            }
        } else {
            token_count = token_count + 1
            pos = lex_end(source, pos, kind)
        }
    }
    // Phase 2: Parsing
    nodes := []AstNode{}
    parse_pos := 0
    parse_pos = lex_skip(source, parse_pos)
    import_count := 0
    struct_count := 0
    func_names := []string{}
    func_indices := []int{}
    global_var_names := []string{}

    for {
        parse_pos = lex_skip(source, parse_pos)
        kind := lex_kind(source, parse_pos)
        if kind == TK_EOF { break }

        if kind == TK_PACKAGE {
            // Skip: package <name>
            parse_pos = lex_end(source, parse_pos, kind)
            parse_pos = lex_skip(source, parse_pos)
            parse_pos = lex_end(source, parse_pos, lex_kind(source, parse_pos))
        } else if kind == TK_IMPORT {
            import_result := parse_import_decl(source, parse_pos, nodes)
            if import_result.node_idx >= 0 {
                import_count = import_count + 1
                parse_pos = import_result.new_pos
                parse_pos = lex_skip(source, parse_pos)
            } else {
                break
            }
        } else if kind == TK_STRUCT {
            struct_result := parse_struct_decl(source, parse_pos, nodes)
            struct_count = struct_count + 1
            parse_pos = struct_result.new_pos
        } else if kind == TK_ENUM {
            enum_result := parse_enum_decl(source, parse_pos, nodes)
            parse_pos = enum_result.new_pos
        } else if kind == TK_CONST {
            const_result := parse_const_decl(source, parse_pos, nodes)
            if const_result.node_idx >= 0 {
                register_const(nodes, const_result.node_idx)
            }
            parse_pos = const_result.new_pos
        } else if kind == TK_IDENT {
            // Check for := global declaration
            ce_saved := parse_pos
            ce_end := lex_end(source, parse_pos, kind)
            ce_next_pos := lex_skip(source, ce_end)
            if lex_kind(source, ce_next_pos) == TK_COLONEQUAL {
                ce_result := parse_colonequal_stmt(source, parse_pos, nodes)
                if ce_result.node_idx >= 0 {
                    ce_node := nodes[ce_result.node_idx]
                    push(global_var_names, ce_node.str_val)
                    push(g_global_var_types, infer_init_type(nodes, ce_node.right))
                    if ce_node.right >= 0 {
                        ce_init := nodes[ce_node.right]
                        if ce_init.tag == EXPR_INT {
                            push(g_scalar_globals, ce_node.str_val)
                        }
                        if ce_init.tag == EXPR_UNARY {
                            push(g_scalar_globals, ce_node.str_val)
                        }
                    }
                }
                parse_pos = ce_result.new_pos
            } else {
                break
            }
        } else if kind == TK_FN {
            parse_result := parse_func_decl(source, parse_pos, nodes)
            if parse_result.node_idx < 0 {
                report_error(source, parse_pos, "failed to parse function")
                break
            }
            func_idx := parse_result.node_idx
            func_node := nodes[func_idx]
            push(func_names, func_node.str_val)
            push(func_indices, func_idx)
            parse_pos = parse_result.new_pos
            parse_pos = lex_skip(source, parse_pos)
        } else {
            break
        }
    }

    // Process imports: scan for DECL_IMPORT nodes, read and parse imported modules
    // Uses rename table approach (no AST node mutation) for bootstrap parser compatibility
    imp_i := 0
    main_node_count := len(nodes)
    for imp_i < main_node_count {
        if nodes[imp_i].tag == DECL_IMPORT {
            import_path := nodes[imp_i].str_val
            // Skip stdlib imports (no "./" prefix) — handled by builtin dispatch
            if len(import_path) >= 2 && str_char_at(import_path, 0) == 46 && str_char_at(import_path, 1) == 47 {
                mod_name := extract_module_name(import_path)
                resolved := resolve_import_path(filename, import_path)
                is_dir := os.IsDir(resolved)

                mod_func_names := []string{}
                mod_func_indices := []int{}

                if is_dir == 1 {
                    // Directory package: load all .ease files
                    push(g_import_paths, resolved)
                    push(g_import_names, mod_name)

                    entries := os.ListDir(resolved)
                    epos := 0
                    estart := 0
                    entries_len := len(entries)
                    for epos <= entries_len {
                        // Process entry at newline or end of string
                        if epos == entries_len || str_char_at(entries, epos) == 10 {
                            if epos > estart {
                                entry := str_substring(entries, estart, epos)
                                if has_ease_suffix(entry) == 1 {
                                    file_path := resolved + "/" + entry
                                    push(g_current_file_list, file_path)
                                    dir_source := os.ReadFile(file_path)
                                    dir_pos := 0
                                    dir_pos = lex_skip(dir_source, dir_pos)
                                    for {
                                        dir_pos = lex_skip(dir_source, dir_pos)
                                        dir_kind := lex_kind(dir_source, dir_pos)
                                        if dir_kind == TK_EOF { break }
                                        if dir_kind == TK_PACKAGE {
                                            // Skip: package <name>
                                            dir_pos = lex_end(dir_source, dir_pos, dir_kind)
                                            dir_pos = lex_skip(dir_source, dir_pos)
                                            dir_pos = lex_end(dir_source, dir_pos, lex_kind(dir_source, dir_pos))
                                        } else if dir_kind == TK_IMPORT {
                                            dir_imp := parse_import_decl(dir_source, dir_pos, nodes)
                                            dir_pos = dir_imp.new_pos
                                            dir_pos = lex_skip(dir_source, dir_pos)
                                        } else if dir_kind == TK_STRUCT {
                                            dir_struct := parse_struct_decl(dir_source, dir_pos, nodes)
                                            dir_pos = dir_struct.new_pos
                                        } else if dir_kind == TK_ENUM {
                                            dir_enum := parse_enum_decl(dir_source, dir_pos, nodes)
                                            dir_pos = dir_enum.new_pos
                                        } else if dir_kind == TK_CONST {
                                            dir_const := parse_const_decl(dir_source, dir_pos, nodes)
                                            if dir_const.node_idx >= 0 {
                                                register_const(nodes, dir_const.node_idx)
                                            }
                                            dir_pos = dir_const.new_pos
                                        } else if dir_kind == TK_IDENT {
                                            dir_ce_end := lex_end(dir_source, dir_pos, dir_kind)
                                            dir_ce_next := lex_skip(dir_source, dir_ce_end)
                                            if lex_kind(dir_source, dir_ce_next) == TK_COLONEQUAL {
                                                dir_ce := parse_colonequal_stmt(dir_source, dir_pos, nodes)
                                                if dir_ce.node_idx >= 0 {
                                                    dir_ce_node := nodes[dir_ce.node_idx]
                                                    push(global_var_names, dir_ce_node.str_val)
                                                    push(g_global_var_types, infer_init_type(nodes, dir_ce_node.right))
                                                    if dir_ce_node.right >= 0 {
                                                        dir_ce_init := nodes[dir_ce_node.right]
                                                        if dir_ce_init.tag == EXPR_INT {
                                                            push(g_scalar_globals, dir_ce_node.str_val)
                                                        }
                                                        if dir_ce_init.tag == EXPR_UNARY {
                                                            push(g_scalar_globals, dir_ce_node.str_val)
                                                        }
                                                    }
                                                }
                                                dir_pos = dir_ce.new_pos
                                            } else {
                                                break
                                            }
                                        } else if dir_kind == TK_FN {
                                            dir_func := parse_func_decl(dir_source, dir_pos, nodes)
                                            if dir_func.node_idx < 0 {
                                                report_error(dir_source, dir_pos, "failed to parse function")
                                                break
                                            }
                                            dir_func_idx := dir_func.node_idx
                                            dir_orig := nodes[dir_func_idx].str_val
                                            push(mod_func_names, dir_orig)
                                            push(mod_func_indices, dir_func_idx)
                                            dir_pos = dir_func.new_pos
                                            dir_pos = lex_skip(dir_source, dir_pos)
                                        } else {
                                            break
                                        }
                                    }
                                }
                            }
                            estart = epos + 1
                        }
                        epos = epos + 1
                    }

                    // Register functions with visibility enforcement
                    // All functions get compiled with qualified names
                    // Only uppercase (exported) functions are added to rename table
                    mfi := 0
                    for mfi < len(mod_func_names) {
                        qualified := mod_name + "." + mod_func_names[mfi]
                        push(func_names, qualified)
                        push(func_indices, mod_func_indices[mfi])
                        if is_exported(mod_func_names[mfi]) == 1 {
                            // Uppercase: accessible from outside the package
                            push(g_rename_from, mod_func_names[mfi])
                            push(g_rename_to, qualified)
                        }
                        // Intra-package calls: functions within the package use
                        // unqualified names that get resolved by the rename table
                        // built from within the package's own functions
                        mfi = mfi + 1
                    }

                    // Build intra-package rename table so functions within the
                    // package can call each other by unqualified names
                    ipfi := 0
                    for ipfi < len(mod_func_names) {
                        // Only add if not already in rename table (avoid duplication with exported ones)
                        if is_exported(mod_func_names[ipfi]) == 0 {
                            push(g_rename_from, mod_func_names[ipfi])
                            push(g_rename_to, mod_name + "." + mod_func_names[ipfi])
                        }
                        ipfi = ipfi + 1
                    }
                } else {
                    // Single file import (existing behavior)
                    push(g_current_file_list, resolved)

                    mod_source := os.ReadFile(resolved)
                    push(g_import_paths, resolved)
                    push(g_import_names, mod_name)

                    // Parse all top-level declarations from the imported module
                    mod_pos := 0
                    mod_pos = lex_skip(mod_source, mod_pos)

                    for {
                        mod_pos = lex_skip(mod_source, mod_pos)
                        mod_kind := lex_kind(mod_source, mod_pos)
                        if mod_kind == TK_EOF { break }

                        if mod_kind == TK_PACKAGE {
                            // Skip: package <name>
                            mod_pos = lex_end(mod_source, mod_pos, mod_kind)
                            mod_pos = lex_skip(mod_source, mod_pos)
                            mod_pos = lex_end(mod_source, mod_pos, lex_kind(mod_source, mod_pos))
                        } else if mod_kind == TK_IMPORT {
                            mod_import_result := parse_import_decl(mod_source, mod_pos, nodes)
                            mod_pos = mod_import_result.new_pos
                            mod_pos = lex_skip(mod_source, mod_pos)
                        } else if mod_kind == TK_STRUCT {
                            mod_struct_result := parse_struct_decl(mod_source, mod_pos, nodes)
                            mod_pos = mod_struct_result.new_pos
                        } else if mod_kind == TK_ENUM {
                            mod_enum_result := parse_enum_decl(mod_source, mod_pos, nodes)
                            mod_pos = mod_enum_result.new_pos
                        } else if mod_kind == TK_CONST {
                            mod_const := parse_const_decl(mod_source, mod_pos, nodes)
                            if mod_const.node_idx >= 0 {
                                register_const(nodes, mod_const.node_idx)
                            }
                            mod_pos = mod_const.new_pos
                        } else if mod_kind == TK_IDENT {
                            mod_ce_end := lex_end(mod_source, mod_pos, mod_kind)
                            mod_ce_next := lex_skip(mod_source, mod_ce_end)
                            if lex_kind(mod_source, mod_ce_next) == TK_COLONEQUAL {
                                mod_ce := parse_colonequal_stmt(mod_source, mod_pos, nodes)
                                if mod_ce.node_idx >= 0 {
                                    mod_ce_node := nodes[mod_ce.node_idx]
                                    push(global_var_names, mod_ce_node.str_val)
                                    push(g_global_var_types, infer_init_type(nodes, mod_ce_node.right))
                                    if mod_ce_node.right >= 0 {
                                        mod_ce_init := nodes[mod_ce_node.right]
                                        if mod_ce_init.tag == EXPR_INT {
                                            push(g_scalar_globals, mod_ce_node.str_val)
                                        }
                                        if mod_ce_init.tag == EXPR_UNARY {
                                            push(g_scalar_globals, mod_ce_node.str_val)
                                        }
                                    }
                                }
                                mod_pos = mod_ce.new_pos
                            } else {
                                break
                            }
                        } else if mod_kind == TK_FN {
                            mod_func_result := parse_func_decl(mod_source, mod_pos, nodes)
                            if mod_func_result.node_idx < 0 {
                                report_error(mod_source, mod_pos, "failed to parse function")
                                break
                            }
                            mod_func_idx := mod_func_result.node_idx
                            orig_name := nodes[mod_func_idx].str_val
                            push(mod_func_names, orig_name)
                            push(mod_func_indices, mod_func_idx)
                            mod_pos = mod_func_result.new_pos
                            mod_pos = lex_skip(mod_source, mod_pos)
                        } else {
                            break
                        }
                    }

                    // Register imported functions with qualified names (flat merge)
                    // Add to rename table so internal calls get resolved
                    mfi := 0
                    for mfi < len(mod_func_names) {
                        qualified := mod_name + "." + mod_func_names[mfi]
                        push(func_names, qualified)
                        push(func_indices, mod_func_indices[mfi])
                        push(g_rename_from, mod_func_names[mfi])
                        push(g_rename_to, qualified)
                        mfi = mfi + 1
                    }
                }
            }
        }
        imp_i = imp_i + 1
    }

    // Load bootstrap stdlib modules programmatically (not via import declarations,
    // because the Go compiler's sema would reject them due to builtin conflicts)
    stdlib_mods := []string{"./ease/io", "./ease/strings", "./ease/os", "./ease/strconv", "./ease/time", "./ease/result", "./ease/json", "./ease/lsp"}
    smi := 0
    for smi < len(stdlib_mods) {
        smod_path := stdlib_mods[smi]
        smod_name := extract_module_name(smod_path)

        // Skip if this module was already loaded via import declarations
        already_loaded := 0
        ali := 0
        for ali < len(g_import_names) {
            if g_import_names[ali] == smod_name {
                already_loaded = 1
                break
            }
            ali = ali + 1
        }
        if already_loaded == 0 {

        smod_resolved := resolve_import_path(filename, smod_path)

        // Fallback: if source-relative path doesn't exist, try bootstrap/ease/{name}
        smod_is_dir := os.IsDir(smod_resolved)
        if smod_is_dir == 0 {
            fallback := "bootstrap/ease/" + smod_name
            if os.IsDir(fallback) == 1 {
                smod_resolved = fallback
                smod_is_dir = 1
            }
        }

        push(g_import_paths, smod_resolved)
        push(g_import_names, smod_name)

        // Collect files to parse: if directory, list .ease files; otherwise single file
        smod_files := []string{}
        if smod_is_dir == 1 {
            smod_entries := os.ListDir(smod_resolved)
            sepos := 0
            sestart := 0
            smod_entries_len := len(smod_entries)
            for sepos <= smod_entries_len {
                if sepos == smod_entries_len || str_char_at(smod_entries, sepos) == 10 {
                    if sepos > sestart {
                        smod_entry := str_substring(smod_entries, sestart, sepos)
                        if has_ease_suffix(smod_entry) == 1 {
                            push(smod_files, smod_resolved + "/" + smod_entry)
                        }
                    }
                    sestart = sepos + 1
                }
                sepos = sepos + 1
            }
        } else {
            push(smod_files, smod_resolved)
        }

        sfi := 0
        for sfi < len(smod_files) {
            smod_file := smod_files[sfi]
            smod_source := os.ReadFile(smod_file)
            smod_pos := 0
            smod_pos = lex_skip(smod_source, smod_pos)
            for {
                smod_pos = lex_skip(smod_source, smod_pos)
                smod_kind := lex_kind(smod_source, smod_pos)
                if smod_kind == TK_EOF { break }
                if smod_kind == TK_PACKAGE {
                    // Skip: package <name>
                    smod_pos = lex_end(smod_source, smod_pos, smod_kind)
                    smod_pos = lex_skip(smod_source, smod_pos)
                    smod_pos = lex_end(smod_source, smod_pos, lex_kind(smod_source, smod_pos))
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_FN {
                    smod_result := parse_func_decl(smod_source, smod_pos, nodes)
                    if smod_result.node_idx < 0 { break }
                    smod_func_idx := smod_result.node_idx
                    smod_orig := nodes[smod_func_idx].str_val
                    smod_qualified := smod_name + "." + smod_orig
                    push(func_names, smod_qualified)
                    push(func_indices, smod_func_idx)
                    push(g_rename_from, smod_orig)
                    push(g_rename_to, smod_qualified)
                    smod_pos = smod_result.new_pos
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_STRUCT {
                    smod_struct := parse_struct_decl(smod_source, smod_pos, nodes)
                    smod_pos = smod_struct.new_pos
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_ENUM {
                    smod_enum := parse_enum_decl(smod_source, smod_pos, nodes)
                    smod_pos = smod_enum.new_pos
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_CONST {
                    smod_const := parse_const_decl(smod_source, smod_pos, nodes)
                    if smod_const.node_idx >= 0 {
                        register_const(nodes, smod_const.node_idx)
                    }
                    smod_pos = smod_const.new_pos
                    smod_pos = lex_skip(smod_source, smod_pos)
                } else if smod_kind == TK_IDENT {
                    smod_ce_end := lex_end(smod_source, smod_pos, smod_kind)
                    smod_ce_next := lex_skip(smod_source, smod_ce_end)
                    if lex_kind(smod_source, smod_ce_next) == TK_COLONEQUAL {
                        smod_ce := parse_colonequal_stmt(smod_source, smod_pos, nodes)
                        if smod_ce.node_idx >= 0 {
                            smod_ce_node := nodes[smod_ce.node_idx]
                            push(global_var_names, smod_ce_node.str_val)
                            push(g_global_var_types, infer_init_type(nodes, smod_ce_node.right))
                            if smod_ce_node.right >= 0 {
                                smod_ce_init := nodes[smod_ce_node.right]
                                if smod_ce_init.tag == EXPR_INT {
                                    push(g_scalar_globals, smod_ce_node.str_val)
                                }
                                if smod_ce_init.tag == EXPR_UNARY {
                                    push(g_scalar_globals, smod_ce_node.str_val)
                                }
                            }
                        }
                        smod_pos = smod_ce.new_pos
                        smod_pos = lex_skip(smod_source, smod_pos)
                    } else {
                        smod_pos = lex_end(smod_source, smod_pos, smod_kind)
                        smod_pos = lex_skip(smod_source, smod_pos)
                    }
                } else {
                    // Skip comments and non-function declarations
                    smod_pos = lex_end(smod_source, smod_pos, smod_kind)
                    smod_pos = lex_skip(smod_source, smod_pos)
                }
            }
            sfi = sfi + 1
        }

        } // end if (not already_loaded)
        smi = smi + 1
    }

    // Bridge lowercase "print" callers to uppercase "io.Print"
    push(g_rename_from, "print")
    push(g_rename_to, "io.Print")

    // Build struct field type registry and dynamic struct registry from parsed DECL_STRUCT nodes
    sfi := 0
    nodes_len := len(nodes)
    for sfi < nodes_len {
        if nodes[sfi].tag == DECL_STRUCT {
            struct_name := nodes[sfi].str_val
            field_names_list := []string{}
            // Walk consecutive DECL_FIELD nodes starting at struct.left
            fi := nodes[sfi].left
            if fi >= 0 {
                field_idx := 0
                for fi < nodes_len {
                    if nodes[fi].tag != DECL_FIELD { break }
                    push(field_names_list, nodes[fi].str_val)
                    if nodes[fi].type_tag != TYPE_UNKNOWN {
                        register_field_type(nodes[fi].str_val, nodes[fi].type_tag, nodes[fi].int_val)
                    }
                    RegisterFieldOffset(nodes[fi].str_val, field_idx * 8)
                    field_idx = field_idx + 1
                    fi = fi + 1
                }
            }
            RegisterStruct(struct_name, field_names_list)
        }
        sfi = sfi + 1
    }

    // Register enums
    efi := 0
    for efi < nodes_len {
        if nodes[efi].tag == DECL_ENUM {
            ename := nodes[efi].str_val
            evariants := []string{}
            efield_counts := []int{}
            efield_names := []string{}
            efield_types := []int{}
            // Walk consecutive DECL_VARIANT nodes starting at enum.left
            evi := nodes[efi].left
            evc := nodes[efi].int_val
            evci := 0
            for evci < evc {
                if evi >= nodes_len { break }
                if nodes[evi].tag != DECL_VARIANT { break }
                push(evariants, nodes[evi].str_val)
                // Count fields for this variant
                vfi := nodes[evi].left
                vfc := 0
                if vfi >= 0 {
                    for vfi < nodes_len {
                        if nodes[vfi].tag != DECL_FIELD { break }
                        push(efield_names, nodes[vfi].str_val)
                        push(efield_types, nodes[vfi].type_tag)
                        vfc = vfc + 1
                        vfi = vfi + 1
                    }
                }
                push(efield_counts, vfc)
                evi = evi + 1
                evci = evci + 1
            }
            RegisterEnum(ename, evariants, efield_counts, efield_names, efield_types)
        }
        efi = efi + 1
    }

    // Build function return type registry
    // Pre-register built-in functions (no DECL_FUNC nodes for these)
    register_func_return_type("os.Argv", TYPE_STRING, 0, "")
    register_func_return_type("os.IsDir", TYPE_INT, 0, "")
    register_func_return_type("os.ListDir", TYPE_STRING, 0, "")

    // Build method registry from parser side table
    mri := 0
    for mri < len(g_method_decl_node_idx) {
        mstruct := g_method_decl_struct[mri]
        mmethod := g_method_decl_name[mri]
        mfunc := mstruct + "_" + mmethod
        push(g_method_struct_names, mstruct)
        push(g_method_names, mmethod)
        push(g_method_func_names, mfunc)
        mri = mri + 1
    }

    // Register all user-defined functions from parsed declarations
    // Use func_names[i] for the name (which has qualified names for imported functions)
    reg_i := 0
    for reg_i < len(func_indices) {
        fn_node := nodes[func_indices[reg_i]]
        ret_sname := lookup_type_name(func_indices[reg_i])
        register_func_return_type(func_names[reg_i], fn_node.type_tag, fn_node.int_val, ret_sname)
        reg_i = reg_i + 1
    }

    // Phase 3: IR Generation
    instrs := []IRInstr{}

    fn_count := len(func_names)
    gen_all_i := 0
    for gen_all_i < fn_count {
        g_param_types_start = len(g_param_types)
        g_param_struct_names_start = len(g_param_struct_names)

        func_idx := func_indices[gen_all_i]
        func_name := func_names[gen_all_i]
        param_count := count_func_params(nodes, func_idx)

        func_label := 5000 + gen_all_i
        label_instr := IRInstr {
            op: OP_LABEL,
            dest: func_label,
            arg1: param_count,
            arg2: 0,
            arg3: 0,
            str_val: func_name
        }
        push(instrs, label_instr)

        symtab_names := []string{}
        symtab_vregs := []int{}
        // Add global variables to symtab with sentinel vregs (<= -1000)
        gvi := 0
        for gvi < len(global_var_names) {
            push(symtab_names, global_var_names[gvi])
            push(symtab_vregs, -1000 - gvi)
            gvi = gvi + 1
        }
        // Add constants to symtab with sentinel vregs (<= -2000)
        ci := 0
        for ci < len(g_const_names) {
            push(symtab_names, g_const_names[ci])
            push(symtab_vregs, -2000 - ci)
            ci = ci + 1
        }
        gen_ir_from_ast_with_symtab(func_idx, nodes, instrs, symtab_names, symtab_vregs)
        gen_all_i = gen_all_i + 1
    }

    // Phase 4: LLVM IR Generation
    output_ll := "./tmp/output.ll"
    result := emit_llvm_ir(instrs, output_ll)
    if result != 0 {
        return 1
    }

    return 0
}
