// Bootstrap Compiler Integration Demo
// Demonstrates all compilation phases working together:
// Source Code -> Lexer -> Parser -> Sema -> IR -> Codegen

import (
    "strconv"
    "./sha256"
)

// ============================================================================
// Token Definitions (from token.ease)
// ============================================================================

fn TK_IDENT() -> int { return 1 }
fn TK_INT() -> int { return 2 }
fn TK_STRING() -> int { return 3 }

// Keywords
fn TK_FN() -> int { return 10 }
fn TK_LET() -> int { return 11 }
fn TK_MUT() -> int { return 12 }
fn TK_IF() -> int { return 13 }
fn TK_ELSE() -> int { return 14 }
fn TK_FOR() -> int { return 15 }
fn TK_IN() -> int { return 16 }
fn TK_RETURN() -> int { return 17 }
fn TK_BREAK() -> int { return 18 }
fn TK_STRUCT() -> int { return 19 }
fn TK_TRUE() -> int { return 20 }
fn TK_FALSE() -> int { return 21 }
fn TK_IMPORT() -> int { return 22 }

// Arithmetic operators
fn TK_PLUS() -> int { return 30 }
fn TK_MINUS() -> int { return 31 }
fn TK_STAR() -> int { return 32 }
fn TK_SLASH() -> int { return 33 }
fn TK_PERCENT() -> int { return 34 }

// Comparison operators
fn TK_LT() -> int { return 35 }
fn TK_GT() -> int { return 36 }
fn TK_LE() -> int { return 37 }
fn TK_GE() -> int { return 38 }
fn TK_EQ() -> int { return 39 }
fn TK_NE() -> int { return 40 }

// Logical operators
fn TK_AND() -> int { return 41 }
fn TK_OR() -> int { return 42 }
fn TK_NOT() -> int { return 43 }

// Assignment
fn TK_ASSIGN() -> int { return 44 }

// Delimiters
fn TK_ARROW() -> int { return 47 }
fn TK_DOT() -> int { return 48 }
fn TK_DOTDOT() -> int { return 49 }

fn TK_LPAREN() -> int { return 51 }
fn TK_RPAREN() -> int { return 52 }
fn TK_LBRACE() -> int { return 53 }
fn TK_RBRACE() -> int { return 54 }
fn TK_LBRACKET() -> int { return 55 }
fn TK_RBRACKET() -> int { return 56 }
fn TK_COMMA() -> int { return 57 }
fn TK_COLON() -> int { return 58 }
fn TK_SEMI() -> int { return 59 }

fn TK_EOF() -> int { return 100 }

// ============================================================================
// Simplified Lexer (from lexer.ease)
// ============================================================================

fn is_digit(ch: int) -> bool {
    return ch >= 48 && ch <= 57  // '0' to '9'
}

fn is_alpha(ch: int) -> bool {
    return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95  // A-Z, a-z, _
}

fn is_hex_digit(ch: int) -> bool {
    return is_digit(ch) || (ch >= 97 && ch <= 102) || (ch >= 65 && ch <= 70)  // 0-9, a-f, A-F
}

fn lex_peek(src: string, pos: int) -> int {
    if pos >= len(src) {
        return 0
    }
    return str_char_at(src, pos)
}

fn lex_skip(src: string, pos: int) -> int {
    let src_len = len(src)
    let mut p = pos
    for p < src_len {
        let ch = lex_peek(src, p)

        // Skip whitespace
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 {  // space, tab, newline, CR
            p = p + 1
        } else {
            // Check for comments: //
            if ch == 47 && p + 1 < src_len {  // '/' character
                let next_ch = lex_peek(src, p + 1)
                if next_ch == 47 {  // Second '/' - it's a comment
                    // Skip until end of line
                    p = p + 2  // Skip //
                    for p < src_len {
                        let comment_ch = lex_peek(src, p)
                        if comment_ch == 10 || comment_ch == 13 {  // newline or CR
                            break
                        }
                        p = p + 1
                    }
                } else {
                    break  // Not a comment, stop skipping
                }
            } else {
                break  // Not whitespace or comment
            }
        }
    }
    return p
}

fn lex_kind(src: string, pos: int) -> int {
    let src_len = len(src)
    if pos >= src_len {
        return TK_EOF()
    }

    let ch = lex_peek(src, pos)
    let mut next = 0
    if pos + 1 < src_len {
        next = lex_peek(src, pos + 1)
    }

    // Two-character tokens
    if ch == 45 && next == 62 { return TK_ARROW() }      // ->
    if ch == 60 && next == 61 { return TK_LE() }         // <=
    if ch == 62 && next == 61 { return TK_GE() }         // >=
    if ch == 61 && next == 61 { return TK_EQ() }         // ==
    if ch == 33 && next == 61 { return TK_NE() }         // !=
    if ch == 38 && next == 38 { return TK_AND() }        // &&
    if ch == 124 && next == 124 { return TK_OR() }       // ||
    if ch == 46 && next == 46 { return TK_DOTDOT() }     // ..

    // Single-char tokens
    if ch == 40 { return TK_LPAREN() }    // (
    if ch == 41 { return TK_RPAREN() }    // )
    if ch == 123 { return TK_LBRACE() }   // {
    if ch == 125 { return TK_RBRACE() }   // }
    if ch == 91 { return TK_LBRACKET() }  // [
    if ch == 93 { return TK_RBRACKET() }  // ]
    if ch == 44 { return TK_COMMA() }     // ,
    if ch == 58 { return TK_COLON() }     // :
    if ch == 59 { return TK_SEMI() }      // ;
    if ch == 46 { return TK_DOT() }       // .
    if ch == 43 { return TK_PLUS() }      // +
    if ch == 45 { return TK_MINUS() }     // -
    if ch == 42 { return TK_STAR() }      // *
    if ch == 47 { return TK_SLASH() }     // /
    if ch == 37 { return TK_PERCENT() }   // %
    if ch == 60 { return TK_LT() }        // <
    if ch == 62 { return TK_GT() }        // >
    if ch == 61 { return TK_ASSIGN() }    // =
    if ch == 33 { return TK_NOT() }       // !

    // Numbers
    if is_digit(ch) {
        return TK_INT()
    }

    // String literals
    if ch == 34 {  // " character
        return TK_STRING()
    }

    // Identifiers and keywords
    if is_alpha(ch) {
        let mut end = pos
        for end < src_len && (is_alpha(lex_peek(src, end)) || is_digit(lex_peek(src, end))) {
            end = end + 1
        }
        let word = str_substring(src, pos, end)
        if word == "fn" { return TK_FN() }
        if word == "let" { return TK_LET() }
        if word == "mut" { return TK_MUT() }
        if word == "if" { return TK_IF() }
        if word == "else" { return TK_ELSE() }
        if word == "for" { return TK_FOR() }
        if word == "in" { return TK_IN() }
        if word == "return" { return TK_RETURN() }
        if word == "break" { return TK_BREAK() }
        if word == "struct" { return TK_STRUCT() }
        if word == "true" { return TK_TRUE() }
        if word == "false" { return TK_FALSE() }
        if word == "import" { return TK_IMPORT() }
        return TK_IDENT()
    }

    return TK_EOF()
}

fn lex_end(src: string, pos: int, kind: int) -> int {
    if kind == TK_EOF() { return pos }

    // Two-character tokens
    if kind == TK_ARROW() || kind == TK_LE() || kind == TK_GE() ||
       kind == TK_EQ() || kind == TK_NE() || kind == TK_AND() ||
       kind == TK_OR() || kind == TK_DOTDOT() {
        return pos + 2
    }

    // Single-character tokens
    if kind == TK_LPAREN() || kind == TK_RPAREN() || kind == TK_LBRACE() ||
       kind == TK_RBRACE() || kind == TK_LBRACKET() || kind == TK_RBRACKET() ||
       kind == TK_COMMA() || kind == TK_COLON() || kind == TK_SEMI() || kind == TK_DOT() ||
       kind == TK_PLUS() || kind == TK_MINUS() || kind == TK_STAR() || kind == TK_SLASH() ||
       kind == TK_PERCENT() || kind == TK_LT() || kind == TK_GT() || kind == TK_ASSIGN() || kind == TK_NOT() {
        return pos + 1
    }

    // Numbers (decimal and hexadecimal)
    if kind == TK_INT() {
        let mut end = pos
        // Check for hex literal: 0x...
        if end + 1 < len(src) && lex_peek(src, end) == 48 && lex_peek(src, end + 1) == 120 {  // '0' and 'x'
            end = end + 2  // Skip "0x"
            for end < len(src) && is_hex_digit(lex_peek(src, end)) {
                end = end + 1
            }
        } else {
            // Decimal number
            for end < len(src) && is_digit(lex_peek(src, end)) {
                end = end + 1
            }
        }
        return end
    }

    // String literals
    if kind == TK_STRING() {
        let mut end = pos + 1  // Skip opening quote
        for end < len(src) {
            let ch = lex_peek(src, end)
            if ch == 34 {  // Closing quote
                return end + 1  // Include closing quote
            }
            if ch == 92 {  // Backslash (escape)
                end = end + 2  // Skip escape sequence
            } else {
                end = end + 1
            }
        }
        return end  // Unterminated string (return what we have)
    }

    // Identifiers and keywords
    if kind == TK_IDENT() || kind == TK_FN() || kind == TK_LET() || kind == TK_MUT() ||
       kind == TK_IF() || kind == TK_ELSE() || kind == TK_FOR() || kind == TK_IN() ||
       kind == TK_RETURN() || kind == TK_BREAK() || kind == TK_STRUCT() ||
       kind == TK_TRUE() || kind == TK_FALSE() || kind == TK_IMPORT() {
        let mut end = pos
        for end < len(src) && (is_alpha(lex_peek(src, end)) || is_digit(lex_peek(src, end))) {
            end = end + 1
        }
        return end
    }

    // Two-character operators
    if kind == TK_ARROW() || kind == TK_LE() || kind == TK_GE() ||
       kind == TK_EQ() || kind == TK_NE() || kind == TK_AND() ||
       kind == TK_OR() || kind == TK_DOTDOT() {
        return pos + 2
    }

    return pos + 1
}

fn lex_string_value(src: string, pos: int, kind: int) -> string {
    if kind == TK_IDENT() || kind == TK_FN() || kind == TK_LET() || kind == TK_MUT() ||
       kind == TK_IF() || kind == TK_ELSE() || kind == TK_FOR() || kind == TK_IN() ||
       kind == TK_RETURN() || kind == TK_BREAK() || kind == TK_STRUCT() ||
       kind == TK_TRUE() || kind == TK_FALSE() || kind == TK_IMPORT() {
        let end = lex_end(src, pos, kind)
        return str_substring(src, pos, end)
    }
    if kind == TK_STRING() {
        // Extract string content without quotes
        let end = lex_end(src, pos, kind)
        return str_substring(src, pos + 1, end - 1)  // Skip opening and closing quotes
    }
    return ""
}

fn lex_int_value(src: string, pos: int) -> int {
    let end = lex_end(src, pos, TK_INT())
    let s = str_substring(src, pos, end)
    let mut val = 0
    let mut i = 0
    let s_len = len(s)

    // Check for hex: "0x..."
    if s_len >= 2 && str_char_at(s, 0) == 48 && str_char_at(s, 1) == 120 {  // '0' and 'x'
        // Parse hex
        i = 2  // Skip "0x"
        for i < s_len {
            let ch = str_char_at(s, i)
            let mut digit = 0
            if ch >= 48 && ch <= 57 { digit = ch - 48 }            // '0'-'9'
            if ch >= 97 && ch <= 102 { digit = ch - 97 + 10 }      // 'a'-'f'
            if ch >= 65 && ch <= 70 { digit = ch - 65 + 10 }       // 'A'-'F'
            val = val * 16 + digit
            i = i + 1
        }
    } else {
        // Parse decimal
        for i < s_len {
            let ch = str_char_at(s, i)
            val = val * 10 + (ch - 48)
            i = i + 1
        }
    }
    return val
}

// ============================================================================
// Parser and AST (expanded for full language)
// ============================================================================

struct AstNode {
    tag: int,           // Node type (expression, statement, declaration)
    int_val: int,       // Integer value or operator type
    str_val: string,    // Identifier name or string value
    left: int,          // Left child or first child (-1 if none)
    right: int,         // Right child or second child (-1 if none)
    extra: int,         // Extra child or metadata (-1 if none)
    type_tag: int,      // Type information (0=unknown, 1=int, 2=bool, etc.)
}

// Expression node types
fn EXPR_INT() -> int { return 1 }
fn EXPR_BOOL() -> int { return 2 }
fn EXPR_IDENT() -> int { return 3 }
fn EXPR_BINARY() -> int { return 4 }
fn EXPR_UNARY() -> int { return 5 }
fn EXPR_CALL() -> int { return 6 }
fn EXPR_INDEX() -> int { return 7 }
fn EXPR_FIELD() -> int { return 8 }
fn EXPR_ARRAY_LIT() -> int { return 9 }
fn EXPR_STRUCT_LIT() -> int { return 10 }
fn EXPR_STRING() -> int { return 11 }

// Statement node types
fn STMT_LET() -> int { return 20 }
fn STMT_RETURN() -> int { return 21 }
fn STMT_IF() -> int { return 22 }
fn STMT_FOR() -> int { return 23 }
fn STMT_ASSIGN() -> int { return 24 }
fn STMT_EXPR() -> int { return 25 }
fn STMT_BLOCK() -> int { return 26 }
fn STMT_BREAK() -> int { return 27 }

// Declaration node types
fn DECL_FUNC() -> int { return 40 }
fn DECL_STRUCT() -> int { return 41 }
fn DECL_PARAM() -> int { return 42 }
fn DECL_FIELD() -> int { return 43 }
fn DECL_IMPORT() -> int { return 44 }

// Type tags
fn TYPE_UNKNOWN() -> int { return 0 }
fn TYPE_INT() -> int { return 1 }
fn TYPE_BOOL() -> int { return 2 }
fn TYPE_STRING() -> int { return 3 }

// Global storage for function call arguments (workaround for immutability)
// Maps call node index -> argument indices
// Layout: [call_idx1, arg_count1, arg1_idx, arg2_idx, ..., call_idx2, arg_count2, ...]
// TODO: Re-enable when parser supports top-level let
let mut g_call_args = []int{}

fn store_call_args(call_node_idx: int, arg_indices: []int) {
    push(g_call_args, call_node_idx)
    push(g_call_args, len(arg_indices))
    let mut i = 0
    let count = len(arg_indices)
    for i < count {
        push(g_call_args, arg_indices[i])
        i = i + 1
    }
}

fn get_call_args(call_node_idx: int) -> []int {
    // Search for call_node_idx in g_call_args
    let mut i = 0
    for {
        if i >= len(g_call_args) {
            break
        }
        if g_call_args[i] == call_node_idx {
            // Found it - next element is arg_count
            let arg_count = g_call_args[i + 1]
            let mut result = []int{}
            let mut j = 0
            for j < arg_count {
                push(result, g_call_args[i + 2 + j])
                j = j + 1
            }
            return result
        }
        // Skip to next entry: current + 1 (count) + count (args)
        let arg_count = g_call_args[i + 1]
        i = i + 2 + arg_count
    }
    return []int{}
}

// Global storage for struct literal field values
// Maps struct_lit node index -> field value indices
// Layout: same as g_call_args
// TODO: Re-enable when parser supports top-level let
let mut g_struct_fields = []int{}

fn store_struct_fields(struct_node_idx: int, field_indices: []int) {
    push(g_struct_fields, struct_node_idx)
    push(g_struct_fields, len(field_indices))
    let mut i = 0
    let count = len(field_indices)
    for i < count {
        push(g_struct_fields, field_indices[i])
        i = i + 1
    }
}

fn get_struct_fields(struct_node_idx: int) -> []int {
    let mut i = 0
    for {
        if i >= len(g_struct_fields) {
            break
        }
        if g_struct_fields[i] == struct_node_idx {
            let field_count = g_struct_fields[i + 1]
            let mut result = []int{}
            let mut j = 0
            for j < field_count {
                push(result, g_struct_fields[i + 2 + j])
                j = j + 1
            }
            return result
        }
        let field_count = g_struct_fields[i + 1]
        i = i + 2 + field_count
    }
    return []int{}
}

// Helper functions for creating AST nodes
fn new_int_node(val: int, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_INT(),
        int_val: val,
        str_val: "",
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_INT()
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_bool_node(val: int, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_BOOL(),
        int_val: val,
        str_val: "",
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_BOOL()
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_ident_node(name: string, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_IDENT(),
        int_val: 0,
        str_val: name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_binary_node(op: int, left_idx: int, right_idx: int, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_BINARY(),
        int_val: op,
        str_val: "",
        left: left_idx,
        right: right_idx,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, node)
    return len(nodes) - 1
}

fn new_unary_node(op: int, operand: int, nodes: []AstNode) -> int {
    let node = AstNode {
        tag: EXPR_UNARY(),
        int_val: op,
        str_val: "",
        left: operand,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, node)
    return len(nodes) - 1
}

// Simplified parser using mutable position tracking
// Note: A production compiler would use a proper Parser struct with methods

fn parse_primary(src: string, pos: int, nodes: []AstNode) -> int {
    let kind = lex_kind(src, pos)

    if kind == TK_INT() {
        let val = lex_int_value(src, pos)
        return new_int_node(val, nodes)
    }

    if kind == TK_TRUE() {
        return new_bool_node(1, nodes)
    }

    if kind == TK_FALSE() {
        return new_bool_node(0, nodes)
    }

    if kind == TK_IDENT() {
        let name = lex_string_value(src, pos, kind)
        return new_ident_node(name, nodes)
    }

    if kind == TK_LPAREN() {
        // Parenthesized expression
        let mut new_pos = lex_end(src, pos, kind)
        new_pos = lex_skip(src, new_pos)
        // TODO: recursively parse expression
        return -1
    }

    return -1
}

// ============================================================================
// Parser Helper Structures
// ============================================================================

struct ParseResult {
    node_idx: int,
    new_pos: int,
}

// ============================================================================
// Statement Parser
// ============================================================================

// Parse variable declaration: let [mut] name = expr
fn parse_let_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'let' token
    let mut p = pos
    let kind = lex_kind(src, p)
    if kind != TK_LET() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Check for 'mut'
    let mut is_mut = 0
    let next_kind = lex_kind(src, p)
    if next_kind == TK_MUT() {
        is_mut = 1
        p = lex_end(src, p, next_kind)
        p = lex_skip(src, p)
    }

    // Parse identifier
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let name = lex_string_value(src, p, name_kind)
    let name_node = new_ident_node(name, nodes)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect '='
    let eq_kind = lex_kind(src, p)
    if eq_kind != TK_ASSIGN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, eq_kind)
    p = lex_skip(src, p)

    // Parse initializer expression
    let expr_result = parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let expr_node = expr_result.node_idx
    p = expr_result.new_pos

    // Create let statement node
    // left = name, right = expr, int_val = is_mut
    let stmt = AstNode {
        tag: STMT_LET(),
        int_val: is_mut,
        str_val: name,
        left: name_node,
        right: expr_node,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse return statement: return [expr]
fn parse_if_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'if' token
    let mut p = pos
    let kind = lex_kind(src, p)
    if kind != TK_IF() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Parse condition expression
    let cond_result = parse_expr_with_pos(src, p, nodes)
    if cond_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let cond_node = cond_result.node_idx
    p = cond_result.new_pos
    p = lex_skip(src, p)

    // Parse then block
    let then_result = parse_block(src, p, nodes)
    if then_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let then_node = then_result.node_idx
    p = then_result.new_pos
    p = lex_skip(src, p)

    // Check for else
    let mut else_node = -1
    let next_kind = lex_kind(src, p)
    if next_kind == TK_ELSE() {
        p = lex_end(src, p, next_kind)
        p = lex_skip(src, p)
        // Parse else block
        let else_result = parse_block(src, p, nodes)
        if else_result.node_idx >= 0 {
            else_node = else_result.node_idx
            p = else_result.new_pos
        }
    }

    // Create if statement node
    // left = condition, right = then block, extra = else block
    let stmt = AstNode {
        tag: STMT_IF(),
        int_val: 0,
        str_val: "",
        left: cond_node,
        right: then_node,
        extra: else_node,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

fn parse_for_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'for' token
    let mut p = pos
    let kind = lex_kind(src, p)
    if kind != TK_FOR() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Check for range-based for loop: for i in range { }
    let next_kind = lex_kind(src, p)
    let mut cond_node = -1
    let mut loop_var = ""

    if next_kind == TK_IDENT() {
        // Might be: for i in range or for condition
        let saved_pos = p
        let var_name = lex_string_value(src, p, next_kind)
        p = lex_end(src, p, next_kind)
        p = lex_skip(src, p)

        if lex_kind(src, p) == TK_IN() {
            // It's a range-based for loop: for i in range
            loop_var = var_name
            p = lex_end(src, p, TK_IN())
            p = lex_skip(src, p)

            // Parse range expression
            let range_result = parse_expr_with_pos(src, p, nodes)
            if range_result.node_idx >= 0 {
                cond_node = range_result.node_idx
                p = range_result.new_pos
                p = lex_skip(src, p)
            }
        } else {
            // Not 'in', so restore and parse as condition expression
            p = saved_pos
            let cond_result = parse_expr_with_pos(src, p, nodes)
            if cond_result.node_idx >= 0 {
                cond_node = cond_result.node_idx
                p = cond_result.new_pos
                p = lex_skip(src, p)
            }
        }
    } else if next_kind != TK_LBRACE() {
        // Parse condition expression (not identifier, not lbrace)
        let cond_result = parse_expr_with_pos(src, p, nodes)
        if cond_result.node_idx >= 0 {
            cond_node = cond_result.node_idx
            p = cond_result.new_pos
            p = lex_skip(src, p)
        }
    }

    // Parse body block
    let body_result = parse_block(src, p, nodes)
    if body_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let body_node = body_result.node_idx
    p = body_result.new_pos

    // Create for statement node
    // left = condition/range (-1 for infinite loop), right = body block
    // str_val = loop variable name (for range-based loops)
    let stmt = AstNode {
        tag: STMT_FOR(),
        int_val: 0,
        str_val: loop_var,
        left: cond_node,
        right: body_node,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

fn parse_return_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at 'return' token
    let mut p = pos
    let kind = lex_kind(src, p)
    if kind != TK_RETURN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, kind)
    p = lex_skip(src, p)

    // Check if there's an expression to return
    let next_kind = lex_kind(src, p)
    let mut expr_node = -1

    // If not EOF, semicolon, or close brace, parse expression
    if next_kind != TK_EOF() && next_kind != TK_SEMI() && next_kind != TK_RBRACE() {
        let expr_result = parse_expr_with_pos(src, p, nodes)
        expr_node = expr_result.node_idx
        p = expr_result.new_pos
    }

    // Create return statement node
    let stmt = AstNode {
        tag: STMT_RETURN(),
        int_val: 0,
        str_val: "",
        left: expr_node,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse assignment: ident = expr
fn parse_assign_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    // pos should be at identifier
    let mut p = pos
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let name = lex_string_value(src, p, name_kind)
    let name_node = new_ident_node(name, nodes)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect '='
    let eq_kind = lex_kind(src, p)
    if eq_kind != TK_ASSIGN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, eq_kind)
    p = lex_skip(src, p)

    // Parse expression
    let expr_result = parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let expr_node = expr_result.node_idx
    p = expr_result.new_pos

    // Create assignment node
    let stmt = AstNode {
        tag: STMT_ASSIGN(),
        int_val: 0,
        str_val: name,
        left: name_node,
        right: expr_node,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, stmt)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse a statement (dispatcher)
fn parse_stmt(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)
    let kind = lex_kind(src, p)

    if kind == TK_LET() {
        return parse_let_stmt(src, p, nodes)
    }

    if kind == TK_IF() {
        return parse_if_stmt(src, p, nodes)
    }

    if kind == TK_FOR() {
        return parse_for_stmt(src, p, nodes)
    }

    if kind == TK_RETURN() {
        return parse_return_stmt(src, p, nodes)
    }

    if kind == TK_BREAK() {
        p = lex_end(src, p, kind)
        let stmt = AstNode {
            tag: STMT_BREAK(),
            int_val: 0,
            str_val: "",
            left: -1,
            right: -1,
            extra: -1,
            type_tag: TYPE_UNKNOWN()
        }
        push(nodes, stmt)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }

    if kind == TK_LBRACE() {
        return parse_block(src, p, nodes)
    }

    // Check if it's an assignment (ident followed by =)
    if kind == TK_IDENT() {
        let saved_pos = p
        p = lex_end(src, p, kind)
        p = lex_skip(src, p)
        let next_kind = lex_kind(src, p)
        if next_kind == TK_ASSIGN() {
            return parse_assign_stmt(src, saved_pos, nodes)
        }
        // Not an assignment, restore position and parse as expression statement
        p = saved_pos
    }

    // Expression statement
    let expr_result = parse_expr_with_pos(src, p, nodes)
    if expr_result.node_idx >= 0 {
        let stmt = AstNode {
            tag: STMT_EXPR(),
            int_val: 0,
            str_val: "",
            left: expr_result.node_idx,
            right: -1,
            extra: -1,
            type_tag: TYPE_UNKNOWN()
        }
        push(nodes, stmt)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: expr_result.new_pos }
    }

    return ParseResult { node_idx: -1, new_pos: p }
}

// ============================================================================
// Declaration Parser
// ============================================================================

// Parse function parameter: name: type
fn parse_param(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Parse parameter name
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let param_name = lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect ':'
    let colon_kind = lex_kind(src, p)
    if colon_kind != TK_COLON() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, colon_kind)
    p = lex_skip(src, p)

    // Parse type name (simple or array type)
    let mut type_name = ""
    let type_kind = lex_kind(src, p)

    if type_kind == TK_LBRACKET() {
        // Array type: []ElementType
        type_name = "[]"
        p = lex_end(src, p, type_kind)  // Skip '['
        p = lex_skip(src, p)

        // Expect ']'
        if lex_kind(src, p) == TK_RBRACKET() {
            p = lex_end(src, p, TK_RBRACKET())
            p = lex_skip(src, p)
        }

        // Parse element type
        if lex_kind(src, p) == TK_IDENT() {
            let elem_type = lex_string_value(src, p, TK_IDENT())
            type_name = type_name + elem_type
            p = lex_end(src, p, TK_IDENT())
        }
    } else if type_kind == TK_IDENT() {
        // Simple type
        type_name = lex_string_value(src, p, type_kind)
        p = lex_end(src, p, type_kind)
    } else {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    // Create parameter node
    // str_val = param_name, int_val = 0 (type stored separately in real impl)
    let param = AstNode {
        tag: DECL_PARAM(),
        int_val: 0,
        str_val: param_name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, param)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse parameter list: (param1, param2, ...)
fn parse_param_list(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect '('
    let lparen = lex_kind(src, p)
    if lparen != TK_LPAREN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lparen)
    p = lex_skip(src, p)

    // Check for empty parameter list
    let next = lex_kind(src, p)
    if next == TK_RPAREN() {
        p = lex_end(src, p, next)
        return ParseResult { node_idx: -1, new_pos: p }  // No parameters
    }

    // Parse first parameter
    let first_result = parse_param(src, p, nodes)
    if first_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let mut first_param = first_result.node_idx
    p = first_result.new_pos
    p = lex_skip(src, p)

    // Parse remaining parameters
    let mut last_param = first_param
    for {
        let comma = lex_kind(src, p)
        if comma != TK_COMMA() {
            break
        }
        p = lex_end(src, p, comma)
        p = lex_skip(src, p)

        let param_result = parse_param(src, p, nodes)
        if param_result.node_idx < 0 {
            break
        }
        // Link as sibling (would need to update nodes array - simplified for now)
        last_param = param_result.node_idx
        p = param_result.new_pos
        p = lex_skip(src, p)
    }

    // Expect ')'
    let rparen = lex_kind(src, p)
    if rparen != TK_RPAREN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rparen)

    return ParseResult { node_idx: first_param, new_pos: p }
}

// Parse function body: { stmt* }
fn parse_block(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect '{'
    let lbrace = lex_kind(src, p)
    if lbrace != TK_LBRACE() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lbrace)
    p = lex_skip(src, p)

    // Parse statements until '}'
    let mut first_stmt = -1
    let mut last_stmt_idx = -1
    for {
        let next = lex_kind(src, p)
        if next == TK_RBRACE() || next == TK_EOF() {
            break
        }

        let stmt_result = parse_stmt(src, p, nodes)
        if stmt_result.node_idx < 0 {
            break
        }

        if first_stmt < 0 {
            first_stmt = stmt_result.node_idx
        } else {
            // Link previous statement to this one via extra field
            // TODO: Cannot mutate array elements in Ease yet
            // if last_stmt_idx >= 0 {
            //     nodes[last_stmt_idx].extra = stmt_result.node_idx
            // }
        }
        last_stmt_idx = stmt_result.node_idx
        p = stmt_result.new_pos
        p = lex_skip(src, p)

        // Skip optional semicolon
        let semi = lex_kind(src, p)
        if semi == TK_SEMI() {
            p = lex_end(src, p, semi)
            p = lex_skip(src, p)
        }
    }

    // Expect '}'
    let rbrace = lex_kind(src, p)
    if rbrace != TK_RBRACE() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rbrace)

    // Create block node
    // left = first statement index
    // right = last statement index (for multi-statement support)
    let block = AstNode {
        tag: STMT_BLOCK(),
        int_val: 0,
        str_val: "",
        left: first_stmt,
        right: last_stmt_idx,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, block)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse import declaration: import ("path")
fn parse_import_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect 'import'
    let import_kind = lex_kind(src, p)
    if import_kind != TK_IMPORT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, import_kind)
    p = lex_skip(src, p)

    // Expect '('
    if lex_kind(src, p) != TK_LPAREN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, TK_LPAREN())
    p = lex_skip(src, p)

    // Parse import path (string literal)
    let path_kind = lex_kind(src, p)
    if path_kind != TK_STRING() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let import_path = lex_string_value(src, p, path_kind)
    p = lex_end(src, p, path_kind)
    p = lex_skip(src, p)

    // Expect ')'
    if lex_kind(src, p) != TK_RPAREN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, TK_RPAREN())

    // Create import declaration node
    // str_val = import path
    let import_node = AstNode {
        tag: DECL_IMPORT(),
        int_val: 0,
        str_val: import_path,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, import_node)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse function declaration: fn name(params) -> type { body }
fn parse_func_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect 'fn'
    let fn_kind = lex_kind(src, p)
    if fn_kind != TK_FN() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, fn_kind)
    p = lex_skip(src, p)

    // Parse function name
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let func_name = lex_string_value(src, p, name_kind)
    print(func_name)
    print("\n")
    p = lex_end(src, p, name_kind)

    // Parse parameter list
    let params_result = parse_param_list(src, p, nodes)
    p = params_result.new_pos
    p = lex_skip(src, p)

    // Check for '->' (return type is optional)
    let mut ret_type = ""
    let arrow = lex_kind(src, p)
    if arrow == TK_ARROW() {
        p = lex_end(src, p, arrow)
        p = lex_skip(src, p)

        // Parse return type (simple or array type)
        let ret_type_kind = lex_kind(src, p)

        if ret_type_kind == TK_LBRACKET() {
            // Array type: []ElementType
            ret_type = "[]"
            p = lex_end(src, p, ret_type_kind)  // Skip '['
            p = lex_skip(src, p)

            // Expect ']'
            if lex_kind(src, p) == TK_RBRACKET() {
                p = lex_end(src, p, TK_RBRACKET())
                p = lex_skip(src, p)
            }

            // Parse element type
            if lex_kind(src, p) == TK_IDENT() {
                let elem_type = lex_string_value(src, p, TK_IDENT())
                ret_type = ret_type + elem_type
                p = lex_end(src, p, TK_IDENT())
            }
        } else if ret_type_kind == TK_IDENT() {
            // Simple type
            ret_type = lex_string_value(src, p, ret_type_kind)
            p = lex_end(src, p, ret_type_kind)
        } else {
            return ParseResult { node_idx: -1, new_pos: p }
        }
    }

    // Parse body
    let body_result = parse_block(src, p, nodes)
    if body_result.node_idx < 0 {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    // Create function declaration node
    // str_val = function name
    // left = parameters (first param node)
    // right = body (block node)
    let func = AstNode {
        tag: DECL_FUNC(),
        int_val: 0,
        str_val: func_name,
        left: params_result.node_idx,
        right: body_result.node_idx,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, func)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: body_result.new_pos }
}

// Parse struct field: name: type
fn parse_field(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Parse field name
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let field_name = lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect ':'
    let colon = lex_kind(src, p)
    if colon != TK_COLON() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, colon)
    p = lex_skip(src, p)

    // Parse type (including array types like []int or []string)
    let type_kind = lex_kind(src, p)
    let mut type_name = ""

    if type_kind == TK_LBRACKET() {
        // Array type: []ElementType
        type_name = "[]"
        p = lex_end(src, p, TK_LBRACKET())
        p = lex_skip(src, p)

        if lex_kind(src, p) == TK_RBRACKET() {
            p = lex_end(src, p, TK_RBRACKET())
            p = lex_skip(src, p)
        }

        if lex_kind(src, p) == TK_IDENT() {
            let elem_type = lex_string_value(src, p, TK_IDENT())
            type_name = type_name + elem_type
            p = lex_end(src, p, TK_IDENT())
        }
    } else if type_kind == TK_IDENT() {
        type_name = lex_string_value(src, p, type_kind)
        p = lex_end(src, p, type_kind)
    } else {
        return ParseResult { node_idx: -1, new_pos: p }
    }

    p = lex_skip(src, p)

    // Skip optional comma
    let comma = lex_kind(src, p)
    if comma == TK_COMMA() {
        p = lex_end(src, p, comma)
    }

    // Create field node
    let field = AstNode {
        tag: DECL_FIELD(),
        int_val: 0,
        str_val: field_name,
        left: -1,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, field)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// Parse struct declaration: struct Name { fields }
fn parse_struct_decl(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)

    // Expect 'struct'
    let struct_kind = lex_kind(src, p)
    if struct_kind != TK_STRUCT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, struct_kind)
    p = lex_skip(src, p)

    // Parse struct name
    let name_kind = lex_kind(src, p)
    if name_kind != TK_IDENT() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    let struct_name = lex_string_value(src, p, name_kind)
    p = lex_end(src, p, name_kind)
    p = lex_skip(src, p)

    // Expect '{'
    let lbrace = lex_kind(src, p)
    if lbrace != TK_LBRACE() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, lbrace)
    p = lex_skip(src, p)

    // Parse fields
    let mut first_field = -1
    for {
        let next = lex_kind(src, p)
        if next == TK_RBRACE() || next == TK_EOF() {
            break
        }

        let field_result = parse_field(src, p, nodes)
        if field_result.node_idx < 0 {
            break
        }

        if first_field < 0 {
            first_field = field_result.node_idx
        }
        p = field_result.new_pos
        p = lex_skip(src, p)
    }

    // Expect '}'
    let rbrace = lex_kind(src, p)
    if rbrace != TK_RBRACE() {
        return ParseResult { node_idx: -1, new_pos: p }
    }
    p = lex_end(src, p, rbrace)

    // Create struct declaration node
    let struct_decl = AstNode {
        tag: DECL_STRUCT(),
        int_val: 0,
        str_val: struct_name,
        left: first_field,
        right: -1,
        extra: -1,
        type_tag: TYPE_UNKNOWN()
    }
    push(nodes, struct_decl)
    return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
}

// ============================================================================
// Expression Parser
// ============================================================================

// Parse atom (literal or identifier - no parentheses yet)
fn parse_atom(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)
    let kind = lex_kind(src, p)

    if kind == TK_INT() {
        let val = lex_int_value(src, p)
        let node = new_int_node(val, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == TK_TRUE() {
        let node = new_bool_node(1, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == TK_FALSE() {
        let node = new_bool_node(0, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == TK_STRING() {
        let val = lex_string_value(src, p, kind)
        let node = AstNode {
            tag: EXPR_STRING(),
            int_val: 0,
            str_val: val,
            left: -1,
            right: -1,
            extra: -1,
            type_tag: TYPE_UNKNOWN()
        }
        push(nodes, node)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }
    if kind == TK_IDENT() {
        let name = lex_string_value(src, p, kind)
        let node = new_ident_node(name, nodes)
        p = lex_end(src, p, kind)
        return ParseResult { node_idx: node, new_pos: p }
    }
    if kind == TK_LBRACKET() {
        // Array literal: []Type{elem1, elem2, ...}
        // For bootstrap: simplified to []int{...}
        p = lex_end(src, p, kind)  // Skip '['
        p = lex_skip(src, p)

        // Expect ']'
        if lex_kind(src, p) != TK_RBRACKET() {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, TK_RBRACKET())
        p = lex_skip(src, p)

        // Expect type name (for now, just skip - assume 'int')
        if lex_kind(src, p) == TK_IDENT() {
            p = lex_end(src, p, TK_IDENT())
            p = lex_skip(src, p)
        }

        // Expect '{'
        if lex_kind(src, p) != TK_LBRACE() {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, TK_LBRACE())
        p = lex_skip(src, p)

        // Parse elements
        let mut elem_count = 0
        let mut first_elem_idx = -1

        for {
            p = lex_skip(src, p)
            if lex_kind(src, p) == TK_RBRACE() {
                break
            }

            // Parse element expression
            let elem_result = parse_expr_with_pos(src, p, nodes)
            if elem_result.node_idx < 0 {
                break
            }

            if elem_count == 0 {
                first_elem_idx = elem_result.node_idx
            }
            elem_count = elem_count + 1

            p = elem_result.new_pos
            p = lex_skip(src, p)

            // Check for comma
            if lex_kind(src, p) == TK_COMMA() {
                p = lex_end(src, p, TK_COMMA())
                p = lex_skip(src, p)
            } else {
                break
            }
        }

        // Expect '}'
        if lex_kind(src, p) != TK_RBRACE() {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, TK_RBRACE())

        // Create array literal node
        let array_node = AstNode {
            tag: EXPR_ARRAY_LIT(),
            int_val: elem_count,
            str_val: "int",  // element type
            left: -1,
            right: first_elem_idx,
            extra: -1,
            type_tag: TYPE_UNKNOWN()
        }
        push(nodes, array_node)
        return ParseResult { node_idx: len(nodes) - 1, new_pos: p }
    }

    return ParseResult { node_idx: -1, new_pos: p }
}

// Parse multiplicative: * /
// Parse unary: - !
fn parse_unary(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let pos = lex_skip(src, start_pos)
    let kind = lex_kind(src, pos)

    if kind == TK_MINUS() {
        let mut new_pos = lex_end(src, pos, kind)
        let operand_result = parse_unary(src, new_pos, nodes)
        if operand_result.node_idx < 0 {
            return operand_result
        }
        let unary_idx = new_unary_node(kind, operand_result.node_idx, nodes)
        return ParseResult { node_idx: unary_idx, new_pos: operand_result.new_pos }
    }

    return parse_primary_expr(src, start_pos, nodes)
}

fn parse_multiplicative(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_unary(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_STAR() && op != TK_SLASH() && op != TK_PERCENT() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_unary(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse additive: + -
fn parse_additive(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_multiplicative(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_PLUS() && op != TK_MINUS() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_multiplicative(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse comparison: < > <= >=
fn parse_comparison(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_additive(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    pos = lex_skip(src, pos)
    let op = lex_kind(src, pos)
    if op == TK_LT() || op == TK_GT() || op == TK_LE() || op == TK_GE() ||
       op == TK_EQ() || op == TK_NE() {
        pos = lex_end(src, pos, op)
        let right_result = parse_additive(src, pos, nodes)
        if right_result.node_idx >= 0 {
            left = new_binary_node(op, left, right_result.node_idx, nodes)
            pos = right_result.new_pos
        }
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse logical AND: &&
fn parse_logical_and(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_comparison(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_AND() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_comparison(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse logical OR: || (top level)
fn parse_expr_with_pos(src: string, start_pos: int, nodes: []AstNode) -> ParseResult {
    let mut result = parse_logical_and(src, start_pos, nodes)
    if result.node_idx < 0 {
        return result
    }

    let mut pos = result.new_pos
    let mut left = result.node_idx

    for {
        pos = lex_skip(src, pos)
        let op = lex_kind(src, pos)
        if op != TK_OR() {
            break
        }

        pos = lex_end(src, pos, op)
        let right_result = parse_logical_and(src, pos, nodes)
        if right_result.node_idx < 0 {
            break
        }

        left = new_binary_node(op, left, right_result.node_idx, nodes)
        pos = right_result.new_pos
    }

    return ParseResult { node_idx: left, new_pos: pos }
}

// Parse primary with parentheses support (defined after parse_expr_with_pos)
fn parse_primary_expr(src: string, pos: int, nodes: []AstNode) -> ParseResult {
    let mut p = pos
    p = lex_skip(src, p)
    let kind = lex_kind(src, p)

    // Check for parenthesized expression first
    if kind == TK_LPAREN() {
        p = lex_end(src, p, kind)  // Skip '('
        // Recursively parse the full expression inside parentheses
        let expr_result = parse_expr_with_pos(src, p, nodes)
        if expr_result.node_idx < 0 {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = expr_result.new_pos
        p = lex_skip(src, p)
        let rparen = lex_kind(src, p)
        if rparen != TK_RPAREN() {
            return ParseResult { node_idx: -1, new_pos: p }
        }
        p = lex_end(src, p, rparen)  // Skip ')'
        return ParseResult { node_idx: expr_result.node_idx, new_pos: p }
    }

    // Otherwise, parse atom (literal or identifier)
    let atom_result = parse_atom(src, pos, nodes)
    if atom_result.node_idx < 0 {
        return atom_result
    }

    // Handle postfix operators (function calls, array indexing, field access) in a loop for chaining
    let mut current_node = atom_result.node_idx
    p = atom_result.new_pos

    for {
        p = lex_skip(src, p)
        let next_kind = lex_kind(src, p)

        if next_kind == TK_LPAREN() {
            // It's a function call
            let func_name_node = current_node
            p = lex_end(src, p, next_kind)  // Skip '('
            p = lex_skip(src, p)

            // Parse arguments
            let mut first_arg = -1
            let mut arg_indices = []int{}

            // Check if there are any arguments
            if lex_kind(src, p) != TK_RPAREN() {
                for {
                    let arg_result = parse_expr_with_pos(src, p, nodes)
                    if arg_result.node_idx < 0 {
                        break
                    }

                    if first_arg < 0 {
                        first_arg = arg_result.node_idx
                    }
                    push(arg_indices, arg_result.node_idx)

                    p = arg_result.new_pos
                    p = lex_skip(src, p)

                    // Check for comma
                    if lex_kind(src, p) == TK_COMMA() {
                        p = lex_end(src, p, TK_COMMA())
                        p = lex_skip(src, p)
                    } else {
                        break
                    }
                }
            }

            // Expect ')'
            p = lex_skip(src, p)
            if lex_kind(src, p) != TK_RPAREN() {
                return ParseResult { node_idx: -1, new_pos: p }
            }
            p = lex_end(src, p, TK_RPAREN())

            // Create call expression node
            // left = function name node, right = first argument, int_val = arg count
            let func_name = nodes[func_name_node].str_val
            let call_node = AstNode {
                tag: EXPR_CALL(),
                int_val: len(arg_indices),
                str_val: func_name,
                left: func_name_node,
                right: first_arg,
                extra: -1,
                type_tag: TYPE_UNKNOWN()
            }
            push(nodes, call_node)
            current_node = len(nodes) - 1

            // Store argument indices for this call node
            store_call_args(current_node, arg_indices)
            // Continue to check for more postfix operators
        } else {
            // Note: Struct literals (StructName { field: value }) are currently NOT parsed
            // as postfix operators due to ambiguity with statement blocks. For now, struct
            // literals must be parsed as primary expressions or handled separately.
            if next_kind == TK_LBRACE() && nodes[current_node].tag == EXPR_IDENT() {
                // Struct literal: StructName { field1: value1, field2: value2 }
                // Only parse if identifier starts with uppercase (struct names are capitalized)
                let struct_name_node = current_node
                let struct_name = nodes[struct_name_node].str_val

                // Check if first character is uppercase (65-90 = A-Z)
                let mut is_uppercase = 0
                if len(struct_name) > 0 {
                    let first_char = str_char_at(struct_name, 0)
                    if first_char >= 65 && first_char <= 90 {
                        is_uppercase = 1
                    }
                }

                if is_uppercase == 0 {
                    // Not a struct literal, continue
                    break
                }
                p = lex_end(src, p, next_kind)  // Skip '{'
                p = lex_skip(src, p)

                // Parse field initializers (simplified - just count them for now)
                let mut first_field_idx = -1
                let mut field_value_indices = []int{}

                for {
                    p = lex_skip(src, p)
                    if lex_kind(src, p) == TK_RBRACE() {
                        break
                    }

                    // Parse field name
                    if lex_kind(src, p) != TK_IDENT() {
                        break
                    }
                    let field_name = lex_string_value(src, p, TK_IDENT())
                    p = lex_end(src, p, TK_IDENT())
                    p = lex_skip(src, p)

                    // Expect ':'
                    if lex_kind(src, p) != TK_COLON() {
                        break
                    }
                    p = lex_end(src, p, TK_COLON())
                    p = lex_skip(src, p)

                    // Parse field value expression
                    let value_result = parse_expr_with_pos(src, p, nodes)
                    if value_result.node_idx < 0 {
                        break
                    }

                    if first_field_idx < 0 {
                        first_field_idx = value_result.node_idx
                    }
                    push(field_value_indices, value_result.node_idx)

                    p = value_result.new_pos
                    p = lex_skip(src, p)

                    // Check for comma
                    if lex_kind(src, p) == TK_COMMA() {
                        p = lex_end(src, p, TK_COMMA())
                        p = lex_skip(src, p)
                    } else {
                        break
                    }
                }

                // Expect '}'
                if lex_kind(src, p) != TK_RBRACE() {
                    return ParseResult { node_idx: -1, new_pos: p }
                }
                p = lex_end(src, p, TK_RBRACE())

                // Create struct literal node
                let struct_lit_node = AstNode {
                    tag: EXPR_STRUCT_LIT(),
                    int_val: len(field_value_indices),
                    str_val: struct_name,
                    left: struct_name_node,
                    right: first_field_idx,
                    extra: -1,
                    type_tag: TYPE_UNKNOWN()
                }
                push(nodes, struct_lit_node)
                current_node = len(nodes) - 1

                // Store field value indices for this struct literal
                store_struct_fields(current_node, field_value_indices)
                // Continue to check for more postfix operators
            } else {
                if next_kind == TK_LBRACKET() {
                    // Array indexing
                    let array_node = current_node
                    p = lex_end(src, p, next_kind)  // Skip '['
                    p = lex_skip(src, p)

                    // Parse index expression
                    let index_result = parse_expr_with_pos(src, p, nodes)
                    if index_result.node_idx < 0 {
                        return ParseResult { node_idx: -1, new_pos: p }
                    }
                    p = index_result.new_pos
                    p = lex_skip(src, p)

                    // Expect ']'
                    if lex_kind(src, p) != TK_RBRACKET() {
                        return ParseResult { node_idx: -1, new_pos: p }
                    }
                    p = lex_end(src, p, TK_RBRACKET())

                    // Create array index node
                    // left = array expression, right = index expression
                    let index_node = AstNode {
                        tag: EXPR_INDEX(),
                        int_val: 0,
                        str_val: "",
                        left: array_node,
                        right: index_result.node_idx,
                        extra: -1,
                        type_tag: TYPE_UNKNOWN()
                    }
                    push(nodes, index_node)
                    current_node = len(nodes) - 1
                    // Continue to check for more postfix operators
                } else {
                    if next_kind == TK_DOT() {
                        // Field access
                        let base_node = current_node
                        p = lex_end(src, p, next_kind)  // Skip '.'
                        p = lex_skip(src, p)

                        // Parse field name
                        let field_kind = lex_kind(src, p)
                        if field_kind != TK_IDENT() {
                            return ParseResult { node_idx: -1, new_pos: p }
                        }
                        let field_name = lex_string_value(src, p, field_kind)
                        p = lex_end(src, p, field_kind)

                        // Create field access node
                        // left = base expression, str_val = field name
                        let field_node = AstNode {
                            tag: EXPR_FIELD(),
                            int_val: 0,
                            str_val: field_name,
                            left: base_node,
                            right: -1,
                            extra: -1,
                            type_tag: TYPE_UNKNOWN()
                        }
                        push(nodes, field_node)
                        current_node = len(nodes) - 1
                        // Continue to check for more postfix operators
                    } else {
                        // No more postfix operators, break the loop
                        break
                    }
                }
            }
        }
    }

    return ParseResult { node_idx: current_node, new_pos: p }
}

// Wrapper for backward compatibility
fn parse_expr_simple(src: string, nodes: []AstNode) -> int {
    let result = parse_expr_with_pos(src, 0, nodes)
    return result.node_idx
}

// ============================================================================
// Symbol Table for Variables (with Type Tracking)
// ============================================================================

struct SymbolTable {
    names: []string,  // Variable names
    vregs: []int,     // Corresponding virtual registers
    types: []int,     // Type tags (TYPE_INT, TYPE_BOOL, etc.)
}

fn symtab_new() -> SymbolTable {
    return SymbolTable {
        names: []string{},
        vregs: []int{}
    }
}

fn symtab_add(st: SymbolTable, name: string, vreg: int) {
    push(st.names, name)
    push(st.vregs, vreg)
}

fn symtab_lookup(st: SymbolTable, name: string) -> int {
    let mut i = 0
    let count = len(st.names)
    for i < count {
        if st.names[i] == name {
            return st.vregs[i]
        }
        i = i + 1
    }
    return -1  // Not found
}

// ============================================================================
// Simplified IR Generator (from ir.ease)
// ============================================================================

struct IRInstr {
    op: int,       // Instruction opcode
    dest: int,     // Destination vreg or label id
    arg1: int,     // First argument vreg or immediate
    arg2: int,     // Second argument vreg or label id
    arg3: int,     // Third argument vreg (for operations like str_substring)
    str_val: string, // For function names, variable names, etc.
}

// IR Opcodes
fn OP_LOADCONST() -> int { return 1 }
fn OP_ADD() -> int { return 2 }
fn OP_SUB() -> int { return 3 }
fn OP_MUL() -> int { return 4 }
fn OP_DIV() -> int { return 5 }
fn OP_CMP_LT() -> int { return 6 }
fn OP_CMP_GT() -> int { return 7 }
fn OP_CMP_LE() -> int { return 8 }
fn OP_CMP_GE() -> int { return 9 }
fn OP_CMP_EQ() -> int { return 10 }
fn OP_CMP_NE() -> int { return 11 }
fn OP_AND() -> int { return 12 }
fn OP_OR() -> int { return 13 }
fn OP_NOT() -> int { return 14 }
fn OP_ALLOCA() -> int { return 20 }
fn OP_STORE() -> int { return 21 }
fn OP_LOAD() -> int { return 22 }
fn OP_INDEXADDR() -> int { return 23 }  // Pointer arithmetic: base + offset
fn OP_MEMCOPY() -> int { return 24 }    // Memory copy: src, dest, size
fn OP_ARRAY_PUSH() -> int { return 25 } // Array push: array, elem, elem_size
fn OP_ARRAY_LEN() -> int { return 26 }  // Array length: returns len from fat pointer
fn OP_STR_CHAR_AT() -> int { return 27 } // String char at: str, index -> char (int)
fn OP_STR_SUBSTRING() -> int { return 28 } // String substring: str, start, end -> str
fn OP_RET() -> int { return 30 }

// Struct definitions and offsets (hardcoded for known structs)
// AstNode: tag(8), int_val(8), str_val(8), left(8), right(8), extra(8), type_tag(8) = 56 bytes
// IRInstr: op(8), dest(8), arg1(8), arg2(8), str_val(8) = 40 bytes
// ParseResult: node_idx(8), new_pos(8) = 16 bytes

fn struct_size(struct_name: string) -> int {
    if struct_name == "AstNode" { return 56 }
    if struct_name == "IRInstr" { return 40 }
    if struct_name == "ParseResult" { return 16 }
    return 64  // Default: 8 fields * 8 bytes
}

fn field_offset(struct_name: string, field_name: string) -> int {
    // AstNode fields
    if struct_name == "AstNode" {
        if field_name == "tag" { return 0 }
        if field_name == "int_val" { return 8 }
        if field_name == "str_val" { return 16 }
        if field_name == "left" { return 24 }
        if field_name == "right" { return 32 }
        if field_name == "extra" { return 40 }
        if field_name == "type_tag" { return 48 }
    }
    // IRInstr fields
    if struct_name == "IRInstr" {
        if field_name == "op" { return 0 }
        if field_name == "dest" { return 8 }
        if field_name == "arg1" { return 16 }
        if field_name == "arg2" { return 24 }
        if field_name == "str_val" { return 32 }
    }
    // ParseResult fields
    if struct_name == "ParseResult" {
        if field_name == "node_idx" { return 0 }
        if field_name == "new_pos" { return 8 }
    }
    return 0  // Unknown field, return 0
}
fn OP_CALL() -> int { return 31 }
fn OP_LABEL() -> int { return 40 }
fn OP_JUMP() -> int { return 41 }
fn OP_BRANCH() -> int { return 42 }

// Helper: Generate IR for len() builtin
fn gen_ir_call_len(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    let arg_indices = get_call_args(ast_idx)
    if len(arg_indices) != 1 {
        return -1
    }
    let array_vreg = gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    let result_vreg = len(instrs)
    let len_instr = IRInstr { op: OP_ARRAY_LEN(), dest: result_vreg, arg1: array_vreg, arg2: 0, arg3: 0, str_val: "" }
    push(instrs, len_instr)
    return result_vreg
}

// Helper: Generate IR for push() builtin
fn gen_ir_call_push(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    let arg_indices = get_call_args(ast_idx)
    if len(arg_indices) != 2 {
        return -1
    }
    let array_vreg = gen_ir_from_ast_with_symtab(arg_indices[0], nodes, instrs, symtab_names, symtab_vregs)
    let elem_vreg = gen_ir_from_ast_with_symtab(arg_indices[1], nodes, instrs, symtab_names, symtab_vregs)
    let push_instr = IRInstr { op: OP_ARRAY_PUSH(), dest: -1, arg1: array_vreg, arg2: elem_vreg, arg3: 0, str_val: "" }
    push(instrs, push_instr)
    return array_vreg
}

fn get_field_offset(name: string) -> int {
    let mut off = 0
    if name == "tag" { off = 0 }
    if name == "int_val" { off = 8 }
    if name == "str_val" { off = 16 }
    if name == "left" { off = 24 }
    if name == "right" { off = 32 }
    if name == "extra" { off = 40 }
    if name == "type_tag" { off = 48 }
    return off
}

fn gen_ir_eval_args(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> []int {
    let mut arg_vregs = []int{}
    let arg_indices = get_call_args(ast_idx)
    let mut i = 0
    for i < len(arg_indices) {
        let vreg = gen_ir_from_ast_with_symtab(arg_indices[i], nodes, instrs, st_names, st_vregs)
        push(arg_vregs, vreg)
        i = i + 1
    }
    return arg_vregs
}

fn gen_ir_index(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let arr = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_names, st_vregs)
    let idx = gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_names, st_vregs)
    let res = len(instrs)
    let instr = IRInstr { op: OP_LOAD(), dest: res, arg1: arr, arg2: idx, arg3: 0, str_val: "array_index" }
    push(instrs, instr)
    return res
}

fn gen_ir_field(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let base = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_names, st_vregs)
    let off = get_field_offset(node.str_val)
    let res = len(instrs)
    let instr = IRInstr { op: OP_LOAD(), dest: res, arg1: base, arg2: off, arg3: 0, str_val: node.str_val }
    push(instrs, instr)
    return res
}

fn gen_ir_array_lit(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let mut f = -1
    let mut cnt = 0
    let mut i = node.right
    for i < len(nodes) && cnt < node.int_val {
        if nodes[i].tag < STMT_LET() {
            let v = gen_ir_from_ast_with_symtab(i, nodes, instrs, st_n, st_v)
            if cnt == 0 { f = v }
            cnt = cnt + 1
        }
        i = i + 1
    }
    if f >= 0 { return f }
    let r = len(instrs)
    push(instrs, IRInstr { op: OP_LOADCONST(), dest: r, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    return r
}

fn get_struct_field_names(name: string) -> []string {
    let f = []string{}
    if name == "AstNode" { push(f, "tag") push(f, "int_val") push(f, "str_val") push(f, "left") push(f, "right") push(f, "extra") push(f, "type_tag") }
    if name == "IRInstr" { push(f, "op") push(f, "dest") push(f, "arg1") push(f, "arg2") push(f, "str_val") }
    if name == "ParseResult" { push(f, "node_idx") push(f, "new_pos") }
    return f
}

fn gen_ir_store_struct_fields(ptr: int, sname: string, idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let vals = get_struct_fields(idx)
    let fnames = get_struct_field_names(sname)
    let mut i = 0
    for i < len(vals) && i < len(fnames) {
        let v = gen_ir_from_ast_with_symtab(vals[i], nodes, instrs, st_names, st_vregs)
        let off = field_offset(sname, fnames[i])
        let addr = len(instrs)
        push(instrs, IRInstr { op: OP_INDEXADDR(), dest: addr, arg1: ptr, arg2: off, arg3: 0, str_val: fnames[i] })
        push(instrs, IRInstr { op: OP_STORE(), dest: -1, arg1: addr, arg2: v, arg3: 0, str_val: "" })
        i = i + 1
    }
    return 0 }

fn gen_ir_struct_lit(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let size = struct_size(node.str_val)
    let ptr = len(instrs)
    let alloc = IRInstr { op: OP_ALLOCA(), dest: ptr, arg1: size, arg2: 0, arg3: 0, str_val: node.str_val }
    push(instrs, alloc)
    gen_ir_store_struct_fields(ptr, node.str_val, ast_idx, nodes, instrs, st_names, st_vregs)
    return ptr
}

fn gen_ir_call_user(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let args = gen_ir_eval_args(ast_idx, nodes, instrs, st_names, st_vregs)
    let mut i = 0
    for i < len(args) {
        push(instrs, IRInstr { op: OP_ADD(), dest: i, arg1: args[i], arg2: -1, arg3: 0, str_val: "" })
        i = i + 1
    }
    let res = len(instrs)
    push(instrs, IRInstr { op: OP_CALL(), dest: res, arg1: 0, arg2: node.int_val, arg3: 0, str_val: node.str_val })
    return res
}

// Helper: Generate IR for binary operations
fn gen_ir_binary_op(token_op: int) -> int {
    let mut op = OP_ADD()
    if token_op == TK_PLUS() { op = OP_ADD() }
    if token_op == TK_MINUS() { op = OP_SUB() }
    if token_op == TK_STAR() { op = OP_MUL() }
    if token_op == TK_SLASH() { op = OP_DIV() }
    if token_op == TK_LT() { op = OP_CMP_LT() }
    if token_op == TK_GT() { op = OP_CMP_GT() }
    if token_op == TK_LE() { op = OP_CMP_LE() }
    if token_op == TK_GE() { op = OP_CMP_GE() }
    if token_op == TK_EQ() { op = OP_CMP_EQ() }
    if token_op == TK_NE() { op = OP_CMP_NE() }
    if token_op == TK_AND() { op = OP_AND() }
    if token_op == TK_OR() { op = OP_OR() }
    return op
}

fn gen_ir_binary(node: AstNode, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    let left_vreg = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, symtab_names, symtab_vregs)
    let right_vreg = gen_ir_from_ast_with_symtab(node.right, nodes, instrs, symtab_names, symtab_vregs)
    let op = gen_ir_binary_op(node.int_val)
    let dest_vreg = len(instrs)
    let instr = IRInstr { op: op, dest: dest_vreg, arg1: left_vreg, arg2: right_vreg, arg3: 0, str_val: "" }
    push(instrs, instr)
    return dest_vreg
}

// Helper: Generate IR for simple expression nodes
fn gen_ir_expr(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    if node.tag == EXPR_INT() {
        let vreg = len(instrs)
        let instr = IRInstr { op: OP_LOADCONST(), dest: vreg, arg1: node.int_val, arg2: 0, arg3: 0, str_val: "" }
        push(instrs, instr)
        return vreg
    }

    if node.tag == EXPR_BOOL() {
        let vreg = len(instrs)
        let instr = IRInstr { op: OP_LOADCONST(), dest: vreg, arg1: node.int_val, arg2: 0, arg3: 0, str_val: "" }
        push(instrs, instr)
        return vreg
    }

    if node.tag == EXPR_IDENT() {
        let mut found_vreg = -1
        let mut idx1 = 0
        let symtab_len1 = len(symtab_names)
        for idx1 < symtab_len1 {
            if symtab_names[idx1] == node.str_val {
                found_vreg = symtab_vregs[idx1]
                break
            }
            idx1 = idx1 + 1
        }
        if found_vreg < 0 {
            return -1
        }
        return found_vreg
    }

    return 0
}

fn gen_ir_stmt_ret(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let mut v = -1
    if node.left >= 0 { v = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_n, st_v) }
    push(instrs, IRInstr { op: OP_RET(), dest: v, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    return v
}

fn gen_ir_stmt_let(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let v = gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v)
    if v < 0 { return -1 }
    push(st_n, node.str_val)
    push(st_v, v)
    return v
}

fn gen_ir_stmt_assign(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    return gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v)
}

fn gen_ir_stmt_if(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let c = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_n, st_v)
    if c < 0 { return -1 }
    let el = len(instrs) + 1000 let en = len(instrs) + 2000
    push(instrs, IRInstr { op: OP_BRANCH(), dest: c, arg1: el, arg2: 0, arg3: 0, str_val: "" })
    if node.right >= 0 { gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v) }
    push(instrs, IRInstr { op: OP_JUMP(), dest: en, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    push(instrs, IRInstr { op: OP_LABEL(), dest: el, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    if node.extra >= 0 { gen_ir_from_ast_with_symtab(node.extra, nodes, instrs, st_n, st_v) }
    push(instrs, IRInstr { op: OP_LABEL(), dest: en, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    return 0
}

fn gen_ir_stmt_for(n: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let s = len(instrs) + 3000
    let e = len(instrs) + 4000
    push(instrs, IRInstr { op: OP_LABEL(), dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    if n.left >= 0 {
        let c = gen_ir_from_ast_with_symtab(n.left, nodes, instrs, st_n, st_v)
        if c < 0 { return -1 }
        push(instrs, IRInstr { op: OP_BRANCH(), dest: c, arg1: e, arg2: 0, arg3: 0, str_val: "" })
    }
    if n.right >= 0 { gen_ir_from_ast_with_symtab(n.right, nodes, instrs, st_n, st_v) }
    push(instrs, IRInstr { op: OP_JUMP(), dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    push(instrs, IRInstr { op: OP_LABEL(), dest: e, arg1: 0, arg2: 0, arg3: 0, str_val: "" }) return 0
}

fn gen_ir_stmt_block(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let mut last = -1 let mut i = node.left let e = node.right + 1
    for i < e {
        if nodes[i].tag >= STMT_LET() {
            last = gen_ir_from_ast_with_symtab(i, nodes, instrs, st_n, st_v)
        }
        i = i + 1
    }
    return last
}

fn gen_ir_from_ast_with_symtab(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    if ast_idx < 0 {
        return -1
    }

    let node = nodes[ast_idx]

    // Dispatch simple expressions to helper
    if node.tag == EXPR_INT() || node.tag == EXPR_BOOL() || node.tag == EXPR_IDENT() {
        return gen_ir_expr(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_BINARY() {
        return gen_ir_binary(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_CALL() {
        let func_name = node.str_val
        if func_name == "len" {
            return gen_ir_call_len(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "push" {
            return gen_ir_call_push(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        return gen_ir_call_user(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_ARRAY_LIT() {
        return gen_ir_array_lit(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_INDEX() {
        return gen_ir_index(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_FIELD() {
        return gen_ir_field(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_STRUCT_LIT() {
        return gen_ir_struct_lit(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_RETURN() {
        return gen_ir_stmt_ret(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_LET() {
        return gen_ir_stmt_let(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_ASSIGN() {
        return gen_ir_stmt_assign(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_EXPR() {
        // Expression statement (e.g., function call without using result)
        // node.left = expression
        // Just evaluate the expression and return its vreg
        return gen_ir_from_ast_with_symtab(node.left, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_IF() {
        return gen_ir_stmt_if(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_FOR() {
        return gen_ir_stmt_for(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_BLOCK() {
        return gen_ir_stmt_block(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == DECL_FUNC() {
        // Generate function with parameters
        // node.left = first parameter index (or -1 if no parameters)
        // node.right = body node

        // Add all parameters to symbol table (using v0, v1, v2, ... for parameter vregs)
        // Parameters are stored consecutively in nodes array starting at node.left
        if node.left >= 0 {
            // Iterate through consecutive parameter nodes
            let mut param_idx = node.left
            let mut param_reg = 0  // v0, v1, v2, etc.

            // Find how many consecutive DECL_PARAM nodes there are
            let mut param_i = node.left
            let nodes_len2 = len(nodes)
            for param_i < nodes_len2 {
                let param_node = nodes[param_i]
                if param_node.tag == DECL_PARAM() {
                    // Add parameter to symbol table
                    push(symtab_names, param_node.str_val)
                    push(symtab_vregs, param_reg)
                    param_reg = param_reg + 1
                } else {
                    // Stop when we hit a non-parameter node
                    break
                }
                param_i = param_i + 1
            }
        }

        // Generate body
        if node.right >= 0 {
            return gen_ir_from_ast_with_symtab(node.right, nodes, instrs, symtab_names, symtab_vregs)
        }
    }

    return 0
}

// ============================================================================
// Simplified Codegen (from codegen.ease)
// ============================================================================

// ARM64 Instruction Encoders

fn encode_mov_imm(rd: int, imm: int) -> int {
    // MOV Xd, #imm (using MOVZ for simplicity, handles 0-65535)
    // MOVZ: 110 1 0010 1 hw(2) imm16(16) Rd(5)
    // For full 64-bit values, need MOVZ + MOVK sequence
    let hw = 0  // shift = 0
    return 0xd2800000 + (hw * 0x200000) + ((imm % 65536) * 0x20) + rd
}

fn encode_add(rd: int, rn: int, rm: int) -> int {
    // ADD Xd, Xn, Xm
    // sf=1 (64-bit), op=0, S=0, shift=00, Rm, imm6=0, Rn, Rd
    return 0x8b000000 + (rm * 0x10000) + (rn * 0x20) + rd
}

fn encode_mov_reg(rd: int, rm: int) -> int {
    // MOV Xd, Xm (implemented as ORR Xd, XZR, Xm)
    // sf=1 (64-bit), opc=01, shift=00, N=0, Rm, imm6=0, Rn=31 (XZR), Rd
    return 0xaa0003e0 + (rm * 0x10000) + rd
}

fn encode_sub(rd: int, rn: int, rm: int) -> int {
    // SUB Xd, Xn, Xm
    return 0xcb000000 + (rm * 0x10000) + (rn * 0x20) + rd
}

fn encode_mul(rd: int, rn: int, rm: int) -> int {
    // MUL Xd, Xn, Xm
    // MADD with Ra=XZR
    return 0x9b007c00 + (rm * 0x10000) + (rn * 0x20) + rd
}

fn encode_lsl(rd: int, rn: int, shift: int) -> int {
    // LSL Xd, Xn, #shift (Logical Shift Left)
    // Encoded as UBFM with specific immr and imms values
    // sf=1, opc=10, N=1, immr=(64-shift)%64, imms=63-shift, Rn, Rd
    let immr = (64 - shift) % 64
    let imms = 63 - shift
    return 0xd3400000 + (immr * 0x10000) + (imms * 0x400) + (rn * 0x20) + rd
}

fn encode_add_imm(rd: int, rn: int, imm: int) -> int {
    // ADD Xd, Xn, #imm (immediate addition)
    // sf=1 (64-bit), op=0, S=0, shift=00, imm12, Rn, Rd
    return 0x91000000 + ((imm % 4096) * 0x400) + (rn * 0x20) + rd
}

fn encode_ret() -> int {
    // RET (return, defaults to X30/LR)
    return 0xd65f03c0
}

fn encode_cbz(rt: int, offset: int) -> int {
    // CBZ Xt, label (Compare and Branch if Zero)
    // sf=1 (64-bit), op=011010, imm19, Rt
    // offset is in instructions (divide by 4 for byte offset)
    return 0xb4000000 + ((offset % 524288) * 0x20) + rt
}

fn encode_b(offset: int) -> int {
    // B label (Unconditional branch)
    // op=000101, imm26
    // offset is in instructions (divide by 4 for byte offset)
    return 0x14000000 + (offset % 67108864)
}

fn encode_bl(offset: int) -> int {
    // BL label (Branch with Link - function call)
    // op=100101, imm26
    // offset is in instructions (divide by 4 for byte offset)
    // Saves return address in X30 (LR) and branches to target
    // Mask offset to 26 bits to handle negative offsets correctly
    let mut masked_offset = offset % 67108864
    if masked_offset < 0 {
        masked_offset = masked_offset + 67108864
    }
    return 0x94000000 + masked_offset
}

fn encode_ldr_offset(rt: int, rn: int, offset: int) -> int {
    // LDR Xt, [Xn, #offset]
    // Load 64-bit register from memory address [Xn + offset]
    // size=11 (64-bit), V=0, opc=01, imm12 (unsigned offset / 8), Rn, Rt
    // Encoding: 11 111 0 01 01 imm12(12) Rn(5) Rt(5)
    // imm12 is offset >> 3 (divided by 8, must be 8-byte aligned)
    let imm12 = (offset / 8) % 4096
    return 0xf9400000 + (imm12 * 0x400) + (rn * 0x20) + rt
}

fn encode_str_offset(rt: int, rn: int, offset: int) -> int {
    // STR Xt, [Xn, #offset]
    // Store 64-bit register to memory address [Xn + offset]
    // size=11 (64-bit), V=0, opc=00, imm12 (unsigned offset / 8), Rn, Rt
    // Encoding: 11 111 0 01 00 imm12(12) Rn(5) Rt(5)
    // imm12 is offset >> 3 (divided by 8, must be 8-byte aligned)
    let imm12 = (offset / 8) % 4096
    return 0xf9000000 + (imm12 * 0x400) + (rn * 0x20) + rt
}

fn encode_ldrb_offset(rt: int, rn: int, offset: int) -> int {
    // LDRB Wt, [Xn, #offset]
    // Load byte (8-bit) from memory address [Xn + offset]
    // size=00 (8-bit), V=0, opc=01, imm12 (unsigned offset), Rn, Rt
    // Encoding: 00 111 0 01 01 imm12(12) Rn(5) Rt(5)
    // imm12 is the byte offset directly (no division needed)
    let imm12 = offset % 4096
    return 0x39400000 + (imm12 * 0x400) + (rn * 0x20) + rt
}

fn encode_strb_offset(rt: int, rn: int, offset: int) -> int {
    // STRB Wt, [Xn, #offset]
    // Store byte (8-bit) to memory address [Xn + offset]
    // size=00 (8-bit), V=0, opc=00, imm12 (unsigned offset), Rn, Rt
    // Encoding: 00 111 0 01 00 imm12(12) Rn(5) Rt(5)
    // imm12 is the byte offset directly (no division needed)
    let imm12 = offset % 4096
    return 0x39000000 + (imm12 * 0x400) + (rn * 0x20) + rt
}

fn gen_code_from_ir(instrs: []IRInstr, code: []int) {
    // Two-pass approach:
    // Pass 1: Build label map (label_id -> instruction_index) and function map (name -> position)
    let mut label_ids = []int{}
    let mut label_positions = []int{}
    let mut func_names = []string{}
    let mut func_positions = []int{}
    let mut instr_count = 0

    let mut pass1_i = 0
    let instrs_len = len(instrs)
    for pass1_i < instrs_len {
        let instr = instrs[pass1_i]
        if instr.op == OP_LABEL() {
            push(label_ids, instr.dest)
            push(label_positions, instr_count)
            // If this label has a function name (str_val), track it
            if instr.str_val != "" {
                push(func_names, instr.str_val)
                push(func_positions, instr_count)
            }
        } else {
            instr_count = instr_count + 1
        }
        pass1_i = pass1_i + 1
    }

    // Pass 2: Generate code
    instr_count = 0
    let mut pass2_i = 0
    for pass2_i < instrs_len {
        let instr = instrs[pass2_i]

        if instr.op == OP_LOADCONST() {
            // MOV Xd, #imm
            let encoded = encode_mov_imm(instr.dest, instr.arg1)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_ADD() {
            // Check if this is actually a MOV (arg2 = -1 flag)
            let mut encoded = 0
            if instr.arg2 == -1 {
                // This is a register move: dest = arg1
                encoded = encode_mov_reg(instr.dest, instr.arg1)
            } else {
                // Normal ADD
                encoded = encode_add(instr.dest, instr.arg1, instr.arg2)
            }
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_SUB() {
            let encoded = encode_sub(instr.dest, instr.arg1, instr.arg2)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_MUL() {
            let encoded = encode_mul(instr.dest, instr.arg1, instr.arg2)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_LOAD() {
            // LDR Xdest, [Xbase, #offset]
            // For now, simplified: assume arg1 is base register, arg2 is offset
            // In real implementation, would handle array indexing differently
            let base_reg = instr.arg1
            let offset = instr.arg2
            let dest_reg = instr.dest
            let encoded = encode_ldr_offset(dest_reg, base_reg, offset)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_STORE() {
            // STR Xsrc, [Xbase, #offset]
            // Store value from arg2 to memory at arg1 + offset
            let base_reg = instr.arg1
            let src_reg = instr.arg2
            let offset = 0  // For now, store directly (no offset)
            let encoded = encode_str_offset(src_reg, base_reg, offset)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_ALLOCA() {
            // Allocate stack space
            // For bootstrap: use a simple heap_alloc call (simplified)
            // In full implementation: adjust stack pointer
            // For now: generate MOV Xdest, #size (placeholder)
            let encoded = encode_mov_imm(instr.dest, instr.arg1)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_INDEXADDR() {
            // Pointer arithmetic: dest = arg1 + arg2 (offset)
            // ADD Xdest, Xbase, #offset
            if instr.arg2 == 0 {
                // No offset, just copy pointer
                let encoded = encode_mov_reg(instr.dest, instr.arg1)
                push(code, encoded)
            } else {
                // Add offset to base pointer
                // For now, load offset into temp register and add
                let temp_reg = 16  // X16 as temp
                let mov_encoded = encode_mov_imm(temp_reg, instr.arg2)
                push(code, mov_encoded)
                instr_count = instr_count + 1
                let add_encoded = encode_add(instr.dest, instr.arg1, temp_reg)
                push(code, add_encoded)
            }
            instr_count = instr_count + 1
        }
        if instr.op == OP_STORE() {
            // STR: Store arg2 (value) to memory at arg1 (address)
            // STR Xvalue, [Xaddr]
            let encoded = encode_str_offset(instr.arg2, instr.arg1, 0)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_ARRAY_LEN() {
            // Load length from fat pointer at offset 8
            // LDR Xdest, [Xarray, #8]
            let encoded = encode_ldr_offset(instr.dest, instr.arg1, 8)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_ARRAY_PUSH() {
            // Simplified push (no growth): load len, store elem, increment len
            // For bootstrap: assume 8-byte elements (int, pointer, etc.)
            let array_reg = instr.arg1
            let elem_reg = instr.arg2

            // Load len from fat pointer at offset 8
            // LDR X16, [Xarray, #8]
            let load_len = encode_ldr_offset(16, array_reg, 8)
            push(code, load_len)
            instr_count = instr_count + 1

            // Load data pointer from offset 0
            // LDR X17, [Xarray, #0]
            let load_ptr = encode_ldr_offset(17, array_reg, 0)
            push(code, load_ptr)
            instr_count = instr_count + 1

            // Calculate element address: X18 = X17 + (X16 * 8)
            // LSL X18, X16, #3  (multiply by 8)
            let shift = encode_lsl(18, 16, 3)
            push(code, shift)
            instr_count = instr_count + 1

            // ADD X18, X17, X18
            let add_addr = encode_add(18, 17, 18)
            push(code, add_addr)
            instr_count = instr_count + 1

            // Store element: STR Xelem, [X18]
            let store_elem = encode_str_offset(elem_reg, 18, 0)
            push(code, store_elem)
            instr_count = instr_count + 1

            // Increment length: ADD X16, X16, #1
            let inc_len = encode_add_imm(16, 16, 1)
            push(code, inc_len)
            instr_count = instr_count + 1

            // Store new length back: STR X16, [Xarray, #8]
            let store_len = encode_str_offset(16, array_reg, 8)
            push(code, store_len)
            instr_count = instr_count + 1
        }
        if instr.op == OP_STR_CHAR_AT() {
            // str_char_at(str, index) - returns character at index as int
            // dest = result, arg1 = string vreg, arg2 = index vreg
            let str_reg = instr.arg1
            let index_reg = instr.arg2
            let dest_reg = instr.dest

            // Compute address: str + index
            // ADD X16, Xstr, Xindex
            let add_addr = encode_add(16, str_reg, index_reg)
            push(code, add_addr)
            instr_count = instr_count + 1

            // Load byte at address
            // LDRB W17, [X16, #0]
            let load_byte = encode_ldrb_offset(17, 16, 0)
            push(code, load_byte)
            instr_count = instr_count + 1

            // Move result to destination register
            // MOV Xdest, X17
            let mov_result = encode_mov_reg(dest_reg, 17)
            push(code, mov_result)
            instr_count = instr_count + 1
        }
        if instr.op == OP_STR_SUBSTRING() {
            // str_substring(str, start, end) - returns new string with substring
            // dest = result pointer, arg1 = string vreg, arg2 = start vreg, arg3 = end vreg
            // Note: Full implementation requires mmap syscall for allocation
            // For bootstrap demo, we'll show the structure but actual execution needs runtime support

            let str_reg = instr.arg1
            let start_reg = instr.arg2
            let end_reg = instr.arg3
            let dest_reg = instr.dest

            // Calculate length: end - start
            // SUB X16, Xend, Xstart
            let calc_len = encode_sub(16, end_reg, start_reg)
            push(code, calc_len)
            instr_count = instr_count + 1

            // Calculate source address: str + start
            // ADD X17, Xstr, Xstart
            let calc_src = encode_add(17, str_reg, start_reg)
            push(code, calc_src)
            instr_count = instr_count + 1

            // For now: just return source pointer (not a copy)
            // Full implementation would:
            // 1. Allocate buffer with mmap (size = length + 1)
            // 2. Copy bytes in loop from X17 to buffer
            // 3. Null-terminate buffer
            // 4. Return buffer pointer
            // MOV Xdest, X17
            let mov_result = encode_mov_reg(dest_reg, 17)
            push(code, mov_result)
            instr_count = instr_count + 1
        }
        if instr.op == OP_CALL() {
            // BL <function> - Branch with Link (function call)
            // Look up function position by name
            let mut target_pos = 0
            let mut j = 0
            let func_count = len(func_names)
            for j < func_count {
                if func_names[j] == instr.str_val {
                    target_pos = func_positions[j]
                    break
                }
                j = j + 1
            }
            // Calculate offset from current instruction to function start
            let offset = target_pos - instr_count
            let encoded = encode_bl(offset)
            push(code, encoded)
            instr_count = instr_count + 1

            // Move return value from X0 to destination register
            // Return value comes back in X0, need to move it to vreg
            if instr.dest >= 0 {
                let dest_reg = instr.dest
                if dest_reg != 0 {
                    // Only generate MOV if destination is not X0
                    let mov_result = encode_mov_reg(dest_reg, 0)
                    push(code, mov_result)
                    instr_count = instr_count + 1
                }
            }
        }
        if instr.op == OP_RET() {
            // If returning a value, move it to X0
            if instr.dest >= 0 {
                let mov_to_x0 = encode_mov_reg(0, instr.dest)
                push(code, mov_to_x0)
                instr_count = instr_count + 1
            }

            // Check if we're in main function - only main should exit
            // Find which function we're currently in by checking from end
            let mut is_main_func = 0
            let mut current_func_idx = -1

            let num_funcs = len(func_names)
            let mut check_i = 0
            for check_i < num_funcs {
                if func_positions[check_i] <= instr_count {
                    current_func_idx = check_i
                }
                check_i = check_i + 1
            }

            // Check if current function is main
            if current_func_idx >= 0 {
                if func_names[current_func_idx] == "main" {
                    is_main_func = 1
                }
            }

            if is_main_func == 1 {
                // Main function: call exit syscall
                // MOV X16, #1 (exit syscall number)
                let mov_x16 = encode_mov_imm(16, 1)
                push(code, mov_x16)
                instr_count = instr_count + 1
                // SVC #0x80 (make syscall)
                push(code, 0xd4001001)
                instr_count = instr_count + 1
            } else {
                // Other functions: use RET instruction
                // RET = 0xD65F03C0 (return using X30/LR)
                push(code, 0xD65F03C0)
                instr_count = instr_count + 1
            }
        }
        if instr.op == OP_BRANCH() {
            // CBZ Rt, label - branch if register is zero
            // Find label position
            let mut target_pos = 0
            let mut branch_j = 0
            let label_count = len(label_ids)
            for branch_j < label_count {
                if label_ids[branch_j] == instr.arg1 {
                    target_pos = label_positions[branch_j]
                    break
                }
                branch_j = branch_j + 1
            }
            let offset = target_pos - instr_count
            let encoded = encode_cbz(instr.dest, offset)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        if instr.op == OP_JUMP() {
            // B label - unconditional branch
            // Find label position
            let mut target_pos = 0
            let mut jump_j = 0
            let label_count2 = len(label_ids)
            for jump_j < label_count2 {
                if label_ids[jump_j] == instr.dest {
                    target_pos = label_positions[jump_j]
                    break
                }
                jump_j = jump_j + 1
            }
            let offset = target_pos - instr_count
            let encoded = encode_b(offset)
            push(code, encoded)
            instr_count = instr_count + 1
        }
        // OP_LABEL doesn't generate code, just marks position
        pass2_i = pass2_i + 1
    }
}

// ============================================================================
// Main Integration Demo
// ============================================================================

fn print_hex(val: int) {
    print("0x")
    let mut v = val
    let mut digits = []int{}
    let mut hex_i = 0
    for hex_i < 8 {
        push(digits, v % 16)
        v = v / 16
        hex_i = hex_i + 1
    }
    let mut print_i = 0
    for print_i < 8 {
        let d = digits[7 - print_i]
        if d < 10 {
            print(strconv.Itoa(d))
        } else {
            if d == 10 { print("a") }
            if d == 11 { print("b") }
            if d == 12 { print("c") }
            if d == 13 { print("d") }
            if d == 14 { print("e") }
            if d == 15 { print("f") }
        }
        print_i = print_i + 1
    }
}

// ============================================================================
// Mach-O Binary Writer
// ============================================================================

// Mach-O constants
fn MH_MAGIC_64() -> int { return 0xfeedfacf }
fn MH_EXECUTE() -> int { return 0x2 }
fn MH_NOUNDEFS() -> int { return 0x1 }
fn MH_DYLDLINK() -> int { return 0x4 }
fn MH_TWOLEVEL() -> int { return 0x80 }
fn MH_PIE() -> int { return 0x200000 }
fn CPU_TYPE_ARM64() -> int { return 0x100000C }
fn CPU_SUBTYPE_ARM64_ALL() -> int { return 0x0 }
fn LC_SEGMENT_64() -> int { return 0x19 }
fn LC_MAIN() -> int { return 0x80000028 }
fn LC_LOAD_DYLINKER() -> int { return 0xE }
fn LC_BUILD_VERSION() -> int { return 0x32 }
fn LC_SYMTAB() -> int { return 0x2 }
fn LC_DYSYMTAB() -> int { return 0xB }
fn LC_CODE_SIGNATURE() -> int { return 0x1D }
fn PLATFORM_MACOS() -> int { return 1 }
fn CSMAGIC_EMBEDDED_SIGNATURE() -> int { return 0xfade0cc0 }
fn CSMAGIC_CODEDIRECTORY() -> int { return 0xfade0c02 }
fn CSMAGIC_REQUIREMENTS() -> int { return 0xfade0c01 }
fn CSSLOT_CODEDIRECTORY() -> int { return 0 }
fn CSSLOT_REQUIREMENTS() -> int { return 2 }
fn VM_PROT_READ() -> int { return 0x1 }
fn VM_PROT_WRITE() -> int { return 0x2 }
fn VM_PROT_EXECUTE() -> int { return 0x4 }
fn PAGE_SIZE() -> int { return 0x4000 }

// Binary writing helpers
fn write_u16_le(addr: int, value: int) {
    poke(addr, value - ((value / 256) * 256))
    poke(addr + 1, value / 256)
}

fn write_u32_le(addr: int, value: int) {
    poke(addr, value - ((value / 256) * 256))
    poke(addr + 1, (value / 256) - ((value / 65536) * 256))
    poke(addr + 2, (value / 65536) - ((value / 16777216) * 256))
    poke(addr + 3, value / 16777216)
}

fn write_u64_le(addr: int, value: int) {
    write_u32_le(addr, value)
    let high = value / 4294967296
    write_u32_le(addr + 4, high)
}

fn write_zeros(addr: int, count: int) {
    let mut i = 0
    for i < count {
        poke(addr + i, 0)
        i = i + 1
    }
}

fn align_up(val: int, alignment: int) -> int {
    let remainder = val - ((val / alignment) * alignment)
    if remainder == 0 {
        return val
    }
    return val + (alignment - remainder)
}

// Write Mach-O header (32 bytes)
fn write_mach_header(buf: int, num_cmds: int, cmds_size: int) -> int {
    let mut offset = 0
    write_u32_le(buf + offset, MH_MAGIC_64())
    offset = offset + 4
    write_u32_le(buf + offset, CPU_TYPE_ARM64())
    offset = offset + 4
    write_u32_le(buf + offset, CPU_SUBTYPE_ARM64_ALL())
    offset = offset + 4
    write_u32_le(buf + offset, MH_EXECUTE())
    offset = offset + 4
    write_u32_le(buf + offset, num_cmds)
    offset = offset + 4
    write_u32_le(buf + offset, cmds_size)
    offset = offset + 4
    let flags = MH_NOUNDEFS() + MH_DYLDLINK() + MH_TWOLEVEL() + MH_PIE()
    write_u32_le(buf + offset, flags)
    offset = offset + 4
    write_u32_le(buf + offset, 0)
    offset = offset + 4
    return 32
}

// Helper: Write ASCII string to buffer (up to 16 bytes, zero-padded)
fn write_segment_name(buf: int, name: string) {
    // For bootstrap simplicity, hardcode the most common names
    if name == "__PAGEZERO" {
        poke(buf, 95)   // '_'
        poke(buf + 1, 95)   // '_'
        poke(buf + 2, 80)   // 'P'
        poke(buf + 3, 65)   // 'A'
        poke(buf + 4, 71)   // 'G'
        poke(buf + 5, 69)   // 'E'
        poke(buf + 6, 90)   // 'Z'
        poke(buf + 7, 69)   // 'E'
        poke(buf + 8, 82)   // 'R'
        poke(buf + 9, 79)   // 'O'
        let mut i = 10
        for i < 16 {
            poke(buf + i, 0)
            i = i + 1
        }
    }
    if name == "__TEXT" {
        poke(buf, 95)   // '_'
        poke(buf + 1, 95)   // '_'
        poke(buf + 2, 84)   // 'T'
        poke(buf + 3, 69)   // 'E'
        poke(buf + 4, 88)   // 'X'
        poke(buf + 5, 84)   // 'T'
        let mut i = 6
        for i < 16 {
            poke(buf + i, 0)
            i = i + 1
        }
    }
    if name == "__text" {
        poke(buf, 95)   // '_'
        poke(buf + 1, 95)   // '_'
        poke(buf + 2, 116)  // 't'
        poke(buf + 3, 101)  // 'e'
        poke(buf + 4, 120)  // 'x'
        poke(buf + 5, 116)  // 't'
        let mut i = 6
        for i < 16 {
            poke(buf + i, 0)
            i = i + 1
        }
    }
}

// Write __PAGEZERO segment (72 bytes)
fn write_pagezero_segment(buf: int) -> int {
    let mut offset = 0
    write_u32_le(buf + offset, LC_SEGMENT_64())
    offset = offset + 4
    write_u32_le(buf + offset, 72)
    offset = offset + 4
    write_segment_name(buf + offset, "__PAGEZERO")
    offset = offset + 16
    write_u64_le(buf + offset, 0)
    offset = offset + 8
    write_u64_le(buf + offset, 4294967296)
    offset = offset + 8
    write_u64_le(buf + offset, 0)
    offset = offset + 8
    write_u64_le(buf + offset, 0)
    offset = offset + 8
    write_u32_le(buf + offset, 0)
    offset = offset + 4
    write_u32_le(buf + offset, 0)
    offset = offset + 4
    write_u32_le(buf + offset, 0)
    offset = offset + 4
    write_u32_le(buf + offset, 0)
    offset = offset + 4
    return 72
}

// Write __TEXT segment (152 bytes with section)
fn write_text_segment(buf: int, code_size: int, file_offset: int) -> int {
    let mut offset = 0
    let vm_addr = 4294967296 + file_offset  // 0x100000000 + file_offset
    let seg_size = align_up(file_offset + code_size, PAGE_SIZE())  // Include header in segment

    write_u32_le(buf + offset, LC_SEGMENT_64())
    offset = offset + 4
    write_u32_le(buf + offset, 152)
    offset = offset + 4
    write_segment_name(buf + offset, "__TEXT")
    offset = offset + 16
    write_u64_le(buf + offset, 4294967296)  // vmaddr starts at 0x100000000
    offset = offset + 8
    write_u64_le(buf + offset, seg_size)  // vmsize includes header
    offset = offset + 8
    write_u64_le(buf + offset, 0)  // fileoff: segment starts at beginning of file
    offset = offset + 8
    write_u64_le(buf + offset, seg_size)  // filesize: entire segment
    offset = offset + 8
    let prot = VM_PROT_READ() + VM_PROT_EXECUTE()
    write_u32_le(buf + offset, prot)  // maxprot
    offset = offset + 4
    write_u32_le(buf + offset, prot)  // initprot
    offset = offset + 4
    write_u32_le(buf + offset, 1)
    offset = offset + 4
    write_u32_le(buf + offset, 0)
    offset = offset + 4
    // Section structure (80 bytes): sectname, segname, addr, size, offset, align, reloff, nreloc, flags, reserved
    write_segment_name(buf + offset, "__text")
    offset = offset + 16
    write_segment_name(buf + offset, "__TEXT")
    offset = offset + 16
    let section_vmaddr = 4294967296 + file_offset  // 0x100000000 + file_offset
    write_u64_le(buf + offset, section_vmaddr)
    offset = offset + 8
    write_u64_le(buf + offset, code_size)
    offset = offset + 8
    write_u32_le(buf + offset, file_offset)
    offset = offset + 4
    write_u32_le(buf + offset, 2)  // align = 2^2 = 4 bytes
    offset = offset + 4
    write_u32_le(buf + offset, 0)  // reloff
    offset = offset + 4
    write_u32_le(buf + offset, 0)  // nreloc
    offset = offset + 4
    write_u32_le(buf + offset, 0x80000400)  // flags: S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    offset = offset + 4
    write_u32_le(buf + offset, 0)  // reserved1
    offset = offset + 4
    write_u32_le(buf + offset, 0)  // reserved2
    offset = offset + 4
    write_u32_le(buf + offset, 0)  // reserved3 (64-bit only)
    offset = offset + 4
    return 152
}

// Write LC_LOAD_DYLINKER (32 bytes)
fn write_dylinker_command(buf: int) -> int {
    let mut offset = 0
    write_u32_le(buf + offset, LC_LOAD_DYLINKER())
    offset = offset + 4
    write_u32_le(buf + offset, 32)
    offset = offset + 4
    write_u32_le(buf + offset, 12)  // offset to string within command
    offset = offset + 4
    // String: "/usr/lib/dyld" (null-terminated, padded to 4-byte boundary)
    poke(buf + offset, 47)  // '/'
    poke(buf + offset + 1, 117)  // 'u'
    poke(buf + offset + 2, 115)  // 's'
    poke(buf + offset + 3, 114)  // 'r'
    poke(buf + offset + 4, 47)  // '/'
    poke(buf + offset + 5, 108)  // 'l'
    poke(buf + offset + 6, 105)  // 'i'
    poke(buf + offset + 7, 98)  // 'b'
    poke(buf + offset + 8, 47)  // '/'
    poke(buf + offset + 9, 100)  // 'd'
    poke(buf + offset + 10, 121)  // 'y'
    poke(buf + offset + 11, 108)  // 'l'
    poke(buf + offset + 12, 100)  // 'd'
    poke(buf + offset + 13, 0)  // null terminator
    write_u16_le(buf + offset + 14, 0)  // padding to 4-byte boundary
    offset = offset + 20
    return 32
}

// Write LC_BUILD_VERSION (24 bytes)
fn write_build_version_cmd(buf: int) -> int {
    let mut offset = 0
    write_u32_le(buf + offset, LC_BUILD_VERSION())
    offset = offset + 4
    write_u32_le(buf + offset, 24)
    offset = offset + 4
    write_u32_le(buf + offset, PLATFORM_MACOS())  // platform = 1 (macOS)
    offset = offset + 4
    write_u32_le(buf + offset, 0x000B0000)  // minos = 11.0
    offset = offset + 4
    write_u32_le(buf + offset, 0x000B0000)  // sdk = 11.0
    offset = offset + 4
    write_u32_le(buf + offset, 0)  // ntools = 0
    offset = offset + 4
    return 24
}

// Write __LINKEDIT segment (72 bytes)
fn write_linkedit_segment(buf: int, linkedit_offset: int, linkedit_size: int) -> int {
    let mut offset = 0
    write_u32_le(buf + offset, LC_SEGMENT_64())
    offset = offset + 4
    write_u32_le(buf + offset, 72)
    offset = offset + 4
    // segname: "__LINKEDIT"
    write_zeros(buf + offset, 16)
    poke(buf + offset, 95)   // '_'
    poke(buf + offset + 1, 95) // '_'
    poke(buf + offset + 2, 76) // 'L'
    poke(buf + offset + 3, 73) // 'I'
    poke(buf + offset + 4, 78) // 'N'
    poke(buf + offset + 5, 75) // 'K'
    poke(buf + offset + 6, 69) // 'E'
    poke(buf + offset + 7, 68) // 'D'
    poke(buf + offset + 8, 73) // 'I'
    poke(buf + offset + 9, 84) // 'T'
    offset = offset + 16
    write_u64_le(buf + offset, 4294967296 + PAGE_SIZE())  // vmaddr after __TEXT
    offset = offset + 8
    write_u64_le(buf + offset, PAGE_SIZE())  // vmsize
    offset = offset + 8
    write_u64_le(buf + offset, linkedit_offset)
    offset = offset + 8
    write_u64_le(buf + offset, linkedit_size)
    offset = offset + 8
    write_u32_le(buf + offset, VM_PROT_READ())  // maxprot
    offset = offset + 4
    write_u32_le(buf + offset, VM_PROT_READ())  // initprot
    offset = offset + 4
    write_u32_le(buf + offset, 0)  // nsects
    offset = offset + 4
    write_u32_le(buf + offset, 0)  // flags
    offset = offset + 4
    return 72
}

// Write LC_SYMTAB (24 bytes)
fn write_symtab_cmd(buf: int, symoff: int, nsyms: int, stroff: int, strsize: int) -> int {
    let mut offset = 0
    write_u32_le(buf + offset, LC_SYMTAB())
    offset = offset + 4
    write_u32_le(buf + offset, 24)
    offset = offset + 4
    write_u32_le(buf + offset, symoff)
    offset = offset + 4
    write_u32_le(buf + offset, nsyms)
    offset = offset + 4
    write_u32_le(buf + offset, stroff)
    offset = offset + 4
    write_u32_le(buf + offset, strsize)
    offset = offset + 4
    return 24
}

// Write LC_DYSYMTAB (80 bytes)
fn write_dysymtab_cmd(buf: int) -> int {
    let mut offset = 0
    write_u32_le(buf + offset, LC_DYSYMTAB())
    offset = offset + 4
    write_u32_le(buf + offset, 80)
    offset = offset + 4
    write_zeros(buf + offset, 72)  // All zeros for minimal binary
    offset = offset + 72
    return 80
}

// Write LC_CODE_SIGNATURE (16 bytes)
fn write_code_signature_cmd(buf: int, dataoff: int, datasize: int) -> int {
    let mut offset = 0
    write_u32_le(buf + offset, LC_CODE_SIGNATURE())
    offset = offset + 4
    write_u32_le(buf + offset, 16)
    offset = offset + 4
    write_u32_le(buf + offset, dataoff)
    offset = offset + 4
    write_u32_le(buf + offset, datasize)
    offset = offset + 4
    return 16
}

// Write big-endian uint32
fn write_u32_be(addr: int, value: int) {
    poke(addr, value / 16777216)
    poke(addr + 1, (value / 65536) - ((value / 16777216) * 256))
    poke(addr + 2, (value / 256) - ((value / 65536) * 256))
    poke(addr + 3, value - ((value / 256) * 256))
}

// Create ad-hoc code signature blob (full version)
fn write_code_signature_blob(sig_buf: int, bin_buf: int, sig_offset: int, code_limit: int, identifier: string) -> int {
    let mut offset = 0

    // Calculate sizes
    let ident_len = 8  // "main" + null + padding
    let cd_size = 88 + ident_len + 32  // CodeDirectory header + identifier + 1 hash slot
    let cd_size_aligned = align_up(cd_size, 4)
    let req_size = 12  // Empty requirements
    let total_size = 12 + (2 * 8) + cd_size_aligned + req_size  // SuperBlob header is 12 bytes, not 8

    // SuperBlob header
    write_u32_be(sig_buf + offset, CSMAGIC_EMBEDDED_SIGNATURE())
    offset = offset + 4
    write_u32_be(sig_buf + offset, total_size)
    offset = offset + 4
    write_u32_be(sig_buf + offset, 2)  // count (CodeDirectory + Requirements)
    offset = offset + 4

    // Index entry 0: CodeDirectory
    write_u32_be(sig_buf + offset, CSSLOT_CODEDIRECTORY())
    offset = offset + 4
    write_u32_be(sig_buf + offset, 12 + 16)  // offset: header(12) + indices(2*8)
    offset = offset + 4

    // Index entry 1: Requirements
    write_u32_be(sig_buf + offset, CSSLOT_REQUIREMENTS())
    offset = offset + 4
    write_u32_be(sig_buf + offset, 12 + 16 + cd_size_aligned)  // after header + indices + CodeDirectory
    offset = offset + 4

    // CodeDirectory blob
    let cd_start = offset
    write_u32_be(sig_buf + offset, CSMAGIC_CODEDIRECTORY())
    offset = offset + 4
    write_u32_be(sig_buf + offset, cd_size_aligned)
    offset = offset + 4
    write_u32_be(sig_buf + offset, 0x20400)  // version
    offset = offset + 4
    write_u32_be(sig_buf + offset, 0x20002)  // flags (adhoc | linker-signed)
    offset = offset + 4
    write_u32_be(sig_buf + offset, 52)  // hashOffset
    offset = offset + 4
    write_u32_be(sig_buf + offset, 88)  // identOffset
    offset = offset + 4
    write_u32_be(sig_buf + offset, 0)  // nSpecialSlots
    offset = offset + 4
    write_u32_be(sig_buf + offset, 1)  // nCodeSlots
    offset = offset + 4
    write_u32_be(sig_buf + offset, code_limit)  // codeLimit
    offset = offset + 4
    poke(sig_buf + offset, 32)  // hashSize (SHA256 = 32 bytes)
    offset = offset + 1
    poke(sig_buf + offset, 2)  // hashType (SHA256)
    offset = offset + 1
    poke(sig_buf + offset, 0)  // platform
    offset = offset + 1
    poke(sig_buf + offset, 12)  // pageSize (2^12 = 4096)
    offset = offset + 1
    write_u32_be(sig_buf + offset, 0)  // spare2
    offset = offset + 4
    write_u32_be(sig_buf + offset, 0)  // scatterOffset
    offset = offset + 4
    write_u32_be(sig_buf + offset, 0)  // teamOffset
    offset = offset + 4
    write_u32_be(sig_buf + offset, 0)  // spare3
    offset = offset + 4
    write_u64_le(sig_buf + offset, 0)  // codeLimit64
    offset = offset + 8
    write_u64_le(sig_buf + offset, 0)  // execSegBase
    offset = offset + 8
    write_u64_le(sig_buf + offset, 0)  // execSegLimit
    offset = offset + 8
    write_u64_le(sig_buf + offset, 0)  // execSegFlags
    offset = offset + 8

    // Hash slot: SHA256 of code section (at hashOffset, not at current offset!)
    offset = cd_start + 52  // Jump to hashOffset
    sha256.Sha256(bin_buf, code_limit, sig_buf + offset)
    offset = offset + 32

    // Identifier: "main" (at identOffset)
    offset = cd_start + 88  // Jump to identOffset
    poke(sig_buf + offset, 109)  // 'm'
    poke(sig_buf + offset + 1, 97)  // 'a'
    poke(sig_buf + offset + 2, 105)  // 'i'
    poke(sig_buf + offset + 3, 110)  // 'n'
    poke(sig_buf + offset + 4, 0)  // null
    offset = offset + 5

    // Pad to alignment
    for offset < (cd_start + cd_size_aligned) {
        poke(sig_buf + offset, 0)
        offset = offset + 1
    }

    // Requirements blob (empty)
    write_u32_be(sig_buf + offset, CSMAGIC_REQUIREMENTS())
    offset = offset + 4
    write_u32_be(sig_buf + offset, req_size)
    offset = offset + 4
    write_u32_le(sig_buf + offset, 0)
    offset = offset + 4

    return total_size
}

// Write LC_MAIN (24 bytes)
fn write_main_cmd(buf: int, entry_offset: int) -> int {
    let mut offset = 0
    write_u32_le(buf + offset, LC_MAIN())
    offset = offset + 4
    write_u32_le(buf + offset, 24)
    offset = offset + 4
    write_u64_le(buf + offset, entry_offset)
    offset = offset + 8
    write_u64_le(buf + offset, 0)
    offset = offset + 8
    return 24
}

// Write complete Mach-O binary (Note: disabled due to type system limitations)
// Requires: syscall_write to accept int buffers, or a way to cast int to string
// fn write_macho_binary(filename: string, code: []int) -> int {
//     let code_size = len(code) * 4
//     let header_size = 32 + 72 + 152 + 24
//     let file_size = align_up(header_size + code_size, PAGE_SIZE())
