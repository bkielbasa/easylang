// Bootstrap Ease Compiler (LLVM IR backend)
// Main entry point — imports domain modules and orchestrates compilation pipeline

import (
    "./strconv"
    "./token"
    "./lexer"
    "./ast"
    "./parser"
    "./ir"
    "./irgen"
    "./llvm"
)

// Global storage for function call arguments (workaround for immutability)
// Maps call node index -> argument indices
// Layout: [call_idx1, arg_count1, arg1_idx, arg2_idx, ..., call_idx2, arg_count2, ...]
let mut g_call_args = []int{}

fn store_call_args(call_node_idx: int, arg_indices: []int) {
    push(g_call_args, call_node_idx)
    push(g_call_args, len(arg_indices))
    let mut i = 0
    let count = len(arg_indices)
    for i < count {
        push(g_call_args, arg_indices[i])
        i = i + 1
    }
}

fn get_call_args(call_node_idx: int) -> []int {
    // Search for call_node_idx in g_call_args
    let mut i = 0
    for {
        if i >= len(g_call_args) {
            break
        }
        if g_call_args[i] == call_node_idx {
            // Found it - next element is arg_count
            let arg_count = g_call_args[i + 1]
            let mut result = []int{}
            let mut j = 0
            for j < arg_count {
                push(result, g_call_args[i + 2 + j])
                j = j + 1
            }
            return result
        }
        // Skip to next entry: current + 1 (count) + count (args)
        let arg_count = g_call_args[i + 1]
        i = i + 2 + arg_count
    }
    return []int{}
}

// Global storage for struct literal field values
// Maps struct_lit node index -> field value indices
// Layout: same as g_call_args
let mut g_struct_fields = []int{}
let mut g_string_vars = []string{}
let mut g_string_array_vars = []string{}
let mut g_string_vars_start = 0
let mut g_string_array_vars_start = 0
let mut g_scalar_globals = []string{}
let mut g_break_label = -1
let mut g_next_label = 100000
let mut g_func_ret_names = []string{}
let mut g_func_ret_types = []int{}
let mut g_func_ret_is_array = []int{}
let mut g_import_paths = []string{}
let mut g_import_names = []string{}
let mut g_rename_from = []string{}
let mut g_rename_to = []string{}

fn register_func_return_type(name: string, ret_type: int, is_array: int) {
    push(g_func_ret_names, name)
    push(g_func_ret_types, ret_type)
    push(g_func_ret_is_array, is_array)
}

fn lookup_func_return_type(name: string) -> int {
    let mut i = len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_types[i]
        }
        i = i - 1
    }
    return TYPE_UNKNOWN()
}

fn lookup_func_return_is_array(name: string) -> int {
    let mut i = len(g_func_ret_names) - 1
    for i >= 0 {
        if g_func_ret_names[i] == name {
            return g_func_ret_is_array[i]
        }
        i = i - 1
    }
    return 0
}

// Find the position of '.' in a string, returns -1 if not found
fn find_dot(name: string) -> int {
    let mut i = 0
    for i < len(name) {
        if str_char_at(name, i) == 46 { return i }
        i = i + 1
    }
    return -1
}

// Find the last '/' in a string, returns -1 if not found
fn find_last_slash(path: string) -> int {
    let mut i = len(path) - 1
    for i >= 0 {
        if str_char_at(path, i) == 47 { return i }
        i = i - 1
    }
    return -1
}

// Extract module name from import path: "./lexer" -> "lexer", "./sub/parser" -> "parser"
fn extract_module_name(import_path: string) -> string {
    let slash_pos = find_last_slash(import_path)
    if slash_pos >= 0 {
        return str_substring(import_path, slash_pos + 1, len(import_path))
    }
    return import_path
}

// Resolve import path relative to source file: "./lexer" -> "dir/lexer.ease"
fn resolve_import_path(source_path: string, import_path: string) -> string {
    let slash_pos = find_last_slash(source_path)
    let mut dir = "."
    if slash_pos >= 0 {
        dir = str_substring(source_path, 0, slash_pos)
    }
    // Strip leading "./" from import_path if present
    let mut rel_path = import_path
    if len(import_path) >= 2 && str_char_at(import_path, 0) == 46 && str_char_at(import_path, 1) == 47 {
        rel_path = str_substring(import_path, 2, len(import_path))
    }
    return dir + "/" + rel_path + ".ease"
}

// Look up a function name in the rename table; returns qualified name or original
fn lookup_rename(name: string) -> string {
    let mut i = 0
    for i < len(g_rename_from) {
        if g_rename_from[i] == name {
            return g_rename_to[i]
        }
        i = i + 1
    }
    return name
}

fn store_struct_fields(struct_node_idx: int, field_indices: []int) {
    push(g_struct_fields, struct_node_idx)
    push(g_struct_fields, len(field_indices))
    let mut i = 0
    let count = len(field_indices)
    for i < count {
        push(g_struct_fields, field_indices[i])
        i = i + 1
    }
}

fn get_struct_fields(struct_node_idx: int) -> []int {
    let mut i = 0
    for {
        if i >= len(g_struct_fields) {
            break
        }
        if g_struct_fields[i] == struct_node_idx {
            let field_count = g_struct_fields[i + 1]
            let mut result = []int{}
            let mut j = 0
            for j < field_count {
                push(result, g_struct_fields[i + 2 + j])
                j = j + 1
            }
            return result
        }
        let field_count = g_struct_fields[i + 1]
        i = i + 2 + field_count
    }
    return []int{}
}

fn count_func_params(nodes: []AstNode, func_idx: int) -> int {
    let node = nodes[func_idx]
    if node.left < 0 { return 0 }
    let mut count = 0
    let mut pi = node.left
    let nodes_len = len(nodes)
    for pi < nodes_len {
        if nodes[pi].tag == DECL_PARAM() {
            count = count + 1
        } else {
            break
        }
        pi = pi + 1
    }
    return count
}

fn main() -> int {
    print("=== Bootstrap Ease Compiler (LLVM IR) ===\n\n")

    // Get command-line arguments
    let argc = os.Argc()
    let mut source = ""
    let mut filename = ""

    if argc > 1 {
        filename = os.Argv(1)
        print("Reading file: " + filename + "\n")
        source = os.ReadFile(filename)
        print("File loaded successfully\n\n")
    } else {
        print("ERROR: No input file specified\n")
        print("Usage: compiler <source.ease>\n")
        return 1
    }

    // Phase 1: Lexing
    print("Phase 1: Lexing\n")
    let mut pos = 0
    let mut token_count = 0
    for {
        pos = lex_skip(source, pos)
        let kind = lex_kind(source, pos)
        if kind == TK_EOF() { break }
        token_count = token_count + 1
        pos = lex_end(source, pos, kind)
    }
    print("Lexed " + strconv.Itoa(token_count) + " tokens\n\n")

    // Phase 2: Parsing
    print("Phase 2: Parsing\n")
    let mut nodes = []AstNode{}
    let mut parse_pos = 0
    parse_pos = lex_skip(source, parse_pos)
    let mut import_count = 0
    let mut struct_count = 0
    let mut func_names = []string{}
    let mut func_indices = []int{}
    let mut global_var_names = []string{}

    for {
        parse_pos = lex_skip(source, parse_pos)
        let kind = lex_kind(source, parse_pos)
        if kind == TK_EOF() { break }

        if kind == TK_IMPORT() {
            let import_result = parse_import_decl(source, parse_pos, nodes)
            if import_result.node_idx >= 0 {
                import_count = import_count + 1
                parse_pos = import_result.new_pos
                parse_pos = lex_skip(source, parse_pos)
            } else {
                break
            }
        } else if kind == TK_STRUCT() {
            let struct_result = parse_struct_decl(source, parse_pos, nodes)
            struct_count = struct_count + 1
            parse_pos = struct_result.new_pos
        } else if kind == TK_LET() {
            let let_result = parse_let_stmt(source, parse_pos, nodes)
            if let_result.node_idx >= 0 {
                let let_node = nodes[let_result.node_idx]
                push(global_var_names, let_node.str_val)
                // Track scalar (integer) globals vs array globals
                if let_node.right >= 0 {
                    let init_node = nodes[let_node.right]
                    if init_node.tag == EXPR_INT() {
                        push(g_scalar_globals, let_node.str_val)
                    }
                    if init_node.tag == EXPR_UNARY() {
                        push(g_scalar_globals, let_node.str_val)
                    }
                }
            }
            parse_pos = let_result.new_pos
        } else if kind == TK_FN() {
            let parse_result = parse_func_decl(source, parse_pos, nodes)
            if parse_result.node_idx < 0 {
                print("ERROR: Failed to parse function at position " + strconv.Itoa(parse_pos) + "\n")
                break
            }
            let func_idx = parse_result.node_idx
            let func_node = nodes[func_idx]
            push(func_names, func_node.str_val)
            push(func_indices, func_idx)
            print("  " + func_node.str_val + " (" + strconv.Itoa(len(func_names)) + ")\n")
            parse_pos = parse_result.new_pos
            parse_pos = lex_skip(source, parse_pos)
        } else {
            break
        }
    }

    print("Parsed " + strconv.Itoa(len(func_names)) + " functions\n\n")

    // Process imports: scan for DECL_IMPORT nodes, read and parse imported modules
    // Uses rename table approach (no AST node mutation) for bootstrap parser compatibility
    let mut imp_i = 0
    let main_node_count = len(nodes)
    for imp_i < main_node_count {
        if nodes[imp_i].tag == DECL_IMPORT() {
            let import_path = nodes[imp_i].str_val
            // Skip stdlib imports (no "./" prefix) — handled by builtin dispatch
            if len(import_path) >= 2 && str_char_at(import_path, 0) == 46 && str_char_at(import_path, 1) == 47 {
                let mod_name = extract_module_name(import_path)
                let resolved = resolve_import_path(filename, import_path)
                print("Importing module: " + mod_name + " from " + resolved + "\n")

                let mod_source = os.ReadFile(resolved)
                push(g_import_paths, resolved)
                push(g_import_names, mod_name)

                // Parse all top-level declarations from the imported module
                let mut mod_pos = 0
                mod_pos = lex_skip(mod_source, mod_pos)
                let mut mod_func_names = []string{}
                let mut mod_func_indices = []int{}

                for {
                    mod_pos = lex_skip(mod_source, mod_pos)
                    let mod_kind = lex_kind(mod_source, mod_pos)
                    if mod_kind == TK_EOF() { break }

                    if mod_kind == TK_IMPORT() {
                        let mod_import_result = parse_import_decl(mod_source, mod_pos, nodes)
                        mod_pos = mod_import_result.new_pos
                        mod_pos = lex_skip(mod_source, mod_pos)
                    } else if mod_kind == TK_STRUCT() {
                        let mod_struct_result = parse_struct_decl(mod_source, mod_pos, nodes)
                        mod_pos = mod_struct_result.new_pos
                    } else if mod_kind == TK_LET() {
                        let mod_let_result = parse_let_stmt(mod_source, mod_pos, nodes)
                        if mod_let_result.node_idx >= 0 {
                            let mod_let_node = nodes[mod_let_result.node_idx]
                            push(global_var_names, mod_let_node.str_val)
                            if mod_let_node.right >= 0 {
                                let mod_init = nodes[mod_let_node.right]
                                if mod_init.tag == EXPR_INT() {
                                    push(g_scalar_globals, mod_let_node.str_val)
                                }
                                if mod_init.tag == EXPR_UNARY() {
                                    push(g_scalar_globals, mod_let_node.str_val)
                                }
                            }
                        }
                        mod_pos = mod_let_result.new_pos
                    } else if mod_kind == TK_FN() {
                        let mod_func_result = parse_func_decl(mod_source, mod_pos, nodes)
                        if mod_func_result.node_idx < 0 {
                            print("ERROR: Failed to parse function in " + resolved + " at position " + strconv.Itoa(mod_pos) + "\n")
                            break
                        }
                        let mod_func_idx = mod_func_result.node_idx
                        let orig_name = nodes[mod_func_idx].str_val
                        push(mod_func_names, orig_name)
                        push(mod_func_indices, mod_func_idx)
                        mod_pos = mod_func_result.new_pos
                        mod_pos = lex_skip(mod_source, mod_pos)
                    } else {
                        break
                    }
                }

                // Register imported functions with qualified names
                // Add to rename table so internal calls get resolved
                let mut mfi = 0
                for mfi < len(mod_func_names) {
                    let qualified = mod_name + "." + mod_func_names[mfi]
                    push(func_names, qualified)
                    push(func_indices, mod_func_indices[mfi])
                    push(g_rename_from, mod_func_names[mfi])
                    push(g_rename_to, qualified)
                    print("  " + qualified + " (" + strconv.Itoa(len(func_names)) + ")\n")
                    mfi = mfi + 1
                }
            }
        }
        imp_i = imp_i + 1
    }

    if len(g_import_names) > 0 {
        print("Imported " + strconv.Itoa(len(g_import_names)) + " module(s)\n\n")
    }

    // Build function return type registry
    // Pre-register built-in functions (no DECL_FUNC nodes for these)
    register_func_return_type("os.ReadFile", TYPE_STRING(), 0)
    register_func_return_type("os.Argv", TYPE_STRING(), 0)
    register_func_return_type("str_substring", TYPE_STRING(), 0)

    // Register all user-defined functions from parsed declarations
    // Use func_names[i] for the name (which has qualified names for imported functions)
    let mut reg_i = 0
    for reg_i < len(func_indices) {
        let fn_node = nodes[func_indices[reg_i]]
        register_func_return_type(func_names[reg_i], fn_node.type_tag, fn_node.int_val)
        reg_i = reg_i + 1
    }

    // Phase 3: IR Generation
    print("Phase 3: IR Generation\n")
    let mut instrs = []IRInstr{}

    let fn_count = len(func_names)
    let mut gen_all_i = 0
    for gen_all_i < fn_count {
        // Scope string tracking to current function
        g_string_vars_start = len(g_string_vars)
        g_string_array_vars_start = len(g_string_array_vars)

        let func_idx = func_indices[gen_all_i]
        let func_name = func_names[gen_all_i]
        let param_count = count_func_params(nodes, func_idx)

        let func_label = 5000 + gen_all_i
        let label_instr = IRInstr {
            op: OP_LABEL(),
            dest: func_label,
            arg1: param_count,
            arg2: 0,
            arg3: 0,
            str_val: func_name
        }
        push(instrs, label_instr)

        let mut symtab_names = []string{}
        let mut symtab_vregs = []int{}
        // Add global variables to symtab with sentinel vregs (<= -1000)
        let mut gvi = 0
        for gvi < len(global_var_names) {
            push(symtab_names, global_var_names[gvi])
            push(symtab_vregs, -1000 - gvi)
            gvi = gvi + 1
        }
        gen_ir_from_ast_with_symtab(func_idx, nodes, instrs, symtab_names, symtab_vregs)
        gen_all_i = gen_all_i + 1
    }

    print("Generated " + strconv.Itoa(len(instrs)) + " IR instructions\n\n")

    // Phase 4: LLVM IR Generation
    print("Phase 4: LLVM IR Generation\n")
    let output_ll = "./tmp/output.ll"
    let result = emit_llvm_ir(instrs, output_ll)
    if result != 0 {
        return 1
    }

    print("\n=== Compilation Complete ===\n")
    print("To build the executable:\n")
    print("  clang -O1 runtime/ease_runtime.c " + output_ll + " -o tmp/output\n")
    print("  ./tmp/output\n")

    return 0
}
