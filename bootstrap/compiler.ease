fn get_field_offset(name: string) -> int {
    let mut off = 0
    // AstNode fields
    if name == "tag" { off = 0 }
    if name == "int_val" { off = 8 }
    if name == "str_val" { off = 16 }
    if name == "left" { off = 24 }
    if name == "right" { off = 32 }
    if name == "extra" { off = 40 }
    if name == "type_tag" { off = 48 }
    // ParseResult fields (unique names)
    if name == "node_idx" { off = 0 }
    if name == "new_pos" { off = 8 }
    // IRInstr fields (unique names only - str_val collision handled in gen_ir_field)
    if name == "op" { off = 0 }
    if name == "dest" { off = 8 }
    if name == "arg1" { off = 16 }
    if name == "arg2" { off = 24 }
    if name == "arg3" { off = 32 }
    return off
}

fn gen_ir_eval_args(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> []int {
    let mut arg_vregs = []int{}
    let arg_indices = get_call_args(ast_idx)
    let mut i = 0
    for i < len(arg_indices) {
        let vreg = gen_ir_from_ast_with_symtab(arg_indices[i], nodes, instrs, st_names, st_vregs)
        push(arg_vregs, vreg)
        i = i + 1
    }
    return arg_vregs
}

fn gen_ir_index(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let arr = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_names, st_vregs)
    let idx = gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_names, st_vregs)
    let res = len(instrs)
    let instr = IRInstr { op: OP_LOAD(), dest: res, arg1: arr, arg2: idx, arg3: 0, str_val: "array_index" }
    push(instrs, instr)
    return res
}

fn gen_ir_field(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let base = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_names, st_vregs)
    let mut off = get_field_offset(node.str_val)
    // Handle str_val collision: AstNode.str_val is at offset 16, IRInstr.str_val is at offset 40
    // Detect IRInstr access by checking the base expression variable name
    if node.str_val == "str_val" {
        let left = nodes[node.left]
        if left.tag == EXPR_IDENT() && left.str_val == "instr" {
            off = 40
        }
        if left.tag == EXPR_INDEX() {
            let arr = nodes[left.left]
            if arr.tag == EXPR_IDENT() && arr.str_val == "instrs" {
                off = 40
            }
        }
    }
    let res = len(instrs)
    let instr = IRInstr { op: OP_LOAD(), dest: res, arg1: base, arg2: off, arg3: 0, str_val: node.str_val }
    push(instrs, instr)
    return res
}

fn gen_ir_array_lit(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let mut f = -1
    let mut cnt = 0
    let mut i = node.right
    for i < len(nodes) && cnt < node.int_val {
        if nodes[i].tag < STMT_LET() {
            let v = gen_ir_from_ast_with_symtab(i, nodes, instrs, st_n, st_v)
            if cnt == 0 { f = v }
            cnt = cnt + 1
        }
        i = i + 1
    }
    if f >= 0 { return f }
    // Empty array: allocate a 24-byte fat pointer (ptr, len, cap) initialized to zero
    let size_vreg = len(instrs)
    push(instrs, IRInstr { op: OP_LOADCONST(), dest: size_vreg, arg1: 24, arg2: 0, arg3: 0, str_val: "" })
    let r = len(instrs)
    push(instrs, IRInstr { op: OP_HEAP_ALLOC(), dest: r, arg1: size_vreg, arg2: 0, arg3: 0, str_val: "" })
    return r
}

fn get_struct_field_names(name: string) -> []string {
    let f = []string{}
    if name == "AstNode" { push(f, "tag") push(f, "int_val") push(f, "str_val") push(f, "left") push(f, "right") push(f, "extra") push(f, "type_tag") }
    if name == "IRInstr" { push(f, "op") push(f, "dest") push(f, "arg1") push(f, "arg2") push(f, "arg3") push(f, "str_val") }
    if name == "ParseResult" { push(f, "node_idx") push(f, "new_pos") }
    return f
}

fn gen_ir_store_struct_fields(ptr: int, sname: string, idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let vals = get_struct_fields(idx)
    let fnames = get_struct_field_names(sname)
    let mut i = 0
    for i < len(vals) && i < len(fnames) {
        let v = gen_ir_from_ast_with_symtab(vals[i], nodes, instrs, st_names, st_vregs)
        let off = field_offset(sname, fnames[i])
        let addr = len(instrs)
        push(instrs, IRInstr { op: OP_INDEXADDR(), dest: addr, arg1: ptr, arg2: off, arg3: 0, str_val: fnames[i] })
        push(instrs, IRInstr { op: OP_STORE(), dest: -1, arg1: addr, arg2: v, arg3: 0, str_val: "" })
        i = i + 1
    }
    return 0 }

fn gen_ir_struct_lit(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let size = struct_size(node.str_val)
    let ptr = len(instrs)
    let alloc = IRInstr { op: OP_ALLOCA(), dest: ptr, arg1: size, arg2: 0, arg3: 0, str_val: node.str_val }
    push(instrs, alloc)
    gen_ir_store_struct_fields(ptr, node.str_val, ast_idx, nodes, instrs, st_names, st_vregs)
    return ptr
}

fn gen_ir_call_user(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, st_names: []string, st_vregs: []int) -> int {
    let args = gen_ir_eval_args(ast_idx, nodes, instrs, st_names, st_vregs)
    let mut i = 0
    for i < len(args) {
        push(instrs, IRInstr { op: OP_ARG(), dest: i, arg1: args[i], arg2: -1, arg3: 0, str_val: "" })
        i = i + 1
    }
    let res = len(instrs)
    push(instrs, IRInstr { op: OP_CALL(), dest: res, arg1: 0, arg2: node.int_val, arg3: 0, str_val: node.str_val })
    return res
}

// Helper: Generate IR for binary operations
fn gen_ir_binary_op(token_op: int) -> int {
    let mut op = OP_ADD()
    if token_op == TK_PLUS() { op = OP_ADD() }
    if token_op == TK_MINUS() { op = OP_SUB() }
    if token_op == TK_STAR() { op = OP_MUL() }
    if token_op == TK_SLASH() { op = OP_DIV() }
    if token_op == TK_LT() { op = OP_CMP_LT() }
    if token_op == TK_GT() { op = OP_CMP_GT() }
    if token_op == TK_LE() { op = OP_CMP_LE() }
    if token_op == TK_GE() { op = OP_CMP_GE() }
    if token_op == TK_EQ() { op = OP_CMP_EQ() }
    if token_op == TK_NE() { op = OP_CMP_NE() }
    if token_op == TK_AND() { op = OP_AND() }
    if token_op == TK_OR() { op = OP_OR() }
    if token_op == TK_CARET() { op = OP_XOR() }
    if token_op == TK_AMPERSAND() { op = OP_BITAND() }
    if token_op == TK_PIPE() { op = OP_BITOR() }
    return op
}

fn gen_ir_binary(node: AstNode, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    let left_vreg = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, symtab_names, symtab_vregs)
    let right_vreg = gen_ir_from_ast_with_symtab(node.right, nodes, instrs, symtab_names, symtab_vregs)
    let mut op = gen_ir_binary_op(node.int_val)
    // Detect string concatenation: if + and either operand is string-typed
    if node.int_val == TK_PLUS() {
        if is_string_expr(node.left, nodes) == 1 || is_string_expr(node.right, nodes) == 1 {
            op = OP_STR_CONCAT()
        }
    }
    // Detect string equality: if == and either operand is string-typed
    if node.int_val == TK_EQ() {
        if is_string_expr(node.left, nodes) == 1 || is_string_expr(node.right, nodes) == 1 {
            op = OP_STR_EQ()
        }
    }
    // Detect string inequality: if != and either operand is string-typed
    if node.int_val == TK_NE() {
        if is_string_expr(node.left, nodes) == 1 || is_string_expr(node.right, nodes) == 1 {
            op = OP_STR_NE()
        }
    }
    let dest_vreg = len(instrs)
    let instr = IRInstr { op: op, dest: dest_vreg, arg1: left_vreg, arg2: right_vreg, arg3: 0, str_val: "" }
    push(instrs, instr)
    return dest_vreg
}

// Helper: Generate IR for simple expression nodes
fn gen_ir_expr(node: AstNode, ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    if node.tag == EXPR_INT() {
        let vreg = len(instrs)
        let instr = IRInstr { op: OP_LOADCONST(), dest: vreg, arg1: node.int_val, arg2: 0, arg3: 0, str_val: "" }
        push(instrs, instr)
        return vreg
    }

    if node.tag == EXPR_BOOL() {
        let vreg = len(instrs)
        let instr = IRInstr { op: OP_LOADCONST(), dest: vreg, arg1: node.int_val, arg2: 0, arg3: 0, str_val: "" }
        push(instrs, instr)
        return vreg
    }

    if node.tag == EXPR_IDENT() {
        // Search backwards to find the most recent binding (handles variable shadowing)
        let mut found_vreg = -1
        let symtab_len = len(symtab_names)
        let mut idx1 = symtab_len - 1
        for idx1 >= 0 {
            if symtab_names[idx1] == node.str_val {
                found_vreg = symtab_vregs[idx1]
                break
            }
            idx1 = idx1 - 1
        }
        if found_vreg <= -1000 {
            // Global variable sentinel - emit OP_LOAD_GLOBAL
            let vreg = len(instrs)
            push(instrs, IRInstr { op: OP_LOAD_GLOBAL(), dest: vreg, arg1: 0, arg2: 0, arg3: 0, str_val: node.str_val })
            if is_scalar_global(node.str_val) == 1 {
                // For scalar globals, dereference the address to get the value
                let val_vreg = len(instrs)
                push(instrs, IRInstr { op: OP_LOAD(), dest: val_vreg, arg1: vreg, arg2: 0, arg3: 0, str_val: "" })
                return val_vreg
            }
            return vreg
        }
        if found_vreg < 0 {
            return -1
        }
        return found_vreg
    }

    if node.tag == EXPR_STRING() {
        // String literal - will be loaded from string table
        let vreg = len(instrs)
        // Store string index in arg1, use str_val to store the actual string for later embedding
        let instr = IRInstr { op: OP_LOADCONST(), dest: vreg, arg1: 0, arg2: 0, arg3: 0, str_val: node.str_val }
        push(instrs, instr)
        return vreg
    }

    return 0
}

fn gen_ir_stmt_ret(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let mut v = -1
    if node.left >= 0 {
        v = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_n, st_v)
    }
    push(instrs, IRInstr { op: OP_RET(), dest: v, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    return v
}

fn gen_ir_stmt_let(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // Track string variables for is_string_expr heuristic
    if node.right >= 0 {
        if is_string_expr(node.right, nodes) == 1 {
            push(g_string_vars, node.str_val)
        }
        if is_string_array_expr(node.right, nodes) == 1 {
            push(g_string_array_vars, node.str_val)
        }
    }
    let v = gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v)
    if v < 0 { return -1 }
    // Always create a new vreg via COPY to prevent aliasing when init is a variable reference.
    // Without this, "let mut end = pos" would map end to pos's vreg, and modifying end would corrupt pos.
    let new_vreg = len(instrs)
    push(instrs, IRInstr { op: OP_COPY(), dest: new_vreg, arg1: v, arg2: 0, arg3: 0, str_val: "" })
    push(st_n, node.str_val)
    push(st_v, new_vreg)
    return new_vreg
}

fn gen_ir_stmt_assign(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let val_vreg = gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v)
    if val_vreg < 0 { return -1 }

    // Look up the target variable in the symbol table
    let target_name = node.str_val
    let mut var_vreg = -1
    let mut si = 0
    let st_len = len(st_n)
    for si < st_len {
        if st_n[si] == target_name {
            var_vreg = st_v[si]
        }
        si = si + 1
    }

    if var_vreg <= -1000 {
        // Global variable - emit store through address
        if is_scalar_global(target_name) == 1 {
            let addr_vreg = len(instrs)
            push(instrs, IRInstr { op: OP_LOAD_GLOBAL(), dest: addr_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: target_name })
            push(instrs, IRInstr { op: OP_STORE(), dest: -1, arg1: addr_vreg, arg2: val_vreg, arg3: 0, str_val: "" })
        }
    } else if var_vreg >= 0 && var_vreg != val_vreg {
        // Emit copy from result vreg to variable vreg
        push(instrs, IRInstr { op: OP_COPY(), dest: var_vreg, arg1: val_vreg, arg2: 0, arg3: 0, str_val: "" })
    }
    return val_vreg
}

fn gen_ir_stmt_if(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let c = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, st_n, st_v)
    if c < 0 { return -1 }
    let el = g_next_label
    g_next_label = g_next_label + 1
    let en = g_next_label
    g_next_label = g_next_label + 1
    push(instrs, IRInstr { op: OP_BRANCH(), dest: c, arg1: el, arg2: 0, arg3: 0, str_val: "" })
    if node.right >= 0 { gen_ir_from_ast_with_symtab(node.right, nodes, instrs, st_n, st_v) }
    push(instrs, IRInstr { op: OP_JUMP(), dest: en, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    push(instrs, IRInstr { op: OP_LABEL(), dest: el, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    if node.extra >= 0 { gen_ir_from_ast_with_symtab(node.extra, nodes, instrs, st_n, st_v) }
    push(instrs, IRInstr { op: OP_LABEL(), dest: en, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    return 0
}

fn gen_ir_stmt_for(n: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    let s = g_next_label
    g_next_label = g_next_label + 1
    let e = g_next_label
    g_next_label = g_next_label + 1
    push(instrs, IRInstr { op: OP_LABEL(), dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    if n.left >= 0 {
        let c = gen_ir_from_ast_with_symtab(n.left, nodes, instrs, st_n, st_v)
        if c < 0 { return -1 }
        push(instrs, IRInstr { op: OP_BRANCH(), dest: c, arg1: e, arg2: 0, arg3: 0, str_val: "" })
    }
    // Save/restore break label for proper nesting
    let saved_break = g_break_label
    g_break_label = e
    if n.right >= 0 { gen_ir_from_ast_with_symtab(n.right, nodes, instrs, st_n, st_v) }
    g_break_label = saved_break
    push(instrs, IRInstr { op: OP_JUMP(), dest: s, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
    push(instrs, IRInstr { op: OP_LABEL(), dest: e, arg1: 0, arg2: 0, arg3: 0, str_val: "" }) return 0
}

fn gen_ir_stmt_block(node: AstNode, nodes: []AstNode, instrs: []IRInstr, st_n: []string, st_v: []int) -> int {
    // First pass: collect child node indices from IF/FOR statements
    // These nodes and their descendants shouldn't be processed as top-level statements
    let mut child_indices = []int{}
    let mut scan_i = node.left
    let mut e = node.right + 1
    let nodes_len = len(nodes)
    if scan_i < 0 { return -1 }
    if e > nodes_len { e = nodes_len }
    for scan_i < e {
        if scan_i >= nodes_len { break }
        let scan_tag = nodes[scan_i].tag
        if scan_tag == STMT_IF() || scan_tag == STMT_FOR() {
            let scan_node = nodes[scan_i]
            // Mark direct children
            if scan_node.left >= 0 { push(child_indices, scan_node.left) }
            if scan_node.right >= 0 {
                push(child_indices, scan_node.right)
                // If child is a block, also mark all nodes in that block's range
                if scan_node.right < len(nodes) {
                    let child_node = nodes[scan_node.right]
                    if child_node.tag == STMT_BLOCK() {
                        let mut block_i = child_node.left
                        let block_e = child_node.right + 1
                        for block_i < block_e {
                            push(child_indices, block_i)
                            block_i = block_i + 1
                        }
                    }
                }
            }
            if scan_node.extra >= 0 {
                push(child_indices, scan_node.extra)
                // If child is a block, also mark all nodes in that block's range
                if scan_node.extra < len(nodes) {
                    let child_node = nodes[scan_node.extra]
                    if child_node.tag == STMT_BLOCK() {
                        let mut block_i = child_node.left
                        let block_e = child_node.right + 1
                        for block_i < block_e {
                            push(child_indices, block_i)
                            block_i = block_i + 1
                        }
                    }
                }
            }
        }
        scan_i = scan_i + 1
    }

    // Second pass: process statements, skipping child nodes
    let mut last = -1
    let mut i = node.left
    for i < e {
        if i >= nodes_len { break }
        let node_tag = nodes[i].tag
        if node_tag >= STMT_LET() && node_tag != STMT_BLOCK() {
            // Check if this node is a child of another statement
            let mut is_child = 0
            let mut check_j = 0
            let child_count = len(child_indices)
            for check_j < child_count {
                if child_indices[check_j] == i {
                    is_child = 1
                    break
                }
                check_j = check_j + 1
            }
            if is_child == 0 {
                last = gen_ir_from_ast_with_symtab(i, nodes, instrs, st_n, st_v)
            }
        }
        i = i + 1
    }
    return last
}

fn gen_ir_from_ast_with_symtab(ast_idx: int, nodes: []AstNode, instrs: []IRInstr, symtab_names: []string, symtab_vregs: []int) -> int {
    if ast_idx < 0 {
        return -1
    }

    let node = nodes[ast_idx]

    // Dispatch simple expressions to helper
    if node.tag == EXPR_INT() || node.tag == EXPR_BOOL() || node.tag == EXPR_IDENT() || node.tag == EXPR_STRING() {
        return gen_ir_expr(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_UNARY() {
        let operand = gen_ir_from_ast_with_symtab(node.left, nodes, instrs, symtab_names, symtab_vregs)
        if node.int_val == TK_MINUS() {
            // Unary minus: 0 - operand
            let zero_vreg = len(instrs)
            push(instrs, IRInstr { op: OP_LOADCONST(), dest: zero_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            let result_vreg = len(instrs)
            push(instrs, IRInstr { op: OP_SUB(), dest: result_vreg, arg1: zero_vreg, arg2: operand, arg3: 0, str_val: "" })
            return result_vreg
        }
        if node.int_val == TK_NOT() {
            // Logical NOT: operand == 0
            let zero_vreg = len(instrs)
            push(instrs, IRInstr { op: OP_LOADCONST(), dest: zero_vreg, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
            let result_vreg = len(instrs)
            push(instrs, IRInstr { op: OP_CMP_EQ(), dest: result_vreg, arg1: operand, arg2: zero_vreg, arg3: 0, str_val: "" })
            return result_vreg
        }
        return operand
    }

    if node.tag == EXPR_BINARY() {
        return gen_ir_binary(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_CALL() {
        let func_name = node.str_val
        if func_name == "len" {
            return gen_ir_call_len(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "push" {
            return gen_ir_call_push(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "poke" {
            return gen_ir_call_poke(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "peek" {
            return gen_ir_call_peek(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "heap_alloc" {
            return gen_ir_call_heap_alloc(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "ReadFile" || func_name == "os.ReadFile" {
            return gen_ir_call_readfile(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "Argc" || func_name == "os.Argc" {
            return gen_ir_call_argc(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "Argv" || func_name == "os.Argv" {
            return gen_ir_call_argv(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "Itoa" || func_name == "strconv.Itoa" {
            return gen_ir_call_itoa(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "print" {
            return gen_ir_call_print(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "str_char_at" {
            return gen_ir_call_str_char_at(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "str_substring" {
            return gen_ir_call_str_substring(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "open" || func_name == "syscall.open" {
            return gen_ir_call_syscall_open(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "write" || func_name == "syscall.write" {
            return gen_ir_call_syscall_write(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        if func_name == "close" || func_name == "syscall.close" {
            return gen_ir_call_syscall_close(ast_idx, nodes, instrs, symtab_names, symtab_vregs)
        }
        return gen_ir_call_user(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_ARRAY_LIT() {
        return gen_ir_array_lit(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_INDEX() {
        return gen_ir_index(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_FIELD() {
        return gen_ir_field(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == EXPR_STRUCT_LIT() {
        return gen_ir_struct_lit(node, ast_idx, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_RETURN() {
        return gen_ir_stmt_ret(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_LET() {
        return gen_ir_stmt_let(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_ASSIGN() {
        return gen_ir_stmt_assign(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_EXPR() {
        // Expression statement (e.g., function call without using result)
        // node.left = expression
        // Just evaluate the expression and return its vreg
        return gen_ir_from_ast_with_symtab(node.left, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_IF() {
        return gen_ir_stmt_if(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_FOR() {
        return gen_ir_stmt_for(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_BLOCK() {
        return gen_ir_stmt_block(node, nodes, instrs, symtab_names, symtab_vregs)
    }

    if node.tag == STMT_BREAK() {
        // Use global break label (set by gen_ir_stmt_for with save/restore)
        if g_break_label >= 0 {
            push(instrs, IRInstr { op: OP_JUMP(), dest: g_break_label, arg1: 0, arg2: 0, arg3: 0, str_val: "" })
        }
        return 0
    }

    if node.tag == DECL_FUNC() {
        // Generate function with parameters
        // node.left = first parameter index (or -1 if no parameters)
        // node.right = body node

        // Add all parameters to symbol table.
        // Use 90000+ offset for parameter vregs to avoid collision with instruction-based vregs.
        // Parameters are stored consecutively in nodes array starting at node.left
        if node.left >= 0 {
            // Iterate through consecutive parameter nodes
            let mut param_idx = node.left
            let mut param_reg = 90000  // 90000, 90001, 90002, etc.

            // Find how many consecutive DECL_PARAM nodes there are
            let mut param_i = node.left
            let nodes_len2 = len(nodes)
            for param_i < nodes_len2 {
                let param_node = nodes[param_i]
                if param_node.tag == DECL_PARAM() {
                    // Add parameter to symbol table
                    push(symtab_names, param_node.str_val)
                    push(symtab_vregs, param_reg)
                    // Track string-typed parameters for is_string_expr
                    if param_node.type_tag == TYPE_STRING() && param_node.int_val == 0 {
                        push(g_string_vars, param_node.str_val)
                    }
                    if param_node.type_tag == TYPE_STRING() && param_node.int_val == 1 {
                        push(g_string_array_vars, param_node.str_val)
                    }
                    param_reg = param_reg + 1
                } else {
                    // Stop when we hit a non-parameter node
                    break
                }
                param_i = param_i + 1
            }
        }

        // Generate body
        if node.right >= 0 {
            return gen_ir_from_ast_with_symtab(node.right, nodes, instrs, symtab_names, symtab_vregs)
        }
    }

    return 0
}

// ============================================================================
// LLVM IR Code Generation
// ============================================================================
//
// Strategy: translate bootstrap IR to LLVM IR text, delegate all builtins
// to the C runtime (ease_runtime.c). clang compiles the .ll to native binary.
//
// Design: all values are i64. Pointers are integers (ptrtoint/inttoptr).
// Each virtual register gets an alloca i64 slot; clang -O1 mem2reg pass
// promotes these to SSA registers automatically.
//

fn write_str(fd: int, s: string) {
    syscall.write(fd, s, len(s))
}

fn hex_digit_char(v: int) -> string {
    if v == 0 { return "0" }
    if v == 1 { return "1" }
    if v == 2 { return "2" }
    if v == 3 { return "3" }
    if v == 4 { return "4" }
    if v == 5 { return "5" }
    if v == 6 { return "6" }
    if v == 7 { return "7" }
    if v == 8 { return "8" }
    if v == 9 { return "9" }
    if v == 10 { return "A" }
    if v == 11 { return "B" }
    if v == 12 { return "C" }
    if v == 13 { return "D" }
    if v == 14 { return "E" }
    if v == 15 { return "F" }
    return "0"
}

fn hex_byte_str(v: int) -> string {
    let hi = v / 16
    let lo = v - hi * 16
    return hex_digit_char(hi) + hex_digit_char(lo)
}

fn llvm_escape_string(s: string) -> string {
    let mut result = "c\""
    let mut i = 0
    let slen = len(s)
    for i < slen {
        let ch = str_char_at(s, i)
        if ch >= 32 && ch < 127 && ch != 34 && ch != 92 {
            result = result + str_substring(s, i, i + 1)
        } else {
            let hbs = hex_byte_str(ch)
            result = result + "\\" + hbs
        }
        i = i + 1
    }
    result = result + "\\00\""
    return result
}

fn llvm_mangle(name: string) -> string {
    let mut result = ""
    let mut i = 0
    let slen = len(name)
    for i < slen {
        let ch = str_char_at(name, i)
        if ch == 46 {
            result = result + "_"
        } else {
            result = result + str_substring(name, i, i + 1)
        }
        i = i + 1
    }
    return result
}

fn llvm_func_name(name: string) -> string {
    if name == "main" {
        return "ease_main"
    }
    return llvm_mangle(name)
}

fn add_unique(arr: []int, val: int) {
    let mut i = 0
    for i < len(arr) {
        if arr[i] == val { return }
        i = i + 1
    }
    push(arr, val)
}

fn tmp_name(ti: int, sub: int) -> string {
    return "%t." + strconv.Itoa(ti * 10 + sub)
}

fn emit_load_vreg(fd: int, vreg: int, ti: int, sub: int) -> string {
    let name = tmp_name(ti, sub)
    write_str(fd, "  " + name + " = load i64, ptr %v." + strconv.Itoa(vreg) + "\n")
    return name
}

fn emit_load_ptr(fd: int, vreg: int, ti: int, s1: int, s2: int) -> string {
    let val = emit_load_vreg(fd, vreg, ti, s1)
    let name = tmp_name(ti, s2)
    write_str(fd, "  " + name + " = inttoptr i64 " + val + " to ptr\n")
    return name
}

fn emit_store_vreg(fd: int, vreg: int, val: string) {
    write_str(fd, "  store i64 " + val + ", ptr %v." + strconv.Itoa(vreg) + "\n")
}

fn emit_ptrtoint_store(fd: int, vreg: int, ptr_val: string, ti: int, sub: int) {
    let name = tmp_name(ti, sub)
    write_str(fd, "  " + name + " = ptrtoint ptr " + ptr_val + " to i64\n")
    emit_store_vreg(fd, vreg, name)
}

fn emit_llvm_binop(fd: int, instr: IRInstr, op: string, ti: int) {
    let lhs = emit_load_vreg(fd, instr.arg1, ti, 0)
    let rhs = emit_load_vreg(fd, instr.arg2, ti, 1)
    let result = tmp_name(ti, 2)
    write_str(fd, "  " + result + " = " + op + " i64 " + lhs + ", " + rhs + "\n")
    emit_store_vreg(fd, instr.dest, result)
}

fn emit_llvm_cmp(fd: int, instr: IRInstr, pred: string, ti: int) {
    let lhs = emit_load_vreg(fd, instr.arg1, ti, 0)
    let rhs = emit_load_vreg(fd, instr.arg2, ti, 1)
    let cmp = tmp_name(ti, 2)
    write_str(fd, "  " + cmp + " = icmp " + pred + " i64 " + lhs + ", " + rhs + "\n")
    let ext = tmp_name(ti, 3)
    write_str(fd, "  " + ext + " = zext i1 " + cmp + " to i64\n")
    emit_store_vreg(fd, instr.dest, ext)
}

fn emit_llvm_decls(fd: int) {
    write_str(fd, "declare ptr @malloc(i64)\n")
    write_str(fd, "declare ptr @calloc(i64, i64)\n")
    write_str(fd, "declare ptr @memcpy(ptr, ptr, i64)\n")
    write_str(fd, "declare ptr @memset(ptr, i32, i64)\n")
    write_str(fd, "declare i64 @ease_str_eq(ptr, ptr)\n")
    write_str(fd, "declare i64 @ease_str_ne(ptr, ptr)\n")
    write_str(fd, "declare i64 @ease_str_len(ptr)\n")
    write_str(fd, "declare ptr @ease_str_concat(ptr, ptr)\n")
    write_str(fd, "declare ptr @ease_str_slice(ptr, i64, i64)\n")
    write_str(fd, "declare i64 @ease_str_char_at(ptr, i64)\n")
    write_str(fd, "declare ptr @ease_str_substring(ptr, i64, i64)\n")
    write_str(fd, "declare void @ease_array_push(ptr, ptr, i64)\n")
    write_str(fd, "declare void @ease_print(ptr)\n")
    write_str(fd, "declare ptr @ease_read_file(ptr)\n")
    write_str(fd, "declare i64 @ease_write_file(ptr, ptr)\n")
    write_str(fd, "declare ptr @ease_int_to_str(i64)\n")
    write_str(fd, "declare i64 @ease_str_to_int(ptr)\n")
    write_str(fd, "declare void @ease_poke(ptr, i64)\n")
    write_str(fd, "declare i64 @ease_peek(ptr)\n")
    write_str(fd, "declare void @ease_memset(ptr, i64, i64)\n")
    write_str(fd, "declare i64 @ease_syscall_open(ptr, i64, i64)\n")
    write_str(fd, "declare i64 @ease_syscall_read(i64, ptr, i64)\n")
    write_str(fd, "declare i64 @ease_syscall_write(i64, ptr, i64)\n")
    write_str(fd, "declare i64 @ease_syscall_close(i64)\n")
    write_str(fd, "declare i64 @ease_argc()\n")
    write_str(fd, "declare ptr @ease_argv(i64)\n")
    write_str(fd, "\n")
}

fn collect_vregs(instrs: []IRInstr, start: int, end_pos: int, param_count: int) -> []int {
    let mut vregs = []int{}
    let mut p = 0
    for p < param_count {
        add_unique(vregs, 90000 + p)
        p = p + 1
    }
    let mut i = start
    for i < end_pos {
        let instr = instrs[i]
        let op = instr.op
        // dest is vreg for result-producing operations
        if op == OP_LOADCONST() || op == OP_ADD() || op == OP_SUB() || op == OP_MUL() || op == OP_DIV() || op == OP_CMP_LT() || op == OP_CMP_GT() || op == OP_CMP_LE() || op == OP_CMP_GE() || op == OP_CMP_EQ() || op == OP_CMP_NE() || op == OP_AND() || op == OP_OR() || op == OP_NOT() || op == OP_XOR() || op == OP_BITAND() || op == OP_BITOR() || op == OP_ALLOCA() || op == OP_LOAD() || op == OP_INDEXADDR() || op == OP_ARRAY_LEN() || op == OP_STR_LEN() || op == OP_STR_CHAR_AT() || op == OP_STR_SUBSTRING() || op == OP_PEEK() || op == OP_HEAP_ALLOC() || op == OP_CALL() || op == OP_READFILE() || op == OP_ARGC() || op == OP_ARGV() || op == OP_INT_TO_STR() || op == OP_STR_EQ() || op == OP_STR_NE() || op == OP_STR_CONCAT() || op == OP_LOAD_GLOBAL() || op == OP_SYSCALL_OPEN() || op == OP_SYSCALL_WRITE() || op == OP_SYSCALL_CLOSE() {
            if instr.dest >= 0 { add_unique(vregs, instr.dest) }
        }
        // RET dest is vreg
        if op == OP_RET() && instr.dest >= 0 { add_unique(vregs, instr.dest) }
        // BRANCH dest is vreg (condition)
        if op == OP_BRANCH() && instr.dest >= 0 { add_unique(vregs, instr.dest) }
        // COPY: dest=target, arg1=source
        if op == OP_COPY() {
            if instr.dest >= 0 { add_unique(vregs, instr.dest) }
            if instr.arg1 >= 0 { add_unique(vregs, instr.arg1) }
        }
        // arg1 is vreg for most ops (not LOADCONST, ALLOCA, LABEL, JUMP, BRANCH, ARGC, CALL)
        if op != OP_LOADCONST() && op != OP_LOAD_GLOBAL() && op != OP_ALLOCA() && op != OP_LABEL() && op != OP_JUMP() && op != OP_BRANCH() && op != OP_ARGC() && op != OP_CALL() {
            if instr.arg1 >= 0 { add_unique(vregs, instr.arg1) }
        }
        // arg2 is vreg for binary ops, STORE, ARRAY_PUSH, POKE, STR_EQ/NE, STR_CHAR_AT, etc
        if op == OP_ADD() || op == OP_SUB() || op == OP_MUL() || op == OP_DIV() || op == OP_CMP_LT() || op == OP_CMP_GT() || op == OP_CMP_LE() || op == OP_CMP_GE() || op == OP_CMP_EQ() || op == OP_CMP_NE() || op == OP_AND() || op == OP_OR() || op == OP_XOR() || op == OP_BITAND() || op == OP_BITOR() || op == OP_STORE() || op == OP_ARRAY_PUSH() || op == OP_POKE() || op == OP_STR_EQ() || op == OP_STR_NE() || op == OP_STR_CONCAT() || op == OP_STR_CHAR_AT() || op == OP_MEMCOPY() || op == OP_SYSCALL_OPEN() || op == OP_SYSCALL_WRITE() || op == OP_SYSCALL_CLOSE() {
            if instr.arg2 >= 0 { add_unique(vregs, instr.arg2) }
        }
        // STR_SUBSTRING arg2 and arg3 are vregs
        if op == OP_STR_SUBSTRING() {
            if instr.arg2 >= 0 { add_unique(vregs, instr.arg2) }
            if instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        }
        // MEMCOPY arg3 is vreg (size)
        if op == OP_MEMCOPY() && instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        // SYSCALL_OPEN arg3 is vreg (mode)
        if op == OP_SYSCALL_OPEN() && instr.arg3 >= 0 { add_unique(vregs, instr.arg3) }
        i = i + 1
    }
    return vregs
}

fn emit_llvm_ir(instrs: []IRInstr, output_path: string) -> int {
    let fd = syscall.open(output_path, 1537, 420)
    if fd < 0 {
        print("ERROR: Failed to open output file: " + output_path + "\n")
        return 1
    }

    // Pass 1: Collect string constants
    let mut string_table = []string{}
    let mut string_dests = []int{}
    let mut si = 0
    for si < len(instrs) {
        if instrs[si].op == OP_LOADCONST() {
            if instrs[si].str_val != "" {
                push(string_table, instrs[si].str_val)
                push(string_dests, instrs[si].dest)
            }
        }
        si = si + 1
    }

    // Emit string constants
    let mut sci = 0
    for sci < len(string_table) {
        let s = string_table[sci]
        let escaped = llvm_escape_string(s)
        write_str(fd, "@.str." + strconv.Itoa(sci) + " = private unnamed_addr constant [" + strconv.Itoa(len(s) + 1) + " x i8] " + escaped + "\n")
        sci = sci + 1
    }
    if len(string_table) > 0 {
        write_str(fd, "\n")
    }

    // Pass 1b: Collect global variables from OP_LOAD_GLOBAL instructions
    let mut global_names = []string{}
    let mut gi = 0
    for gi < len(instrs) {
        if instrs[gi].op == OP_LOAD_GLOBAL() {
            let gname = instrs[gi].str_val
            // Check if already collected
            let mut found = 0
            let mut gj = 0
            for gj < len(global_names) {
                if global_names[gj] == gname {
                    found = 1
                    break
                }
                gj = gj + 1
            }
            if found == 0 {
                push(global_names, gname)
            }
        }
        gi = gi + 1
    }

    // Emit global variable declarations
    let mut gdi = 0
    for gdi < len(global_names) {
        if is_scalar_global(global_names[gdi]) == 1 {
            write_str(fd, "@" + global_names[gdi] + " = global i64 0\n")
        } else {
            write_str(fd, "@" + global_names[gdi] + " = global [24 x i8] zeroinitializer\n")
        }
        gdi = gdi + 1
    }
    if len(global_names) > 0 {
        write_str(fd, "\n")
    }

    // Emit runtime declarations
    emit_llvm_decls(fd)

    // Pass 2: Emit functions
    let mut fi = 0
    let instrs_len = len(instrs)
    for fi < instrs_len {
        if instrs[fi].op == OP_LABEL() && instrs[fi].str_val != "" {
            let func_name = instrs[fi].str_val
            let param_count = instrs[fi].arg1
            let func_start = fi + 1

            // Find function end
            let mut func_end = instrs_len
            let mut fj = fi + 1
            for fj < instrs_len {
                if instrs[fj].op == OP_LABEL() && instrs[fj].str_val != "" {
                    func_end = fj
                    break
                }
                fj = fj + 1
            }

            // Emit function
            emit_llvm_function(fd, instrs, func_start, func_end, func_name, param_count, string_table, string_dests)

            fi = func_end
        } else {
            fi = fi + 1
        }
    }

    syscall.close(fd)
    print("Generated LLVM IR: " + output_path + "\n")
    return 0
}

fn find_string_index(dest: int, string_dests: []int) -> int {
    let mut i = 0
    for i < len(string_dests) {
        if string_dests[i] == dest {
            return i
        }
        i = i + 1
    }
    return -1
}

fn emit_llvm_function(fd: int, instrs: []IRInstr, start: int, end_pos: int, func_name: string, param_count: int, string_table: []string, string_dests: []int) {
    let lname = llvm_func_name(func_name)

    // Build parameter list
    let mut params = ""
    let mut pi = 0
    for pi < param_count {
        if pi > 0 { params = params + ", " }
        params = params + "i64 %param." + strconv.Itoa(pi)
        pi = pi + 1
    }

    write_str(fd, "define i64 @" + lname + "(" + params + ") {\n")

    // Collect all vregs used
    let vregs = collect_vregs(instrs, start, end_pos, param_count)

    // Emit allocas for all vregs
    let mut vi = 0
    for vi < len(vregs) {
        write_str(fd, "  %v." + strconv.Itoa(vregs[vi]) + " = alloca i64\n")
        vi = vi + 1
    }

    // Store parameters into vreg slots (params use 90000+ offset vregs)
    pi = 0
    for pi < param_count {
        write_str(fd, "  store i64 %param." + strconv.Itoa(pi) + ", ptr %v." + strconv.Itoa(90000 + pi) + "\n")
        pi = pi + 1
    }

    // Branch to body
    write_str(fd, "  br label %B.body\n")
    write_str(fd, "B.body:\n")

    // Emit instructions
    let mut terminated = 0
    let mut call_args = []int{}
    let mut ii = start
    for ii < end_pos {
        let instr = instrs[ii]
        let ti = ii

        if instr.op == OP_LABEL() && instr.str_val == "" {
            // Basic block label
            if terminated == 0 {
                write_str(fd, "  br label %L." + strconv.Itoa(instr.dest) + "\n")
            }
            write_str(fd, "L." + strconv.Itoa(instr.dest) + ":\n")
            terminated = 0
        }

        if terminated == 0 && instr.op == OP_LOADCONST() {
            if instr.str_val != "" {
                // String constant
                let str_idx = find_string_index(instr.dest, string_dests)
                if str_idx >= 0 {
                    let t = tmp_name(ti, 0)
                    write_str(fd, "  " + t + " = ptrtoint ptr @.str." + strconv.Itoa(str_idx) + " to i64\n")
                    emit_store_vreg(fd, instr.dest, t)
                }
            } else {
                // Integer constant
                emit_store_vreg(fd, instr.dest, strconv.Itoa(instr.arg1))
            }
        }

        if terminated == 0 && instr.op == OP_LOAD_GLOBAL() {
            // Load address of a global variable: ptrtoint ptr @name to i64
            let t = tmp_name(ti, 0)
            write_str(fd, "  " + t + " = ptrtoint ptr @" + instr.str_val + " to i64\n")
            emit_store_vreg(fd, instr.dest, t)
        }

        if terminated == 0 && instr.op == OP_ADD() {
            if instr.arg2 == -1 {
                // Copy (MOV variant)
                let v = emit_load_vreg(fd, instr.arg1, ti, 0)
                emit_store_vreg(fd, instr.dest, v)
            } else {
                emit_llvm_binop(fd, instr, "add", ti)
            }
        }
        if terminated == 0 && instr.op == OP_SUB() { emit_llvm_binop(fd, instr, "sub", ti) }
        if terminated == 0 && instr.op == OP_MUL() { emit_llvm_binop(fd, instr, "mul", ti) }
        if terminated == 0 && instr.op == OP_DIV() { emit_llvm_binop(fd, instr, "sdiv", ti) }
        if terminated == 0 && instr.op == OP_AND() { emit_llvm_binop(fd, instr, "and", ti) }
        if terminated == 0 && instr.op == OP_OR() { emit_llvm_binop(fd, instr, "or", ti) }
        if terminated == 0 && instr.op == OP_XOR() { emit_llvm_binop(fd, instr, "xor", ti) }
        if terminated == 0 && instr.op == OP_BITAND() { emit_llvm_binop(fd, instr, "and", ti) }
        if terminated == 0 && instr.op == OP_BITOR() { emit_llvm_binop(fd, instr, "or", ti) }

        if terminated == 0 && instr.op == OP_NOT() {
            let v = emit_load_vreg(fd, instr.arg1, ti, 0)
            let r = tmp_name(ti, 1)
            write_str(fd, "  " + r + " = xor i64 " + v + ", 1\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_CMP_EQ() { emit_llvm_cmp(fd, instr, "eq", ti) }
        if terminated == 0 && instr.op == OP_CMP_NE() { emit_llvm_cmp(fd, instr, "ne", ti) }
        if terminated == 0 && instr.op == OP_CMP_LT() { emit_llvm_cmp(fd, instr, "slt", ti) }
        if terminated == 0 && instr.op == OP_CMP_LE() { emit_llvm_cmp(fd, instr, "sle", ti) }
        if terminated == 0 && instr.op == OP_CMP_GT() { emit_llvm_cmp(fd, instr, "sgt", ti) }
        if terminated == 0 && instr.op == OP_CMP_GE() { emit_llvm_cmp(fd, instr, "sge", ti) }

        if terminated == 0 && instr.op == OP_LOAD() {
            let base = emit_load_vreg(fd, instr.arg1, ti, 0)
            // arg2: if str_val is "array_index", arg2 is a vreg; otherwise immediate offset
            let mut addr_val = ""
            if instr.str_val == "array_index" {
                // Array indexing: base is fat pointer address, arg2 is index vreg
                // 1. Extract data pointer from fat pointer (offset 0)
                let fp = tmp_name(ti, 1)
                write_str(fd, "  " + fp + " = inttoptr i64 " + base + " to ptr\n")
                let dp = tmp_name(ti, 2)
                write_str(fd, "  " + dp + " = load i64, ptr " + fp + "\n")
                // 2. Scale index by element size (8 bytes for pointer-based storage)
                let idx = emit_load_vreg(fd, instr.arg2, ti, 3)
                let scaled = tmp_name(ti, 4)
                write_str(fd, "  " + scaled + " = mul i64 " + idx + ", 8\n")
                // 3. Calculate element address
                let a = tmp_name(ti, 5)
                write_str(fd, "  " + a + " = add i64 " + dp + ", " + scaled + "\n")
                addr_val = a
            } else {
                if instr.arg2 == 0 {
                    addr_val = base
                } else {
                    let a = tmp_name(ti, 2)
                    write_str(fd, "  " + a + " = add i64 " + base + ", " + strconv.Itoa(instr.arg2) + "\n")
                    addr_val = a
                }
            }
            let ptr = tmp_name(ti, 6)
            write_str(fd, "  " + ptr + " = inttoptr i64 " + addr_val + " to ptr\n")
            let val = tmp_name(ti, 7)
            write_str(fd, "  " + val + " = load i64, ptr " + ptr + "\n")
            emit_store_vreg(fd, instr.dest, val)
        }

        if terminated == 0 && instr.op == OP_STORE() {
            let addr = emit_load_vreg(fd, instr.arg1, ti, 0)
            let val = emit_load_vreg(fd, instr.arg2, ti, 1)
            let ptr = tmp_name(ti, 2)
            write_str(fd, "  " + ptr + " = inttoptr i64 " + addr + " to ptr\n")
            write_str(fd, "  store i64 " + val + ", ptr " + ptr + "\n")
        }

        if terminated == 0 && instr.op == OP_COPY() {
            // Copy value from source vreg (arg1) to dest vreg
            let val = emit_load_vreg(fd, instr.arg1, ti, 0)
            emit_store_vreg(fd, instr.dest, val)
        }

        if terminated == 0 && instr.op == OP_ALLOCA() {
            // Allocate with malloc (survives function returns)
            let size = strconv.Itoa(instr.arg1)
            let p = tmp_name(ti, 0)
            write_str(fd, "  " + p + " = call ptr @malloc(i64 " + size + ")\n")
            let z = tmp_name(ti, 1)
            write_str(fd, "  " + z + " = call ptr @memset(ptr " + p + ", i32 0, i64 " + size + ")\n")
            emit_ptrtoint_store(fd, instr.dest, p, ti, 2)
        }

        if terminated == 0 && instr.op == OP_INDEXADDR() {
            let base = emit_load_vreg(fd, instr.arg1, ti, 0)
            if instr.arg2 == 0 {
                emit_store_vreg(fd, instr.dest, base)
            } else {
                let r = tmp_name(ti, 1)
                write_str(fd, "  " + r + " = add i64 " + base + ", " + strconv.Itoa(instr.arg2) + "\n")
                emit_store_vreg(fd, instr.dest, r)
            }
        }

        if terminated == 0 && instr.op == OP_MEMCOPY() {
            // arg1=src, arg2=dest, arg3=size
            let src = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let dst = emit_load_ptr(fd, instr.arg2, ti, 2, 3)
            let size = emit_load_vreg(fd, instr.arg3, ti, 4)
            write_str(fd, "  call ptr @memcpy(ptr " + dst + ", ptr " + src + ", i64 " + size + ")\n")
        }

        if terminated == 0 && instr.op == OP_ARRAY_LEN() {
            // Fat pointer: [ptr, len, cap]. len is at offset 8
            let base = emit_load_vreg(fd, instr.arg1, ti, 0)
            let addr = tmp_name(ti, 1)
            write_str(fd, "  " + addr + " = add i64 " + base + ", 8\n")
            let ptr = tmp_name(ti, 2)
            write_str(fd, "  " + ptr + " = inttoptr i64 " + addr + " to ptr\n")
            let val = tmp_name(ti, 3)
            write_str(fd, "  " + val + " = load i64, ptr " + ptr + "\n")
            emit_store_vreg(fd, instr.dest, val)
        }

        if terminated == 0 && instr.op == OP_STR_LEN() {
            // String length via runtime call
            let str_val = emit_load_vreg(fd, instr.arg1, ti, 0)
            let str_ptr = tmp_name(ti, 1)
            write_str(fd, "  " + str_ptr + " = inttoptr i64 " + str_val + " to ptr\n")
            let result = tmp_name(ti, 2)
            write_str(fd, "  " + result + " = call i64 @ease_str_len(ptr " + str_ptr + ")\n")
            emit_store_vreg(fd, instr.dest, result)
        }

        if terminated == 0 && instr.op == OP_ARRAY_PUSH() {
            // arg1=fat ptr vreg, arg2=element vreg
            let fp = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let elem = emit_load_vreg(fd, instr.arg2, ti, 2)
            let tmp_alloca = tmp_name(ti, 3)
            write_str(fd, "  " + tmp_alloca + " = alloca i64\n")
            write_str(fd, "  store i64 " + elem + ", ptr " + tmp_alloca + "\n")
            write_str(fd, "  call void @ease_array_push(ptr " + fp + ", ptr " + tmp_alloca + ", i64 8)\n")
        }

        if terminated == 0 && instr.op == OP_POKE() {
            let addr = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let val = emit_load_vreg(fd, instr.arg2, ti, 2)
            write_str(fd, "  call void @ease_poke(ptr " + addr + ", i64 " + val + ")\n")
        }

        if terminated == 0 && instr.op == OP_PEEK() {
            let addr = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let r = tmp_name(ti, 2)
            write_str(fd, "  " + r + " = call i64 @ease_peek(ptr " + addr + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_HEAP_ALLOC() {
            let size = emit_load_vreg(fd, instr.arg1, ti, 0)
            let p = tmp_name(ti, 1)
            write_str(fd, "  " + p + " = call ptr @malloc(i64 " + size + ")\n")
            let ms = tmp_name(ti, 2)
            write_str(fd, "  " + ms + " = call ptr @memset(ptr " + p + ", i32 0, i64 " + size + ")\n")
            emit_ptrtoint_store(fd, instr.dest, p, ti, 3)
        }

        if terminated == 0 && instr.op == OP_READFILE() {
            let path = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let p = tmp_name(ti, 2)
            write_str(fd, "  " + p + " = call ptr @ease_read_file(ptr " + path + ")\n")
            emit_ptrtoint_store(fd, instr.dest, p, ti, 3)
        }

        if terminated == 0 && instr.op == OP_ARGC() {
            let r = tmp_name(ti, 0)
            write_str(fd, "  " + r + " = call i64 @ease_argc()\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_ARGV() {
            let idx = emit_load_vreg(fd, instr.arg1, ti, 0)
            let p = tmp_name(ti, 1)
            write_str(fd, "  " + p + " = call ptr @ease_argv(i64 " + idx + ")\n")
            emit_ptrtoint_store(fd, instr.dest, p, ti, 2)
        }

        if terminated == 0 && instr.op == OP_INT_TO_STR() {
            let val = emit_load_vreg(fd, instr.arg1, ti, 0)
            let p = tmp_name(ti, 1)
            write_str(fd, "  " + p + " = call ptr @ease_int_to_str(i64 " + val + ")\n")
            emit_ptrtoint_store(fd, instr.dest, p, ti, 2)
        }

        if terminated == 0 && instr.op == OP_PRINT() {
            let s = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            write_str(fd, "  call void @ease_print(ptr " + s + ")\n")
        }

        if terminated == 0 && instr.op == OP_STR_EQ() {
            let a = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let b = emit_load_ptr(fd, instr.arg2, ti, 2, 3)
            let r = tmp_name(ti, 4)
            write_str(fd, "  " + r + " = call i64 @ease_str_eq(ptr " + a + ", ptr " + b + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_STR_NE() {
            let a = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let b = emit_load_ptr(fd, instr.arg2, ti, 2, 3)
            let r = tmp_name(ti, 4)
            write_str(fd, "  " + r + " = call i64 @ease_str_ne(ptr " + a + ", ptr " + b + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_STR_CONCAT() {
            let a = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let b = emit_load_ptr(fd, instr.arg2, ti, 2, 3)
            let r = tmp_name(ti, 4)
            write_str(fd, "  " + r + " = call ptr @ease_str_concat(ptr " + a + ", ptr " + b + ")\n")
            emit_ptrtoint_store(fd, instr.dest, r, ti, 5)
        }

        if terminated == 0 && instr.op == OP_STR_CHAR_AT() {
            let s = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let idx = emit_load_vreg(fd, instr.arg2, ti, 2)
            let r = tmp_name(ti, 3)
            write_str(fd, "  " + r + " = call i64 @ease_str_char_at(ptr " + s + ", i64 " + idx + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_STR_SUBSTRING() {
            let s = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let start_val = emit_load_vreg(fd, instr.arg2, ti, 2)
            let end_val = emit_load_vreg(fd, instr.arg3, ti, 3)
            let p = tmp_name(ti, 4)
            write_str(fd, "  " + p + " = call ptr @ease_str_substring(ptr " + s + ", i64 " + start_val + ", i64 " + end_val + ")\n")
            emit_ptrtoint_store(fd, instr.dest, p, ti, 5)
        }

        if terminated == 0 && instr.op == OP_SYSCALL_OPEN() {
            let path = emit_load_ptr(fd, instr.arg1, ti, 0, 1)
            let flags = emit_load_vreg(fd, instr.arg2, ti, 2)
            let mode = emit_load_vreg(fd, instr.arg3, ti, 3)
            let r = tmp_name(ti, 4)
            write_str(fd, "  " + r + " = call i64 @ease_syscall_open(ptr " + path + ", i64 " + flags + ", i64 " + mode + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_SYSCALL_WRITE() {
            let sfd = emit_load_vreg(fd, instr.arg1, ti, 0)
            let buf = emit_load_ptr(fd, instr.arg2, ti, 1, 2)
            let size = emit_load_vreg(fd, instr.arg3, ti, 3)
            let r = tmp_name(ti, 4)
            write_str(fd, "  " + r + " = call i64 @ease_syscall_write(i64 " + sfd + ", ptr " + buf + ", i64 " + size + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_SYSCALL_CLOSE() {
            let sfd = emit_load_vreg(fd, instr.arg1, ti, 0)
            let r = tmp_name(ti, 1)
            write_str(fd, "  " + r + " = call i64 @ease_syscall_close(i64 " + sfd + ")\n")
            emit_store_vreg(fd, instr.dest, r)
        }

        if terminated == 0 && instr.op == OP_ARG() {
            // Collect argument for next call
            push(call_args, instr.arg1)
        }

        if terminated == 0 && instr.op == OP_CALL() {
            let callee = llvm_func_name(instr.str_val)
            // Build argument string
            let mut args_str = ""
            let mut ai = 0
            for ai < len(call_args) {
                if ai > 0 { args_str = args_str + ", " }
                let arg_val = emit_load_vreg(fd, call_args[ai], ti, ai)
                args_str = args_str + "i64 " + arg_val
                ai = ai + 1
            }
            // Emit call
            if instr.dest >= 0 {
                let r = tmp_name(ti, 9)
                write_str(fd, "  " + r + " = call i64 @" + callee + "(" + args_str + ")\n")
                emit_store_vreg(fd, instr.dest, r)
            } else {
                write_str(fd, "  call i64 @" + callee + "(" + args_str + ")\n")
            }
            // Reset call args
            call_args = []int{}
        }

        if terminated == 0 && instr.op == OP_RET() {
            if instr.dest >= 0 {
                let v = emit_load_vreg(fd, instr.dest, ti, 0)
                write_str(fd, "  ret i64 " + v + "\n")
            } else {
                write_str(fd, "  ret i64 0\n")
            }
            terminated = 1
        }

        if terminated == 0 && instr.op == OP_JUMP() {
            write_str(fd, "  br label %L." + strconv.Itoa(instr.dest) + "\n")
            terminated = 1
        }

        if terminated == 0 && instr.op == OP_BRANCH() {
            // Branch to arg1 if dest is ZERO (CBZ semantics)
            let cond = emit_load_vreg(fd, instr.dest, ti, 0)
            let cmp = tmp_name(ti, 1)
            write_str(fd, "  " + cmp + " = icmp eq i64 " + cond + ", 0\n")
            let fall_label = "L.fall." + strconv.Itoa(ti)
            write_str(fd, "  br i1 " + cmp + ", label %L." + strconv.Itoa(instr.arg1) + ", label %" + fall_label + "\n")
            write_str(fd, fall_label + ":\n")
            terminated = 0
        }

        ii = ii + 1
    }

    // If function didn't end with a terminator, add default return
    if terminated == 0 {
        write_str(fd, "  ret i64 0\n")
    }

    write_str(fd, "}\n\n")
}

// ============================================================================
// Main
// ============================================================================

fn print_hex(val: int) {
    let mut v = val
    let mut digits = []int{}
    let mut hex_i = 0
    for hex_i < 8 {
        push(digits, v - ((v / 16) * 16))
        v = v / 16
        hex_i = hex_i + 1
    }
    let mut pri = 0
    for pri < 8 {
        let d = digits[7 - pri]
        if d < 10 {
            print(strconv.Itoa(d))
        } else {
            if d == 10 { print("a") }
            if d == 11 { print("b") }
            if d == 12 { print("c") }
            if d == 13 { print("d") }
            if d == 14 { print("e") }
            if d == 15 { print("f") }
        }
        pri = pri + 1
    }
}

fn count_func_params(nodes: []AstNode, func_idx: int) -> int {
    let node = nodes[func_idx]
    if node.left < 0 { return 0 }
    let mut count = 0
    let mut pi = node.left
    let nodes_len = len(nodes)
    for pi < nodes_len {
        if nodes[pi].tag == DECL_PARAM() {
            count = count + 1
        } else {
            break
        }
        pi = pi + 1
    }
    return count
}

fn main() -> int {
    print("=== Bootstrap Ease Compiler (LLVM IR) ===\n\n")

    // Get command-line arguments
    let argc = os.Argc()
    let mut source = ""

    if argc > 1 {
        let filename = os.Argv(1)
        print("Reading file: " + filename + "\n")
        source = os.ReadFile(filename)
        print("File loaded successfully\n\n")
    } else {
        print("ERROR: No input file specified\n")
        print("Usage: compiler <source.ease>\n")
        return 1
    }

    // Phase 1: Lexing
    print("Phase 1: Lexing\n")
    let mut pos = 0
    let mut token_count = 0
    for {
        pos = lex_skip(source, pos)
        let kind = lex_kind(source, pos)
        if kind == TK_EOF() { break }
        token_count = token_count + 1
        pos = lex_end(source, pos, kind)
    }
    print("Lexed " + strconv.Itoa(token_count) + " tokens\n\n")

    // Phase 2: Parsing
    print("Phase 2: Parsing\n")
    let mut nodes = []AstNode{}
    let mut parse_pos = 0
    parse_pos = lex_skip(source, parse_pos)
    let mut import_count = 0
    let mut struct_count = 0
    let mut func_names = []string{}
    let mut func_indices = []int{}
    let mut global_var_names = []string{}

    for {
        parse_pos = lex_skip(source, parse_pos)
        let kind = lex_kind(source, parse_pos)
        if kind == TK_EOF() { break }

        if kind == TK_IMPORT() {
            let import_result = parse_import_decl(source, parse_pos, nodes)
            if import_result.node_idx >= 0 {
                import_count = import_count + 1
                parse_pos = import_result.new_pos
                parse_pos = lex_skip(source, parse_pos)
            } else {
                break
            }
        } else if kind == TK_STRUCT() {
            let struct_result = parse_struct_decl(source, parse_pos, nodes)
            struct_count = struct_count + 1
            parse_pos = struct_result.new_pos
        } else if kind == TK_LET() {
            let let_result = parse_let_stmt(source, parse_pos, nodes)
            if let_result.node_idx >= 0 {
                let let_node = nodes[let_result.node_idx]
                push(global_var_names, let_node.str_val)
                // Track scalar (integer) globals vs array globals
                if let_node.right >= 0 {
                    let init_node = nodes[let_node.right]
                    if init_node.tag == EXPR_INT() {
                        push(g_scalar_globals, let_node.str_val)
                    }
                    if init_node.tag == EXPR_UNARY() {
                        push(g_scalar_globals, let_node.str_val)
                    }
                }
            }
            parse_pos = let_result.new_pos
        } else if kind == TK_FN() {
            let parse_result = parse_func_decl(source, parse_pos, nodes)
            if parse_result.node_idx < 0 {
                print("ERROR: Failed to parse function at position " + strconv.Itoa(parse_pos) + "\n")
                break
            }
            let func_idx = parse_result.node_idx
            let func_node = nodes[func_idx]
            push(func_names, func_node.str_val)
            push(func_indices, func_idx)
            print("  " + func_node.str_val + " (" + strconv.Itoa(len(func_names)) + ")\n")
            parse_pos = parse_result.new_pos
            parse_pos = lex_skip(source, parse_pos)
        } else {
            break
        }
    }

    print("Parsed " + strconv.Itoa(len(func_names)) + " functions\n\n")

    // Build function return type registry
    // Pre-register built-in functions (no DECL_FUNC nodes for these)
    register_func_return_type("Itoa", TYPE_STRING(), 0)
    register_func_return_type("strconv.Itoa", TYPE_STRING(), 0)
    register_func_return_type("ReadFile", TYPE_STRING(), 0)
    register_func_return_type("os.ReadFile", TYPE_STRING(), 0)
    register_func_return_type("Argv", TYPE_STRING(), 0)
    register_func_return_type("os.Argv", TYPE_STRING(), 0)
    register_func_return_type("str_substring", TYPE_STRING(), 0)

    // Register all user-defined functions from parsed declarations
    let mut reg_i = 0
    for reg_i < len(func_indices) {
        let fn_node = nodes[func_indices[reg_i]]
        register_func_return_type(fn_node.str_val, fn_node.type_tag, fn_node.int_val)
        reg_i = reg_i + 1
    }

    // Phase 3: IR Generation
    print("Phase 3: IR Generation\n")
    let mut instrs = []IRInstr{}

    let fn_count = len(func_names)
    let mut gen_all_i = 0
    for gen_all_i < fn_count {
        // Scope string tracking to current function
        g_string_vars_start = len(g_string_vars)
        g_string_array_vars_start = len(g_string_array_vars)

        let func_idx = func_indices[gen_all_i]
        let func_name = func_names[gen_all_i]
        let param_count = count_func_params(nodes, func_idx)

        let func_label = 5000 + gen_all_i
        let label_instr = IRInstr {
            op: OP_LABEL(),
            dest: func_label,
            arg1: param_count,
            arg2: 0,
            arg3: 0,
            str_val: func_name
        }
        push(instrs, label_instr)

        let mut symtab_names = []string{}
        let mut symtab_vregs = []int{}
        // Add global variables to symtab with sentinel vregs (<= -1000)
        let mut gvi = 0
        for gvi < len(global_var_names) {
            push(symtab_names, global_var_names[gvi])
            push(symtab_vregs, -1000 - gvi)
            gvi = gvi + 1
        }
        gen_ir_from_ast_with_symtab(func_idx, nodes, instrs, symtab_names, symtab_vregs)
        gen_all_i = gen_all_i + 1
    }

    print("Generated " + strconv.Itoa(len(instrs)) + " IR instructions\n\n")

    // Phase 4: LLVM IR Generation
    print("Phase 4: LLVM IR Generation\n")
    let output_ll = "./tmp/output.ll"
    let result = emit_llvm_ir(instrs, output_ll)
    if result != 0 {
        return 1
    }

    print("\n=== Compilation Complete ===\n")
    print("To build the executable:\n")
    print("  clang -O1 runtime/ease_runtime.c " + output_ll + " -o tmp/output\n")
    print("  ./tmp/output\n")

    return 0
}
