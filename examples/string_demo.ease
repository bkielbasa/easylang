// String manipulation demonstration using stdlib

import ("strings")
import ("strconv")

fn main() -> int {
    print("=== String Operations Demo ===\n\n")

    // Concatenation
    let greeting = strings.Concat("Hello", " ")
    let message = strings.Concat(greeting, "World!")
    print("Concatenation: ")
    print(message)
    print("\n\n")

    // Contains
    print("Contains 'World': ")
    if strings.Contains(message, "World") {
        print("Yes\n")
    } else {
        print("No\n")
    }

    // Starts/Ends with
    print("Starts with 'Hello': ")
    if strings.StartsWith(message, "Hello") {
        print("Yes\n")
    } else {
        print("No\n")
    }

    print("Ends with '!': ")
    if strings.EndsWith(message, "!") {
        print("Yes\n")
    } else {
        print("No\n")
    }
    print("\n")

    // Index of
    let pos = strings.IndexOf(message, "World")
    print("Position of 'World': ")
    print(strconv.Itoa(pos))
    print("\n\n")

    // Substring
    let sub = strings.Substring(message, 0, 5)
    print("First 5 characters: ")
    print(sub)
    print("\n\n")

    // Character at
    let ch = strings.CharAt(message, 0)
    print("First character code: ")
    print(strconv.Itoa(ch))
    print("\n\n")

    // Replace
    let replaced = strings.Replace(message, "World", "Ease")
    print("Replaced: ")
    print(replaced)
    print("\n\n")

    // Number conversion
    let num_str = strconv.Itoa(42)
    print("Number to string: ")
    print(num_str)
    print("\n")

    let num = strconv.Atoi("123")
    print("String to number: ")
    print(strconv.Itoa(num))
    print("\n")

    return 0
}
