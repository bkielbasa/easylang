package main

// Simple calculator demonstrating arithmetic and functions

fn add(a: int, b: int) -> int {
    return a + b
}

fn subtract(a: int, b: int) -> int {
    return a - b
}

fn multiply(a: int, b: int) -> int {
    return a * b
}

fn divide(a: int, b: int) -> int {
    if b == 0 {
        print("Error: Division by zero\n")
        return 0
    }
    return a / b
}

fn factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn fibonacci(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn main() -> int {
    print("=== Ease Calculator ===\n\n")

    // Basic arithmetic
    print("10 + 5 = ")
    print(strconv.Itoa(add(10, 5)))
    print("\n")

    print("10 - 5 = ")
    print(strconv.Itoa(subtract(10, 5)))
    print("\n")

    print("10 * 5 = ")
    print(strconv.Itoa(multiply(10, 5)))
    print("\n")

    print("10 / 5 = ")
    print(strconv.Itoa(divide(10, 5)))
    print("\n\n")

    // Factorial
    print("5! = ")
    print(strconv.Itoa(factorial(5)))
    print("\n")

    // Fibonacci
    print("fib(10) = ")
    print(strconv.Itoa(fibonacci(10)))
    print("\n")

    return 0
}
