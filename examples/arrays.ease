package main

// Comprehensive array operations demonstration
import ("strconv")

// Bubble sort
fn bubble_sort(arr: []int) {
    n := len(arr)
    for i in 0..n {
        for j in 0..(n - i - 1) {
            if arr[j] > arr[j + 1] {
                temp := arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
        }
    }
}

// Binary search (requires sorted array)
fn binary_search(arr: []int, target: int) -> int {
    left := 0
    right := len(arr) - 1
    
    for left <= right {
        mid := left + (right - left) / 2
        
        if arr[mid] == target {
            return mid
        }
        
        if arr[mid] < target {
            left = mid + 1
        } else {
            right = mid - 1
        }
    }
    
    return -1  // not found
}

// Find minimum value
fn find_min(arr: []int) -> int {
    if len(arr) == 0 {
        return 0
    }
    
    min_val := arr[0]
    for i in 1..len(arr) {
        if arr[i] < min_val {
            min_val = arr[i]
        }
    }
    return min_val
}

// Find maximum value
fn find_max(arr: []int) -> int {
    if len(arr) == 0 {
        return 0
    }
    
    max_val := arr[0]
    for i in 1..len(arr) {
        if arr[i] > max_val {
            max_val = arr[i]
        }
    }
    return max_val
}

// Calculate average
fn average(arr: []int) -> int {
    if len(arr) == 0 {
        return 0
    }
    
    sum := 0
    for i in 0..len(arr) {
        sum = sum + arr[i]
    }
    return sum / len(arr)
}

// Print array
fn print_array(arr: []int) {
    print("[")
    for i in 0..len(arr) {
        print(strconv.Itoa(arr[i]))
        if i < len(arr) - 1 {
            print(", ")
        }
    }
    print("]")
}

fn main() -> int {
    print("=== Array Operations Demo ===\n\n")
    
    // Create an unsorted array
    numbers := []int{64, 34, 25, 12, 22, 11, 90}
    
    print("Original array: ")
    print_array(numbers)
    print("\n\n")
    
    print("Min: ")
    print(strconv.Itoa(find_min(numbers)))
    print("\n")
    
    print("Max: ")
    print(strconv.Itoa(find_max(numbers)))
    print("\n")
    
    print("Average: ")
    print(strconv.Itoa(average(numbers)))
    print("\n\n")
    
    // Sort the array
    bubble_sort(numbers)
    
    print("Sorted array: ")
    print_array(numbers)
    print("\n\n")
    
    // Binary search
    target := 22
    print("Searching for ")
    print(strconv.Itoa(target))
    print(": ")
    index := binary_search(numbers, target)
    if index >= 0 {
        print("found at index ")
        print(strconv.Itoa(index))
    } else {
        print("not found")
    }
    print("\n\n")
    
    // Test append operation
    print("Appending 100...\n")
    numbers = append(numbers, 100)
    print("Array after append: ")
    print_array(numbers)
    print("\n")
    
    print("New length: ")
    print(strconv.Itoa(len(numbers)))
    print("\n")
    
    return 0
}
