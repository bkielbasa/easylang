package main

// Example: File I/O operations in Ease
import ("strconv")

fn main() -> int {
    print("=== File I/O Examples ===\n\n")

    // Example 1: Low-level syscalls
    print("1. Low-level syscalls (open/write/read/close):\n")
    demo_syscalls()

    print("\n")

    // Example 2: High-level helpers (if available)
    print("2. Write and read text files:\n")
    demo_text_files()

    print("\nAll tests passed!\n")
    return 0
}

fn demo_syscalls() {
    // Open file for writing
    // Flags: O_WRONLY=1, O_CREAT=0x200, O_TRUNC=0x400 -> 0x601=1537
    // Mode: 0644 octal = 420 decimal
    let fd = syscall.open("examples/output.txt", 1537, 420)
    if fd < 0 {
        print("  ERROR: Failed to open file for writing\n")
        return
    }

    // Write to file
    let msg = "File I/O works!\n"
    let written = syscall.write(fd, msg, 16)
    syscall.close(fd)

    print("  ✓ Wrote ")
    print(strconv.Itoa(written))
    print(" bytes\n")

    // Open file for reading
    let fd2 = syscall.open("examples/output.txt", 0, 0) // O_RDONLY
    if fd2 < 0 {
        print("  ERROR: Failed to open file for reading\n")
        return
    }

    // Read from file
    let buf = heap_alloc(100)
    let bytes_read = syscall.read(fd2, buf, 100)
    syscall.close(fd2)

    print("  ✓ Read ")
    print(strconv.Itoa(bytes_read))
    print(" bytes\n")
}

fn demo_text_files() {
    // Write a multiline file
    let content = "Line 1\nLine 2\nLine 3\n"

    // Using syscalls to write
    let fd = syscall.open("examples/multiline.txt", 1537, 420)
    if fd >= 0 {
        syscall.write(fd, content, 21)
        syscall.close(fd)
        print("  ✓ Created multiline.txt\n")
    }

    // Read it back
    let fd2 = syscall.open("examples/multiline.txt", 0, 0)
    if fd2 >= 0 {
        let buf = heap_alloc(100)
        let n = syscall.read(fd2, buf, 100)
        syscall.close(fd2)
        print("  ✓ Read back ")
        print(strconv.Itoa(n))
        print(" bytes\n")
    }
}
