package main

// Enum and pattern matching examples.
//
// Demonstrates:
// - Simple enums (tag-only variants)
// - Enums with data fields
// - Pattern matching with match expressions

enum Color {
    Red,
    Green,
    Blue,
}

enum Option {
    Some { value: int },
    None,
}

fn unwrap_or(opt: Option, def: int) -> int {
    match opt {
        Option::Some { value } => value,
        Option::None => def,
    }
}

fn color_code(c: Color) -> int {
    match c {
        Color::Red => 1,
        Color::Green => 2,
        Color::Blue => 3,
    }
}

fn main() -> int {
    // Simple enum construction
    r := Color::Red
    g := Color::Green
    b := Color::Blue

    // Pattern matching on simple enum
    rc := color_code(r)
    gc := color_code(g)
    bc := color_code(b)

    // Enum with data
    some := Option::Some { value: 42 }
    none := Option::None

    // Pattern matching extracts data
    a := unwrap_or(some, 0)
    d := unwrap_or(none, 10)

    // Verify: 1 + 2 + 3 + 42 + 10 = 58
    total := rc + gc + bc + a + d
    if total != 58 {
        return 1
    }
    return 0
}
