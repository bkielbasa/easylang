// Comprehensive global variable test

let x = 42
let mut y = 100
let name = "Ease"
let flag = true

fn main() -> int {
    print("Testing global variables:\n")

    print("x (immutable int) = ")
    print(strconv.Itoa(x))
    print("\n")

    print("y (mutable int) = ")
    print(strconv.Itoa(y))
    print("\n")

    print("name (string) = ")
    print(name)
    print("\n")

    print("flag (bool) = ")
    if flag {
        print("true")
    } else {
        print("false")
    }
    print("\n")

    // Test using globals in expressions
    let sum = x + y
    print("x + y = ")
    print(strconv.Itoa(sum))
    print("\n")

    print("\nAll tests passed!\n")
    return 0
}
