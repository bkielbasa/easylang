// Exact pattern from bootstrap sema analyze_binary
import ("strconv")

// Global array to simulate g_temp_types
let mut g_test_array = []int{}

// Simulate analyze_expr - returns 1
fn get_value() -> int {
    // Add some stack usage
    let a = 1
    let b = 2
    let c = 3
    let d = 4
    let e = 5
    return a
}

// Simulate types_equal
fn compare_direct(t1: int, t2: int) -> bool {
    print("compare_direct: t1=")
    print(strconv.Itoa(t1))
    print(", t2=")
    print(strconv.Itoa(t2))
    print("\n")
    return t1 == t2
}

// Simulate types_equal_safe
fn compare_safe(t1: int, t2: int) -> bool {
    g_test_array = []int{}
    push(g_test_array, t1)
    push(g_test_array, t2)
    print("compare_safe: stored t1=")
    print(strconv.Itoa(g_test_array[0]))
    print(", stored t2=")
    print(strconv.Itoa(g_test_array[1]))
    print("\n")
    return compare_direct(g_test_array[0], g_test_array[1])
}

// Simulate the exact pattern from analyze_binary
fn test_pattern() -> int {
    print("Getting left value...\n")
    let lt = get_value()
    print("lt = ")
    print(strconv.Itoa(lt))
    print("\n")

    print("Getting right value...\n")
    let rt = get_value()
    print("rt = ")
    print(strconv.Itoa(rt))
    print("\n")

    print("Calling compare_safe...\n")
    let result = compare_safe(lt, rt)

    if !result {
        print("ERROR: comparison failed!\n")
        return 1
    }

    print("Success!\n")
    return 0
}

fn main() -> int {
    return test_pattern()
}
