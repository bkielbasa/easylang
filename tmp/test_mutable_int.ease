// Test mutable int global

let mut counter = 0

fn increment() {
    counter = counter + 1
}

fn get_counter() -> int {
    return counter
}

fn main() -> int {
    print("Initial counter: ")
    print(strconv.Itoa(get_counter()))
    print("\n")

    increment()
    print("After increment: ")
    print(strconv.Itoa(get_counter()))
    print("\n")

    increment()
    increment()
    print("After 2 more: ")
    print(strconv.Itoa(get_counter()))
    print("\n")

    return 0
}
