// Test global array access pattern like bootstrap sema
import ("strconv")

let mut g_array = []int{}

fn check_equal(a: int, b: int) -> bool {
    print("check_equal: a=")
    print(strconv.Itoa(a))
    print(", b=")
    print(strconv.Itoa(b))
    print("\n")
    return a == b
}

fn test_global_array() -> int {
    // Initialize global array with same value
    g_array = []int{}
    push(g_array, 42)
    push(g_array, 42)

    print("Reading from global array...\n")
    let x = g_array[0]
    print("x = ")
    print(strconv.Itoa(x))
    print("\n")

    let y = g_array[1]
    print("y = ")
    print(strconv.Itoa(y))
    print("\n")

    print("Calling check_equal(g_array[0], g_array[1])...\n")
    let result = check_equal(g_array[0], g_array[1])

    if !result {
        print("ERROR: values should be equal!\n")
        return 1
    }

    print("Success!\n")
    return 0
}

fn main() -> int {
    return test_global_array()
}
