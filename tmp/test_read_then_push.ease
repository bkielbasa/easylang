struct Container {
    values: []int,
}

fn make_container() -> Container {
    let mut c = Container { values: []int{} }
    push(c.values, 42)
    return c
}

fn read_and_push(c: Container) {
    print("Reading from array\n")
    let val = c.values[0]

    print("Got: ")
    print(strconv.Itoa(val))
    print("\n")

    print("Computing new value\n")
    let new_val = val + 1

    print("Pushing ")
    print(strconv.Itoa(new_val))
    print("\n")

    push(c.values, new_val)

    print("Done\n")
}

fn main() -> int {
    let c = make_container()
    read_and_push(c)
    return 0
}
