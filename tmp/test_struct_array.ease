struct Container {
    values: []int,
}

fn add_value(c: Container, val: int) {
    print("In add_value, len before: ")
    print(strconv.Itoa(len(c.values)))
    print("\n")
    push(c.values, val)
    print("In add_value, len after: ")
    print(strconv.Itoa(len(c.values)))
    print("\n")
}

fn main() -> int {
    let mut c = Container { values: []int{} }
    push(c.values, 1)
    push(c.values, 2)

    print("Before call, len: ")
    print(strconv.Itoa(len(c.values)))
    print("\n")

    add_value(c, 3)

    print("After call, len: ")
    print(strconv.Itoa(len(c.values)))
    print("\n")

    print("Values: ")
    let mut i = 0
    for i < len(c.values) {
        print(strconv.Itoa(c.values[i]))
        print(" ")
        i = i + 1
    }
    print("\n")

    return 0
}
