struct Builder {
    next_vreg: []int,
}

fn new_builder() -> Builder {
    print("  new_builder: creating struct\n")
    let mut b = Builder {
        next_vreg: []int{},
    }
    print("  new_builder: pushing 0\n")
    push(b.next_vreg, 0)
    print("  new_builder: done, len=")
    print(strconv.Itoa(len(b.next_vreg)))
    print("\n")
    return b
}

fn alloc_vreg(b: Builder) -> int {
    print("  alloc_vreg: entry, len=")
    print(strconv.Itoa(len(b.next_vreg)))
    print("\n")

    print("  alloc_vreg: computing index\n")
    let idx = len(b.next_vreg) - 1

    print("  alloc_vreg: reading at index ")
    print(strconv.Itoa(idx))
    print("\n")

    let vreg = b.next_vreg[idx]

    print("  alloc_vreg: got vreg=")
    print(strconv.Itoa(vreg))
    print("\n")

    let new_val = vreg + 1
    push(b.next_vreg, new_val)
    return vreg
}

fn main() -> int {
    print("Creating builder\n")
    let mut builder = new_builder()

    print("Allocating vreg 1\n")
    let v1 = alloc_vreg(builder)
    print("Got: ")
    print(strconv.Itoa(v1))
    print("\n")

    print("Success!\n")
    return 0
}
