struct Container {
    values: []int,
}

fn make_container() -> Container {
    print("make_container: creating\n")
    let mut c = Container { values: []int{} }
    print("make_container: pushing values\n")
    push(c.values, 1)
    push(c.values, 2)
    print("make_container: done, len=")
    print(strconv.Itoa(len(c.values)))
    print("\n")
    return c
}

fn main() -> int {
    print("Calling make_container\n")
    let c = make_container()

    print("Got container, len=")
    print(strconv.Itoa(len(c.values)))
    print("\n")

    print("Values: ")
    let mut i = 0
    for i < len(c.values) {
        print(strconv.Itoa(c.values[i]))
        print(" ")
        i = i + 1
    }
    print("\n")

    return 0
}
